<!-- 管理页统一样式与脚本片段：由 webui/build.py 提取并注入统一工作区 -->
<style>
/* ==MGMT_CSS_START== */
/* ───────────── 管理页专用交互样式（v0.3 四页工作区 + 移动端鱼轮播保留） ───────────── */
#ms-mgmt-view .m-mob-only,
#ms-mgmt-view .m-ab-mob-head {
  display: none;
}

.ab-roster {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: 440px;
  overflow-y: auto;
}

.ab-card {
  width: 100%;
  text-align: left;
  padding: 10px 12px;
  border: 1px solid var(--mil-line);
  border-radius: 12px;
  background: var(--mil-screen);
  color: var(--mil-ink);
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 5px;
  transition: border-color 0.14s ease, background-color 0.14s ease;
}

.ab-card.is-selected,
.ab-card[aria-selected="true"] {
  background: var(--mil-panel);
  border-color: var(--mil-accent);
}

:root[data-ui-style="millennium"] .ab-card {
  border-width: 2px;
  border-radius: 0;
  box-shadow: inset 1px 1px 0 var(--mil-screen-shade);
}

:root[data-ui-style="millennium"] .ab-card.is-selected,
:root[data-ui-style="millennium"] .ab-card[aria-selected="true"] {
  background: var(--mil-key-hi);
  border-color: var(--mil-hot);
  box-shadow: var(--mil-raise);
}

.pr-studio {
  display: grid;
  grid-template-columns: minmax(250px, 0.78fr) minmax(0, 1.45fr);
  gap: 14px;
  align-items: start;
}

.pr-roster-tools {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 10px;
}

.pr-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.pr-primary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-top: 10px;
}

.pr-span-2 {
  grid-column: 1 / -1;
}

.pr-adv-wrap {
  margin-top: 12px;
  border-top: 1px solid var(--mil-line);
  padding-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

:root[data-ui-style="millennium"] .pr-adv-wrap {
  border-top: 2px dashed var(--mil-rule);
}

.pr-adv-toggle {
  justify-content: flex-start;
  width: fit-content;
}

.pr-adv-body {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.pr-adv-body[hidden],
.pr-pane[hidden] {
  display: none;
}

.pr-pane {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.pr-md-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.pr-ab-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
  justify-content: space-between;
}

.pr-ab-filter .mil-input {
  flex: 1 1 200px;
}

.pr-ability-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 8px;
}

.pr-ability-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 12px;
  border: 1px solid var(--mil-line);
  border-radius: 12px;
  background: var(--mil-screen);
  color: var(--mil-ink);
}

:root[data-ui-style="millennium"] .pr-ability-card {
  border-width: 2px;
  border-radius: 0;
}

.pr-ability-meta {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.pr-mob-sheet-body {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* ── 移动端裸鱼轮播（两套主题下均无方框/圆框背景，选中居中大彩鱼，两侧缩小去色） ── */
#ms-mgmt-view .m-mob-carousel-wrap {
  position: relative;
  padding: 4px 0 8px;
}
#ms-mgmt-view .m-mob-carousel {
  display: flex;
  align-items: flex-end;
  gap: 6px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  padding: 6px 42px 8px;
}
#ms-mgmt-view .m-mob-carousel::-webkit-scrollbar {
  display: none;
}
#ms-mgmt-view .mob-role-item {
  scroll-snap-align: center;
  flex: 0 0 auto;
  min-width: 78px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 4px 6px;
  border: 0 !important;
  border-radius: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  color: var(--mil-ink);
  cursor: pointer;
  transition: transform 160ms ease, opacity 160ms ease;
}
#ms-mgmt-view .mob-role-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0 !important;
  border-radius: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  padding: 0 !important;
  transition: transform 160ms ease, filter 160ms ease, opacity 160ms ease;
}
#ms-mgmt-view .mob-role-item:not(.is-active) .mob-role-avatar {
  transform: scale(0.84);
  filter: grayscale(0.8);
  opacity: 0.58;
}
#ms-mgmt-view .mob-role-item.is-active .mob-role-avatar {
  transform: scale(1.06);
  filter: none;
  opacity: 1;
}
#ms-mgmt-view .mob-role-name {
  font-size: 12px;
  font-weight: 700;
  line-height: 1.2;
}
#ms-mgmt-view .mob-role-sub {
  font-size: 10px;
  color: var(--mil-muted);
}
#ms-mgmt-view .mob-role-step {
  position: absolute;
  top: 28px;
  z-index: 2;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1px solid var(--mil-line);
  background: var(--mil-panel);
  color: var(--mil-ink);
  font-weight: 800;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
:root[data-ui-style="millennium"] #ms-mgmt-view .mob-role-step {
  border-radius: 0;
  border: 2px solid var(--mil-line);
}
#ms-mgmt-view .mob-role-step.prev { left: 4px; }
#ms-mgmt-view .mob-role-step.next { right: 4px; }
#ms-mgmt-view .mob-role-dots {
  display: flex;
  justify-content: center;
  gap: 5px;
  margin-top: 2px;
}
#ms-mgmt-view .mob-role-dot {
  width: 6px;
  height: 6px;
  border-radius: 999px;
  border: 0;
  padding: 0;
  background: var(--mil-lo);
  cursor: pointer;
}
#ms-mgmt-view .mob-role-dot.is-active {
  width: 16px;
  background: var(--mil-ink);
}
#ms-mgmt-view .m-mob-role-card1 {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
#ms-mgmt-view .m-mob-role-card1-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
#ms-mgmt-view .m-mob-role-card1-title {
  font-size: 15px;
  font-weight: 800;
}
#ms-mgmt-view .m-mob-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  padding: 11px 12px;
  border: 0;
  border-bottom: 1px solid var(--mil-line);
  background: transparent;
  color: var(--mil-ink);
  font-size: 13.5px;
  font-weight: 600;
  cursor: pointer;
  text-align: left;
}
#ms-mgmt-view .m-mob-row:last-child { border-bottom: 0; }
#ms-mgmt-view .m-mob-row-l,
#ms-mgmt-view .m-mob-row-r {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}
#ms-mgmt-view .m-mob-row-val {
  font-size: 12px;
  color: var(--mil-muted);
}
#ms-mgmt-view .m-mob-scrim,
#ms-mgmt-view .m-mob-sheet-scrim {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(15, 16, 17, 0.42);
}
#ms-mgmt-view .m-mob-scrim[hidden],
#ms-mgmt-view .m-mob-sheet-scrim[hidden] {
  display: none;
}
#ms-mgmt-view .m-mob-sheet {
  width: 100%;
  max-width: 720px;
  max-height: 82vh;
  overflow-y: auto;
  background: var(--mil-panel);
  border-top: 1px solid var(--mil-line);
  border-radius: 18px 18px 0 0;
  padding: 10px 16px 24px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
:root[data-ui-style="millennium"] #ms-mgmt-view .m-mob-sheet {
  border-radius: 0;
  border-top: 2px solid var(--mil-line);
}
#ms-mgmt-view .m-mob-handle {
  width: 36px;
  height: 4px;
  border-radius: 999px;
  background: var(--mil-lo);
  margin: 0 auto 4px;
}
#ms-mgmt-view .m-mob-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ── 产物检视工作台 ── */
.lib-shell {
  display: grid;
  grid-template-columns: minmax(220px, 0.56fr) minmax(0, 1.6fr);
  gap: 14px;
  align-items: start;
}

.lib-shell.has-drawer {
  grid-template-columns: minmax(200px, 0.5fr) minmax(0, 0.95fr) minmax(380px, 1.35fr);
}

.lib-aside {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.lib-aside-block {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.lib-cat-rail {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.lib-cat-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 7px 10px;
  border: 1px solid var(--mil-line);
  border-radius: 10px;
  background: var(--mil-screen);
  color: var(--mil-ink);
  font-size: 12.5px;
  font-weight: 600;
  cursor: pointer;
  text-align: left;
}

.lib-cat-btn:hover,
.lib-cat-btn[aria-pressed="true"] {
  border-color: var(--mil-accent);
  background: var(--mil-panel);
}

:root[data-ui-style="millennium"] .lib-cat-btn {
  border-radius: 0;
  border-width: 1.5px;
}

:root[data-ui-style="millennium"] .lib-cat-btn[aria-pressed="true"] {
  background: var(--mil-key-on, #a8dab5);
  color: #1d261f;
}

.lib-cat-ic {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}

.lib-chat-chips {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.lib-gallery {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 10px;
}

.lib-card {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 12px;
  border: 1px solid var(--mil-line);
  border-radius: 14px;
  background: var(--mil-screen);
  color: var(--mil-ink);
  text-align: left;
  cursor: pointer;
  min-width: 0;
  transition: border-color 0.14s ease, background-color 0.14s ease;
}

.lib-card:hover,
.lib-card.is-selected {
  border-color: var(--mil-accent);
  background: var(--mil-panel);
}

:root[data-ui-style="millennium"] .lib-card {
  border-width: 2px;
  border-radius: 0;
  box-shadow: inset 1px 1px 0 var(--mil-screen-shade);
}

.lib-thumb-img {
  width: 100%;
  height: 118px;
  border-radius: 10px;
  background-color: var(--mil-well);
  background-position: center;
  background-size: cover;
  background-repeat: no-repeat;
  border: 1px solid var(--mil-line);
}

:root[data-ui-style="millennium"] .lib-thumb-img {
  border-radius: 0;
}

.lib-drawer {
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-width: 0;
}

.lib-drawer[hidden],
.lib-main [hidden] {
  display: none;
}

.lib-drawer-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.lib-img-stage {
  width: 100%;
  min-height: 300px;
  border-radius: 12px;
  border: 1px solid var(--mil-line);
  background-color: var(--mil-screen);
  background-position: center;
  background-size: contain;
  background-repeat: no-repeat;
}

.lib-img-stage.is-wide {
  min-height: 460px;
  background-position: top center;
  background-size: 100% auto;
}

:root[data-ui-style="millennium"] .lib-img-stage {
  border-radius: 0;
}

.lib-doc-box {
  max-height: 62vh;
  overflow: auto;
  padding: 14px 16px;
  border: 1px solid var(--mil-line);
  border-radius: 12px;
  background: var(--mil-screen);
  color: var(--mil-ink);
  font-size: 13px;
  line-height: 1.65;
}

:root[data-ui-style="millennium"] .lib-doc-box {
  border-radius: 0;
  border-width: 1.5px;
}

.lib-md-doc h1, .lib-md-doc h2, .lib-md-doc h3, .lib-md-doc h4 {
  margin: 12px 0 6px;
  line-height: 1.35;
}
.lib-md-doc h1 { font-size: 17px; }
.lib-md-doc h2 { font-size: 15px; border-bottom: 1px solid var(--mil-rule); padding-bottom: 4px; }
.lib-md-doc h3 { font-size: 13.5px; }
.lib-md-doc p, .lib-md-doc ul, .lib-md-doc ol, .lib-md-doc blockquote { margin: 6px 0; }
.lib-md-doc ul, .lib-md-doc ol { padding-left: 20px; }
.lib-md-doc blockquote {
  border-left: 3px solid var(--mil-accent);
  padding-left: 10px;
  color: var(--mil-muted);
}
.lib-md-doc code {
  font-family: var(--mil-font-mono);
  font-size: 12px;
  padding: 1px 4px;
  background: var(--mil-well);
}

.lib-html-doc {
  max-height: 64vh;
  overflow: auto;
  border: 1px solid var(--mil-line);
  border-radius: 12px;
  background: #ffffff;
  color: #18181b;
  padding: 14px;
}

:root[data-ui-style="millennium"] .lib-html-doc {
  border-radius: 0;
  border-width: 1.5px;
}

.lib-inline-pic {
  width: 100%;
  min-height: 180px;
  margin: 8px 0;
  background-position: center;
  background-size: contain;
  background-repeat: no-repeat;
}

.sk-review-banner {
  padding: 10px 12px;
  border: 1px solid var(--mil-accent);
  border-radius: 10px;
  background: var(--mil-screen);
}

:root[data-ui-style="millennium"] .sk-review-banner {
  border-radius: 0;
  border-width: 2px;
}

/* ── 单行可滚动分区标签栏（WCAG 1.4.1 底边形状指示器） ── */
.ab-top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 12px;
}

.ab-top-tabs {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  scrollbar-width: none;
  scroll-snap-type: inline proximity;
  gap: 6px;
  padding-bottom: 3px;
  max-width: 100%;
}

.ab-top-tabs::-webkit-scrollbar {
  display: none;
}

.ab-top-tabs [role="tab"] {
  position: relative;
  flex: none;
  scroll-snap-align: start;
}

.ab-top-tabs [role="tab"][aria-selected="true"] {
  border-color: var(--mil-accent);
}

.ab-top-tabs [role="tab"][aria-selected="true"]::after {
  content: "";
  position: absolute;
  inset: auto 2px -2px;
  border-block-end: 3px solid var(--mil-accent);
}

:root[data-ui-style="millennium"] .ab-top-tabs [role="tab"][aria-selected="true"] {
  background: var(--mil-key-hi);
  border-color: var(--mil-hot);
}

:root[data-ui-style="millennium"] .ab-top-tabs [role="tab"][aria-selected="true"]::after {
  inset: auto 0 -2px;
  border-block-end: 3px solid var(--mil-hot);
}

.ab-pane-inner {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.mil-fieldset {
  margin: 0;
  padding: 8px 10px;
  border: 1px solid var(--mil-line);
  border-radius: 10px;
  background: var(--mil-screen);
}

:root[data-ui-style="millennium"] .mil-fieldset {
  border-radius: 0;
  border-width: 1.5px;
}

.mil-radio-row {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
}

.mil-radio-row input[type="radio"] {
  accent-color: var(--mil-accent);
  margin: 0;
}

/* ── 手账双栏工作台 ── */
.mem-studio {
  display: grid;
  grid-template-columns: minmax(260px, 0.72fr) minmax(0, 1.48fr);
  gap: 14px;
  align-items: start;
}

.mem-aside,
.mem-main-stack {
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-width: 0;
}

.mem-search-box {
  display: flex;
  flex-direction: column;
  gap: 8px;
  border-top: 1px solid var(--mil-line);
  padding-top: 10px;
}

:root[data-ui-style="millennium"] .mem-search-box {
  border-top: 2px dashed var(--mil-rule);
}

.lib-fs-editor {
  width: 100%;
  min-height: 360px;
}

/* ── 设置 4 块布局 ── */
.set-blocks {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  align-items: start;
}

.set-block {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.set-admins-split {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 10px;
}

.set-subcard {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 10px 12px;
  border: 1px solid var(--mil-line);
  border-radius: 12px;
  background: var(--mil-screen);
}

:root[data-ui-style="millennium"] .set-subcard {
  border-width: 2px;
  border-radius: 0;
}

.set-admin-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.set-vault-form {
  display: flex;
  flex-direction: column;
  gap: 10px;
  border-top: 1px solid var(--mil-line);
  padding-top: 10px;
}

:root[data-ui-style="millennium"] .set-vault-form {
  border-top: 2px dashed var(--mil-rule);
}

@media (max-width: 960px) {
  .pr-studio,
  .mem-studio,
  .lib-shell,
  .lib-shell.has-drawer,
  .set-blocks {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (max-width: 760px) {
  #ms-mgmt-view .m-mob-only {
    display: flex;
  }
  #ms-mgmt-view .m-ab-mob-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  #ms-mgmt-view .m-ab-mob-head[hidden] {
    display: none;
  }
  #ms-mgmt-view .m-ab-roster {
    display: none;
  }
  .pr-primary-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}
/* ==MGMT_CSS_END== */
</style>
<script>
  /* ==MGMT_BOOT_START== */
  const TOOLSET_META = {
    context: { title: "会话与记忆", desc: "会话记忆、自身近况与上下文检索" },
    web: { title: "联网搜索", desc: "只读网页检索与内容抓取" },
    workspace: { title: "文件读写", desc: "持久工作区与产物文件读写" },
    exec: { title: "命令运行", desc: "宿主机或轻量沙箱命令执行" },
    schedule: { title: "定时提醒", desc: "周期提醒与条件触发监控" },
  };
  const ALL_TOOLSETS = ["context", "web", "workspace", "exec", "schedule"];
  const MAX_PROFILE_MD_LINES = 150;

  function triggerZipDownload(b64, filename) {
    if (!b64) return;
    const link = document.createElement("a");
    link.href = `data:application/zip;base64,${b64}`;
    link.download = filename || "maisya-package.zip";
    document.body.appendChild(link);
    link.click();
    link.remove();
  }

  function bytesToBase64(bytes) {
    let bin = "";
    for (let i = 0; i < bytes.length; i += 8192) {
      bin += String.fromCharCode(...bytes.subarray(i, i + 8192));
    }
    return btoa(bin);
  }

  async function stageAndPreviewZipFile(file) {
    if (!file) throw new Error("未选择压缩包");
    if (!file.name.toLowerCase().endsWith(".zip")) throw new Error("请选择有效的 .zip 压缩包");
    if (file.size > 4 * 1024 * 1024) throw new Error("压缩包超过 4 MiB 上限");
    const buf = await file.arrayBuffer();
    const bytes = new Uint8Array(buf);
    if (bytes.length < 4 || bytes[0] !== 0x50 || bytes[1] !== 0x4b) throw new Error("文件头校验失败，非标准 ZIP 包");
    const fullB64 = bytesToBase64(bytes);
    if (bytes.length <= 16384) {
      const previewRes = await hostRpc("write", "package_preview", { base64: fullB64 });
      return { previewRes, base64: fullB64, transferToken: "" };
    }
    const chunkSize = 16384;
    let token = "";
    for (let off = 0; off < bytes.length; off += chunkSize) {
      const slice = bytes.subarray(off, Math.min(bytes.length, off + chunkSize));
      const done = off + slice.length >= bytes.length;
      const chunkRes = await hostRpc("write", "package_upload_chunk", {
        token: token || undefined,
        offset: off,
        data: bytesToBase64(slice),
        done,
      });
      if (!chunkRes?.success) {
        return { previewRes: chunkRes, base64: fullB64, transferToken: "" };
      }
      if (chunkRes.token) token = chunkRes.token;
    }
    const previewRes = await hostRpc("write", "package_preview", { transfer_token: token });
    return { previewRes, base64: fullB64, transferToken: token };
  }

  function renderPkgPreviewHtml(preview) {
    const p = preview?.preview || preview || {};
    const kindTxt = p.kind_label || (p.kind === "profile" ? "身份档案" : p.kind === "capability_pack" ? "能力包" : p.kind === "legacy_profile" ? "旧版档案包" : "分享模板");
    const pid = p.profile_id || p.profile?.id || "";
    const pName = p.title || p.profile_name || p.profile?.name || pid;
    const rawSkills = Array.isArray(p.skills) ? p.skills : [];
    const skillLabels = rawSkills.map((s) => (typeof s === "string" ? s : (s?.title || s?.id || ""))).filter(Boolean);
    const secrets = Array.isArray(p.required_secret_handles) ? p.required_secret_handles : (Array.isArray(p.required_secrets) ? p.required_secrets : []);
    const schedCount = Number(p.schedules_count ?? p.schedule_count ?? (Array.isArray(p.schedules) ? p.schedules.length : 0));
    const hasProf = Boolean(p.has_profile ?? (p.kind === "profile" || p.kind === "template" || pid));
    return `
      <div class="mil-row" style="justify-content:space-between;align-items:center">
        <strong>${esc(kindTxt)}${pName ? ` · ${esc(pName)}` : ""}</strong>
        ${pid ? `<span class="mil-tag mono">${esc(pid)}</span>` : ""}
      </div>
      ${p.description ? `<div class="mil-hint">${esc(p.description)}</div>` : ""}
      <div class="mil-row" style="flex-wrap:wrap;gap:6px">
        ${hasProf ? `<span class="mil-tag mil-tag--ok">包含身份设定</span>` : `<span class="mil-tag">仅能力包（不含角色身份）</span>`}
        ${skillLabels.length ? `<span class="mil-tag">技能 ${skillLabels.length} 项：${esc(skillLabels.slice(0, 6).join(", "))}</span>` : ""}
        ${schedCount > 0 ? `<span class="mil-tag">脱敏日程 ${schedCount} 项</span>` : ""}
        ${secrets.length ? `<span class="mil-tag mil-tag--warn">需自备凭据：${esc(secrets.join(", "))}</span>` : `<span class="mil-tag mil-tag--ok">无敏感凭据依赖</span>`}
      </div>
      <div class="mil-hint" style="margin-top:4px">导出压缩包会自动剥离群号、私密路径与密码，绝不外泄隐私。</div>`;
  }

  const BUILTIN_PROFILE_IDS = new Set(["default", "scout", "digest"]);

  const fmtDateTime = (ts) => {
    const n = Number(ts || 0);
    if (!n || Number.isNaN(n)) return "已保存";
    const d = new Date(n * 1000);
    if (Number.isNaN(d.getTime())) return "已保存";
    const pad = (v) => String(v).padStart(2, "0");
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
  };

  function bootManagementTab(tab, sig) {
    Promise.resolve(window.maibot?.ready).then(() => {
      if (disposed || sig?.aborted || activePage !== tab) return;
      renderIconSlots();
      if (tab === "abilities") bootAbilitiesTab(sig);
      else if (tab === "memory") bootMemoryTab(sig);
      else if (tab === "library") bootLibraryTab(sig);
      else if (tab === "settings") bootSettingsTab(sig);
    });
  }

  /* ───────────── 能力页容器（角色 | 技能 | 外部连接） ───────────── */
  function bootAbilitiesTab(sig) {
    const booted = { profiles: false, skills: false, connectors: false };
    let currentSub = pendingAbilitiesSubTab || "profiles";
    pendingAbilitiesSubTab = "profiles";
    let reloadProfilesFn = null;
    let reloadSkillsFn = null;
    let profilesStale = false;
    let skillsStale = false;

    const abCtrl = {
      getSub: () => currentSub,
      switchSub: (sub) => activateSub(sub),
      registerReloadProfiles: (fn) => { reloadProfilesFn = fn; },
      registerReloadSkills: (fn) => { reloadSkillsFn = fn; },
      markProfilesStale: () => { profilesStale = true; },
      markSkillsStale: () => { skillsStale = true; },
    };

    function activateSub(nextSub) {
      const sub = ["profiles", "skills", "connectors"].includes(nextSub) ? nextSub : "profiles";
      currentSub = sub;
      $$("#ab-sub-tabs [data-ab-sub]").forEach((btn) => {
        const sel = btn.dataset.abSub === sub;
        btn.setAttribute("aria-selected", String(sel));
        if (sel) {
          try { btn.scrollIntoView({ block: "nearest", inline: "nearest" }); } catch (_) {}
        }
      });
      const pPane = $("#ab-pane-profiles");
      const sPane = $("#ab-pane-skills");
      const cPane = $("#ab-pane-connectors");
      if (pPane) pPane.hidden = sub !== "profiles";
      if (sPane) sPane.hidden = sub !== "skills";
      if (cPane) cPane.hidden = sub !== "connectors";
      renderIconSlots();

      if (sub === "profiles") {
        if (!booted.profiles) {
          booted.profiles = true;
          bootProfilesTab(sig, abCtrl);
        } else if (profilesStale && typeof reloadProfilesFn === "function") {
          profilesStale = false;
          reloadProfilesFn();
        }
      } else if (sub === "skills") {
        if (!booted.skills) {
          booted.skills = true;
          bootSkillsTab(sig, abCtrl);
        } else if (skillsStale && typeof reloadSkillsFn === "function") {
          skillsStale = false;
          reloadSkillsFn();
        }
      } else if (sub === "connectors") {
        if (!booted.connectors) {
          booted.connectors = true;
          bootConnectorsSubTab(sig, abCtrl);
        }
      }
    }

    const view = $("#ms-mgmt-view");
    view?.addEventListener("click", (ev) => {
      const subBtn = ev.target.closest("#ab-sub-tabs [data-ab-sub]");
      if (subBtn) {
        activateSub(subBtn.dataset.abSub);
      }
    }, { signal: sig });

    view?.addEventListener("keydown", (ev) => {
      const tabBtn = ev.target.closest("#ab-sub-tabs [role='tab']");
      if (!tabBtn) return;
      if (ev.key !== "ArrowRight" && ev.key !== "ArrowLeft") return;
      ev.preventDefault();
      const tabs = $$("#ab-sub-tabs [role='tab']");
      const idx = tabs.indexOf(tabBtn);
      if (idx < 0) return;
      const next = tabs[(idx + (ev.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length];
      next?.focus();
      if (next?.dataset?.abSub) activateSub(next.dataset.abSub);
    }, { signal: sig });

    window.addEventListener("maisya:abilities-subtab", (ev) => {
      if (disposed || sig?.aborted || activePage !== "abilities") return;
      if (ev.detail?.sub) activateSub(ev.detail.sub);
    }, { signal: sig });

    activateSub(currentSub);
  }

  /* ───────────── 角色子栏（档案列表 + 角色独立 MEMORY.md + 模型链 + 三层打包分享） ───────────── */
  async function bootProfilesTab(sig, abCtrl = null) {
    const pState = {
      profiles: [],
      skills: [],
      connectors: [],
      models: [],
      modelChain: [],
      modelQuery: "",
      selectedId: pendingProfileTarget || "",
      creating: false,
      advOpen: false,
      advTab: "general",
      abKind: "all",
      abSearch: "",
      rosterQuery: "",
      fishMode: "auto",
      detailSeq: 0,
      fishTouched: false,
      modelTouched: false,
      mdTouched: false,
      scopeTouched: false,
      toolsets: new Set(ALL_TOOLSETS),
      skillsSet: new Set(),
      mcpSet: new Set(),
      apisSet: new Set(),
      connectorsSet: new Set(),
      fishSeed: "",
      notesVersion: null,
      notesProfileId: "",
      notesDirty: false,
      roleMemVersion: null,
      roleMemProfileId: "",
      roleMemDirty: false,
      compProfileId: "",
      compFiles: [],
      activeCompPath: "",
      allowChats: [],
      knownChats: [],
      chatSources: {},
      digestOverview: [],
      allowPickerOpen: false,
      allowQuery: "",
      plannerData: null,
      plannerSummary: null,
      plannerVersion: null,
      plannerDirty: false,
      plannerSeq: 0,
      pkgMode: "export",
      pkgTier: "template",
      pkgTransferToken: "",
      pkgBase64: "",
      pkgShareLink: "",
      pkgReady: false,
    };
    pendingProfileTarget = null;

    function normalizeConnectors(raw) {
      if (Array.isArray(raw)) {
        return raw.map((c) => (typeof c === "string" ? { id: c, name: c, kind: "mcp" } : { kind: c?.kind || "mcp", ...c }));
      }
      if (raw && typeof raw === "object") {
        const out = [];
        (Array.isArray(raw.mcp) ? raw.mcp : []).forEach((c) => {
          const obj = typeof c === "string" ? { id: c, name: c } : (c || {});
          const id = obj.id || obj.name || "";
          if (id) out.push({ ...obj, id, kind: "mcp" });
        });
        (Array.isArray(raw.plugin_apis) ? raw.plugin_apis : []).forEach((c) => {
          const obj = typeof c === "string" ? { id: c, name: c } : (c || {});
          const id = obj.id || obj.name || obj.api || "";
          if (id) out.push({ ...obj, id, kind: "api" });
        });
        return out;
      }
      return [];
    }

    const getCur = () => pState.profiles.find((p) => p.id === pState.selectedId) || pState.profiles[0] || null;
    const isPlannerSelected = () => !pState.creating && pState.selectedId === "__planner__";
    const say = (txt, err = false) => {
      const el = $("#pr-feedback");
      if (!el) return;
      el.textContent = txt || "";
      el.className = `mil-feedback${!txt ? "" : err ? " mil-feedback--err" : " mil-feedback--ok"}`;
    };
    const sayPkg = (txt, err = false) => {
      const el = $("#pkg-feedback");
      if (!el) return;
      el.textContent = txt || "";
      el.className = `mil-feedback${!txt ? "" : err ? " mil-feedback--err" : " mil-feedback--ok"}`;
    };

    function updateMdCounter() {
      const ta = $("#pr-md");
      const badge = $("#pr-md-count");
      if (!ta || !badge) return;
      const val = String(ta.value || "");
      const lines = val ? val.split(/\r?\n/).length : 0;
      badge.textContent = `${lines} / ${MAX_PROFILE_MD_LINES} 行`;
      badge.className = `mil-tag${lines > MAX_PROFILE_MD_LINES ? " mil-tag--bad" : lines >= 130 ? " mil-tag--warn" : ""}`;
    }

    function renderFishBox(profileId, seed) {
      const box = $("#pr-fish-preview");
      const headFish = $("#pr-head-fish");
      const helpBtn = $("#pr-fish-help");
      const pid = profileId || "default";
      const html = roleFishHtml(pid, seed, 52, {});
      if (box) box.innerHTML = html;
      if (headFish) headFish.innerHTML = roleFishHtml(pid, seed, 28, { still: true });
      const parsed = parseFishCustom(seed);
      if (helpBtn) {
        helpBtn.dataset.help = parsed
          ? `当前为锁定外形：${FISH_SPECIES[parsed.species]?.name || parsed.species}（${FISH_COLOR_NAMES[parsed.color] || "自定义配色"}），可随时改回自动或随机。`
          : seed
            ? "当前为随机生成外观，点击「随机」可再换一款，或切回「自动」。"
            : "自动按档案名稳定生成小鱼外观，也可切换随机或锁定自定义款式。";
      }
      const spWrap = $("#pr-fish-species");
      const clWrap = $("#pr-fish-colors");
      if (spWrap) {
        const curSp = parsed?.species || Object.keys(FISH_SPECIES)[0];
        spWrap.innerHTML = Object.entries(FISH_SPECIES).map(([k, spec]) =>
          `<button type="button" class="fish-opt" data-fish-species="${esc(k)}" aria-pressed="${String(curSp === k)}">${fishSvg(customFishSeed({ species: k, color: parsed?.color ?? 0, eyes: parsed?.eyes || "dots" }), { size: 36, still: true })}<span>${esc(spec.name)}</span></button>`
        ).join("");
      }
      if (clWrap) {
        const curCl = parsed?.color ?? 0;
        clWrap.innerHTML = FISH_COLORS.map((c, idx) =>
          `<button type="button" class="fish-swatch" style="--c:${esc(c)}" data-fish-color="${idx}" aria-label="${esc(FISH_COLOR_NAMES[idx] || `色${idx}`)}" aria-pressed="${String(curCl === idx)}"></button>`
        ).join("");
      }
    }

    function renderProfileModelChain() {
      const ic = window.MaisyaIcons;
      const hiddenIn = $("#pr-model");
      const chainEl = $("#pr-model-chain");
      const groupsEl = $("#pr-model-groups");
      const searchIcEl = $("#pr-model-search-ic");
      const catalog = window.MaisyaUI.normalizeModelCatalog(pState.models, pState.modelChain);
      const byName = new Map(catalog.map((m) => [m.name, m]));
      if (hiddenIn) hiddenIn.value = pState.modelChain[0] || "";
      if (searchIcEl && ic?.ctrl) searchIcEl.innerHTML = ic.ctrl("search", 14, 1.9);

      if (chainEl) {
        const upIc = ic?.ctrl ? ic.ctrl("chevron_u", 13, 1.9) : "^";
        const dnIc = ic?.ctrl ? ic.ctrl("chevron_d", 13, 1.9) : "v";
        const delIc = ic?.ctrl ? ic.ctrl("close", 13, 1.9) : "×";
        chainEl.innerHTML = pState.modelChain.length
          ? pState.modelChain.map((mName, idx) => {
              const info = byName.get(mName) || { name: mName, provider: "", visual: false };
              return `<div class="ms-model-row" data-model-item="${esc(mName)}">
                <div class="ms-model-row-l">
                  <span class="ms-model-idx">${idx + 1}</span>
                  <div class="ms-model-meta">
                    <div class="ms-model-name mono">${esc(mName)}</div>
                    <div class="ms-model-sub">
                      ${info.provider ? `<span>${esc(info.provider)}</span>` : `<span>已指定</span>`}
                      ${info.visual ? `<span class="ms-vis-badge">视觉</span>` : ""}
                    </div>
                  </div>
                </div>
                <div class="ms-model-ops">
                  <button type="button" class="ms-model-op" data-pr-model-idx="${idx}" data-pr-model-move="-1" ${idx === 0 ? "disabled" : ""} aria-label="上移模型">${upIc}</button>
                  <button type="button" class="ms-model-op" data-pr-model-idx="${idx}" data-pr-model-move="1" ${idx === pState.modelChain.length - 1 ? "disabled" : ""} aria-label="下移模型">${dnIc}</button>
                  <button type="button" class="ms-model-op ms-model-op--del" data-pr-model-del="${esc(mName)}" aria-label="移除模型 ${esc(mName)}">${delIc}</button>
                </div>
              </div>`;
            }).join("")
          : `<div class="mil-hint">未单独指定模型，默认跟随全局任务模型</div>`;
      }
      if (groupsEl) {
        groupsEl.innerHTML = window.MaisyaUI.renderModelGroupsHtml(catalog, {
          selectedNames: pState.modelChain,
          excludeSelected: true,
          query: pState.modelQuery,
        });
      }
    }

    function renderAbilityCards() {
      const connBtn = $('[data-ab-kind="connectors"]');
      if (connBtn) connBtn.hidden = pState.connectors.length === 0;
      if (pState.abKind === "connectors" && pState.connectors.length === 0) {
        pState.abKind = "all";
        $$("#pr-ab-kind [data-ab-kind]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.abKind === "all")));
      }
      const wrap = $("#pr-ability-cards");
      if (!wrap) return;
      const q = pState.abSearch.trim().toLowerCase();
      const rows = [];
      if (pState.abKind === "all" || pState.abKind === "toolsets") {
        ALL_TOOLSETS.forEach((k) => {
          const m = TOOLSET_META[k] || { title: k, desc: "" };
          rows.push({ kind: "toolsets", id: k, title: m.title, desc: m.desc, tag: "系统工具", checked: pState.toolsets.has(k) });
        });
      }
      if (pState.abKind === "all" || pState.abKind === "skills") {
        pState.skills.forEach((s) => {
          const id = s.id || s.name || s;
          rows.push({ kind: "skills", id, title: s.title || s.name || id, desc: s.description || "可复用技能", tag: "技能", checked: pState.skillsSet.has(id) });
        });
      }
      if ((pState.abKind === "all" || pState.abKind === "connectors") && pState.connectors.length > 0) {
        pState.connectors.forEach((c) => {
          const id = c.id || c.name || c.api || c;
          const connKind = c.kind === "api" ? "api" : "mcp";
          const checked = connKind === "api"
            ? (pState.apisSet.has(id) || pState.connectorsSet.has(id))
            : (pState.mcpSet.has(id) || pState.connectorsSet.has(id));
          rows.push({
            kind: "connectors",
            connKind,
            id,
            title: c.title || c.name || id,
            desc: c.description || c.scope || (connKind === "api" ? "插件接口" : "外部服务"),
            tag: connKind === "api" ? (c.readonly ? "只读接口" : "插件接口") : (c.readonly ? "只读服务" : "外部服务"),
            checked,
          });
        });
      }
      const filtered = q ? rows.filter((r) => `${r.id} ${r.title} ${r.desc}`.toLowerCase().includes(q)) : rows;
      wrap.innerHTML = filtered.length
        ? filtered.map((r) => `<div class="pr-ability-card">
            <div class="pr-ability-meta">
              <strong style="font-size:12.5px">${esc(r.title)}</strong>
              <span class="mil-hint">${esc(r.desc)}</span>
              <span class="mil-tag">${esc(r.tag)}</span>
            </div>
            <label class="mil-switch">
              <input type="checkbox" data-ab-toggle-kind="${esc(r.kind)}" data-ab-toggle-id="${esc(r.id)}" data-ab-conn-kind="${esc(r.connKind || "")}" ${r.checked ? "checked" : ""} />
              <span class="mil-switch-track"></span>
            </label>
          </div>`).join("")
        : `<div class="mil-hint">暂无匹配项</div>`;
    }

    function togglePlannerMode(on) {
      const panel = $("#pr-planner-panel");
      if (panel) panel.hidden = !on;
      const fishBox = $("#pr-fish-box");
      if (fishBox) fishBox.hidden = on;
      const grid = $("#pr-editor .pr-primary-grid");
      if (grid) grid.hidden = on;
      const advWrap = $("#pr-editor .pr-adv-wrap");
      if (advWrap) advWrap.hidden = on;
      if (on && $("#pr-digest-guide")) $("#pr-digest-guide").hidden = true;
      const saveBtn = $("#pr-btn-save");
      if (saveBtn) saveBtn.textContent = on ? "保存调度手册" : "保存档案";
      const delBtn = $("#pr-btn-delete");
      const expBtn = $("#pr-btn-export");
      if (on) {
        if (delBtn) delBtn.disabled = true;
        if (expBtn) expBtn.disabled = true;
        if ($("#pr-head-title")) $("#pr-head-title").textContent = "MaiBot（调度） · 调度手册 PLANNER.md";
        const headFish = $("#pr-head-fish");
        if (headFish) headFish.innerHTML = roleFishHtml("maibot_planner", "", 28, { still: true });
      }
    }

    function updatePlannerLenBadge() {
      const lenEl = $("#pl-len");
      const mdEl = $("#pl-md");
      if (!lenEl || !mdEl) return;
      const chars = String(mdEl.value || "").length;
      lenEl.textContent = `${chars} / 2000 字（上限 6000）`;
      lenEl.className = `mil-tag num${chars > 6000 ? " mil-tag--bad" : chars > 2000 ? " mil-tag--warn" : ""}`;
    }

    function renderPlannerPanel(data, forceMd = false) {
      if (!data) return;
      pState.plannerData = data;
      const manual = data.manual || {};
      pState.plannerVersion = manual.version ?? 0;
      if ($("#pl-ver")) $("#pl-ver").textContent = `v${pState.plannerVersion}`;
      const mdEl = $("#pl-md");
      if (mdEl && (forceMd || !pState.plannerDirty)) {
        mdEl.value = manual.content || "";
        pState.plannerDirty = false;
      }
      updatePlannerLenBadge();

      const chk = data.check || {};
      const warnEl = $("#pl-check-warn");
      if (warnEl) {
        const warns = [];
        if (Array.isArray(chk.unknown_profiles) && chk.unknown_profiles.length) {
          warns.push(`手册中提到的角色不在当前可用名册内：${chk.unknown_profiles.join("、")}`);
        }
        if (chk.over_suggested_length) {
          warns.push(`正文共 ${chk.chars} 字，超过建议长度 ${chk.suggested_chars || 2000} 字，建议精简以节省每轮上下文开销`);
        }
        warnEl.textContent = warns.join("；");
        warnEl.hidden = warns.length === 0;
      }

      const props = Array.isArray(data.pending_proposals) ? data.pending_proposals : [];
      if (pState.plannerSummary) pState.plannerSummary.pending_proposals_count = props.length;
      const pWrap = $("#pl-proposals-wrap");
      const pList = $("#pl-proposals-list");
      const pCnt = $("#pl-prop-count");
      if (pCnt) pCnt.textContent = `${props.length} 条`;
      if (pWrap) pWrap.hidden = props.length === 0;
      if (pList) {
        pList.innerHTML = props.map((pr) => `<div class="ms-entry-row" style="flex-direction:column;align-items:stretch;gap:6px">
          <div class="mil-row" style="justify-content:space-between;align-items:center;gap:6px;flex-wrap:wrap">
            <strong>${esc(pr.title || "调度经验草稿")}</strong>
            <div class="mil-row" style="gap:4px">${(pr.signals || []).map((s) => `<span class="mil-tag">${esc(s)}</span>`).join("")}</div>
          </div>
          ${pr.rationale ? `<div class="mil-hint">${esc(pr.rationale)}</div>` : ""}
          <pre class="mil-pre" style="margin:0;white-space:pre-wrap">${esc(pr.content || "")}</pre>
          <div class="mil-row" style="justify-content:flex-end;gap:6px">
            <button type="button" class="mil-key mil-key--sm" data-pl-prop-dismiss="${esc(pr.proposal_id)}">忽略</button>
            <button type="button" class="mil-key mil-key--sm mil-key--hot" data-pl-prop-confirm="${esc(pr.proposal_id)}">采纳写入手册</button>
          </div>
        </div>`).join("");
      }

      const hist = Array.isArray(manual.history) ? manual.history : [];
      const hWrap = $("#pl-hist-wrap");
      const hList = $("#pl-hist-list");
      if (hWrap && hList) {
        hWrap.hidden = hist.length === 0;
        hList.innerHTML = hist.map((h) => `<button type="button" class="mil-key mil-key--sm" data-pl-rb="${esc(h.version)}">恢复 v${esc(h.version)} · ${fmtTime(h.at || h.updated)}</button>`).join("");
      }

      const rosterEl = $("#pl-roster-preview");
      const roster = Array.isArray(data.roster) ? data.roster : [];
      if (rosterEl) {
        rosterEl.innerHTML = roster.length
          ? roster.map((r) => `<div class="ms-entry-row" style="flex-direction:column;align-items:stretch;gap:3px">
              <div class="mil-row" style="justify-content:space-between;align-items:center;gap:6px">
                <span><strong>${esc(r.title || r.id)}</strong> <span class="mono mil-hint">${esc(r.id)}</span></span>
                <div class="mil-row" style="gap:4px">${(r.capabilities || []).map((c) => `<span class="mil-tag">${esc(c)}</span>`).join("")}</div>
              </div>
              <div class="mil-hint">${esc(r.description || "暂无说明")}</div>
            </div>`).join("")
          : `<div class="mil-hint">当前没有可调度的启用角色</div>`;
      }

      const prev = data.injection_preview || {};
      const tokEl = $("#pl-token-tag");
      const prevEl = $("#pl-inject-preview");
      if (tokEl) tokEl.textContent = `约 ${Number(prev.estimated_tokens || 0)} tokens · ${Number(prev.chars || 0)} 字符`;
      if (prevEl) prevEl.textContent = String(prev.text || "");
    }

    async function loadPlannerDetail(forceMd = false) {
      const seq = ++pState.plannerSeq;
      const res = await hostRpc("read", "planner", {});
      if (disposed || sig?.aborted || pState.selectedId !== "__planner__" || seq !== pState.plannerSeq) return;
      if (!res?.success) { say(res?.error || "调度手册读取失败", true); return; }
      togglePlannerMode(true);
      renderPlannerPanel(res, forceMd);
    }

    function selectRoleById(pid) {
      if (!pid) return;
      if (pid === "__planner__") {
        pState.selectedId = "__planner__";
        pState.creating = false;
        pState.plannerDirty = false;
        say("");
        renderRoster();
        togglePlannerMode(true);
        if (pState.plannerData) renderPlannerPanel(pState.plannerData, true);
        loadPlannerDetail(true);
        return;
      }
      pState.selectedId = pid;
      pState.creating = false;
      renderRoster();
      fillEditorFromProfile(getCur(), false);
      loadProfileDetail(pid);
    }

    function renderMobRoleCarousel() {
      const car = $("#mob-role-carousel");
      const dots = $("#mob-role-dots");
      if (!car) return;
      const curId = isPlannerSelected() ? "__planner__" : (getCur()?.id || "");
      const items = [
        { id: "__planner__", name: "MaiBot（调度）", fish_seed: "", sub: "调度手册", isPlanner: true },
        ...pState.profiles.map((p) => ({
          ...p,
          sub: p.access === "admins" ? "仅管理员" : p.enabled === false ? "停用" : "可用",
        })),
      ];
      car.innerHTML = items.map((p) => {
        const active = p.id === curId;
        const off = !p.isPlanner && p.enabled === false;
        const fish = roleFishHtml(p.isPlanner ? "maibot_planner" : p.id, p.fish_seed || "", active ? 52 : 42, active ? {} : { still: true }, off ? "mil-fish--off" : "");
        return `<button type="button" class="mob-role-item${active ? " is-active" : ""}" role="option" aria-selected="${String(active)}" data-mob-role="${esc(p.id)}">
          <span class="mob-role-avatar">${fish}</span>
          <span class="mob-role-name">${esc(p.name || p.title || p.id)}</span>
          <span class="mob-role-sub">${esc(p.sub)}</span>
        </button>`;
      }).join("");
      if (dots) {
        dots.innerHTML = items.map((p) =>
          `<button type="button" class="mob-role-dot${p.id === curId ? " is-active" : ""}" data-mob-role="${esc(p.id)}" aria-label="${esc(p.name || p.title || p.id)}"></button>`
        ).join("");
      }
      const activeEl = car.querySelector(".mob-role-item.is-active");
      if (activeEl && typeof activeEl.scrollIntoView === "function") {
        try { activeEl.scrollIntoView({ inline: "center", block: "nearest", behavior: calm() ? "auto" : "smooth" }); } catch (_) {}
      }
      if (isPlannerSelected()) {
        $("#ab-mob-role-title").textContent = "MaiBot（调度）";
        $("#ab-mob-role-env").textContent = "常驻主脑";
        $("#mob-val-overview").textContent = "PLANNER.md";
        $("#mob-val-models").textContent = "跟随主脑";
        $("#mob-val-skills").textContent = "查看手册与名册";
        $("#mob-val-fish").textContent = "主脑固定";
      } else {
        const cur = getCur();
        if (cur) {
          $("#ab-mob-role-title").textContent = cur.name || cur.title || cur.id;
          $("#ab-mob-role-env").textContent = cur.access === "admins" ? "仅管理员" : cur.execution_mode === "sandbox" ? "沙箱" : cur.execution_mode === "auto" ? "智能" : "宿主机";
          $("#mob-val-overview").textContent = cur.id;
          $("#mob-val-models").textContent = pState.modelChain[0] || cur.model_name || "跟随默认";
          const connCount = (Array.isArray(cur.mcp) ? cur.mcp.length : (cur.mcp_servers?.length || 0))
            + (Array.isArray(cur.apis) ? cur.apis.length : 0)
            + (Array.isArray(cur.connectors) ? cur.connectors.length : 0);
          const abCount = (cur.toolsets?.length ?? ALL_TOOLSETS.length) + (cur.skills?.length || 0) + connCount;
          $("#mob-val-skills").textContent = `${abCount} 项`;
          $("#mob-val-fish").textContent = parseFishCustom(cur.fish_seed)?.species ? "定制" : "自动";
        }
      }
    }

    function renderRoster() {
      const box = $("#pr-roster");
      if (!box) return;
      const q = pState.rosterQuery.trim().toLowerCase();
      const plannerSel = !pState.creating && pState.selectedId === "__planner__";
      const plannerMatch = !q || "maibot 调度 planner 调度手册 planner.md".includes(q);
      const pendingPlannerCnt = Number(
        pState.plannerData?.pending_proposals?.length ?? pState.plannerSummary?.pending_proposals_count ?? 0
      );
      const plannerCard = plannerMatch
        ? `<button type="button" class="ab-card${plannerSel ? " is-selected" : ""}" role="option" aria-selected="${String(plannerSel)}" data-pick-profile-id="__planner__">
          <div class="now-card-head">
            <div class="now-card-title">${roleFishHtml("maibot_planner", "", 26, { still: !plannerSel })}<span class="now-card-title-txt">MaiBot（调度）</span></div>
            <span class="mil-tag ${pendingPlannerCnt > 0 ? "mil-tag--warn" : "mil-tag--ok"}">${pendingPlannerCnt > 0 ? `待确认 ${pendingPlannerCnt}` : "常驻主脑"}</span>
          </div>
          <div class="now-card-meta"><span class="mono">PLANNER.md</span><span>· 调度与交付手册</span></div>
        </button>`
        : "";
      const filtered = pState.profiles.filter((p) => !q || `${p.id} ${p.name || p.title || ""} ${p.description || ""}`.toLowerCase().includes(q));
      const profileCardsHtml = filtered.map((p) => {
        const sel = !pState.creating && p.id === pState.selectedId;
        const fish = roleFishHtml(p.id, p.fish_seed || "", 26, { still: !sel }, p.enabled === false ? "mil-fish--off" : "");
        return `<button type="button" class="ab-card${sel ? " is-selected" : ""}" role="option" aria-selected="${String(sel)}" data-pick-profile-id="${esc(p.id)}">
          <div class="now-card-head">
            <div class="now-card-title">${fish}<span class="now-card-title-txt">${esc(p.name || p.title || p.id)}</span></div>
            <span class="mil-tag ${p.enabled === false ? "mil-tag--off" : p.access === "admins" ? "mil-tag--warn" : "mil-tag--ok"}">${p.enabled === false ? "停用" : p.access === "admins" ? "仅管理员" : "启用"}</span>
          </div>
          <div class="now-card-meta"><span class="mono">${esc(p.id)}</span>${p.model_name ? `<span>· ${esc(p.model_name)}</span>` : ""}</div>
        </button>`;
      }).join("");
      box.innerHTML = (plannerCard + profileCardsHtml) || `<div class="mil-hint">没有匹配的档案</div>`;
      renderMobRoleCarousel();
    }

    function fillEditorFromProfile(p, isNew = false, opts = {}) {
      togglePlannerMode(false);
      const asyncDetail = Boolean(opts?.fromAsyncDetail);
      if (!asyncDetail) {
        pState.fishTouched = false;
        pState.modelTouched = false;
        pState.mdTouched = false;
        pState.scopeTouched = false;
      }
      pState.creating = isNew;
      const obj = p || { id: "", name: "", description: "", access: "everyone", enabled: true, toolsets: [...ALL_TOOLSETS], skills: [], mcp: [], apis: [], shared_secrets: true, execution_mode: "auto", session_mode: "workspace", fish_seed: "" };
      $("#pr-head-title").textContent = isNew ? "新建能力档案" : `编辑档案 · ${obj.name || obj.title || obj.id}`;
      $("#pr-id").value = obj.id || "";
      $("#pr-id").readOnly = !isNew;
      $("#pr-name").value = obj.name || obj.title || "";
      $("#pr-desc").value = obj.description || "";
      if (!asyncDetail || !pState.scopeTouched) {
        const rawAccess = obj.access || "everyone";
        const normAccess = rawAccess === "all" ? "everyone" : rawAccess === "chats" ? "listed" : rawAccess;
        $("#pr-access").value = normAccess;
        $("#pr-enabled").checked = obj.enabled !== false;
        $("#pr-enabled-txt").textContent = obj.enabled !== false ? "已启用" : "已停用";
        const chatsWrap = $("#pr-chats-wrap");
        if (chatsWrap) chatsWrap.hidden = ($("#pr-access").value !== "listed");
        pState.allowChats = [...new Set((obj.allow_chats || obj.enabled_chats || obj.allowed_chats || []).map((x) => String(x || "").trim()).filter(Boolean))];
        renderProfileAllowChats();
      } else {
        $("#pr-enabled").checked = obj.enabled !== false;
        $("#pr-enabled-txt").textContent = obj.enabled !== false ? "已启用" : "已停用";
      }
      if (!isNew && obj.id) {
        const switchedProfile = obj.id !== pState.notesProfileId;
        if (switchedProfile) {
          pState.notesProfileId = obj.id;
          pState.notesVersion = null;
          pState.notesDirty = false;
          loadRoleNotes(obj.id, true);
        } else if (pState.notesVersion === null && !pState.notesDirty) {
          loadRoleNotes(obj.id, false);
        }
        const switchedRmem = obj.id !== pState.roleMemProfileId;
        if (switchedRmem) {
          pState.roleMemProfileId = obj.id;
          pState.roleMemVersion = null;
          pState.roleMemDirty = false;
          loadRoleMemory(obj.id, true);
        } else if (pState.roleMemVersion === null && !pState.roleMemDirty) {
          loadRoleMemory(obj.id, false);
        }
      } else {
        pState.notesProfileId = "";
        pState.notesVersion = null;
        pState.notesDirty = false;
        pState.roleMemProfileId = "";
        pState.roleMemVersion = null;
        pState.roleMemDirty = false;
        if ($("#pr-notes-md")) $("#pr-notes-md").value = "";
        if ($("#pr-notes-ver")) $("#pr-notes-ver").textContent = "新建后可用";
        if ($("#pr-notes-hist-wrap")) $("#pr-notes-hist-wrap").hidden = true;
        if ($("#pr-role-mem-md")) $("#pr-role-mem-md").value = "";
        if ($("#pr-role-mem-ver")) $("#pr-role-mem-ver").textContent = "新建后可用";
        if ($("#pr-role-mem-hist-wrap")) $("#pr-role-mem-hist-wrap").hidden = true;
      }

      const cloneWrap = $("#pr-clone-wrap");
      const modelWrap = $("#pr-model-wrap");
      if (cloneWrap) cloneWrap.hidden = !isNew;
      if (modelWrap) modelWrap.classList.toggle("pr-span-2", !isNew);
      const cloneSel = $("#pr-clone");
      if (cloneSel) {
        cloneSel.innerHTML = `<option value="">不从其他档案克隆</option>` + pState.profiles.map((x) => `<option value="${esc(x.id)}">${esc(x.name || x.title || x.id)}</option>`).join("");
        cloneSel.value = obj.clone_from || "";
      }

      const mDrop = $("#pr-model-dropdown");
      const dropOpen = Boolean(mDrop && !mDrop.hidden);
      if (!asyncDetail || (!pState.modelTouched && !dropOpen)) {
        const fbList = Array.isArray(obj.fallback_models) ? obj.fallback_models : [];
        pState.modelChain = [...new Set([obj.model_name, ...fbList].map((s) => String(s || "").trim()).filter(Boolean))];
        pState.modelQuery = "";
        const mSearchIn = $("#pr-model-search");
        if (mSearchIn) mSearchIn.value = "";
        if (mDrop) mDrop.hidden = true;
        $("#pr-model-add-btn")?.setAttribute("aria-expanded", "false");
      }
      renderProfileModelChain();

      $("#pr-exec-mode").value = obj.execution_mode || (obj.environment === "sandbox" ? "sandbox" : "auto");
      const rawSess = obj.session_mode || "workspace";
      $("#pr-session-mode").value = rawSess === "thread" ? "persistent" : rawSess === "task" ? "ephemeral" : rawSess;
      $("#pr-shared-secrets").checked = obj.shared_secrets !== false && obj.share_credentials !== false;
      if (!asyncDetail || !pState.mdTouched) {
        $("#pr-md").value = obj.profile_md ?? obj.instructions ?? "";
        updateMdCounter();
      }

      pState.toolsets = new Set(Array.isArray(obj.toolsets) ? obj.toolsets : ALL_TOOLSETS);
      pState.skillsSet = new Set(Array.isArray(obj.skills) ? obj.skills : []);
      const mcpVals = Array.isArray(obj.mcp_servers) ? obj.mcp_servers : Array.isArray(obj.mcp) ? obj.mcp : Array.isArray(obj.connectors) ? obj.connectors : [];
      const apiVals = Array.isArray(obj.apis) ? obj.apis : [];
      pState.mcpSet = new Set(mcpVals);
      pState.apisSet = new Set(apiVals);
      pState.connectorsSet = new Set([...mcpVals, ...apiVals]);
      if (!asyncDetail || !pState.fishTouched) {
        pState.fishSeed = obj.fish_seed || "";
        const parsed = parseFishCustom(pState.fishSeed);
        pState.fishMode = parsed ? "lock" : pState.fishSeed ? "random" : "auto";
        $$("#pr-fish-mode [data-fish-mode]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.fishMode === pState.fishMode)));
        const fd = $("#pr-fish-drawer");
        if (fd) fd.hidden = pState.fishMode !== "lock";
        renderFishBox(obj.id, pState.fishSeed);
      }
      renderAbilityCards();

      const delBtn = $("#pr-btn-delete");
      const expBtn = $("#pr-btn-export");
      if (delBtn) delBtn.disabled = isNew || BUILTIN_PROFILE_IDS.has(obj.id);
      if (expBtn) expBtn.disabled = isNew || !obj.id;
      const showComp = !isNew && Boolean(obj.id);
      const compFiles = showComp ? (Array.isArray(obj.companion_files) ? obj.companion_files : []) : [];
      const activeComp = showComp && obj.id === pState.compProfileId ? pState.activeCompPath : "";
      if (showComp && obj.id !== pState.compProfileId) pState.compProfileId = obj.id;
      else if (!showComp) { pState.compProfileId = ""; pState.activeCompPath = ""; }
      renderProfileCompanions(compFiles, { visible: showComp, activePath: activeComp });
      renderDigestGuide(isNew ? "" : obj.id);
    }

    function renderProfileCompanions(files = [], { visible = true, activePath = "" } = {}) {
      const box = $("#pr-companions-box");
      const cnt = $("#pr-comp-count");
      const listEl = $("#pr-companions-list");
      const pathEl = $("#pr-comp-path");
      const edEl = $("#pr-comp-editor");
      const delBtn = $("#pr-comp-del");
      if (!box) return;
      box.hidden = !visible;
      if (!visible) { box.open = false; return; }
      pState.compFiles = Array.isArray(files) ? [...files] : [];
      if (cnt) cnt.textContent = String(pState.compFiles.length);
      if (listEl) {
        listEl.innerHTML = pState.compFiles.length
          ? pState.compFiles.map((f) => `<button type="button" class="mil-key mil-key--sm mono${f === activePath ? " mil-key--hot" : ""}" data-pr-comp-open="${esc(f)}">${esc(f)}</button>`).join("")
          : `<span class="mil-hint">暂无附属文件；可在下方填入 references/handbook.md 挂入内部资料，或填写 templates/...、scripts/... 路径新建附属文件。</span>`;
      }
      if (!activePath) {
        pState.activeCompPath = "";
        if (pathEl) pathEl.value = "";
        if (edEl) { edEl.value = ""; edEl.textContent = ""; }
        if (delBtn) delBtn.hidden = true;
      }
    }

    function renderDigestGuide(profileId) {
      const box = $("#pr-digest-guide");
      if (!box) return;
      const show = profileId === "digest" && !pState.creating;
      box.hidden = !show;
      if (!show) return;
      const listEl = $("#pr-digest-overview-list");
      const chatSel = $("#pr-digest-chat");
      const cands = [...new Set([
        ...(pState.digestOverview || []).map((d) => d.chat_id),
        ...(pState.knownChats || []),
      ].filter((c) => c && c !== "self"))];
      if (chatSel) {
        const prev = chatSel.value;
        chatSel.innerHTML = cands.length
          ? cands.map((cid) => {
              const m = window.MaisyaUI.resolveChatMeta(pState.chatSources, cid);
              return `<option value="${esc(cid)}">${esc(m.name && m.name !== m.rawId ? `${m.name} (${cid})` : cid)}</option>`;
            }).join("")
          : `<option value="self">自身测试简报 (self)</option>`;
        if (prev && [...chatSel.options].some((o) => o.value === prev)) chatSel.value = prev;
      }
      if (listEl) {
        const items = pState.digestOverview || [];
        listEl.innerHTML = items.length
          ? items.map((d) => {
              const cid = d.chat_id || "self";
              const m = window.MaisyaUI.resolveChatMeta(pState.chatSources, cid);
              const label = cid === "self" ? "自身简报 (self)" : (m.name && m.name !== m.rawId ? `${m.name} (${cid})` : cid);
              const topicsHtml = (d.topics || []).map((t) => `<span class="mil-tag mil-tag--ok">主题：${esc(t)}</span>`).join("");
              const feedsHtml = (d.feeds || []).map((f) => `<div class="mil-row" style="justify-content:space-between;gap:6px;padding:2px 0">
                <span class="mil-hint mono" style="overflow-wrap:anywhere">${esc(f.title || f.url)}</span>
                <button type="button" class="mil-key mil-key--sm mil-key--danger" data-digest-del-chat="${esc(cid)}" data-digest-del-url="${esc(f.url || f.id)}">移除</button>
              </div>`).join("");
              return `<div class="ms-entry-row" style="flex-direction:column;align-items:stretch;gap:4px">
                <div class="mil-row" style="justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px">
                  <strong>${esc(label)}</strong>
                  <div class="mil-row" style="gap:4px;flex-wrap:wrap">${topicsHtml || `<span class="mil-hint">暂未设定主题关键词</span>`}</div>
                </div>
                ${feedsHtml || `<span class="mil-hint">暂未绑定固定订阅源（将按主题自动广搜并试订）</span>`}
              </div>`;
            }).join("")
          : `<div class="mil-hint">各会话暂未配置专属简报源；直接在上方添加或私聊告诉 MaiBot 即可自动创建。</div>`;
      }
    }

    async function loadProfileDetail(pid) {
      if (!pid || pState.creating) return;
      const seq = ++pState.detailSeq;
      const det = await hostRpc("read", "profile_detail", { profile_id: pid });
      if (disposed || sig?.aborted || pState.creating || pid !== pState.selectedId || seq !== pState.detailSeq) return;
      if (det?.success && det.profile) {
        if (det.connectors) pState.connectors = normalizeConnectors(det.connectors);
        if (Array.isArray(det.skills) && det.skills.length) pState.skills = det.skills;
        const merged = {
          ...det.profile,
          companion_files: Array.isArray(det.companion_files) ? det.companion_files : (det.profile.companion_files || []),
          profile_md: det.profile_md ?? det.profile.profile_md ?? det.profile.instructions ?? "",
        };
        const idx = pState.profiles.findIndex((x) => x.id === pid);
        if (idx >= 0) pState.profiles[idx] = { ...pState.profiles[idx], ...merged };
        fillEditorFromProfile(merged, false, { fromAsyncDetail: true });
      }
    }

    function renderProfileAllowChats() {
      const hiddenEl = $("#pr-allowed-chats");
      if (hiddenEl) hiddenEl.value = pState.allowChats.join(", ");
      const listEl = $("#pr-allow-chat-list");
      const pickerEl = $("#pr-allow-picker");
      const candEl = $("#pr-allow-cand-list");
      const openBtn = $("#pr-open-allow-picker");
      const structBox = $("#pr-allow-struct-box");
      if (structBox && !structBox.innerHTML.trim()) {
        structBox.innerHTML = `<div class="mil-label" style="margin-bottom:4px">手动指定会话</div>` + window.MaisyaUI.renderStructStreamBuilder("pr-alw", {
          chatSources: pState.chatSources,
          allowGroup: true,
          allowPrivate: true,
          chatType: "group",
          placeholder: "输入群号或用户 ID，例如 100246809",
          ariaLabel: "允许会话 ID",
          btnLabel: "加入白名单",
          btnId: "pr-allow-struct-add",
        });
      }
      const allowSet = new Set(pState.allowChats);
      const candIds = pState.knownChats.filter((c) => !allowSet.has(c));
      if (openBtn) openBtn.textContent = pState.allowPickerOpen ? "收起候选会话" : `+ 添加会话${candIds.length ? ` (${candIds.length})` : ""}`;
      if (pickerEl) pickerEl.hidden = !pState.allowPickerOpen;
      if (candEl && pState.allowPickerOpen) {
        const q = pState.allowQuery.trim().toLowerCase();
        const filtered = candIds.filter((cid) => {
          if (!q) return true;
          const m = window.MaisyaUI.resolveChatMeta(pState.chatSources, cid);
          return `${m.name} ${m.rawId} ${cid}`.toLowerCase().includes(q);
        });
        candEl.innerHTML = filtered.length
          ? filtered.slice(0, 60).map((cid) => `<div class="ms-stream-row">
              <div class="ms-stream-info">${window.MaisyaUI.renderChatBadgeHtml(pState.chatSources, cid, { size: 20, platSize: 12, showType: true, showRawId: true })}</div>
              <button type="button" class="mil-key mil-key--sm" data-pr-add-allow="${esc(cid)}">添加</button>
            </div>`).join("")
          : `<div class="mil-hint">无匹配候选，可使用下方手动指定</div>`;
      }
      if (listEl) {
        listEl.innerHTML = pState.allowChats.length
          ? pState.allowChats.map((cid) => `<div class="ms-stream-row">
              <div class="ms-stream-info">${window.MaisyaUI.renderChatBadgeHtml(pState.chatSources, cid, { size: 20, platSize: 12, showType: true, showRawId: true })}</div>
              <button type="button" class="mil-key mil-key--sm mil-key--danger" data-pr-del-allow="${esc(cid)}">移除</button>
            </div>`).join("")
          : `<div class="mil-hint">暂未添加白名单会话，请点击右上角「+ 添加会话」选择</div>`;
      }
    }

    async function loadRoleNotes(pid, force = false) {
      if (!pid) return;
      const res = await hostRpc("read", "asset", { kind: "notes", target: pid });
      if (disposed || sig?.aborted || pid !== pState.selectedId) return;
      if (!res?.success) return;
      pState.notesVersion = res.version ?? 0;
      const mdEl = $("#pr-notes-md");
      const verEl = $("#pr-notes-ver");
      const histWrap = $("#pr-notes-hist-wrap");
      const histList = $("#pr-notes-hist-list");
      if (mdEl && (force || !pState.notesDirty)) {
        mdEl.value = res.content || "";
        pState.notesDirty = false;
      }
      if (verEl) verEl.textContent = `v${res.version ?? 0}`;
      const hist = Array.isArray(res.history) ? res.history : [];
      if (histWrap && histList) {
        histWrap.hidden = hist.length === 0;
        histList.innerHTML = hist.map((h) => `<button type="button" class="mil-key mil-key--sm" data-pr-notes-rb="${esc(h.version)}">恢复 v${esc(h.version)} · ${fmtTime(h.at || h.updated)}</button>`).join("");
      }
    }

    async function loadRoleMemory(pid, force = false) {
      if (!pid) return;
      const res = await hostRpc("read", "asset", { kind: "role_memory", target: pid });
      if (disposed || sig?.aborted || pid !== pState.selectedId) return;
      if (!res?.success) return;
      pState.roleMemVersion = res.version ?? 0;
      const mdEl = $("#pr-role-mem-md");
      const verEl = $("#pr-role-mem-ver");
      const histWrap = $("#pr-role-mem-hist-wrap");
      const histList = $("#pr-role-mem-hist-list");
      if (mdEl && (force || !pState.roleMemDirty)) {
        mdEl.value = res.content || "";
        pState.roleMemDirty = false;
      }
      if (verEl) verEl.textContent = `v${res.version ?? 0}`;
      const hist = Array.isArray(res.history) ? res.history : [];
      if (histWrap && histList) {
        histWrap.hidden = hist.length === 0;
        histList.innerHTML = hist.map((h) => `<button type="button" class="mil-key mil-key--sm" data-pr-rmem-rb="${esc(h.version)}">恢复 v${esc(h.version)} · ${fmtTime(h.at || h.updated)}</button>`).join("");
      }
    }

    async function loadProfiles() {
      const res = await hostRpc("read", "profiles", {});
      if (disposed || sig?.aborted) return;
      if (!res?.success) { say(res?.error || "档案加载失败", true); return; }
      pState.profiles = res.profiles || res.abilities || [];
      pState.skills = (Array.isArray(res.skill_items) && res.skill_items.length) ? res.skill_items : (res.skills || []);
      pState.connectors = normalizeConnectors(res.connectors || res.mcp_servers || []);
      pState.models = (Array.isArray(res.model_catalog) && res.model_catalog.length) ? res.model_catalog : (res.available_models || []);
      pState.digestOverview = Array.isArray(res.digest_overview) ? res.digest_overview : [];
      pState.plannerSummary = res.planner_summary || null;
      pState.chatSources = { ...(pState.chatSources || {}), ...(res.chat_sources || {}) };
      const rawKnown = res.known_chat_specs || res.known_chats || [];
      pState.knownChats = [...new Set(rawKnown.map((c) => {
        if (typeof c === "string") return c;
        const sp = c?.stream_spec || c?.chat_id || "";
        if (sp && c && typeof c === "object" && !pState.chatSources[sp]) pState.chatSources[sp] = c;
        return sp;
      }).filter(Boolean))];
      if (!pState.selectedId || (pState.selectedId !== "__planner__" && !pState.profiles.some((p) => p.id === pState.selectedId))) {
        pState.selectedId = pState.profiles[0]?.id || "default";
      }
      renderRoster();
      if (pState.selectedId === "__planner__") {
        togglePlannerMode(true);
        loadPlannerDetail(false);
        return;
      }
      const cur = getCur();
      if (cur && !pState.creating) {
        const keepModelDrop = Boolean($("#pr-model-dropdown") && !$("#pr-model-dropdown").hidden);
        fillEditorFromProfile(cur, false);
        if (keepModelDrop && $("#pr-model-dropdown")) {
          $("#pr-model-dropdown").hidden = false;
          $("#pr-model-add-btn")?.setAttribute("aria-expanded", "true");
        }
        loadProfileDetail(cur.id);
      }
    }

    function openMobSheet(kind) {
      const cur = getCur();
      if (!cur) return;
      const scrim = $("#profiles-mob-scrim");
      const title = $("#profiles-mob-sheet-title");
      const body = $("#profiles-mob-sheet-body");
      if (!scrim || !body) return;
      if (kind === "fish") {
        title.textContent = "快速定制档案小鱼";
        body.innerHTML = `<div class="mil-row" style="justify-content:center">${roleFishHtml(cur.id, pState.fishSeed, 64, {})}</div>
          <div class="mil-row" style="justify-content:center;gap:8px">
            <button type="button" class="mil-key mil-key--sm" data-mob-fish-rand="1">随机换一条鱼</button>
            <button type="button" class="mil-key mil-key--sm mil-key--hot" data-mob-scroll="pr-fish-box">展开完整外形设置</button>
          </div>`;
      } else {
        title.textContent = kind === "abilities" ? "技能与工具概览" : kind === "advanced" ? "常规与模型设定" : "基础档案信息";
        body.innerHTML = `<div class="mil-hint">正在编辑：<strong>${esc(cur.name || cur.id)}</strong>（${esc(pState.modelChain[0] || cur.model_name || "跟随默认")}）</div>
          <button type="button" class="mil-key mil-key--sm mil-key--hot" data-mob-scroll="${kind === "overview" ? "pr-editor" : "pr-adv-toggle"}">定位到详细表单</button>`;
      }
      scrim.hidden = false;
    }

    async function loadExportPreview() {
      const box = $("#pkg-export-preview");
      const cur = getCur();
      if (!box || !cur || !cur.id) return;
      box.innerHTML = `<div class="mil-hint">正在整理身份设定与脱敏清单…</div>`;
      const res = await hostRpc("read", "package_export_preview", { profile_id: cur.id, kind: pState.pkgTier });
      if (disposed || sig?.aborted || $("#pkg-scrim")?.hidden) return;
      if (!res?.success) {
        box.innerHTML = `<div class="mil-hint">${esc(res?.error || "预览加载失败")}</div>`;
        return;
      }
      box.innerHTML = renderPkgPreviewHtml(res);
    }

    function syncPkgScheduleChats(previewRes) {
      const wrap = $("#pkg-sched-chat-wrap");
      const sel = $("#pkg-sched-chat");
      if (!wrap || !sel) return;
      const p = previewRes?.preview || previewRes || {};
      const cnt = Number(p.schedules_count ?? p.schedule_count ?? (Array.isArray(p.schedules) ? p.schedules.length : 0));
      const cands = [...new Set([
        ...(Array.isArray(previewRes?.enabled_chats) ? previewRes.enabled_chats : []),
        ...pState.knownChats,
      ].filter(Boolean))];
      wrap.hidden = cnt <= 0 || cands.length === 0;
      sel.innerHTML = `<option value="">暂不创建定时任务</option>` + cands.map((cid) => {
        const meta = window.MaisyaUI.resolveChatMeta(pState.chatSources, cid);
        return `<option value="${esc(cid)}">${esc(meta.name !== meta.rawId ? `${meta.name} (${cid})` : cid)}</option>`;
      }).join("");
    }

    function openPkgModal(mode = "export") {
      const cur = getCur();
      pState.pkgMode = mode;
      pState.pkgTransferToken = "";
      pState.pkgBase64 = "";
      pState.pkgShareLink = "";
      pState.pkgReady = false;
      sayPkg("");
      if ($("#pkg-import-url")) $("#pkg-import-url").value = "";
      if ($("#pkg-file-label")) $("#pkg-file-label").textContent = "未选择文件";
      if ($("#pkg-import-preview")) {
        $("#pkg-import-preview").hidden = true;
        $("#pkg-import-preview").innerHTML = "";
      }
      if ($("#pkg-sched-chat-wrap")) $("#pkg-sched-chat-wrap").hidden = true;
      $("#pkg-import-confirm").disabled = true;
      const impUpd = $("#pkg-imp-update");
      const impCopy = $("#pkg-imp-copy");
      const copyWrap = $("#pkg-copy-id-wrap");
      const copyIn = $("#pkg-copy-id");
      if (impUpd) impUpd.checked = true;
      if (impCopy) impCopy.checked = false;
      if (copyWrap) copyWrap.hidden = true;
      if (copyIn) copyIn.value = "";
      $("#pkg-modal-title").textContent = mode === "import" ? "导入模板或档案包" : `打包与分享 · ${cur?.name || cur?.id || ""}`;
      $$("#pkg-mode-tabs [data-pkg-mode]").forEach((b) => b.setAttribute("aria-selected", String(b.dataset.pkgMode === mode)));
      $("#pkg-pane-export").hidden = mode !== "export";
      $("#pkg-pane-import").hidden = mode !== "import";
      $("#pkg-scrim").hidden = false;
      if (mode === "export") loadExportPreview();
      $("#pkg-close")?.focus();
    }

    function closePkgModal() {
      const scrim = $("#pkg-scrim");
      if (scrim) scrim.hidden = true;
    }

    const view = $("#ms-mgmt-view");
    view.addEventListener("click", async (ev) => {
      const pick = ev.target.closest("[data-pick-profile-id], [data-mob-role]");
      if (pick) {
        const pid = pick.dataset.pickProfileId || pick.dataset.mobRole;
        selectRoleById(pid);
        return;
      }

      if (ev.target.closest("#pl-reload")) {
        pState.plannerDirty = false;
        await loadPlannerDetail(true);
        say("已重新读取调度手册");
        return;
      }

      const plRb = ev.target.closest("[data-pl-rb]");
      if (plRb) {
        const ver = Number(plRb.dataset.plRb);
        if (pState.plannerVersion === null) {
          const curP = await hostRpc("read", "planner", {});
          if (curP?.success) pState.plannerVersion = curP.manual?.version ?? 0;
        }
        const r = await hostRpc("write", "rollback", {
          kind: "planner",
          version: ver,
          expected_version: pState.plannerVersion ?? 0,
        });
        if (!r?.success) { say(r?.error || "回滚调度手册失败", true); return; }
        pState.plannerDirty = false;
        say(`调度手册已回滚至版本 v${ver}`);
        await loadPlannerDetail(true);
        renderRoster();
        return;
      }

      const plPropConfirm = ev.target.closest("[data-pl-prop-confirm]");
      if (plPropConfirm) {
        const propId = plPropConfirm.dataset.plPropConfirm || "";
        const r = await hostRpc("write", "confirm_skill_proposal", { proposal_id: propId });
        if (!r?.success) { say(r?.error || "采纳调度草稿失败", true); return; }
        pState.plannerDirty = false;
        say("已采纳调度经验并写入 PLANNER.md");
        await loadPlannerDetail(true);
        renderRoster();
        return;
      }

      const plPropDismiss = ev.target.closest("[data-pl-prop-dismiss]");
      if (plPropDismiss) {
        const propId = plPropDismiss.dataset.plPropDismiss || "";
        const r = await hostRpc("write", "dismiss_skill_proposal", { proposal_id: propId });
        if (!r?.success) { say(r?.error || "忽略调度草稿失败", true); return; }
        say("已忽略该调度草稿");
        await loadPlannerDetail(false);
        renderRoster();
        return;
      }

      const stepBtn = ev.target.closest("[data-mob-step]");
      if (stepBtn) {
        const delta = Number(stepBtn.dataset.mobStep || 0);
        const ids = ["__planner__", ...pState.profiles.map((p) => p.id)];
        if (ids.length) {
          const curIdx = Math.max(0, ids.indexOf(pState.selectedId));
          const nextId = ids[(curIdx + delta + ids.length) % ids.length];
          selectRoleById(nextId);
        }
        return;
      }

      const jumpRow = ev.target.closest("[data-mob-role-jump]");
      if (jumpRow) {
        if (isPlannerSelected()) {
          $("#pr-planner-panel")?.scrollIntoView?.({ behavior: "smooth", block: "start" });
          return;
        }
        openMobSheet(jumpRow.dataset.mobRoleJump);
        return;
      }

      if (ev.target.closest("#profiles-mob-sheet-close") || ev.target === $("#profiles-mob-scrim")) {
        $("#profiles-mob-scrim").hidden = true;
        return;
      }

      const mobScroll = ev.target.closest("[data-mob-scroll]");
      if (mobScroll) {
        $("#profiles-mob-scrim").hidden = true;
        if (mobScroll.dataset.mobScroll === "pr-adv-toggle" && !pState.advOpen) {
          pState.advOpen = true;
          $("#pr-adv-toggle").setAttribute("aria-expanded", "true");
          $("#pr-adv-body").hidden = false;
        }
        document.getElementById(mobScroll.dataset.mobScroll)?.scrollIntoView?.({ behavior: "smooth", block: "start" });
        return;
      }

      if (ev.target.closest("[data-mob-fish-rand]")) {
        pState.fishTouched = true;
        pState.fishMode = "random";
        pState.fishSeed = newFishSeed();
        renderFishBox(pState.selectedId, pState.fishSeed);
        openMobSheet("fish");
        return;
      }

      if (ev.target.closest("#pr-btn-new")) {
        pState.detailSeq++;
        say("");
        fillEditorFromProfile(null, true);
        $("#pr-id")?.focus();
        return;
      }

      if (ev.target.closest("#pr-adv-toggle")) {
        pState.advOpen = !pState.advOpen;
        $("#pr-adv-toggle").setAttribute("aria-expanded", String(pState.advOpen));
        $("#pr-adv-body").hidden = !pState.advOpen;
        $("#pr-adv-chevron").textContent = pState.advOpen ? "⌃" : "⌄";
        return;
      }

      const subTab = ev.target.closest("[data-pr-tab]");
      if (subTab) {
        pState.advTab = subTab.dataset.prTab;
        $$("[data-pr-tab]").forEach((b) => b.setAttribute("aria-selected", String(b === subTab)));
        $("#pr-pane-general").hidden = pState.advTab !== "general";
        $("#pr-pane-abilities").hidden = pState.advTab !== "abilities";
        const rmemPane = $("#pr-pane-role-memory");
        if (rmemPane) rmemPane.hidden = pState.advTab !== "role_memory";
        const notesPane = $("#pr-pane-notes");
        if (notesPane) notesPane.hidden = pState.advTab !== "notes";
        if (pState.advTab === "role_memory" && !pState.creating && pState.selectedId && pState.roleMemVersion === null && !pState.roleMemDirty) {
          loadRoleMemory(pState.selectedId, false);
        }
        if (pState.advTab === "notes" && !pState.creating && pState.selectedId && pState.notesVersion === null && !pState.notesDirty) {
          loadRoleNotes(pState.selectedId, false);
        }
        return;
      }

      if (ev.target.closest("#pr-role-mem-reload") && !pState.creating && pState.selectedId) {
        pState.roleMemDirty = false;
        await loadRoleMemory(pState.selectedId, true);
        say("已重新读取角色记忆");
        return;
      }
      if (ev.target.closest("#pr-role-mem-save")) {
        if (pState.creating || !pState.selectedId) { say("请先保存新建角色后再编辑角色记忆", true); return; }
        const content = $("#pr-role-mem-md")?.value || "";
        if (pState.roleMemVersion === null) {
          const curRes = await hostRpc("read", "asset", { kind: "role_memory", target: pState.selectedId });
          if (curRes?.success) pState.roleMemVersion = curRes.version ?? 0;
        }
        const r = await hostRpc("write", "asset", {
          kind: "role_memory",
          target: pState.selectedId,
          content,
          expected_version: pState.roleMemVersion ?? 0,
        });
        if (!r?.success) { say(r?.error || "保存角色记忆失败", true); return; }
        pState.roleMemDirty = false;
        say("角色记忆已保存");
        await loadRoleMemory(pState.selectedId, true);
        return;
      }
      const rmemRb = ev.target.closest("[data-pr-rmem-rb]");
      if (rmemRb && !pState.creating && pState.selectedId) {
        const ver = Number(rmemRb.dataset.prRmemRb);
        if (pState.roleMemVersion === null) {
          const curRes = await hostRpc("read", "asset", { kind: "role_memory", target: pState.selectedId });
          if (curRes?.success) pState.roleMemVersion = curRes.version ?? 0;
        }
        const r = await hostRpc("write", "rollback", {
          kind: "role_memory",
          target: pState.selectedId,
          version: ver,
          expected_version: pState.roleMemVersion ?? 0,
        });
        if (!r?.success) { say(r?.error || "回滚角色记忆失败", true); return; }
        pState.roleMemDirty = false;
        say(`角色记忆已回滚至版本 v${ver}`);
        await loadRoleMemory(pState.selectedId, true);
        return;
      }

      if (ev.target.closest("#pr-notes-reload") && !pState.creating && pState.selectedId) {
        pState.notesDirty = false;
        await loadRoleNotes(pState.selectedId, true);
        say("已重新读取角色经验笔记");
        return;
      }
      if (ev.target.closest("#pr-notes-save")) {
        if (pState.creating || !pState.selectedId) { say("请先保存新建档案后再编辑经验笔记", true); return; }
        const content = $("#pr-notes-md")?.value || "";
        if (pState.notesVersion === null) {
          const curRes = await hostRpc("read", "asset", { kind: "notes", target: pState.selectedId });
          if (curRes?.success) pState.notesVersion = curRes.version ?? 0;
        }
        const r = await hostRpc("write", "asset", {
          kind: "notes",
          target: pState.selectedId,
          content,
          expected_version: pState.notesVersion ?? 0,
        });
        if (!r?.success) { say(r?.error || "保存经验笔记失败", true); return; }
        pState.notesDirty = false;
        say("角色经验笔记已保存");
        await loadRoleNotes(pState.selectedId, true);
        return;
      }
      const notesRb = ev.target.closest("[data-pr-notes-rb]");
      if (notesRb && !pState.creating && pState.selectedId) {
        const ver = Number(notesRb.dataset.prNotesRb);
        if (pState.notesVersion === null) {
          const curRes = await hostRpc("read", "asset", { kind: "notes", target: pState.selectedId });
          if (curRes?.success) pState.notesVersion = curRes.version ?? 0;
        }
        const r = await hostRpc("write", "rollback", {
          kind: "notes",
          target: pState.selectedId,
          version: ver,
          expected_version: pState.notesVersion ?? 0,
        });
        if (!r?.success) { say(r?.error || "回滚经验笔记失败", true); return; }
        pState.notesDirty = false;
        say(`已回滚至版本 v${ver}`);
        await loadRoleNotes(pState.selectedId, true);
        return;
      }

      if (ev.target.closest("#pr-open-allow-picker")) {
        pState.allowPickerOpen = !pState.allowPickerOpen;
        if (pState.allowPickerOpen && pState.knownChats.length) {
          const missing = pState.knownChats.filter((c) => !pState.chatSources[c]).slice(0, 60);
          if (missing.length) {
            const r = await hostRpc("read", "chat_sources", { chat_ids: missing });
            if (r?.success && r.chat_sources) pState.chatSources = { ...pState.chatSources, ...r.chat_sources };
          }
        }
        renderProfileAllowChats();
        if (pState.allowPickerOpen) setTimeout(() => $("#pr-allow-cand-search")?.focus(), 20);
        return;
      }
      const addAllowBtn = ev.target.closest("[data-pr-add-allow]");
      if (addAllowBtn) {
        pState.scopeTouched = true;
        const cid = addAllowBtn.dataset.prAddAllow;
        if (cid && !pState.allowChats.includes(cid)) pState.allowChats.push(cid);
        renderProfileAllowChats();
        return;
      }
      const delAllowBtn = ev.target.closest("[data-pr-del-allow]");
      if (delAllowBtn) {
        pState.scopeTouched = true;
        const cid = delAllowBtn.dataset.prDelAllow;
        pState.allowChats = pState.allowChats.filter((x) => x !== cid);
        renderProfileAllowChats();
        return;
      }
      if (ev.target.closest("#pr-allow-struct-add")) {
        pState.scopeTouched = true;
        const built = window.MaisyaUI.readStructStreamBuilder("pr-alw");
        if (!built?.spec) { say("请填写会话群号或用户 ID", true); return; }
        if (!pState.allowChats.includes(built.spec)) pState.allowChats.push(built.spec);
        if (built.inputEl) built.inputEl.value = "";
        renderProfileAllowChats();
        return;
      }

      if (ev.target.closest("#pr-goto-skills")) {
        abCtrl?.switchSub ? abCtrl.switchSub("skills") : switchWorkspaceTab("skills");
        return;
      }
      if (ev.target.closest("#pr-goto-connectors")) {
        abCtrl?.switchSub ? abCtrl.switchSub("connectors") : switchWorkspaceTab("abilities");
        return;
      }

      if (ev.target.closest("#pr-model-add-btn")) {
        const drop = $("#pr-model-dropdown");
        const trig = $("#pr-model-add-btn");
        if (drop && trig) {
          const open = Boolean(drop.hidden);
          drop.hidden = !open;
          trig.setAttribute("aria-expanded", String(open));
          if (open) $("#pr-model-search")?.focus();
        }
        return;
      }
      const pickModel = ev.target.closest("#pr-model-groups [data-pick-model]");
      if (pickModel) {
        const chosen = pickModel.dataset.pickModel;
        if (chosen && !pState.modelChain.includes(chosen)) {
          pState.modelTouched = true;
          pState.modelChain.push(chosen);
          renderProfileModelChain();
          renderMobRoleCarousel();
        }
        const drop = $("#pr-model-dropdown");
        if (drop) drop.hidden = true;
        $("#pr-model-add-btn")?.setAttribute("aria-expanded", "false");
        return;
      }
      const moveModel = ev.target.closest("[data-pr-model-move]");
      if (moveModel) {
        const idx = Number(moveModel.dataset.prModelIdx);
        const delta = Number(moveModel.dataset.prModelMove);
        const nextIdx = idx + delta;
        if (idx >= 0 && nextIdx >= 0 && nextIdx < pState.modelChain.length) {
          pState.modelTouched = true;
          const tmp = pState.modelChain[idx];
          pState.modelChain[idx] = pState.modelChain[nextIdx];
          pState.modelChain[nextIdx] = tmp;
          renderProfileModelChain();
          renderMobRoleCarousel();
        }
        return;
      }
      const delModel = ev.target.closest("[data-pr-model-del]");
      if (delModel) {
        pState.modelTouched = true;
        const target = delModel.dataset.prModelDel;
        pState.modelChain = pState.modelChain.filter((m) => m !== target);
        renderProfileModelChain();
        renderMobRoleCarousel();
        return;
      }
      if (!$("#pr-model-dropdown")?.hidden && !ev.target.closest("#pr-model-box")) {
        $("#pr-model-dropdown").hidden = true;
        $("#pr-model-add-btn")?.setAttribute("aria-expanded", "false");
      }

      const abKindBtn = ev.target.closest("[data-ab-kind]");
      if (abKindBtn) {
        pState.abKind = abKindBtn.dataset.abKind;
        $$("[data-ab-kind]").forEach((b) => b.setAttribute("aria-pressed", String(b === abKindBtn)));
        renderAbilityCards();
        return;
      }

      const fModeBtn = ev.target.closest("[data-fish-mode]");
      if (fModeBtn) {
        const mode = fModeBtn.dataset.fishMode;
        pState.fishTouched = true;
        pState.fishMode = mode;
        $$("#pr-fish-mode [data-fish-mode]").forEach((b) => b.setAttribute("aria-pressed", String(b === fModeBtn)));
        if (mode === "auto") pState.fishSeed = "";
        else if (mode === "random") pState.fishSeed = newFishSeed();
        else if (!parseFishCustom(pState.fishSeed)) pState.fishSeed = customFishSeed({ species: "pebble", color: 0, eyes: "dots" });
        $("#pr-fish-drawer").hidden = mode !== "lock";
        renderFishBox($("#pr-id")?.value || pState.selectedId, pState.fishSeed);
        return;
      }

      const fSpBtn = ev.target.closest("[data-fish-species]");
      if (fSpBtn) {
        const curP = parseFishCustom(pState.fishSeed) || { species: "pebble", color: 0, eyes: "dots" };
        pState.fishTouched = true;
        pState.fishMode = "lock";
        pState.fishSeed = customFishSeed({ ...curP, species: fSpBtn.dataset.fishSpecies });
        renderFishBox($("#pr-id")?.value || pState.selectedId, pState.fishSeed);
        return;
      }

      const fColBtn = ev.target.closest("[data-fish-color]");
      if (fColBtn) {
        const curP = parseFishCustom(pState.fishSeed) || { species: "pebble", color: 0, eyes: "dots" };
        pState.fishTouched = true;
        pState.fishMode = "lock";
        pState.fishSeed = customFishSeed({ ...curP, color: Number(fColBtn.dataset.fishColor || 0) });
        renderFishBox($("#pr-id")?.value || pState.selectedId, pState.fishSeed);
        return;
      }

      if (ev.target.closest("#pr-digest-copy-tip")) {
        const sample = "帮 qq:group:100246809 打开资讯简报，每天 08:30 推送 AI 工具与独立游戏精选，现在先试跑一期发我私聊看看。";
        try { await navigator.clipboard?.writeText?.(sample); say("已复制对话示例，可直接发给 MaiBot"); } catch (_) { say("可直接对 MaiBot 说：" + sample); }
        return;
      }

      if (ev.target.closest("#pr-digest-add-btn")) {
        const targetChat = ($("#pr-digest-chat")?.value || "").trim() || "self";
        const rawInput = ($("#pr-digest-input")?.value || "").trim();
        if (!rawInput) { say("请输入关注话题或订阅源网址", true); return; }
        const parts = rawInput.split(/[,，\n]+/).map((s) => s.trim()).filter(Boolean);
        const urls = parts.filter((s) => /^https?:/i.test(s));
        const topics = parts.filter((s) => !/^https?:/i.test(s));
        const r = await hostRpc("write", "digest_sources_op", { op: "add", target_chat: targetChat, topics, urls });
        if (!r?.success) { say(r?.error || "添加简报配置失败", true); return; }
        if ($("#pr-digest-input")) $("#pr-digest-input").value = "";
        say("已更新该会话的资讯简报关注配置");
        await loadProfiles();
        return;
      }

      const delFeedBtn = ev.target.closest("[data-digest-del-url]");
      if (delFeedBtn) {
        const targetChat = delFeedBtn.dataset.digestDelChat || "self";
        const url = delFeedBtn.dataset.digestDelUrl || "";
        const r = await hostRpc("write", "digest_sources_op", { op: "remove", target_chat: targetChat, url });
        if (!r?.success) { say(r?.error || "移除订阅源失败", true); return; }
        say("已移除该订阅源");
        await loadProfiles();
        return;
      }

      if (ev.target.closest("#pr-btn-save")) {
        if (!pState.creating && pState.selectedId === "__planner__") {
          const content = $("#pl-md")?.value || "";
          if (content.length > 6000) { say("调度手册正文不能超过 6000 字", true); return; }
          if (pState.plannerVersion === null) {
            const curP = await hostRpc("read", "planner", {});
            if (curP?.success) pState.plannerVersion = curP.manual?.version ?? 0;
          }
          const pr = await hostRpc("write", "asset", {
            kind: "planner",
            content,
            expected_version: pState.plannerVersion ?? 0,
          });
          if (!pr?.success) { say(pr?.error || "调度手册保存失败", true); return; }
          pState.plannerDirty = false;
          say("已保存调度手册");
          await loadPlannerDetail(true);
          renderRoster();
          return;
        }
        const id = ($("#pr-id")?.value || "").trim();
        const name = ($("#pr-name")?.value || "").trim();
        const md = $("#pr-md")?.value || "";
        const mdLines = md ? md.split(/\r?\n/).length : 0;
        if (!id || !name) { say("请填写档案标识与显示名称", true); return; }
        if (mdLines > MAX_PROFILE_MD_LINES) { say(`档案正文超出 ${MAX_PROFILE_MD_LINES} 行上限，请精简后再保存`, true); return; }
        const wasNew = pState.creating;
        const rmemChanged = pState.roleMemDirty;
        const notesChanged = pState.notesDirty;
        const rmemTxt = $("#pr-role-mem-md")?.value || "";
        const notesTxt = $("#pr-notes-md")?.value || "";
        const chats = pState.allowChats.length
          ? [...pState.allowChats]
          : ($("#pr-allowed-chats")?.value || "").split(/[,\s]+/).map((s) => s.trim()).filter(Boolean);
        const primaryModel = pState.modelChain[0] || ($("#pr-model")?.value || "").trim();
        const payload = {
          id,
          profile_id: id,
          name,
          title: name,
          description: ($("#pr-desc")?.value || "").trim(),
          access: $("#pr-access")?.value || "everyone",
          enabled: Boolean($("#pr-enabled")?.checked),
          allow_chats: chats,
          enabled_chats: chats,
          clone_from: $("#pr-clone")?.value || "",
          model_name: primaryModel,
          fallback_models: pState.modelChain.slice(1),
          execution_mode: $("#pr-exec-mode")?.value || "auto",
          session_mode: $("#pr-session-mode")?.value || "workspace",
          shared_secrets: Boolean($("#pr-shared-secrets")?.checked),
          instructions: md,
          profile_md: md,
          fish_seed: pState.fishSeed,
          toolsets: [...pState.toolsets],
          skills: [...pState.skillsSet],
          mcp_servers: [...pState.mcpSet],
          mcp: [...pState.mcpSet],
          apis: [...pState.apisSet],
        };
        const act = wasNew ? "profile_create" : "profile_update";
        say("正在保存…");
        const res = await hostRpc("write", act, payload);
        if (!res?.success) { say(res?.error || "档案保存失败", true); return; }
        if (rmemChanged || (wasNew && rmemTxt.trim())) {
          let rmemVer = pState.roleMemVersion;
          if (rmemVer === null) {
            const curR = await hostRpc("read", "asset", { kind: "role_memory", target: id });
            rmemVer = curR?.success ? (curR.version ?? 0) : 0;
          }
          const rr = await hostRpc("write", "asset", { kind: "role_memory", target: id, content: rmemTxt, expected_version: rmemVer });
          if (rr?.success) pState.roleMemDirty = false;
        }
        if (notesChanged || (wasNew && notesTxt.trim())) {
          let notesVer = pState.notesVersion;
          if (notesVer === null) {
            const curN = await hostRpc("read", "asset", { kind: "notes", target: id });
            notesVer = curN?.success ? (curN.version ?? 0) : 0;
          }
          const nr = await hostRpc("write", "asset", { kind: "notes", target: id, content: notesTxt, expected_version: notesVer });
          if (nr?.success) pState.notesDirty = false;
        }
        pState.creating = false;
        pState.selectedId = id;
        say("档案已保存");
        await loadProfiles();
        return;
      }

      if (ev.target.closest("#pr-btn-delete")) {
        if (isPlannerSelected()) { say("MaiBot（调度）为主脑常驻手册，不可删除", true); return; }
        const cur = getCur();
        if (!cur || BUILTIN_PROFILE_IDS.has(cur.id)) { say("内置角色受保护，不可删除（可停用或克隆修改）", true); return; }
        const targetId = cur.id;
        const targetName = cur.name || cur.title || cur.id;
        const ok = await window.MaisyaUI.confirmDanger({
          tag: "删除角色",
          title: `删除自定义角色「${targetName}」？`,
          body: `将永久删除角色档案 ${targetId} 及其私有配置与历史记录，该操作不可恢复。`,
          confirmText: "确认删除",
        });
        if (!ok || disposed || sig?.aborted) return;
        const res = await hostRpc("write", "profile_delete", { profile_id: targetId, id: targetId });
        if (!res?.success) { say(res?.error || "删除档案失败", true); return; }
        pState.selectedId = "default";
        say(`已删除自定义档案 ${targetId}`);
        abCtrl?.markSkillsStale?.();
        await loadProfiles();
        return;
      }

      const prCompOpenBtn = ev.target.closest("[data-pr-comp-open]");
      if (prCompOpenBtn && pState.selectedId && !pState.creating && !isPlannerSelected()) {
        const rel = prCompOpenBtn.dataset.prCompOpen || "";
        const r = await hostRpc("read", "profile_file", { target: pState.selectedId, path: rel });
        if (!r?.success) { say(r?.error || "读取角色附属文件失败", true); return; }
        const txt = String(r.content || "");
        pState.activeCompPath = rel;
        if ($("#pr-comp-path")) $("#pr-comp-path").value = rel;
        const ed = $("#pr-comp-editor");
        if (ed) { ed.value = txt; ed.textContent = txt; }
        if ($("#pr-comp-del")) $("#pr-comp-del").hidden = false;
        renderProfileCompanions(pState.compFiles, { visible: true, activePath: rel });
        return;
      }

      if (ev.target.closest("#pr-comp-save") && pState.selectedId && !pState.creating && !isPlannerSelected()) {
        const rel = ($("#pr-comp-path")?.value || "").trim();
        const content = $("#pr-comp-editor")?.value || "";
        if (!rel) { say("请填写角色附属文件路径，例如 references/handbook.md", true); return; }
        const r = await hostRpc("write", "save_profile_file", { target: pState.selectedId, path: rel, content });
        if (!r?.success) { say(r?.error || "保存角色附属文件失败", true); return; }
        const nextFiles = Array.isArray(r.companion_files) ? r.companion_files : [...new Set([...pState.compFiles, rel])];
        const cur = getCur();
        if (cur) cur.companion_files = nextFiles;
        pState.activeCompPath = rel;
        renderProfileCompanions(nextFiles, { visible: true, activePath: rel });
        if ($("#pr-comp-del")) $("#pr-comp-del").hidden = false;
        say(`已保存角色附属文件 ${rel}`);
        return;
      }

      if (ev.target.closest("#pr-comp-del") && pState.selectedId && !pState.creating && !isPlannerSelected()) {
        const profileId = pState.selectedId;
        const rel = ($("#pr-comp-path")?.value || pState.activeCompPath || "").trim();
        if (!rel) return;
        const ok = await window.MaisyaUI.confirmDanger({
          tag: "删除文件",
          title: `删除角色附属文件「${rel}」？`,
          body: `将永久删除角色 ${profileId} 下的附属文件「${rel}」。`,
          confirmText: "确认删除",
        });
        if (!ok || disposed || sig?.aborted) return;
        const r = await hostRpc("write", "delete_profile_file", { target: profileId, path: rel });
        if (!r?.success) { say(r?.error || "删除角色附属文件失败", true); return; }
        const nextFiles = Array.isArray(r.companion_files) ? r.companion_files : pState.compFiles.filter((f) => f !== rel);
        const cur = getCur();
        if (cur) cur.companion_files = nextFiles;
        renderProfileCompanions(nextFiles, { visible: true });
        say(`已删除角色附属文件 ${rel}`);
        return;
      }

      if (ev.target.closest("#pr-btn-export")) {
        if (isPlannerSelected()) { say("调度手册为本地主脑配置，暂不单独打包导出", true); return; }
        const cur = getCur();
        if (!cur) return;
        openPkgModal("export");
        return;
      }

      if (ev.target.closest("#pr-btn-import")) {
        openPkgModal("import");
        return;
      }

      if (ev.target.closest("#pr-btn-templates")) {
        const scrim = $("#pr-tpl-scrim");
        const listEl = $("#pr-tpl-list");
        const fbEl = $("#pr-tpl-fb");
        if (scrim) scrim.hidden = false;
        if (fbEl) { fbEl.textContent = ""; fbEl.className = "mil-feedback"; }
        if (listEl) listEl.innerHTML = `<div class="mil-hint">正在读取场景模板…</div>`;
        const res = await hostRpc("read", "templates", {});
        if (disposed || sig?.aborted) return;
        if (!res?.success) {
          if (fbEl) { fbEl.textContent = res?.error || "模板读取失败"; fbEl.className = "mil-feedback mil-feedback--err"; }
          if (listEl) listEl.innerHTML = "";
          return;
        }
        const modeMap = { workspace: "共享工作区", persistent: "常驻房间", ephemeral: "单次任务" };
        const items = Array.isArray(res.templates) ? res.templates : [];
        if (listEl) {
          listEl.innerHTML = items.map((t) => {
            const mTxt = modeMap[t.session_mode] || t.session_mode || "共享工作区";
            const btnTxt = t.installed ? "已存在 · 启用并同步" : "+ 一键套用";
            return `<div class="ms-entry-row" style="align-items:flex-start;gap:10px">
              <div class="ms-entry-meta" style="min-width:0;flex:1 1 auto">
                <div class="mil-row" style="gap:6px;align-items:center;flex-wrap:wrap">
                  <strong class="ms-entry-title">${esc(t.name)}</strong>
                  <span class="mil-tag">${esc(mTxt)}</span>
                  ${t.installed ? `<span class="mil-tag mil-tag--ok">已安装</span>` : ""}
                </div>
                <span class="ms-entry-code" style="white-space:normal">${esc(t.tagline)}</span>
                <span class="mil-hint" style="white-space:normal">试试这样说：${esc(t.try_prompt || "")}</span>
              </div>
              <button type="button" class="mil-key mil-key--sm mil-key--hot" style="flex-shrink:0" data-tpl-apply="${esc(t.id)}" data-tpl-name="${esc(t.name)}">${esc(btnTxt)}</button>
            </div>`;
          }).join("") || `<div class="mil-hint">暂无可用场景模板。</div>`;
        }
        return;
      }

      if (ev.target.closest("#pr-tpl-close") || ev.target === $("#pr-tpl-scrim")) {
        const scrim = $("#pr-tpl-scrim");
        if (scrim) scrim.hidden = true;
        return;
      }

      const tplApplyBtn = ev.target.closest("[data-tpl-apply]");
      if (tplApplyBtn) {
        const tid = tplApplyBtn.dataset.tplApply || "";
        const tname = tplApplyBtn.dataset.tplName || tid;
        const fbEl = $("#pr-tpl-fb");
        tplApplyBtn.disabled = true;
        const res = await hostRpc("write", "template_apply", { template_id: tid });
        tplApplyBtn.disabled = false;
        if (disposed || sig?.aborted) return;
        if (!res?.success) {
          if (fbEl) { fbEl.textContent = res?.error || "套用模板失败"; fbEl.className = "mil-feedback mil-feedback--err"; }
          return;
        }
        const scrim = $("#pr-tpl-scrim");
        if (scrim) scrim.hidden = true;
        pState.creating = false;
        pState.selectedId = res.profile_id || pState.selectedId;
        await loadProfiles();
        say(`已套用「${tname}」（${res.profile_id}）${res.try_prompt ? ` · 试着在群里说：${res.try_prompt}` : ""}`);
        return;
      }

      if (ev.target.closest("#pkg-close") || ev.target === $("#pkg-scrim")) {
        closePkgModal();
        return;
      }

      const pkgModeBtn = ev.target.closest("#pkg-mode-tabs [data-pkg-mode]");
      if (pkgModeBtn) {
        const mode = pkgModeBtn.dataset.pkgMode;
        pState.pkgMode = mode;
        $$("#pkg-mode-tabs [data-pkg-mode]").forEach((b) => b.setAttribute("aria-selected", String(b === pkgModeBtn)));
        $("#pkg-pane-export").hidden = mode !== "export";
        $("#pkg-pane-import").hidden = mode !== "import";
        sayPkg("");
        if (mode === "export") loadExportPreview();
        return;
      }

      const pkgTierBtn = ev.target.closest("#pkg-tier-grid [data-pkg-tier]");
      if (pkgTierBtn) {
        pState.pkgTier = pkgTierBtn.dataset.pkgTier;
        $$("#pkg-tier-grid [data-pkg-tier]").forEach((b) => b.setAttribute("aria-pressed", String(b === pkgTierBtn)));
        loadExportPreview();
        return;
      }

      if (ev.target.closest("#pkg-export-download")) {
        const cur = getCur();
        if (!cur) return;
        let res = await hostRpc("write", "package_export", { profile_id: cur.id, kind: pState.pkgTier });
        if (!res?.base64) {
          const fallbackRes = await hostRpc("write", "profile_export_zip", { profile_id: cur.id });
          if (fallbackRes?.success && fallbackRes.base64) res = fallbackRes;
        }
        if (!res?.success || !res.base64) { sayPkg(res?.error || "打包导出失败", true); return; }
        const fname = res.filename || `${cur.id}.maisya.zip`;
        triggerZipDownload(res.base64, fname);
        closePkgModal();
        say(`已导出档案包 ${fname}`);
        return;
      }

      if (ev.target.closest("#pkg-pick-file")) {
        $("#pr-import-file")?.click();
        return;
      }

      if (ev.target.closest("#pkg-preview-url")) {
        const url = ($("#pkg-import-url")?.value || "").trim();
        if (!url) { sayPkg("请先粘贴公开压缩包直链", true); return; }
        const res = await hostRpc("write", "package_preview", { remote_url: url });
        if (!res?.success) { sayPkg(res?.error || "链接拉取或解析失败", true); return; }
        pState.pkgShareLink = url;
        pState.pkgTransferToken = "";
        pState.pkgBase64 = "";
        pState.pkgReady = true;
        $("#pkg-import-preview").innerHTML = renderPkgPreviewHtml(res);
        $("#pkg-import-preview").hidden = false;
        syncPkgScheduleChats(res);
        $("#pkg-import-confirm").disabled = false;
        sayPkg("已解析压缩包，请核对后导入");
        return;
      }

      if (ev.target.closest("#pkg-import-confirm")) {
        if (!pState.pkgReady && !pState.pkgBase64 && !pState.pkgShareLink && !pState.pkgTransferToken) return;
        const impMode = document.querySelector('input[name="pkg_import_mode"]:checked')?.value || "update";
        const copyId = ($("#pkg-copy-id")?.value || "").trim();
        if (impMode === "copy" && !copyId) { sayPkg("请填写另存为新角色的标识", true); return; }
        const schedChat = ($("#pkg-sched-chat")?.value || "").trim();
        const payload = {
          overwrite: impMode !== "copy",
          ...(impMode === "copy" && copyId ? { profile_id: copyId } : {}),
          ...(pState.pkgTransferToken ? { transfer_token: pState.pkgTransferToken } : {}),
          ...(pState.pkgBase64 && !pState.pkgTransferToken ? { base64: pState.pkgBase64 } : {}),
          ...(pState.pkgShareLink ? { remote_url: pState.pkgShareLink } : {}),
          ...(schedChat ? { schedule_target_chat: schedChat } : {}),
        };
        let res = await hostRpc("write", "package_import", payload);
        if (!res?.success && !res?.profile && pState.pkgBase64) {
          const fb = await hostRpc("write", "profile_import_zip", {
            base64: pState.pkgBase64,
            overwrite: impMode !== "copy",
            ...(impMode === "copy" && copyId ? { profile_id: copyId } : {}),
          });
          if (fb?.success) res = fb;
        }
        if (!res?.success) { sayPkg(res?.error || "导入失败", true); return; }
        if (res.profile?.id || res.profile_id) pState.selectedId = res.profile?.id || res.profile_id;
        closePkgModal();
        say("已导入档案包");
        abCtrl?.markSkillsStale?.();
        await loadProfiles();
        return;
      }
    }, { signal: sig });

    view.addEventListener("change", async (ev) => {
      if (ev.target.name === "pkg_import_mode") {
        const copyWrap = $("#pkg-copy-id-wrap");
        if (copyWrap) copyWrap.hidden = ev.target.value !== "copy";
        if (ev.target.value === "copy") $("#pkg-copy-id")?.focus();
      } else if (ev.target.id === "pr-access") {
        pState.scopeTouched = true;
        $("#pr-chats-wrap").hidden = ev.target.value !== "listed";
      } else if (ev.target.id === "pr-enabled") {
        $("#pr-enabled-txt").textContent = ev.target.checked ? "已启用" : "已停用";
      } else if (ev.target.dataset.abToggleId) {
        const kind = ev.target.dataset.abToggleKind;
        const id = ev.target.dataset.abToggleId;
        const checked = ev.target.checked;
        if (kind === "toolsets") {
          if (checked) pState.toolsets.add(id); else pState.toolsets.delete(id);
        } else if (kind === "skills") {
          if (checked) pState.skillsSet.add(id); else pState.skillsSet.delete(id);
        } else {
          if (checked) pState.connectorsSet.add(id); else pState.connectorsSet.delete(id);
          const connRef = ev.target.dataset.abConnKind === "api" ? pState.apisSet : pState.mcpSet;
          if (checked) connRef.add(id); else connRef.delete(id);
        }
      } else if (ev.target.id === "pr-import-file") {
        const file = ev.target.files?.[0];
        ev.target.value = "";
        if (!file) return;
        const labelEl = $("#pkg-file-label");
        if (labelEl) labelEl.textContent = file.name;
        try {
          const staged = await stageAndPreviewZipFile(file);
          if (staged.previewRes?.success) {
            pState.pkgTransferToken = staged.transferToken;
            pState.pkgBase64 = staged.base64;
            pState.pkgShareLink = "";
            pState.pkgReady = true;
            if (!$("#pkg-scrim")?.hidden) {
              $("#pkg-import-preview").innerHTML = renderPkgPreviewHtml(staged.previewRes);
              $("#pkg-import-preview").hidden = false;
              syncPkgScheduleChats(staged.previewRes);
              $("#pkg-import-confirm").disabled = false;
              sayPkg(`已解析 ${file.name}`);
            }
          } else if (staged.base64) {
            const legacy = await hostRpc("write", "profile_import_zip", { base64: staged.base64, filename: file.name });
            if (!legacy?.success) { sayPkg(staged.previewRes?.error || legacy?.error || "导入失败", true); return; }
            if (legacy.profile?.id || legacy.profile_id) pState.selectedId = legacy.profile?.id || legacy.profile_id;
            closePkgModal();
            say(`已导入档案包 ${file.name}`);
            await loadProfiles();
          }
        } catch (err) {
          sayPkg(String(err?.message || err || "文件读取失败"), true);
        }
      }
    }, { signal: sig });

    view.addEventListener("input", (ev) => {
      if (ev.target.id === "pr-search") { pState.rosterQuery = ev.target.value || ""; renderRoster(); }
      else if (ev.target.id === "pr-ab-search") { pState.abSearch = ev.target.value || ""; renderAbilityCards(); }
      else if (ev.target.id === "pr-md") { pState.mdTouched = true; updateMdCounter(); }
      else if (ev.target.id === "pl-md") { pState.plannerDirty = true; updatePlannerLenBadge(); }
      else if (ev.target.id === "pr-notes-md") { pState.notesDirty = true; }
      else if (ev.target.id === "pr-role-mem-md") { pState.roleMemDirty = true; }
      else if (ev.target.id === "pr-allow-cand-search") { pState.allowQuery = ev.target.value || ""; renderProfileAllowChats(); }
      else if (ev.target.id === "pr-model-search") {
        pState.modelQuery = ev.target.value || "";
        const catalog = window.MaisyaUI.normalizeModelCatalog(pState.models, pState.modelChain);
        const groupsEl = $("#pr-model-groups");
        if (groupsEl) {
          groupsEl.innerHTML = window.MaisyaUI.renderModelGroupsHtml(catalog, {
            selectedNames: pState.modelChain,
            excludeSelected: true,
            query: pState.modelQuery,
          });
        }
      }
    }, { signal: sig });

    document.addEventListener("keydown", (ev) => {
      if (ev.key !== "Escape" || activePage !== "abilities" || abCtrl?.getSub?.() !== "profiles") return;
      if (window.MaisyaUI?.isConfirmOpen?.() || ev.target?.closest?.("#ms-confirm-dialog")) return;
      if (!$("#pr-tpl-scrim")?.hidden) { $("#pr-tpl-scrim").hidden = true; $("#pr-btn-templates")?.focus(); return; }
      if (!$("#pkg-scrim")?.hidden) { closePkgModal(); return; }
      const drop = $("#pr-model-dropdown");
      if (drop && !drop.hidden) {
        drop.hidden = true;
        $("#pr-model-add-btn")?.setAttribute("aria-expanded", "false");
        $("#pr-model-add-btn")?.focus();
      }
    }, { signal: sig });

    window.addEventListener("maisya:themechange", () => {
      if (disposed || sig?.aborted || activePage !== "abilities") return;
      renderRoster();
      renderFishBox($("#pr-id")?.value || pState.selectedId, pState.fishSeed);
      renderProfileModelChain();
    }, { signal: sig });

    abCtrl?.registerReloadProfiles?.(loadProfiles);

    let mobScrollTimer = 0;
    const mobCar = $("#mob-role-carousel");
    mobCar?.addEventListener("scroll", () => {
      if (mobScrollTimer) clearTimeout(mobScrollTimer);
      mobScrollTimer = setTimeout(() => {
        if (disposed || sig?.aborted) return;
        const rect = mobCar.getBoundingClientRect();
        const midX = rect.left + rect.width / 2;
        let bestId = "";
        let bestDist = Infinity;
        mobCar.querySelectorAll(".mob-role-item[data-mob-role]").forEach((el) => {
          const r = el.getBoundingClientRect();
          const dist = Math.abs(r.left + r.width / 2 - midX);
          if (dist < bestDist) { bestDist = dist; bestId = el.dataset.mobRole || ""; }
        });
        if (bestId && bestId !== pState.selectedId) {
          selectRoleById(bestId);
        }
      }, 140);
    }, { passive: true, signal: sig });

    loadProfiles();
  }

  /* ───────────── 技能子栏（自动复盘新草稿预览确认 + 近期活动提炼 + 技能工作区） ───────────── */
  async function bootSkillsTab(sig, abCtrl = null) {
    const skState = {
      skills: [],
      systemTools: [],
      externalServices: [],
      proposals: [],
      candidates: [],
      profileCards: [],
      chatSources: {},
      cat: "all",
      query: "",
      editing: null, // { kind: "skill"|"toolset", id, isNew, isPreset, version, proposalId }
      compFiles: [],
      activeCompPath: "",
      pkgTransferToken: "",
      pkgBase64: "",
      pkgShareLink: "",
      pkgReady: false,
    };

    function renderSkillCompanions(files = [], { visible = true, activePath = "" } = {}) {
      const box = $("#sk-companions-box");
      const cnt = $("#sk-comp-count");
      const listEl = $("#sk-companions-list");
      const pathEl = $("#sk-comp-path");
      const edEl = $("#sk-comp-editor");
      const delBtn = $("#sk-comp-del");
      if (!box) return;
      box.hidden = !visible;
      if (!visible) {
        box.open = false;
        return;
      }
      skState.compFiles = Array.isArray(files) ? [...files] : [];
      if (cnt) cnt.textContent = String(skState.compFiles.length);
      if (listEl) {
        listEl.innerHTML = skState.compFiles.length
          ? skState.compFiles.map((f) => `<button type="button" class="mil-key mil-key--sm mono${f === activePath ? " mil-key--hot" : ""}" data-sk-comp-open="${esc(f)}">${esc(f)}</button>`).join("")
          : `<span class="mil-hint">暂无附属文件；可在下方填入 references/guide.md 等路径新建参考规范。</span>`;
      }
      if (!activePath) {
        skState.activeCompPath = "";
        if (pathEl) pathEl.value = "";
        if (edEl) { edEl.value = ""; edEl.textContent = ""; }
        if (delBtn) delBtn.hidden = true;
      }
    }

    const saySk = (txt, err = false) => {
      const el = $("#sk-feedback");
      if (el) { el.textContent = txt || ""; el.className = `mil-feedback${!txt ? "" : err ? " mil-feedback--err" : " mil-feedback--ok"}`; }
    };
    const sayDrawer = (txt, err = false) => {
      const el = $("#sk-drawer-fb");
      if (el) { el.textContent = txt || ""; el.className = `mil-feedback${!txt ? "" : err ? " mil-feedback--err" : " mil-feedback--ok"}`; }
    };
    const saySkPkg = (txt, err = false) => {
      const el = $("#sk-pkg-fb");
      if (el) { el.textContent = txt || ""; el.className = `mil-feedback${!txt ? "" : err ? " mil-feedback--err" : " mil-feedback--ok"}`; }
    };

    function extractSkillMeta(rawMd, fallback = {}) {
      const text = String(rawMd || "");
      let title = String(fallback.title || "");
      let desc = String(fallback.description || "");
      const fm = text.match(/^---\r?\n([\s\S]*?)\r?\n---/);
      if (fm) {
        fm[1].split(/\r?\n/).forEach((line) => {
          const kv = line.match(/^\s*(title|name|description)\s*:\s*(.+)$/);
          if (!kv) return;
          let v = kv[2].trim();
          if ((v.startsWith('"') && v.endsWith('"')) || (v.startsWith("'") && v.endsWith("'"))) {
            try { v = v.startsWith('"') ? JSON.parse(v) : v.slice(1, -1); } catch (_) { v = v.slice(1, -1); }
          }
          if ((kv[1] === "title" || kv[1] === "name") && !title) title = v;
          if (kv[1] === "description" && !desc) desc = v;
        });
      }
      return { title, desc };
    }

    function syncSkillFrontmatter(rawMd, title, desc) {
      const md = String(rawMd || "");
      const cleanTitle = String(title || "").trim();
      const cleanDesc = String(desc || "").trim();
      const fm = md.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
      if (fm) {
        const kept = fm[1].split(/\r?\n/).filter((line) => !/^\s*(?:title|description)\s*:/.test(line));
        const head = [
          ...(cleanTitle ? [`title: ${JSON.stringify(cleanTitle)}`] : []),
          ...(cleanDesc ? [`description: ${JSON.stringify(cleanDesc)}`] : []),
          ...kept,
        ].join("\n");
        return `---\n${head}\n---\n${fm[2]}`;
      }
      if (!cleanTitle && !cleanDesc) return md;
      const head = [
        ...(cleanTitle ? [`title: ${JSON.stringify(cleanTitle)}`] : []),
        ...(cleanDesc ? [`description: ${JSON.stringify(cleanDesc)}`] : []),
      ].join("\n");
      return `---\n${head}\n---\n${md}`;
    }

    function renderPendingProposals() {
      const sec = $("#sk-proposals-sec");
      const listEl = $("#sk-proposals-list");
      const cntEl = $("#sk-proposals-count");
      const badgeEl = $("#ab-tab-prop-badge");
      const props = skState.proposals || [];
      if (badgeEl) {
        badgeEl.hidden = props.length === 0;
        badgeEl.textContent = `待确认 ${props.length}`;
      }
      const navBadge = $("#nav-ab-prop-badge");
      if (navBadge) {
        navBadge.hidden = props.length === 0;
      }
      if (!sec || !listEl) return;
      sec.hidden = props.length === 0;
      if (cntEl) cntEl.textContent = `${props.length} 项`;
      if (!props.length) { listEl.innerHTML = ""; return; }
      const ic = window.MaisyaIcons;
      listEl.innerHTML = props.map((p) => {
        const iconHtml = ic?.mod ? ic.mod("skills", 20) : "";
        const sigBadges = (Array.isArray(p.signals) ? p.signals : []).map((s) => `<span class="mil-tag">${esc(s)}</span>`).join("");
        return `<div class="sk-distill-card" data-proposal-card="${esc(p.proposal_id)}">
          <div class="sk-distill-meta">
            ${iconHtml ? `<span class="onb-item-ic">${iconHtml}</span>` : ""}
            <div class="onb-item-text">
              <div class="mil-row" style="gap:6px;flex-wrap:wrap;align-items:center">
                <strong style="font-size:13px">${esc(p.title || p.skill_id)}</strong>
                <span class="mil-tag mono">${esc(p.skill_id)}</span>
                ${sigBadges}
              </div>
              <div class="mil-hint">${esc(p.description || p.rationale || "自动复盘总结出的新技能草稿，预览确认后保存")}</div>
            </div>
          </div>
          <div class="mil-row" style="gap:6px;flex-shrink:0">
            <button type="button" class="mil-key mil-key--sm mil-key--hot" data-preview-proposal="${esc(p.proposal_id)}">预览并保存</button>
            <button type="button" class="mil-key mil-key--sm" data-dismiss-proposal="${esc(p.proposal_id)}">忽略</button>
          </div>
        </div>`;
      }).join("");
    }

    function renderDistillCandidates() {
      const fold = $("#sk-distill-sec");
      const listEl = $("#sk-distill-list");
      const cntEl = $("#sk-distill-count");
      if (!fold || !listEl) return;
      const cands = skState.candidates || [];
      fold.hidden = cands.length === 0;
      if (cntEl) cntEl.textContent = `${cands.length} 条`;
      if (!cands.length) { listEl.innerHTML = ""; return; }
      const ic = window.MaisyaIcons;
      listEl.innerHTML = cands.map((c) => {
        const iconHtml = ic?.mod ? ic.mod("skills", 20) : "";
        const badgeHtml = c.chat_id ? window.MaisyaUI.renderChatBadgeHtml(skState.chatSources, c.chat_id, { size: 18, platSize: 12 }) : "";
        const sigBadges = (Array.isArray(c.signals) ? c.signals : []).map((s) => `<span class="mil-tag">${esc(s)}</span>`).join("");
        const recBadge = c.recommended_op === "patch" && c.matched_skill
          ? `<span class="mil-tag mil-tag--ok">建议并入：${esc(c.matched_skill_title || c.matched_skill)}</span>`
          : `<span class="mil-tag mil-tag--warn">提炼新类技能</span>`;
        return `<div class="sk-distill-card" data-distill-card="${esc(c.thread_id)}">
          <div class="sk-distill-meta">
            ${iconHtml ? `<span class="onb-item-ic">${iconHtml}</span>` : ""}
            <div class="onb-item-text">
              <div class="mil-row" style="gap:6px;flex-wrap:wrap;align-items:center">
                <strong style="font-size:13px">${esc(c.title || c.thread_id)}</strong>
                ${recBadge}
                ${sigBadges}
              </div>
              <div class="mil-hint">${esc(c.summary || "已完成活动，可复盘提炼为可复用规范")}</div>
              <div class="now-card-meta">${badgeHtml}${c.profile_id ? `<span class="mono">· ${esc(c.profile_id)}</span>` : ""}</div>
            </div>
          </div>
          <div class="mil-row" style="gap:6px;flex-shrink:0">
            <button type="button" class="mil-key mil-key--sm mil-key--hot" data-distill-thread="${esc(c.thread_id)}">复盘提炼</button>
            <button type="button" class="mil-key mil-key--sm" data-dismiss-distill="${esc(c.thread_id)}">忽略</button>
          </div>
        </div>`;
      }).join("");
    }

    function renderSkillGrid() {
      const grid = $("#sk-grid");
      const cnt = $("#sk-count-tag");
      if (!grid) return;
      const ic = window.MaisyaIcons;
      const q = skState.query.trim().toLowerCase();
      const rows = [];
      if (skState.cat === "all" || skState.cat === "personal" || skState.cat === "system") {
        skState.skills.forEach((s) => {
          const cat = s.category || (s.is_preset ? "system" : "personal");
          if (skState.cat !== "all" && skState.cat !== cat) return;
          rows.push({
            kind: "skill",
            cat,
            id: s.id,
            title: s.title || s.name || s.id,
            desc: s.description || "可复用技能文档",
            tag: cat === "system" ? "系统" : "个人",
            boundCount: Array.isArray(s.bound_profiles) ? s.bound_profiles.length : 0,
            iconKey: "skills",
          });
        });
      }
      if (skState.cat === "all" || skState.cat === "toolsets") {
        skState.systemTools.forEach((t) => {
          rows.push({
            kind: "toolset",
            cat: "toolsets",
            id: t.id,
            title: t.title || t.id,
            desc: t.description || "内置系统工具能力",
            tag: "系统工具",
            boundCount: Array.isArray(t.bound_profiles) ? t.bound_profiles.length : 0,
            iconKey: "sliders",
          });
        });
      }
      const filtered = q ? rows.filter((r) => `${r.id} ${r.title} ${r.desc}`.toLowerCase().includes(q)) : rows;
      if (cnt) cnt.textContent = `${filtered.length} 项`;
      const arrowSvg = ic?.ctrl ? ic.ctrl("chevron_r", 14, 1.9) : "&gt;";
      grid.innerHTML = filtered.length
        ? filtered.map((r) => `<button type="button" class="sk-card" data-open-sk-kind="${esc(r.kind)}" data-open-sk-id="${esc(r.id)}">
            <div class="sk-card-l">
              ${ic?.mod ? `<span class="onb-item-ic">${ic.mod(r.iconKey, 20)}</span>` : ""}
              <div class="onb-item-text">
                <div class="sk-card-title">${esc(r.title)}</div>
                <div class="sk-card-desc">${esc(r.desc)}</div>
              </div>
            </div>
            <div class="sk-card-r">
              <span class="mil-tag">${esc(r.tag)}</span>
              ${r.boundCount ? `<span class="mil-tag mil-tag--ok">${r.boundCount} 角色</span>` : ""}
              <span class="mil-inline-ic">${arrowSvg}</span>
            </div>
          </button>`).join("")
        : `<div class="mil-hint">暂无匹配的技能或系统工具</div>`;
    }

    function renderBindCheckboxes(boundSet) {
      const box = $("#sk-bind-profiles");
      if (!box) return;
      box.innerHTML = skState.profileCards.map((p) => `<label class="mil-chk">
        <input type="checkbox" data-sk-bind-profile="${esc(p.id)}" ${boundSet.has(p.id) ? "checked" : ""} />
        <span>${esc(p.name || p.id)}</span>
      </label>`).join("") || `<span class="mil-hint">暂无可选档案</span>`;
    }

    function closeSkillDrawer() {
      const scrim = $("#sk-drawer-scrim");
      if (scrim) scrim.hidden = true;
      skState.editing = null;
    }

    function openAutoProposalDrawer(prop) {
      sayDrawer("");
      const scrim = $("#sk-drawer-scrim");
      if (!scrim || !prop) return;
      skState.editing = {
        kind: "skill",
        id: prop.skill_id || "",
        isNew: true,
        isPreset: false,
        version: null,
        proposalId: prop.proposal_id,
      };
      $("#sk-drawer-title").textContent = `预览并保存新技能 · ${prop.title || prop.skill_id}`;
      const idEl = $("#sk-edit-id");
      const titleEl = $("#sk-edit-title");
      const descEl = $("#sk-edit-desc");
      const mdEl = $("#sk-edit-md");
      idEl.value = prop.skill_id || "";
      idEl.readOnly = false;
      titleEl.value = prop.title || "";
      titleEl.readOnly = false;
      descEl.value = prop.description || "";
      descEl.readOnly = false;
      mdEl.value = prop.content || "";
      mdEl.readOnly = false;
      const revBanner = $("#sk-review-banner");
      const revBadges = $("#sk-review-badges");
      const revRat = $("#sk-review-rationale");
      const revSeg = $("#sk-review-mode-seg");
      if (revBanner) revBanner.hidden = false;
      if (revBadges) {
        const sigTags = (Array.isArray(prop.signals) ? prop.signals : []).map((s) => `<span class="mil-tag">${esc(s)}</span>`).join("");
        revBadges.innerHTML = `<span class="mil-tag mil-tag--warn">任务后自动复盘 · 首次创建确认</span>${sigTags}`;
      }
      if (revRat) revRat.textContent = prop.rationale || "首次提炼出的新技能草稿，确认后保存并可在后续同类任务中自动补充经验。";
      if (revSeg) revSeg.hidden = true;
      if ($("#sk-companion-hint")) $("#sk-companion-hint").textContent = "已自动剥离单次聊天与隐私信息";
      if ($("#sk-versions-wrap")) $("#sk-versions-wrap").hidden = true;
      renderSkillCompanions([], { visible: false });
      if ($("#sk-drawer-export")) $("#sk-drawer-export").hidden = true;
      if ($("#sk-drawer-reset")) $("#sk-drawer-reset").hidden = true;
      if ($("#sk-drawer-delete")) $("#sk-drawer-delete").hidden = true;
      renderBindCheckboxes(new Set(prop.profile_id ? [prop.profile_id] : ["default"]));
      scrim.hidden = false;
      $("#sk-drawer-save")?.focus();
    }

    function openDistillProposalDrawer(prop) {
      sayDrawer("");
      const scrim = $("#sk-drawer-scrim");
      if (!scrim) return;
      const isPatch = prop.op === "patch" && Boolean(prop.skill_id);
      skState.editing = {
        kind: "skill",
        id: prop.skill_id || prop.id || "",
        isNew: !isPatch,
        isPreset: false,
        version: prop.version ?? null,
        distillThreadId: prop.thread_id || "",
        distillOp: isPatch ? "patch" : "create",
        matchedSkill: prop.matched_skill || (isPatch ? prop.skill_id : ""),
      };
      $("#sk-drawer-title").textContent = isPatch
        ? `复盘增补已有技能 · ${prop.title || prop.skill_id}`
        : `复盘提炼类级技能 · ${prop.title || prop.skill_id}`;
      const idEl = $("#sk-edit-id");
      const titleEl = $("#sk-edit-title");
      const descEl = $("#sk-edit-desc");
      const mdEl = $("#sk-edit-md");
      idEl.value = prop.skill_id || prop.id || "";
      idEl.readOnly = isPatch;
      titleEl.value = prop.title || "";
      titleEl.readOnly = false;
      descEl.value = prop.description || "";
      descEl.readOnly = false;
      mdEl.value = prop.content || "";
      mdEl.readOnly = false;

      const revBanner = $("#sk-review-banner");
      const revBadges = $("#sk-review-badges");
      const revRat = $("#sk-review-rationale");
      const revSeg = $("#sk-review-mode-seg");
      if (revBanner) revBanner.hidden = false;
      if (revBadges) {
        const modeTag = isPatch
          ? `<span class="mil-tag mil-tag--ok">并入已有技能：${esc(prop.skill_id)}</span>`
          : `<span class="mil-tag mil-tag--warn">新建类级技能</span>`;
        const sigTags = (Array.isArray(prop.signals) ? prop.signals : []).map((s) => `<span class="mil-tag">${esc(s)}</span>`).join("");
        revBadges.innerHTML = modeTag + sigTags;
      }
      if (revRat) revRat.textContent = prop.rationale || "";
      if (revSeg) {
        revSeg.hidden = !prop.matched_skill;
        $$("#sk-review-mode-seg [data-sk-rev-op]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.skRevOp === (isPatch ? "patch" : "create"))));
      }
      if ($("#sk-companion-hint")) $("#sk-companion-hint").textContent = isPatch ? "已按 Hermes 规范在原技能末尾追加实战规则与避坑项" : "已剥离单次会话信息，保留祈使句规则与避坑指南";
      if ($("#sk-versions-wrap")) $("#sk-versions-wrap").hidden = true;
      renderSkillCompanions([], { visible: false });
      if ($("#sk-drawer-export")) $("#sk-drawer-export").hidden = true;
      if ($("#sk-drawer-reset")) $("#sk-drawer-reset").hidden = true;
      if ($("#sk-drawer-delete")) $("#sk-drawer-delete").hidden = true;
      renderBindCheckboxes(new Set(Array.isArray(prop.suggested_profiles) ? prop.suggested_profiles : []));
      scrim.hidden = false;
      $("#sk-drawer-save")?.focus();
    }

    async function openSkillDrawer(kind, id, isNew = false) {
      sayDrawer("");
      const scrim = $("#sk-drawer-scrim");
      const idEl = $("#sk-edit-id");
      const titleEl = $("#sk-edit-title");
      const descEl = $("#sk-edit-desc");
      const mdEl = $("#sk-edit-md");
      const compEl = $("#sk-companion-hint");
      const verWrap = $("#sk-versions-wrap");
      const verList = $("#sk-versions-list");
      const expBtn = $("#sk-drawer-export");
      const rstBtn = $("#sk-drawer-reset");
      const delBtn = $("#sk-drawer-delete");
      const revBanner = $("#sk-review-banner");
      if (revBanner) revBanner.hidden = true;
      if (!scrim) return;

      if (isNew) {
        skState.editing = { kind: "skill", id: "", isNew: true, isPreset: false, version: null };
        $("#sk-drawer-title").textContent = "新建技能";
        idEl.value = "";
        idEl.readOnly = false;
        titleEl.value = "";
        titleEl.readOnly = false;
        descEl.value = "";
        descEl.readOnly = false;
        mdEl.value = "# 技能步骤\n\n- 适用场景：\n- 执行步骤：\n- 输出要求：\n";
        mdEl.readOnly = false;
        if (compEl) compEl.textContent = "";
        if (verWrap) verWrap.hidden = true;
        renderSkillCompanions([], { visible: false });
        if (expBtn) expBtn.hidden = true;
        if (rstBtn) rstBtn.hidden = true;
        if (delBtn) delBtn.hidden = true;
        renderBindCheckboxes(new Set());
        scrim.hidden = false;
        idEl.focus();
        return;
      }

      if (kind === "toolset") {
        const ts = skState.systemTools.find((t) => t.id === id);
        if (!ts) return;
        const bound = new Set((ts.bound_profiles || []).map((p) => p.id));
        skState.editing = { kind: "toolset", id, isNew: false, isPreset: true, version: null };
        $("#sk-drawer-title").textContent = `系统工具 · ${ts.title || id}`;
        idEl.value = id;
        idEl.readOnly = true;
        titleEl.value = ts.title || id;
        titleEl.readOnly = true;
        descEl.value = ts.description || "";
        descEl.readOnly = true;
        mdEl.value = Array.isArray(ts.tools) && ts.tools.length ? `包含工具：\n- ${ts.tools.join("\n- ")}` : "内置系统工具集";
        mdEl.readOnly = true;
        if (compEl) compEl.textContent = "内置工具集支持按档案分配启用状态";
        if (verWrap) verWrap.hidden = true;
        renderSkillCompanions([], { visible: false });
        if (expBtn) expBtn.hidden = true;
        if (rstBtn) rstBtn.hidden = true;
        if (delBtn) delBtn.hidden = true;
        renderBindCheckboxes(bound);
        scrim.hidden = false;
        $("#sk-drawer-close")?.focus();
        return;
      }

      const sk = skState.skills.find((s) => s.id === id);
      const res = await hostRpc("read", "asset", { kind: "skill", target: id });
      if (disposed || sig?.aborted) return;
      if (!res?.success) { saySk(res?.error || "读取技能失败", true); return; }
      const rawContent = res.content || "";
      const meta = extractSkillMeta(rawContent, sk || {});
      const isPreset = Boolean(sk?.is_preset);
      const bound = new Set((sk?.bound_profiles || []).map((p) => p.id));
      skState.editing = { kind: "skill", id, isNew: false, isPreset, version: res.version ?? null };

      $("#sk-drawer-title").textContent = `编辑技能 · ${meta.title || id}`;
      idEl.value = id;
      idEl.readOnly = true;
      titleEl.value = meta.title || id;
      titleEl.readOnly = false;
      descEl.value = meta.desc || "";
      descEl.readOnly = false;
      mdEl.value = rawContent;
      mdEl.readOnly = false;
      const comps = Array.isArray(sk?.companion_files) ? sk.companion_files : [];
      if (compEl) compEl.textContent = comps.length ? `随包附带文件 ${comps.length} 个` : "";
      renderSkillCompanions(comps, { visible: true });
      if (expBtn) expBtn.hidden = false;
      if (rstBtn) rstBtn.hidden = !isPreset;
      if (delBtn) delBtn.hidden = isPreset;
      renderBindCheckboxes(bound);

      const hist = Array.isArray(res.history) ? res.history : [];
      if (verWrap && verList) {
        verWrap.hidden = hist.length === 0;
        verList.innerHTML = hist.map((h) => `<button type="button" class="mil-key mil-key--sm" data-sk-rollback-ver="${esc(h.version)}">恢复 v${esc(h.version)} · ${fmtTime(h.at || h.updated)}</button>`).join("");
      }
      scrim.hidden = false;
      $("#sk-drawer-close")?.focus();
    }

    async function loadSkills() {
      const res = await hostRpc("read", "skills", {});
      if (disposed || sig?.aborted) return;
      if (!res?.success) { saySk(res?.error || "技能加载失败", true); return; }
      skState.skills = Array.isArray(res.skills) ? res.skills : [];
      skState.systemTools = Array.isArray(res.system_tools) ? res.system_tools : [];
      skState.externalServices = Array.isArray(res.external_services) ? res.external_services : [];
      skState.proposals = Array.isArray(res.pending_proposals) ? res.pending_proposals : [];
      skState.candidates = Array.isArray(res.candidates) ? res.candidates : [];
      skState.profileCards = Array.isArray(res.profile_cards) ? res.profile_cards : [];
      skState.chatSources = res.chat_sources || {};
      renderPendingProposals();
      renderDistillCandidates();
      renderSkillGrid();
    }

    const view = $("#ms-mgmt-view");
    view.addEventListener("click", async (ev) => {
      if (ev.target.closest("#sk-refresh")) { await loadSkills(); return; }
      if (ev.target.closest("#sk-add-btn")) { await openSkillDrawer("skill", "", true); return; }

      const prevPropBtn = ev.target.closest("[data-preview-proposal]");
      if (prevPropBtn) {
        const pid = prevPropBtn.dataset.previewProposal;
        const prop = skState.proposals.find((x) => x.proposal_id === pid);
        if (prop) openAutoProposalDrawer(prop);
        return;
      }
      const dismPropBtn = ev.target.closest("[data-dismiss-proposal]");
      if (dismPropBtn) {
        const pid = dismPropBtn.dataset.dismissProposal;
        await hostRpc("write", "dismiss_skill_proposal", { proposal_id: pid });
        await loadSkills();
        return;
      }

      const catBtn = ev.target.closest("#sk-filters [data-sk-cat]");
      if (catBtn) {
        skState.cat = catBtn.dataset.skCat;
        $$("#sk-filters [data-sk-cat]").forEach((b) => b.setAttribute("aria-pressed", String(b === catBtn)));
        renderSkillGrid();
        return;
      }

      const distillBtn = ev.target.closest("[data-distill-thread]");
      if (distillBtn) {
        const tid = distillBtn.dataset.distillThread;
        const r = await hostRpc("write", "distill_skill_from_thread", { thread_id: tid, preview_only: true });
        if (!r?.success) { saySk(r?.error || "复盘提炼失败", true); return; }
        openDistillProposalDrawer(r);
        return;
      }

      const revOpBtn = ev.target.closest("#sk-review-mode-seg [data-sk-rev-op]");
      if (revOpBtn && skState.editing?.distillThreadId) {
        const nextOp = revOpBtn.dataset.skRevOp;
        const r = await hostRpc("write", "distill_skill_from_thread", {
          thread_id: skState.editing.distillThreadId,
          preview_only: true,
          op: nextOp,
          matched_skill: skState.editing.matchedSkill || "",
        });
        if (r?.success) openDistillProposalDrawer(r);
        return;
      }

      const dismissBtn = ev.target.closest("[data-dismiss-distill]");
      if (dismissBtn) {
        const tid = dismissBtn.dataset.dismissDistill;
        await hostRpc("write", "distill_skill_from_thread", { thread_id: tid, dismiss: true });
        await loadSkills();
        return;
      }

      const openCard = ev.target.closest("[data-open-sk-kind]");
      if (openCard) {
        await openSkillDrawer(openCard.dataset.openSkKind, openCard.dataset.openSkId, false);
        return;
      }

      if (ev.target.closest("#sk-drawer-close") || ev.target.closest("#sk-drawer-cancel") || ev.target === $("#sk-drawer-scrim")) {
        closeSkillDrawer();
        return;
      }

      const compOpenBtn = ev.target.closest("[data-sk-comp-open]");
      if (compOpenBtn && skState.editing?.id) {
        const rel = compOpenBtn.dataset.skCompOpen || "";
        const r = await hostRpc("read", "skill_file", { target: skState.editing.id, path: rel });
        if (!r?.success) { sayDrawer(r?.error || "读取附属文件失败", true); return; }
        const txt = String(r.content || "");
        skState.activeCompPath = rel;
        if ($("#sk-comp-path")) $("#sk-comp-path").value = rel;
        const ed = $("#sk-comp-editor");
        if (ed) { ed.value = txt; ed.textContent = txt; }
        if ($("#sk-comp-del")) $("#sk-comp-del").hidden = false;
        renderSkillCompanions(skState.compFiles, { visible: true, activePath: rel });
        return;
      }

      if (ev.target.closest("#sk-comp-save") && skState.editing?.id) {
        const rel = ($("#sk-comp-path")?.value || "").trim();
        const content = $("#sk-comp-editor")?.value || "";
        if (!rel) { sayDrawer("请填写附属文件路径，例如 references/guide.md", true); return; }
        const r = await hostRpc("write", "save_skill_file", { target: skState.editing.id, path: rel, content });
        if (!r?.success) { sayDrawer(r?.error || "保存附属文件失败", true); return; }
        const nextFiles = Array.isArray(r.companion_files) ? r.companion_files : [...new Set([...skState.compFiles, rel])];
        const sk = skState.skills.find((x) => x.id === skState.editing.id);
        if (sk) sk.companion_files = nextFiles;
        skState.activeCompPath = rel;
        renderSkillCompanions(nextFiles, { visible: true, activePath: rel });
        if ($("#sk-comp-del")) $("#sk-comp-del").hidden = false;
        sayDrawer(`已保存附属文件 ${rel}`);
        return;
      }

      if (ev.target.closest("#sk-comp-del") && skState.editing?.id) {
        const skillId = skState.editing.id;
        const rel = ($("#sk-comp-path")?.value || skState.activeCompPath || "").trim();
        if (!rel) return;
        const ok = await window.MaisyaUI.confirmDanger({
          tag: "删除文件",
          title: `删除技能附属文件「${rel}」？`,
          body: `将永久删除技能 ${skillId} 下的附属文件「${rel}」。`,
          confirmText: "确认删除",
        });
        if (!ok || disposed || sig?.aborted) return;
        const r = await hostRpc("write", "delete_skill_file", { target: skillId, path: rel });
        if (!r?.success) { sayDrawer(r?.error || "删除附属文件失败", true); return; }
        const nextFiles = Array.isArray(r.companion_files) ? r.companion_files : skState.compFiles.filter((f) => f !== rel);
        const sk = skState.skills.find((x) => x.id === skillId);
        if (sk) sk.companion_files = nextFiles;
        renderSkillCompanions(nextFiles, { visible: true });
        sayDrawer(`已删除附属文件 ${rel}`);
        return;
      }

      if (ev.target.closest("#sk-drawer-save") && skState.editing) {
        const ed = skState.editing;
        const boundIds = $$("#sk-bind-profiles [data-sk-bind-profile]:checked").map((c) => c.dataset.skBindProfile);
        if (ed.kind === "toolset") {
          for (const card of skState.profileCards) {
            const curHas = (card.toolsets || []).includes(ed.id);
            const wantHas = boundIds.includes(card.id);
            if (curHas === wantHas) continue;
            const nextToolsets = wantHas
              ? [...new Set([...(card.toolsets || []), ed.id])]
              : (card.toolsets || []).filter((x) => x !== ed.id);
            const r = await hostRpc("write", "profile_update", { profile_id: card.id, id: card.id, toolsets: nextToolsets });
            if (!r?.success) { sayDrawer(r?.error || `更新档案 ${card.id} 失败`, true); return; }
          }
          closeSkillDrawer();
          saySk("系统工具分配已更新");
          await loadSkills();
          return;
        }
        const target = ($("#sk-edit-id")?.value || "").trim();
        const title = ($("#sk-edit-title")?.value || "").trim();
        const desc = ($("#sk-edit-desc")?.value || "").trim();
        const mdRaw = $("#sk-edit-md")?.value || "";
        if (!target) { sayDrawer("请填写技能标识", true); return; }
        const content = syncSkillFrontmatter(mdRaw, title, desc);
        if (ed.proposalId) {
          const pr = await hostRpc("write", "confirm_skill_proposal", {
            proposal_id: ed.proposalId,
            skill_id: target,
            title,
            description: desc,
            content,
            bind_profiles: boundIds,
          });
          if (!pr?.success) { sayDrawer(pr?.error || "确认保存技能草稿失败", true); return; }
          closeSkillDrawer();
          saySk("技能已保存");
          abCtrl?.markProfilesStale?.();
          await loadSkills();
          return;
        }
        if (ed.distillThreadId) {
          const dr = await hostRpc("write", "distill_skill_from_thread", {
            thread_id: ed.distillThreadId,
            preview_only: false,
            op: ed.distillOp || (ed.isNew ? "create" : "patch"),
            matched_skill: ed.distillOp === "patch" ? target : "",
            target,
            title,
            description: desc,
            content,
            profile_ids: boundIds,
          });
          if (!dr?.success) { sayDrawer(dr?.error || "保存复盘技能失败", true); return; }
          closeSkillDrawer();
          saySk("技能已保存");
          abCtrl?.markProfilesStale?.();
          await loadSkills();
          return;
        }
        if (ed.isNew) {
          const cr = await hostRpc("write", "create_skill", { target, title, description: desc, content });
          if (!cr?.success) { sayDrawer(cr?.error || "创建技能失败", true); return; }
        } else {
          const wr = await hostRpc("write", "asset", { kind: "skill", target, content, expected_version: ed.version });
          if (!wr?.success) { sayDrawer(wr?.error || "保存技能失败", true); return; }
        }
        const br = await hostRpc("write", "bind_skill_profiles", { skill: target, profile_ids: boundIds });
        if (!br?.success) { sayDrawer(br?.error || "档案绑定保存失败", true); return; }
        closeSkillDrawer();
        saySk("技能已保存");
        abCtrl?.markProfilesStale?.();
        await loadSkills();
        return;
      }

      if (ev.target.closest("#sk-drawer-export") && skState.editing?.id) {
        const res = await hostRpc("write", "export_skill_zip", { skill: skState.editing.id });
        if (!res?.success || !res.base64) { sayDrawer(res?.error || "导出技能失败", true); return; }
        triggerZipDownload(res.base64, res.filename || `${skState.editing.id}.maisya.zip`);
        sayDrawer(`已导出技能包 ${res.filename || skState.editing.id}`);
        return;
      }

      if (ev.target.closest("#sk-drawer-reset") && skState.editing?.id) {
        const tid = skState.editing.id;
        const title = ($("#sk-edit-title")?.value || tid).trim();
        const ok = await window.MaisyaUI.confirmDanger({
          tag: "恢复默认",
          title: `恢复预设技能「${title}」？`,
          body: `将用内置默认版本覆盖你对技能「${title}」（${tid}）的本地修改（历史记录仍可回滚查看）。`,
          confirmText: "确认恢复",
        });
        if (!ok || disposed || sig?.aborted) return;
        const res = await hostRpc("write", "reset_skill", { target: tid });
        if (!res?.success) { sayDrawer(res?.error || "恢复默认失败", true); return; }
        saySk("已恢复预设技能默认内容");
        await loadSkills();
        await openSkillDrawer("skill", tid, false);
        return;
      }

      if (ev.target.closest("#sk-drawer-delete") && skState.editing?.id) {
        const tid = skState.editing.id;
        const title = ($("#sk-edit-title")?.value || tid).trim();
        const ok = await window.MaisyaUI.confirmDanger({
          tag: "删除技能",
          title: `删除自定义技能「${title}」？`,
          body: `将永久删除技能文档 ${tid} 及其附属文件，并解除在所有角色中的绑定。`,
          confirmText: "确认删除",
        });
        if (!ok || disposed || sig?.aborted) return;
        const res = await hostRpc("write", "delete_skill", { target: tid });
        if (!res?.success) { sayDrawer(res?.error || "删除技能失败", true); return; }
        closeSkillDrawer();
        saySk(`已删除技能 ${tid}`);
        await loadSkills();
        return;
      }

      const rbBtn = ev.target.closest("[data-sk-rollback-ver]");
      if (rbBtn && skState.editing?.id) {
        const ver = Number(rbBtn.dataset.skRollbackVer);
        const res = await hostRpc("write", "rollback", {
          kind: "skill",
          target: skState.editing.id,
          version: ver,
          expected_version: skState.editing.version,
        });
        if (!res?.success) { sayDrawer(res?.error || "回滚失败", true); return; }
        saySk(`已恢复到历史版本 v${ver}`);
        await loadSkills();
        await openSkillDrawer("skill", skState.editing.id, false);
        return;
      }

      if (ev.target.closest("#sk-import-btn")) {
        skState.pkgTransferToken = "";
        skState.pkgBase64 = "";
        skState.pkgShareLink = "";
        skState.pkgReady = false;
        saySkPkg("");
        $("#sk-pkg-link").value = "";
        $("#sk-pkg-file-name").textContent = "未选择文件";
        $("#sk-pkg-preview").hidden = true;
        $("#sk-pkg-confirm").disabled = true;
        $("#sk-pkg-scrim").hidden = false;
        $("#sk-pkg-close")?.focus();
        return;
      }

      if (ev.target.closest("#sk-pkg-close") || ev.target === $("#sk-pkg-scrim")) {
        $("#sk-pkg-scrim").hidden = true;
        return;
      }

      if (ev.target.closest("#sk-pkg-pick-file")) {
        $("#sk-pkg-file")?.click();
        return;
      }

      if (ev.target.closest("#sk-pkg-preview-link")) {
        const url = ($("#sk-pkg-link")?.value || "").trim();
        if (!url) { saySkPkg("请先粘贴公开能力包直链", true); return; }
        const res = await hostRpc("write", "package_preview", { remote_url: url });
        if (!res?.success) { saySkPkg(res?.error || "链接拉取或解析失败", true); return; }
        skState.pkgShareLink = url;
        skState.pkgTransferToken = "";
        skState.pkgBase64 = "";
        skState.pkgReady = true;
        $("#sk-pkg-preview").innerHTML = renderPkgPreviewHtml(res);
        $("#sk-pkg-preview").hidden = false;
        $("#sk-pkg-confirm").disabled = false;
        saySkPkg("已解析能力包，请确认导入");
        return;
      }

      if (ev.target.closest("#sk-pkg-confirm")) {
        if (!skState.pkgReady && !skState.pkgShareLink && !skState.pkgBase64 && !skState.pkgTransferToken) return;
        const res = await hostRpc("write", "package_import", {
          overwrite: true,
          ...(skState.pkgTransferToken ? { transfer_token: skState.pkgTransferToken } : {}),
          ...(skState.pkgBase64 && !skState.pkgTransferToken ? { base64: skState.pkgBase64 } : {}),
          ...(skState.pkgShareLink ? { remote_url: skState.pkgShareLink } : {}),
        });
        if (!res?.success) { saySkPkg(res?.error || "导入能力包失败", true); return; }
        $("#sk-pkg-scrim").hidden = true;
        saySk("能力包已导入并刷新技能列表");
        await loadSkills();
        return;
      }
    }, { signal: sig });

    view.addEventListener("change", async (ev) => {
      if (ev.target.id === "sk-pkg-file") {
        const file = ev.target.files?.[0];
        ev.target.value = "";
        if (!file) return;
        $("#sk-pkg-file-name").textContent = file.name;
        try {
          const staged = await stageAndPreviewZipFile(file);
          if (!staged.previewRes?.success) { saySkPkg(staged.previewRes?.error || "能力包解析失败", true); return; }
          skState.pkgTransferToken = staged.transferToken;
          skState.pkgBase64 = staged.base64;
          skState.pkgShareLink = "";
          skState.pkgReady = true;
          $("#sk-pkg-preview").innerHTML = renderPkgPreviewHtml(staged.previewRes);
          $("#sk-pkg-preview").hidden = false;
          $("#sk-pkg-confirm").disabled = false;
          saySkPkg(`已解析 ${file.name}`);
        } catch (err) {
          saySkPkg(String(err?.message || err || "文件读取失败"), true);
        }
      }
    }, { signal: sig });

    view.addEventListener("input", (ev) => {
      if (ev.target.id === "sk-search") { skState.query = ev.target.value || ""; renderSkillGrid(); }
    }, { signal: sig });

    document.addEventListener("keydown", (ev) => {
      if (ev.key !== "Escape" || activePage !== "abilities" || abCtrl?.getSub?.() !== "skills") return;
      if (window.MaisyaUI?.isConfirmOpen?.() || ev.target?.closest?.("#ms-confirm-dialog")) return;
      if (!$("#sk-pkg-scrim")?.hidden) { $("#sk-pkg-scrim").hidden = true; return; }
      if (!$("#sk-drawer-scrim")?.hidden) closeSkillDrawer();
    }, { signal: sig });

    window.addEventListener("maisya:themechange", () => {
      if (disposed || sig?.aborted || activePage !== "abilities") return;
      renderPendingProposals();
      renderDistillCandidates();
      renderSkillGrid();
    }, { signal: sig });

    abCtrl?.registerReloadSkills?.(loadSkills);
    loadSkills();
  }

  /* ───────────── 外部连接子栏（MCP 连接中心：JSON 粘贴 + 直填密码 + 试连取工具 + 宿主 API 登记） ───────────── */
  async function bootConnectorsSubTab(sig, abCtrl = null) {
    const cState = {
      version: null,
      servers: {},
      apis: {},
      hostPlugins: [],
      hostApis: [],
      inputMode: "form",
      transport: "stdio",
      editingOrigName: "",
      keptKeys: [],
      probedTools: [],
    };
    const sayConn = (txt, err = false) => {
      const el = $("#conn-feedback");
      if (el) { el.textContent = txt || ""; el.className = `mil-feedback${!txt ? "" : err ? " mil-feedback--err" : " mil-feedback--ok"}`; }
    };

    function splitCmdLine(rawStr) {
      const out = [];
      let cur = "";
      let quote = "";
      for (let i = 0; i < rawStr.length; i += 1) {
        const ch = rawStr[i];
        if (quote) {
          if (ch === "\\" && i + 1 < rawStr.length) { cur += rawStr[i + 1]; i += 1; }
          else if (ch === quote) quote = "";
          else cur += ch;
        } else if (ch === '"' || ch === "'") {
          quote = ch;
        } else if (/\s/.test(ch)) {
          if (cur) { out.push(cur); cur = ""; }
        } else {
          cur += ch;
        }
      }
      if (cur) out.push(cur);
      return out;
    }

    function parseKvLines(text) {
      const out = {};
      String(text || "").split(/\r?\n/).forEach((line) => {
        const t = line.trim();
        if (!t || t.startsWith("#")) return;
        let idx = t.indexOf("=");
        if (idx <= 0 && cState.transport === "http") idx = t.indexOf(":");
        if (idx <= 0) return;
        const k = t.slice(0, idx).trim();
        const v = t.slice(idx + 1).trim();
        if (k) out[k] = v;
      });
      return out;
    }

    function setInputMode(mode) {
      cState.inputMode = mode === "json" ? "json" : "form";
      $$("[data-conn-input-mode]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.connInputMode === cState.inputMode)));
      const jBox = $("#conn-json-box");
      if (jBox) jBox.hidden = cState.inputMode !== "json";
    }

    function setTransportMode(tr) {
      cState.transport = tr === "http" ? "http" : "stdio";
      $$("#conn-transport-seg [data-conn-transport]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.connTransport === cState.transport)));
      if ($("#conn-stdio-wrap")) $("#conn-stdio-wrap").hidden = cState.transport === "http";
      if ($("#conn-http-wrap")) $("#conn-http-wrap").hidden = cState.transport !== "http";
      const lbl = $("#conn-env-label");
      const ta = $("#conn-env");
      if (lbl) {
        lbl.textContent = cState.transport === "http"
          ? "请求头鉴权（可选，每行一条 Header=值，例如 Authorization=Bearer xxx，直接填写即可）"
          : "密码或环境变量（可选，每行一条 变量名=值，直接填写无需先存保险箱）";
      }
      if (ta) {
        ta.placeholder = cState.transport === "http"
          ? "例如 Authorization=Bearer sk-xxx（保存时自动加密保护）"
          : "例如 API_TOKEN=sk-xxx（保存时自动加密，无需先存密码保险箱）";
      }
    }

    function renderKeptKeys() {
      const box = $("#conn-kept-keys");
      if (!box) return;
      box.hidden = cState.keptKeys.length === 0;
      box.innerHTML = cState.keptKeys.map((k) =>
        `<button type="button" class="mil-key mil-key--sm mono" data-conn-drop-kept="${esc(k)}">已加密保存：${esc(k)} ×</button>`
      ).join("");
    }

    function renderToolsChecklist(tools, checkedSet = null) {
      const box = $("#conn-tools-box");
      const cntEl = $("#conn-tools-count");
      const listEl = $("#conn-tools-list");
      cState.probedTools = Array.isArray(tools) ? tools : [];
      if (!box || !listEl) return;
      box.hidden = cState.probedTools.length === 0;
      if (cntEl) cntEl.textContent = `${cState.probedTools.length} 项`;
      listEl.innerHTML = cState.probedTools.map((t) => {
        const name = typeof t === "string" ? t : (t?.name || "");
        const desc = typeof t === "string" ? "" : (t?.description || "");
        const isChk = checkedSet ? checkedSet.has(name) : true;
        return `<label class="mil-chk"><input type="checkbox" data-conn-tool="${esc(name)}" ${isChk ? "checked" : ""} /><span><strong class="mono">${esc(name)}</strong>${desc ? ` · ${esc(desc)}` : ""}</span></label>`;
      }).join("");
    }

    function resetConnForm() {
      cState.editingOrigName = "";
      cState.keptKeys = [];
      cState.probedTools = [];
      if ($("#conn-form-title")) $("#conn-form-title").textContent = "添加外部 MCP 连接";
      if ($("#conn-cancel-edit")) $("#conn-cancel-edit").hidden = true;
      if ($("#conn-name")) $("#conn-name").value = "";
      if ($("#conn-cmd")) $("#conn-cmd").value = "";
      if ($("#conn-url")) $("#conn-url").value = "";
      const envEl = $("#conn-env");
      if (envEl) { envEl.value = ""; envEl.textContent = ""; }
      if ($("#conn-desc")) $("#conn-desc").value = "";
      if ($("#conn-readonly")) $("#conn-readonly").checked = true;
      setTransportMode("stdio");
      renderKeptKeys();
      renderToolsChecklist([]);
    }

    function collectConnFormPayload() {
      const name = ($("#conn-name")?.value || "").trim();
      const rawCmd = ($("#conn-cmd")?.value || "").trim();
      const url = ($("#conn-url")?.value || "").trim();
      const desc = ($("#conn-desc")?.value || "").trim();
      const ro = Boolean($("#conn-readonly")?.checked);
      const kv = parseKvLines($("#conn-env")?.value || "");
      return { name, rawCmd, url, desc, ro, kv };
    }

    function renderConnectors() {
      const mcpEl = $("#conn-mcp-list");
      const discEl = $("#conn-disc-list");
      const serverEntries = Object.entries(cState.servers || {});
      if (mcpEl) {
        mcpEl.innerHTML = serverEntries.length
          ? serverEntries.map(([name, spec]) => {
              const isHttp = spec?.transport === "http" || Boolean(spec?.url);
              const cmd = Array.isArray(spec?.command) ? spec.command.join(" ") : "";
              const ro = spec?.readonly !== false;
              const secKeys = [
                ...(Array.isArray(spec?.inline_env_keys) ? spec.inline_env_keys : Object.keys(spec?.credentials || {})),
                ...(Array.isArray(spec?.inline_header_keys) ? spec.inline_header_keys : Object.keys(spec?.header_credentials || {})),
              ];
              const toolsArr = Array.isArray(spec?.tools) ? spec.tools : [];
              const toolsLabel = toolsArr.includes("*") ? "全部工具 (*)" : toolsArr.length ? `${toolsArr.length} 个工具` : "默认全部工具";
              return `<div class="ms-entry-row" data-conn-row="${esc(name)}">
                <div class="ms-entry-meta">
                  <div class="mil-row" style="gap:6px;flex-wrap:wrap;align-items:center">
                    <strong class="ms-entry-title">${esc(name)}</strong>
                    <span class="mil-tag">${isHttp ? "远程网址" : "本机程序"}</span>
                    <span class="mil-tag ${ro ? "mil-tag--ok" : "mil-tag--warn"}">${ro ? "只读共享" : "仅管理员"}</span>
                    <span class="mil-tag">${esc(toolsLabel)}</span>
                    ${secKeys.map((k) => `<span class="mil-tag mono">${esc(k)}</span>`).join("")}
                  </div>
                  <span class="ms-entry-code">${esc(spec?.description || (isHttp ? spec?.url : cmd) || "外部 MCP 工具服务")}</span>
                </div>
                <div class="mil-row" style="gap:6px;flex-shrink:0">
                  <button type="button" class="mil-key mil-key--sm" data-conn-test="${esc(name)}">测试</button>
                  <button type="button" class="mil-key mil-key--sm" data-conn-edit="${esc(name)}">编辑</button>
                  <button type="button" class="mil-key mil-key--sm mil-key--danger" data-conn-del="${esc(name)}">移除</button>
                </div>
              </div>`;
            }).join("")
          : `<div class="mil-hint">暂未登记外部 MCP 服务，普通使用无需额外配置；如需接入外部工具可在下方填写或粘贴 JSON 配置。</div>`;
      }
      if (discEl) {
        const apiEntries = Object.entries(cState.apis || {});
        const regApiNames = new Set(apiEntries.map(([id, spec]) => String(spec?.api_name || spec?.api || id)));
        const rows = [];
        apiEntries.forEach(([name, spec]) => {
          rows.push(`<div class="ms-entry-row"><div class="ms-entry-meta"><strong class="ms-entry-title">${esc(name)}</strong><span class="ms-entry-code">已登记插件接口 · ${esc(spec?.api_name || spec?.api || name)}</span></div><div class="mil-row" style="gap:6px"><span class="mil-tag mil-tag--ok">已登记</span><button type="button" class="mil-key mil-key--sm mil-key--danger" data-conn-del-api="${esc(name)}">移除</button></div></div>`);
        });
        (cState.hostApis || []).slice(0, 20).forEach((a) => {
          const nm = typeof a === "string" ? a : (a?.name || a?.api_name || a?.api || "");
          const pid = typeof a === "object" && a?.plugin_id ? `${a.plugin_id}.${nm}` : nm;
          const desc = typeof a === "object" && a?.description ? a.description : "宿主发现的跨插件接口";
          const safeRo = typeof a === "object" ? (a?.safe_readonly !== false) : true;
          const unsafeHint = typeof a === "object" && a?.unsafe_reason ? a.unsafe_reason : "含写操作词，禁止快捷按只读挂载";
          if (nm && !String(nm).startsWith("maisya_") && !regApiNames.has(nm) && !regApiNames.has(pid)) {
            const actionHtml = safeRo
              ? `<div class="mil-row" style="gap:6px;flex-shrink:0;flex-wrap:wrap"><button type="button" class="mil-key mil-key--sm mil-key--hot" data-conn-mount-api="${esc(nm)}" data-conn-mount-desc="${esc(desc)}">+ 挂载到默认角色</button><button type="button" class="mil-key mil-key--sm" data-conn-reg-api="${esc(nm)}" data-conn-reg-desc="${esc(desc)}">仅登记</button></div>`
              : `<span class="mil-tag mil-tag--warn" title="${esc(unsafeHint)}">写操作接口 · 禁用快捷挂载</span>`;
            rows.push(`<div class="ms-entry-row"><div class="ms-entry-meta"><strong class="ms-entry-title mono">${esc(nm)}</strong><span class="ms-entry-code" style="white-space:normal">${esc(desc)}</span></div>${actionHtml}</div>`);
          }
        });
        discEl.innerHTML = rows.length
          ? rows.join("")
          : `<div class="mil-hint">当前宿主未暴露其他跨插件接口；内置联网搜索、会话检索与工作区工具均已默认就绪。</div>`;
      }
    }

    async function loadConnectors() {
      const [svcRes, discRes] = await Promise.all([
        hostRpc("read", "services", {}),
        hostRpc("read", "discovery", {}),
      ]);
      if (disposed || sig?.aborted) return;
      if (svcRes?.success) {
        cState.version = svcRes.version ?? null;
        const cfg = svcRes.configuration || {};
        cState.servers = cfg.servers || {};
        cState.apis = cfg.apis || {};
      }
      if (discRes?.success) {
        cState.hostPlugins = Array.isArray(discRes.plugins) ? discRes.plugins : [];
        cState.hostApis = Array.isArray(discRes.apis) ? discRes.apis : [];
      }
      renderConnectors();
    }

    const view = $("#ms-mgmt-view");
    view?.addEventListener("click", async (ev) => {
      if (ev.target.closest("#conn-refresh")) {
        await loadConnectors();
        sayConn("已刷新外部连接状态");
        return;
      }
      const modeBtn = ev.target.closest("[data-conn-input-mode]");
      if (modeBtn) {
        setInputMode(modeBtn.dataset.connInputMode);
        return;
      }
      const trBtn = ev.target.closest("#conn-transport-seg [data-conn-transport]");
      if (trBtn) {
        setTransportMode(trBtn.dataset.connTransport);
        return;
      }
      const dropKeptBtn = ev.target.closest("[data-conn-drop-kept]");
      if (dropKeptBtn) {
        const dropK = dropKeptBtn.dataset.connDropKept;
        cState.keptKeys = cState.keptKeys.filter((k) => k !== dropK);
        renderKeptKeys();
        return;
      }
      if (ev.target.closest("#conn-cancel-edit")) {
        resetConnForm();
        sayConn("");
        return;
      }
      if (ev.target.closest("#conn-json-parse")) {
        const rawJson = ($("#conn-json-input")?.value || "").trim();
        if (!rawJson) { sayConn("请先粘贴 mcpServers JSON 配置", true); return; }
        const r = await hostRpc("write", "parse_mcp_json", { json_text: rawJson });
        if (!r?.success) { sayConn(r?.error || "解析 JSON 配置失败", true); return; }
        setInputMode("form");
        if ($("#conn-name")) $("#conn-name").value = r.name || "";
        setTransportMode(r.transport || "stdio");
        if (r.transport === "http") {
          if ($("#conn-url")) $("#conn-url").value = r.url || "";
        } else if ($("#conn-cmd")) {
          $("#conn-cmd").value = r.command_text || "";
        }
        const envEl = $("#conn-env");
        if (envEl) {
          const envTxt = String(r.env_text || "");
          envEl.value = envTxt;
          envEl.textContent = envTxt;
        }
        if ($("#conn-desc") && r.description) $("#conn-desc").value = r.description;
        sayConn(`已解析配置「${r.name || "custom_mcp"}」填入表单，可点击试连或直接保存`);
        return;
      }
      if (ev.target.closest("#conn-probe-btn")) {
        const { name, rawCmd, url, kv } = collectConnFormPayload();
        const isHttp = cState.transport === "http";
        if (isHttp && !url) { sayConn("请先填写远程服务地址", true); return; }
        if (!isHttp && !rawCmd) { sayConn("请先填写启动命令与参数", true); return; }
        const secMap = { ...kv };
        if (cState.keptKeys.length) secMap.__KEEP__ = [...cState.keptKeys];
        sayConn("正在连接测试并拉取工具清单…");
        const r = await hostRpc("write", "probe_mcp_service", {
          name: name || cState.editingOrigName || undefined,
          transport: cState.transport,
          ...(isHttp ? { url, headers: secMap } : { command: splitCmdLine(rawCmd), env: secMap }),
        });
        if (!r?.success) { sayConn(r?.error || "连接测试失败", true); return; }
        const tools = Array.isArray(r.tools) ? r.tools : [];
        const existingSpec = cState.servers[cState.editingOrigName || name];
        const prevTools = Array.isArray(existingSpec?.tools) ? existingSpec.tools : null;
        const checkedSet = prevTools && !prevTools.includes("*") ? new Set(prevTools) : null;
        renderToolsChecklist(tools, checkedSet);
        sayConn(`连接成功，共发现 ${tools.length} 个工具`);
        return;
      }
      const testBtn = ev.target.closest("[data-conn-test]");
      if (testBtn) {
        const name = testBtn.dataset.connTest;
        const spec = cState.servers[name];
        if (!spec) return;
        const isHttp = spec.transport === "http" || Boolean(spec.url);
        sayConn(`正在测试连接 ${name}…`);
        const r = await hostRpc("write", "probe_mcp_service", {
          name,
          transport: isHttp ? "http" : "stdio",
          ...(isHttp ? { url: spec.url } : { command: spec.command }),
        });
        if (!r?.success) { sayConn(r?.error || `连接 ${name} 测试失败`, true); return; }
        sayConn(`连接 ${name} 正常，发现 ${(r.tools || []).length} 个工具`);
        return;
      }
      const editBtn = ev.target.closest("[data-conn-edit]");
      if (editBtn) {
        const name = editBtn.dataset.connEdit;
        const spec = cState.servers[name];
        if (!spec) return;
        const isHttp = spec.transport === "http" || Boolean(spec.url);
        cState.editingOrigName = name;
        cState.keptKeys = isHttp
          ? [...(spec.inline_header_keys || Object.keys(spec.header_credentials || {}))]
          : [...(spec.inline_env_keys || Object.keys(spec.credentials || {}))];
        setInputMode("form");
        setTransportMode(isHttp ? "http" : "stdio");
        if ($("#conn-form-title")) $("#conn-form-title").textContent = `编辑外部连接 · ${name}`;
        if ($("#conn-cancel-edit")) $("#conn-cancel-edit").hidden = false;
        if ($("#conn-name")) $("#conn-name").value = name;
        if (isHttp) {
          if ($("#conn-url")) $("#conn-url").value = spec.url || "";
        } else if ($("#conn-cmd")) {
          $("#conn-cmd").value = Array.isArray(spec.command) ? spec.command.join(" ") : "";
        }
        const envEl = $("#conn-env");
        if (envEl) { envEl.value = ""; envEl.textContent = ""; }
        if ($("#conn-desc")) $("#conn-desc").value = spec.description || "";
        if ($("#conn-readonly")) $("#conn-readonly").checked = spec.readonly !== false;
        renderKeptKeys();
        const existingTools = (spec.tools || []).filter((t) => t && t !== "*");
        renderToolsChecklist(existingTools.map((t) => ({ name: t, description: "" })));
        sayConn(`已载入「${name}」；原有密钥留空会自动沿用，填写新值会覆盖`);
        return;
      }
      const delBtn = ev.target.closest("[data-conn-del]");
      if (delBtn) {
        const name = delBtn.dataset.connDel;
        const ok = await window.MaisyaUI.confirmDanger({
          tag: "移除连接",
          title: `移除外部 MCP 连接「${name}」？`,
          body: "移除后已绑定该连接的角色将无法再调用它的工具。",
          confirmText: "确认移除",
        });
        if (!ok || disposed || sig?.aborted) return;
        const r = await hostRpc("write", "delete_service_item", { kind: "mcp", name, expected_version: cState.version });
        if (!r?.success) { sayConn(r?.error || "移除外部连接失败", true); return; }
        if (cState.editingOrigName === name) resetConnForm();
        sayConn(`已移除连接 ${name}`);
        abCtrl?.markProfilesStale?.();
        await loadConnectors();
        return;
      }
      const mountApiBtn = ev.target.closest("[data-conn-mount-api]");
      if (mountApiBtn) {
        const rawApi = mountApiBtn.dataset.connMountApi || "";
        const desc = mountApiBtn.dataset.connMountDesc || "";
        mountApiBtn.disabled = true;
        const r = await hostRpc("write", "mount_readonly_api", {
          api_name: rawApi,
          profile_id: "default",
          description: desc,
        });
        mountApiBtn.disabled = false;
        if (!r?.success) { sayConn(r?.error || "挂载只读插件接口失败", true); return; }
        sayConn(`已将只读接口 ${rawApi} 登记为 ${r.handle || rawApi} 并挂载到默认角色`);
        abCtrl?.markProfilesStale?.();
        await loadConnectors();
        return;
      }
      const regApiBtn = ev.target.closest("[data-conn-reg-api]");
      if (regApiBtn) {
        const rawApi = regApiBtn.dataset.connRegApi || "";
        const desc = regApiBtn.dataset.connRegDesc || "";
        const cleanId = rawApi.replace(/[^A-Za-z0-9_-]+/g, "_").replace(/^_+|_+$/g, "").slice(0, 48) || "host_api";
        const r = await hostRpc("write", "upsert_service_item", {
          kind: "api",
          name: cleanId,
          expected_version: cState.version,
          item: { api_name: rawApi, description: desc, readonly: true, access: "everyone" },
        });
        if (!r?.success) { sayConn(r?.error || "登记插件接口失败", true); return; }
        sayConn(`已登记插件接口 ${rawApi}，现在可在角色「技能与工具」中勾选分配`);
        abCtrl?.markProfilesStale?.();
        await loadConnectors();
        return;
      }
      const delApiBtn = ev.target.closest("[data-conn-del-api]");
      if (delApiBtn) {
        const name = delApiBtn.dataset.connDelApi;
        const ok = await window.MaisyaUI.confirmDanger({
          tag: "移除接口",
          title: `移除已登记插件接口「${name}」？`,
          body: "移除后角色档案将无法再引用该插件接口配置。",
          confirmText: "确认移除",
        });
        if (!ok || disposed || sig?.aborted) return;
        const r = await hostRpc("write", "delete_service_item", { kind: "api", name, expected_version: cState.version });
        if (!r?.success) { sayConn(r?.error || "移除插件接口失败", true); return; }
        sayConn(`已移除插件接口 ${name}`);
        abCtrl?.markProfilesStale?.();
        await loadConnectors();
      }
    }, { signal: sig });

    view?.addEventListener("submit", async (ev) => {
      if (ev.target.id !== "conn-add-form") return;
      ev.preventDefault();
      const { name, rawCmd, url, desc, ro, kv } = collectConnFormPayload();
      const isHttp = cState.transport === "http";
      if (!name || (isHttp ? !url : !rawCmd)) {
        sayConn(isHttp ? "请填写连接名称与远程网址" : "请填写连接名称与启动命令", true);
        return;
      }
      const checkedTools = $$("#conn-tools-list [data-conn-tool]:checked").map((el) => el.dataset.connTool).filter(Boolean);
      const toolsPayload = cState.probedTools.length > 0 && checkedTools.length > 0
        ? checkedTools
        : (cState.editingOrigName && Array.isArray(cState.servers[cState.editingOrigName]?.tools) && cState.servers[cState.editingOrigName].tools.length
          ? cState.servers[cState.editingOrigName].tools
          : ["*"]);
      const item = {
        transport: isHttp ? "http" : "stdio",
        ...(isHttp ? { url } : { command: splitCmdLine(rawCmd) }),
        ...(isHttp
          ? { ...(Object.keys(kv).length ? { headers: kv } : {}), ...(cState.keptKeys.length ? { keep_header_keys: [...cState.keptKeys] } : {}) }
          : { ...(Object.keys(kv).length ? { env: kv } : {}), ...(cState.keptKeys.length ? { keep_env_keys: [...cState.keptKeys] } : {}) }),
        tools: toolsPayload,
        description: desc,
        readonly: ro,
        access: ro ? "everyone" : "admins",
      };
      const wasEdit = Boolean(cState.editingOrigName);
      const r = await hostRpc("write", "upsert_service_item", {
        kind: "mcp",
        name,
        ...(cState.editingOrigName ? { orig_name: cState.editingOrigName } : {}),
        expected_version: cState.version,
        item,
      });
      if (!r?.success) { sayConn(r?.error || "保存外部连接失败", true); return; }
      resetConnForm();
      sayConn(wasEdit ? `已更新外部连接 ${name}` : `已保存外部连接 ${name}`);
      abCtrl?.markProfilesStale?.();
      await loadConnectors();
    }, { signal: sig });

    loadConnectors();
  }

  /* ───────────── 独立手账页（会话备忘 | 自身近况 | 心跳说明 + 搜索 + 自动学习回执） ───────────── */
  async function bootMemoryTab(sig) {
    const BOOK_META = {
      memory: { title: "会话备忘", limit: 16000, label: "当前会话的称呼、口味、群规与长期约定", tabId: "mem-tab-memory" },
      role_memory: { title: "角色记忆", limit: 8000, label: "该角色专属的长期背景、审美偏好与领域事实（与角色页实时互通）", tabId: "mem-tab-role-memory" },
      journal: { title: "自身近况", limit: 8000, label: "MaiBot 自身视角的近期见闻与活动留痕", tabId: "mem-tab-journal" },
      heartbeat: { title: "心跳说明", limit: 16000, label: "闲暇心跳醒来时关注的话题、订阅方向与相处分寸", tabId: "mem-tab-heartbeat" },
    };
    const HB_TEMPLATE = [
      "## 气质与分寸",
      "- 只在确有新意或恰当话题时自然开口；拿不准时宁可安静沉淀到近况手账。",
      "- 尊重免打扰时段与未回不连戳边界，不打扰正经讨论。",
      "",
      "## 自主探索方向",
      "- 留意群里最近聊起的话题、独立游戏或开源新工具进展，有意思的发现记入自身近况（JOURNAL.md）。",
      "",
    ].join("\n");

    const mState = {
      kind: ["memory", "role_memory", "journal", "heartbeat"].includes(pendingMemoryKind) ? pendingMemoryKind : "memory",
      chatId: "",
      chats: [],
      roleId: "default",
      profiles: [],
      chatSources: {},
      chatQuery: "",
      version: null,
      dirty: false,
      bookLoadSeq: 0,
      learning: [],
      proposals: [],
      proactiveStatus: null,
    };
    pendingMemoryKind = "";

    function renderProactiveStatus() {
      const bar = $("#mem-proactive-bar");
      if (!bar) return;
      const st = mState.proactiveStatus || {};
      const gUsed = Number(st.global_used ?? st.used ?? 0);
      const gLimit = Number(st.global_limit ?? st.limit ?? 3);
      const perChat = Number(st.per_chat_limit ?? st.chat_limit ?? 1);
      const sw = String(st.sleep_window || "").trim();
      const hbMode = String(st.heartbeat_mode || (st.heartbeat_enabled === false ? "off" : "gentle"));
      const hbModeLabel = hbMode === "lively" ? "活泼" : hbMode === "gentle" ? "克制" : "关";
      const hbPlan = Boolean(st.heartbeat_has_plan);
      const hbEff = String(st.heartbeat_effective || (hbMode === "off" ? "关闭" : hbPlan ? "想念 + 逛逛" : "只会想念（未填逛逛方向）"));
      const locks = Array.isArray(st.unreplied_chats) ? st.unreplied_chats : [];
      bar.innerHTML = [
        `<span class="mil-tag mil-tag--ok">今日主动：全局 ${gUsed} / ${gLimit} 次 · 单会话上限 ${perChat} 次</span>`,
        `<span class="mil-tag ${hbMode === "off" ? "mil-tag--off" : hbPlan ? "mil-tag--ok" : "mil-tag--warn"}">闲暇心跳：${esc(hbModeLabel)} · ${esc(hbEff)}</span>`,
        `<span class="mil-tag">${sw ? `免打扰时段：${esc(sw)}` : "全天候可响应"}</span>`,
        locks.length
          ? `<span class="mil-tag mil-tag--warn">未回不连戳锁定：${locks.length} 个会话</span>`
          : `<span class="mil-tag">各会话回应畅通</span>`,
      ].join("");
    }

    const sayMem = (txt, err = false) => {
      const el = $("#mem-feedback");
      if (el) { el.textContent = txt || ""; el.className = `mil-feedback${!txt ? "" : err ? " mil-feedback--err" : " mil-feedback--ok"}`; }
    };

    function updateLenBadge() {
      const meta = BOOK_META[mState.kind] || BOOK_META.memory;
      const len = ($("#mem-editor")?.value || "").length;
      const el = $("#mem-len-tag");
      if (el) {
        el.textContent = `${len} / ${meta.limit} 字`;
        el.className = `mil-tag num${len > meta.limit ? " mil-tag--bad" : len > meta.limit * 0.85 ? " mil-tag--warn" : ""}`;
      }
    }

    function syncBookTabs() {
      const meta = BOOK_META[mState.kind] || BOOK_META.memory;
      $$("#mem-book-tabs [data-mem-kind]").forEach((b) => {
        const sel = b.dataset.memKind === mState.kind;
        b.setAttribute("aria-selected", String(sel));
      });
      const panel = $("#mem-doc-panel");
      if (panel) panel.setAttribute("aria-labelledby", meta.tabId);
      if ($("#mem-doc-title")) $("#mem-doc-title").textContent = meta.title;
      if ($("#mem-editor-label")) $("#mem-editor-label").textContent = meta.label;
      const chatSec = $("#mem-chat-sec");
      if (chatSec) chatSec.hidden = mState.kind !== "memory";
      const roleSec = $("#mem-role-sec");
      if (roleSec) roleSec.hidden = mState.kind !== "role_memory";
      const hbSec = $("#mem-hb-sec");
      if (hbSec) hbSec.hidden = mState.kind !== "heartbeat";
      updateLenBadge();
    }

    function renderRolePicker() {
      const sel = $("#mem-role-select");
      if (!sel) return;
      const list = Array.isArray(mState.profiles) && mState.profiles.length
        ? mState.profiles
        : [
            { id: "default", title: "全能默认助手" },
            { id: "scout", title: "查证助手" },
            { id: "digest", title: "资讯简报" },
          ];
      if (!list.some((p) => p.id === mState.roleId)) mState.roleId = list[0]?.id || "default";
      sel.innerHTML = list.map((p) => `<option value="${esc(p.id)}"${p.id === mState.roleId ? " selected" : ""}>${esc(p.title || p.id)} (${esc(p.id)})</option>`).join("");
    }

    function renderChatPicker() {
      const ic = window.MaisyaIcons;
      const badgeEl = $("#mem-chat-badge");
      const chevEl = $("#mem-chat-chev");
      const searchIc = $("#mem-chat-search-ic");
      const listEl = $("#mem-chat-list");
      const hiddenEl = $("#mem-chat-id");
      if (hiddenEl) hiddenEl.value = mState.chatId || "";
      if (chevEl && ic?.ctrl) chevEl.innerHTML = ic.ctrl("chevron_d", 14, 1.9);
      if (searchIc && ic?.ctrl) searchIc.innerHTML = ic.ctrl("search", 14, 1.9);
      if (badgeEl) {
        badgeEl.innerHTML = mState.chatId
          ? window.MaisyaUI.renderChatBadgeHtml(mState.chatSources, mState.chatId, { size: 20, platSize: 12, showType: true, showRawId: true })
          : `<span class="mil-hint">暂无已启用会话</span>`;
      }
      if (listEl) {
        const q = mState.chatQuery.trim().toLowerCase();
        const filtered = mState.chats.filter((cid) => {
          if (!q) return true;
          const m = window.MaisyaUI.resolveChatMeta(mState.chatSources, cid);
          return `${m.name} ${m.rawId} ${cid}`.toLowerCase().includes(q);
        });
        listEl.innerHTML = filtered.length
          ? filtered.map((cid) => `<button type="button" class="ms-model-opt${cid === mState.chatId ? " is-selected" : ""}" data-mem-pick-chat="${esc(cid)}">
              ${window.MaisyaUI.renderChatBadgeHtml(mState.chatSources, cid, { size: 20, platSize: 12, showType: true, showRawId: true })}
            </button>`).join("")
          : `<div class="mil-hint" style="padding:8px">没有匹配的会话</div>`;
      }
    }

    function renderLearningReceipts() {
      const box = $("#mem-learning-list");
      if (!box) return;
      const props = Array.isArray(mState.proposals) ? mState.proposals : [];
      const list = mState.learning || [];
      if (!props.length && !list.length) {
        box.innerHTML = `<div class="mil-hint">暂无自动复盘回执。角色完成任务后沉淀的经验要点会显示在这里。</div>`;
        return;
      }
      const propHtml = props.slice(0, 6).map((p) => `<div class="ms-entry-row">
        <div class="ms-entry-meta">
          <div class="mil-row" style="gap:6px;align-items:center;flex-wrap:wrap">
            ${roleFishHtml(p.profile_id || "default", "", 18, { still: true })}
            <span class="mil-tag mil-tag--warn">新技能草稿</span>
            <strong class="ms-entry-title">${esc(p.title || p.skill_id)}</strong>
            <span class="mil-tag mono">${esc(p.skill_id)}</span>
          </div>
          <span class="mil-hint">${esc(p.description || p.rationale || "首次自动提炼的新技能，预览保存后即可复用")}</span>
        </div>
        <button type="button" class="mil-key mil-key--sm mil-key--hot" data-mem-goto-skills="1">去预览保存</button>
      </div>`).join("");
      const learnHtml = list.slice(0, 12).map((item) => `<div class="ms-entry-row">
        <div class="ms-entry-meta">
          <div class="mil-row" style="gap:6px;align-items:center;flex-wrap:wrap">
            ${roleFishHtml(item.profile || "default", "", 18, { still: true })}
            <strong class="ms-entry-title">${esc(item.topic || "任务复盘")}</strong>
            ${item.skill_id ? `<span class="mil-tag mil-tag--ok">补入技能：${esc(item.skill_title || item.skill_id)}</span>` : ""}
            <span class="mil-tag mono">${esc(item.profile || "default")}</span>
            <span class="mil-hint">${fmtTime(item.at)}</span>
          </div>
          <span class="mil-hint">${esc(item.summary || "")}</span>
        </div>
        ${item.can_undo ? `<button type="button" class="mil-key mil-key--sm" data-undo-learn="${esc(item.history_id)}" data-undo-prof="${esc(item.profile || "default")}" data-undo-skill="${esc(item.skill_id || "")}">撤回</button>` : `<span class="mil-tag">${esc(item.status === "reverted" ? "已撤回" : "已记录")}</span>`}
      </div>`).join("");
      box.innerHTML = propHtml + learnHtml;
    }

    async function loadCurrentBook() {
      const loadSeq = ++mState.bookLoadSeq;
      syncBookTabs();
      if (mState.kind === "memory" && !mState.chatId) {
        if ($("#mem-editor") && !mState.dirty) $("#mem-editor").value = "";
        if ($("#mem-ver-tag")) $("#mem-ver-tag").textContent = "未选会话";
        if ($("#mem-versions-wrap")) $("#mem-versions-wrap").hidden = true;
        updateLenBadge();
        return;
      }
      const reqKind = mState.kind;
      const reqChat = mState.chatId;
      const reqRole = mState.roleId || "default";
      const req = reqKind === "memory"
        ? { kind: "memory", chat_id: reqChat }
        : reqKind === "role_memory"
          ? { kind: "role_memory", target: reqRole }
          : { kind: reqKind };
      const res = await hostRpc("read", "asset", req);
      if (disposed || sig?.aborted || loadSeq !== mState.bookLoadSeq || reqKind !== mState.kind || (reqKind === "memory" && reqChat !== mState.chatId) || (reqKind === "role_memory" && reqRole !== (mState.roleId || "default"))) return;
      if (!res?.success) { sayMem(res?.error || "手账读取失败", true); return; }
      mState.version = res.version ?? 0;
      if ($("#mem-editor") && !mState.dirty) {
        $("#mem-editor").value = res.content || "";
        mState.dirty = false;
      }
      if ($("#mem-ver-tag")) $("#mem-ver-tag").textContent = `v${mState.version}`;
      updateLenBadge();
      const hist = Array.isArray(res.history) ? res.history : [];
      const hWrap = $("#mem-versions-wrap");
      const hList = $("#mem-versions-list");
      if (hWrap && hList) {
        hWrap.hidden = hist.length === 0;
        hList.innerHTML = hist.map((h) => `<button type="button" class="mil-key mil-key--sm" data-mem-rb="${esc(h.version)}">恢复 v${esc(h.version)} · ${fmtTime(h.at || h.updated)}</button>`).join("");
      }
    }

    async function bootLoadMemory() {
      const [memRes, intRes] = await Promise.all([
        hostRpc("read", "memory", { chat_id: mState.chatId || undefined }),
        hostRpc("read", "intents", {}),
      ]);
      if (disposed || sig?.aborted) return;
      if (memRes?.success) {
        const rawChats = Array.isArray(memRes.chats) ? memRes.chats.filter((c) => c && c !== "self") : [];
        mState.chats = rawChats;
        mState.profiles = Array.isArray(memRes.profiles) ? memRes.profiles : [];
        mState.chatSources = memRes.chat_sources || {};
        mState.proactiveStatus = memRes.proactive_status || memRes.proactive_quota || null;
        mState.proposals = Array.isArray(memRes.pending_skill_proposals) ? memRes.pending_skill_proposals : [];
        if (!mState.chatId && rawChats.length) mState.chatId = rawChats[0];
      }
      if (intRes?.success) {
        mState.learning = Array.isArray(intRes.learning) ? intRes.learning : [];
      }
      renderProactiveStatus();
      renderChatPicker();
      renderRolePicker();
      renderLearningReceipts();
      await loadCurrentBook(false);
    }

    let initBootPromise = null;

    const view = $("#ms-mgmt-view");
    view?.addEventListener("click", async (ev) => {
      const bookBtn = ev.target.closest("#mem-book-tabs [data-mem-kind]");
      if (bookBtn) {
        mState.kind = bookBtn.dataset.memKind;
        mState.version = null;
        mState.dirty = false;
        sayMem("");
        await loadCurrentBook(true);
        return;
      }
      if (ev.target.closest("#mem-chat-trigger")) {
        const drop = $("#mem-chat-drop");
        const trig = $("#mem-chat-trigger");
        if (drop && trig) {
          const open = Boolean(drop.hidden);
          drop.hidden = !open;
          trig.setAttribute("aria-expanded", String(open));
          if (open) $("#mem-chat-search")?.focus();
        }
        return;
      }
      const pickChat = ev.target.closest("[data-mem-pick-chat]");
      if (pickChat) {
        mState.chatId = pickChat.dataset.memPickChat || "";
        mState.version = null;
        mState.dirty = false;
        const drop = $("#mem-chat-drop");
        if (drop) drop.hidden = true;
        $("#mem-chat-trigger")?.setAttribute("aria-expanded", "false");
        renderChatPicker();
        sayMem("");
        await loadCurrentBook(true);
        return;
      }
      if (!$("#mem-chat-drop")?.hidden && !ev.target.closest("#mem-chat-box")) {
        $("#mem-chat-drop").hidden = true;
        $("#mem-chat-trigger")?.setAttribute("aria-expanded", "false");
      }
      if (ev.target.closest("#mem-hb-template")) {
        const ed = $("#mem-editor");
        if (ed) {
          const cur = (ed.value || "").trim();
          ed.value = cur ? `${cur}\n\n${HB_TEMPLATE}` : HB_TEMPLATE;
          mState.dirty = true;
          updateLenBadge();
          sayMem("已填入心跳说明示例，可按需微调后点击保存");
        }
        return;
      }
      if (ev.target.closest("#mem-goto-hb-set")) {
        switchWorkspaceTab("settings");
        return;
      }
      if (ev.target.closest("#mem-reload")) {
        mState.dirty = false;
        await loadCurrentBook(true);
        sayMem("已重新读取手账内容");
        return;
      }
      if (ev.target.closest("#mem-save")) {
        if (initBootPromise) await initBootPromise;
        if (mState.kind === "memory" && !mState.chatId) { sayMem("请先选择要保存备忘的会话", true); return; }
        if (mState.kind === "role_memory") {
          const sr = $("#mem-role-select")?.value;
          if (sr) mState.roleId = sr;
        }
        const content = $("#mem-editor")?.value || "";
        const scopeArgs = mState.kind === "memory"
          ? { chat_id: mState.chatId }
          : mState.kind === "role_memory"
            ? { target: mState.roleId || "default" }
            : {};
        if (mState.version === null) {
          const curRes = await hostRpc("read", "asset", {
            kind: mState.kind,
            ...scopeArgs,
          });
          if (curRes?.success) mState.version = curRes.version ?? 0;
        }
        const r = await hostRpc("write", "asset", {
          kind: mState.kind,
          ...scopeArgs,
          content,
          expected_version: mState.version ?? 0,
        });
        if (!r?.success) { sayMem(r?.error || "保存手账失败", true); return; }
        mState.dirty = false;
        sayMem("手账已保存");
        await loadCurrentBook(true);
        return;
      }
      const rbBtn = ev.target.closest("[data-mem-rb]");
      if (rbBtn) {
        const ver = Number(rbBtn.dataset.memRb);
        const scopeArgs = mState.kind === "memory"
          ? { chat_id: mState.chatId }
          : mState.kind === "role_memory"
            ? { target: mState.roleId || "default" }
            : {};
        const r = await hostRpc("write", "rollback", {
          kind: mState.kind,
          ...scopeArgs,
          version: ver,
          expected_version: mState.version ?? 0,
        });
        if (!r?.success) { sayMem(r?.error || "历史版本回滚失败", true); return; }
        mState.dirty = false;
        sayMem(`已恢复到版本 v${ver}`);
        await loadCurrentBook(true);
        return;
      }
      if (ev.target.closest("[data-mem-goto-skills]")) {
        switchWorkspaceTab("abilities", { abSub: "skills" });
        return;
      }
      const undoBtn = ev.target.closest("[data-undo-learn]");
      if (undoBtn) {
        const prof = undoBtn.dataset.undoProf || "default";
        const skillId = undoBtn.dataset.undoSkill || "";
        const hid = undoBtn.dataset.undoLearn || "";
        const curAsset = skillId
          ? await hostRpc("read", "asset", { kind: "skill", target: skillId })
          : await hostRpc("read", "asset", { kind: "notes", target: prof });
        const expVer = curAsset?.version ?? 0;
        const r = await hostRpc("write", "undo_learning_note", {
          profile_id: prof,
          ...(skillId ? { skill_id: skillId } : {}),
          history_id: hid,
          expected_version: expVer,
        });
        if (!r?.success) { sayMem(r?.error || (skillId ? "撤回技能补充失败" : "撤回经验笔记失败"), true); return; }
        sayMem(skillId ? `已撤回技能「${skillId}」的自动补充` : "已撤回该条自动经验总结");
        const intRes = await hostRpc("read", "intents", {});
        if (intRes?.success) {
          mState.learning = Array.isArray(intRes.learning) ? intRes.learning : [];
          renderLearningReceipts();
        }
      }
    }, { signal: sig });

    view?.addEventListener("change", async (ev) => {
      if (ev.target.id === "mem-role-select") {
        mState.roleId = ev.target.value || "default";
        mState.version = null;
        mState.dirty = false;
        sayMem("");
        await loadCurrentBook(true);
      }
    }, { signal: sig });

    view?.addEventListener("submit", async (ev) => {
      if (ev.target.id !== "mem-search-form") return;
      ev.preventDefault();
      const q = ($("#mem-search-input")?.value || "").trim();
      const outEl = $("#mem-search-results");
      if (!outEl) return;
      if (!q) { outEl.innerHTML = ""; return; }
      const res = await hostRpc("read", "memory", { chat_id: mState.chatId || undefined, query: q });
      if (disposed || sig?.aborted) return;
      if (!res?.success) { outEl.innerHTML = `<div class="mil-hint">${esc(res?.error || "检索失败")}</div>`; return; }
      const hits = [
        ...(Array.isArray(res.results) ? res.results.map((r) => ({ tag: "备忘", text: r.snippet || r.content || r.text || String(r) })) : []),
        ...(Array.isArray(res.experiences) ? res.experiences.map((e) => ({ tag: "经历", text: e.summary || e.title || e.thread_id || "" })) : []),
      ].filter((x) => x.text);
      outEl.innerHTML = hits.length
        ? hits.slice(0, 10).map((h) => `<div class="ms-entry-row"><div class="ms-entry-meta"><span class="mil-tag">${esc(h.tag)}</span><span class="mil-hint">${esc(h.text)}</span></div></div>`).join("")
        : `<div class="mil-hint">未找到匹配内容</div>`;
    }, { signal: sig });

    view?.addEventListener("input", (ev) => {
      if (ev.target.id === "mem-editor") { mState.dirty = true; updateLenBadge(); }
      else if (ev.target.id === "mem-chat-search") { mState.chatQuery = ev.target.value || ""; renderChatPicker(); }
    }, { signal: sig });

    window.addEventListener("maisya:memory-kind", async (ev) => {
      if (disposed || sig?.aborted || activePage !== "memory") return;
      if (ev.detail?.kind && BOOK_META[ev.detail.kind]) {
        mState.kind = ev.detail.kind;
        mState.version = null;
        mState.dirty = false;
        await loadCurrentBook(true);
      }
    }, { signal: sig });

    window.addEventListener("maisya:themechange", () => {
      if (disposed || sig?.aborted || activePage !== "memory") return;
      renderChatPicker();
      renderLearningReceipts();
    }, { signal: sig });

    initBootPromise = bootLoadMemory();
  }

  /* ───────────── 产物页（分类计数栏 + 来源会话筛选 + 多格式富预览检视器） ───────────── */
  async function bootLibraryTab(sig) {
    const FILTER_TITLES = {
      all: "全部产物",
      html: "网页与简报",
      image: "图片与图表",
      markdown: "文档与报告",
      text: "代码与数据",
      conclusion: "交付结论",
    };
    const lState = {
      items: [],
      chatSources: {},
      filter: "all",
      chatFilter: "",
      query: "",
      selectedItem: null,
      selectedDetail: null,
      viewMode: "preview", // "preview" | "raw"
      imgFit: "contain",   // "contain" | "wide"
      copyText: "",
    };

    const sayLib = (txt, err = false) => {
      const el = $("#lib-feedback");
      if (el) { el.textContent = txt || ""; el.className = `mil-feedback${!txt ? "" : err ? " mil-feedback--err" : " mil-feedback--ok"}`; }
    };

    const fmtBytes = (n) => {
      const v = Number(n || 0);
      if (!v || v < 0) return "";
      if (v >= 1024 * 1024) return `${(v / (1024 * 1024)).toFixed(1)} MB`;
      if (v >= 1024) return `${(v / 1024).toFixed(1)} KB`;
      return `${v} B`;
    };

    function itemCategory(it) {
      const mk = String(it?.media_kind || "").toLowerCase();
      const k = String(it?.kind || "").toLowerCase();
      const nm = String(it?.name || it?.path || "").toLowerCase();
      if (k === "conclusion" || mk === "conclusion") return "conclusion";
      if (mk === "image" || isSafeImageDataUri(it?.data_uri) || /\.(png|jpe?g|webp|gif|svg)$/.test(nm)) return "image";
      if (mk === "html" || mk === "page" || /\.html?$/.test(nm)) return "html";
      if (mk === "markdown" || mk === "report" || mk === "md" || mk === "pdf" || /\.(md|markdown|pdf)$/.test(nm)) return "markdown";
      return "text";
    }

    function filterMatchesKind(it, filter) {
      if (!filter || filter === "all") return true;
      const cat = itemCategory(it);
      if (filter === "doc") return ["markdown", "text", "conclusion"].includes(cat);
      return cat === filter || String(it?.media_kind || "").toLowerCase() === filter || String(it?.kind || "").toLowerCase() === filter;
    }

    function iconForArtifact(it, size = 20) {
      const ic = window.MaisyaIcons;
      if (!ic) return "";
      const cat = itemCategory(it);
      const nm = String(it?.name || it?.path || "").toLowerCase();
      if (cat === "html") return ic.brand ? ic.brand("html", size) : ic.mod("artifacts", size);
      if (cat === "markdown") {
        if (nm.endsWith(".pdf") && ic.brand) return ic.brand("pdf2", size);
        return ic.brand ? ic.brand("markdown", size) : ic.mod("memory", size);
      }
      if (cat === "conclusion") return ic.mod ? ic.mod("journal", size) : "";
      if (cat === "image") return ic.mod ? ic.mod("artifacts", size) : "";
      if (nm.endsWith(".json") && ic.brand) return ic.brand("json", size);
      return ic.ctrl ? ic.ctrl("terminal", size - 2, 1.9) : "";
    }

    function renderFilterIconsAndCounts() {
      const ic = window.MaisyaIcons;
      $$("[data-lib-cat-ic]").forEach((el) => {
        const k = el.dataset.libCatIc;
        if (!ic) return;
        if (k === "html") el.innerHTML = ic.brand ? ic.brand("html", 17) : "";
        else if (k === "markdown") el.innerHTML = ic.brand ? ic.brand("markdown", 17) : "";
        else if (k === "image") el.innerHTML = ic.mod ? ic.mod("artifacts", 18) : "";
        else if (k === "conclusion") el.innerHTML = ic.mod ? ic.mod("journal", 18) : "";
        else if (k === "text") el.innerHTML = ic.ctrl ? ic.ctrl("terminal", 16, 1.9) : "";
        else el.innerHTML = ic.ctrl ? ic.ctrl("grid", 16, 1.9) : "";
      });
      const counts = { all: 0, html: 0, image: 0, markdown: 0, text: 0, conclusion: 0 };
      lState.items.forEach((it) => {
        if (lState.chatFilter && it.chat_id !== lState.chatFilter) return;
        counts.all += 1;
        const c = itemCategory(it);
        if (counts[c] !== undefined) counts[c] += 1;
      });
      $$("[data-lib-cnt]").forEach((el) => {
        const k = el.dataset.libCnt;
        el.textContent = String(counts[k] ?? 0);
      });

      const chatWrap = $("#lib-chat-filter-wrap");
      const chatBox = $("#lib-chat-chips");
      const chatIds = [...new Set(lState.items.map((x) => x.chat_id).filter(Boolean))];
      if (chatWrap && chatBox) {
        chatWrap.hidden = chatIds.length === 0;
        if (chatIds.length) {
          chatBox.innerHTML = `<button type="button" class="lib-cat-btn" data-lib-chat="" aria-pressed="${!lState.chatFilter ? "true" : "false"}"><span>全部来源会话</span><span class="mil-tag num">${lState.items.length}</span></button>`
            + chatIds.map((cid) => {
                const cCnt = lState.items.filter((x) => x.chat_id === cid).length;
                return `<button type="button" class="lib-cat-btn" data-lib-chat="${esc(cid)}" aria-pressed="${lState.chatFilter === cid ? "true" : "false"}">
                  <span style="min-width:0;overflow:hidden">${window.MaisyaUI.renderChatBadgeHtml(lState.chatSources, cid, { size: 18, platSize: 11 })}</span>
                  <span class="mil-tag num">${cCnt}</span>
                </button>`;
              }).join("");
        }
      }
    }

    function renderMarkdownHtml(rawMd) {
      let text = String(rawMd || "").replace(/\r\n/g, "\n");
      if (text.startsWith("---\n")) {
        const endFm = text.indexOf("\n---\n", 4);
        if (endFm > 0) text = text.slice(endFm + 5);
      }
      const codeBlocks = [];
      text = text.replace(/```([a-zA-Z0-9_-]*)\n([\s\S]*?)```/g, (_, lang, code) => {
        const idx = codeBlocks.length;
        codeBlocks.push(`<pre class="mil-pre"><code>${esc(code.replace(/\n$/, ""))}</code></pre>`);
        return `\x00CODEBLOCK_${idx}\x00`;
      });
      const inlineFmt = (line) => esc(line)
        .replace(/`([^`]+)`/g, "<code>$1</code>")
        .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
      const out = [];
      let inList = "";
      const closeList = () => { if (inList) { out.push(`</${inList}>`); inList = ""; } };
      for (const line of text.split("\n")) {
        const cbMatch = line.match(/^\x00CODEBLOCK_(\d+)\x00$/);
        if (cbMatch) { closeList(); out.push(codeBlocks[Number(cbMatch[1])] || ""); continue; }
        const hMatch = line.match(/^(#{1,4})\s+(.+)$/);
        if (hMatch) { closeList(); const lv = hMatch[1].length; out.push(`<h${lv}>${inlineFmt(hMatch[2])}</h${lv}>`); continue; }
        const ulMatch = line.match(/^\s*[-*]\s+(.+)$/);
        if (ulMatch) { if (inList !== "ul") { closeList(); inList = "ul"; out.push("<ul>"); } out.push(`<li>${inlineFmt(ulMatch[1])}</li>`); continue; }
        const olMatch = line.match(/^\s*\d+\.\s+(.+)$/);
        if (olMatch) { if (inList !== "ol") { closeList(); inList = "ol"; out.push("<ol>"); } out.push(`<li>${inlineFmt(olMatch[1])}</li>`); continue; }
        const bqMatch = line.match(/^>\s?(.*)$/);
        if (bqMatch) { closeList(); out.push(`<blockquote>${inlineFmt(bqMatch[1])}</blockquote>`); continue; }
        if (!line.trim()) { closeList(); continue; }
        closeList();
        out.push(`<p>${inlineFmt(line)}</p>`);
      }
      closeList();
      return `<div class="lib-doc-box lib-md-doc">${out.join("\n") || `<span class="mil-hint">（空白文档）</span>`}</div>`;
    }

    function buildSafeHtmlDocNode(rawHtml) {
      const parser = new DOMParser();
      const doc = parser.parseFromString(String(rawHtml || ""), "text/html");
      const styles = [];
      doc.querySelectorAll("style").forEach((st) => {
        const css = String(st.textContent || "")
          .replace(/@import[^;]+;/gi, "")
          .replace(/url\s*\(\s*(['"]?)(?!data:image\/)[^)]+\1\s*\)/gi, "none")
          .replace(/(^|\})\s*(html|body)\b/gi, "$1 .lib-html-doc");
        if (css.trim()) styles.push(css);
        st.remove();
      });
      doc.querySelectorAll("script, iframe, frame, frameset, object, embed, applet, base, meta, link, form").forEach((el) => el.remove());
      doc.querySelectorAll("img").forEach((img) => {
        const src = String(img.getAttribute("src") || "").trim();
        const alt = String(img.getAttribute("alt") || "图像").trim();
        if (isSafeImageDataUri(src)) {
          const rep = doc.createElement("div");
          rep.className = "lib-inline-pic";
          rep.setAttribute("role", "img");
          rep.setAttribute("aria-label", alt);
          rep.style.backgroundImage = `url("${src}")`;
          img.replaceWith(rep);
        } else {
          img.remove();
        }
      });
      doc.body.querySelectorAll("*").forEach((el) => {
        for (const attr of [...el.attributes]) {
          const an = attr.name.toLowerCase();
          if (an.startsWith("on") || an === "srcdoc") el.removeAttribute(attr.name);
          else if ((an === "href" || an === "src") && /^\s*javascript:/i.test(attr.value)) el.removeAttribute(attr.name);
        }
      });
      const wrap = document.createElement("div");
      wrap.className = "lib-html-doc";
      if (styles.length) {
        const styleEl = document.createElement("style");
        styleEl.textContent = styles.join("\n");
        wrap.appendChild(styleEl);
      }
      if (doc.body.childNodes.length) {
        wrap.append(...doc.body.childNodes);
      } else {
        const empty = document.createElement("span");
        empty.className = "mil-hint";
        empty.textContent = "（网页正文为空）";
        wrap.appendChild(empty);
      }
      return wrap;
    }

    function renderGallery() {
      const box = $("#lib-gallery");
      const cnt = $("#lib-count-tag");
      const hd = $("#lib-heading");
      if (!box) return;
      renderFilterIconsAndCounts();
      if (hd) hd.textContent = FILTER_TITLES[lState.filter] || "全部产物";
      const q = lState.query.trim().toLowerCase();
      const filtered = lState.items.filter((it) => {
        if (lState.chatFilter && it.chat_id !== lState.chatFilter) return false;
        if (!filterMatchesKind(it, lState.filter)) return false;
        if (q && !`${it.title || ""} ${it.name || ""} ${it.chat_id || ""} ${it.profile || ""} ${it.summary || ""} ${it.excerpt || ""}`.toLowerCase().includes(q)) return false;
        return true;
      });
      if (cnt) cnt.textContent = `${filtered.length} 项`;
      const KIND_LABELS = { html: "网页简报", image: "图片", markdown: "文档", text: "文件", conclusion: "结论" };
      box.innerHTML = filtered.length
        ? filtered.map((it, idx) => {
            const safeImg = isSafeImageDataUri(it.data_uri) ? it.data_uri : "";
            const cat = itemCategory(it);
            const ic = iconForArtifact(it, 20);
            const chatBadge = it.chat_id ? window.MaisyaUI.renderChatBadgeHtml(lState.chatSources, it.chat_id, { size: 16, platSize: 11 }) : "";
            const szTxt = fmtBytes(it.size_bytes || it.bytes);
            return `<button type="button" class="lib-card${lState.selectedItem?.id === it.id ? " is-selected" : ""}" data-lib-idx="${idx}">
              ${safeImg ? `<div class="lib-thumb-img" role="img" aria-label="${esc(it.title || it.name)}" style="background-image:url('${esc(safeImg)}')"></div>` : `<div class="now-card-head"><span class="mil-row" style="gap:6px">${ic}<span class="mil-tag">${esc(KIND_LABELS[cat] || "产物")}</span></span>${szTxt ? `<span class="mil-hint num">${esc(szTxt)}</span>` : ""}</div>`}
              <strong style="font-size:13px;overflow-wrap:anywhere">${esc(it.title || it.name || it.path || "未命名产物")}</strong>
              <span class="mil-hint" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">${esc(it.summary || it.excerpt || "点击查看完整内容")}</span>
              <div class="now-card-meta">${chatBadge}${it.profile ? `<span class="mono">· ${esc(it.profile)}</span>` : ""}<span>· ${fmtTime(it.created_at || it.updated || it.at)}</span></div>
            </button>`;
          }).join("")
        : `<div class="mil-hint">当前分类下暂无产物。线程生成报告、图表或结论后会自动汇总到这里。</div>`;
      box._items = filtered;
    }

    function renderArtifactStage() {
      const detail = lState.selectedDetail;
      const stage = $("#lib-stage");
      const viewSeg = $("#lib-view-seg");
      const fitSeg = $("#lib-img-fit-seg");
      if (!detail || !stage) return;

      const cat = itemCategory(detail);
      const uri = detail.data_uri || (detail.base64 && /^image\//i.test(detail.mime || "") ? `data:${detail.mime};base64,${detail.base64}` : "");
      if (isSafeImageDataUri(uri)) {
        if (viewSeg) viewSeg.hidden = true;
        if (fitSeg) {
          fitSeg.hidden = false;
          $$("#lib-img-fit-seg [data-lib-fit]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.libFit === lState.imgFit)));
        }
        lState.copyText = detail.path || detail.title || detail.name || "";
        stage.innerHTML = `<div class="lib-img-stage${lState.imgFit === "wide" ? " is-wide" : ""}" role="img" aria-label="${esc(detail.title || "图像预览")}" style="background-image:url('${esc(uri)}')"></div>`;
        return;
      }

      if (fitSeg) fitSeg.hidden = true;
      const isRichDoc = (cat === "html" || cat === "markdown") && Boolean(detail.text);
      if (viewSeg) {
        viewSeg.hidden = !isRichDoc;
        $$("#lib-view-seg [data-lib-view]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.libView === lState.viewMode)));
      }

      const txt = detail.text || detail.chunk || detail.preview_text || detail.summary || detail.excerpt
        || (detail.base64 ? `二进制文件（${fmtBytes(detail.bytes || detail.total) || "可点击上方下载"}）` : "（暂无可预览文本）");
      lState.copyText = txt;

      const fragments = [];
      if (isRichDoc && lState.viewMode === "preview") {
        if (cat === "html") {
          fragments.push(buildSafeHtmlDocNode(txt));
        } else {
          const mdHolder = document.createElement("div");
          mdHolder.innerHTML = renderMarkdownHtml(txt);
          fragments.push(...mdHolder.childNodes);
        }
      } else {
        const pre = document.createElement("pre");
        pre.className = "mil-pre";
        pre.style.maxHeight = "58vh";
        pre.textContent = txt;
        fragments.push(pre);
      }
      if (Array.isArray(detail.links) && detail.links.length) {
        const linksHolder = document.createElement("div");
        linksHolder.className = "mil-field";
        linksHolder.style.marginTop = "8px";
        linksHolder.innerHTML = `<span class="mil-label">关联出处链接</span><div class="onb-chip-row">${detail.links.map((u) => `<a class="mil-key mil-key--sm mono" href="${esc(u)}" target="_blank" rel="noopener noreferrer">${esc(u.slice(0, 56))}</a>`).join("")}</div>`;
        fragments.push(linksHolder);
      }
      if (detail.next_offset) {
        const moreHolder = document.createElement("div");
        moreHolder.style.marginTop = "8px";
        moreHolder.innerHTML = `<button type="button" class="mil-key mil-key--sm" id="lib-load-more">继续加载剩余内容</button>`;
        fragments.push(moreHolder);
      }
      stage.replaceChildren(...fragments);
    }

    async function openArtifactDrawer(it) {
      if (!it) return;
      lState.selectedItem = it;
      lState.viewMode = "preview";
      $("#lib-shell").classList.add("has-drawer");
      $("#lib-drawer").hidden = false;
      $("#lib-drawer-title").textContent = it.title || it.name || "产物详情";
      const icBox = $("#lib-drawer-ic");
      if (icBox) icBox.innerHTML = iconForArtifact(it, 22);
      const metaEl = $("#lib-drawer-meta");
      if (metaEl) {
        const badge = it.chat_id ? window.MaisyaUI.renderChatBadgeHtml(lState.chatSources, it.chat_id, { size: 16, platSize: 11, showRawId: true }) : "";
        const szTxt = fmtBytes(it.size_bytes || it.bytes);
        const kindTxt = esc(szTxt || it.mime || it.media_kind || it.kind || "");
        metaEl.innerHTML = badge && kindTxt ? `${badge} · <span>${kindTxt}</span>` : (badge || kindTxt);
      }
      const delArtBtn = $("#lib-art-delete");
      if (delArtBtn) delArtBtn.hidden = !Boolean(it.deletable);
      const jumpBtn = $("#lib-jump-chat");
      if (jumpBtn) jumpBtn.hidden = !Boolean(it.thread_id);
      const stage = $("#lib-stage");
      stage.innerHTML = `<div class="mil-hint">正在读取内容…</div>`;

      let detail = { ...it };
      const rawKind = String(it.kind || "");
      const artKind = rawKind === "workspace_out" ? "workspace_file"
        : (rawKind === "attachment" || rawKind === "workspace_file" || rawKind === "conclusion") ? rawKind
        : (it.handle ? "attachment" : (it.workspace_id && it.path) ? "workspace_file" : it.thread_id ? "conclusion" : "");
      if (artKind || it.path || it.workspace_id || it.artifact_id || it.id) {
        const res = await hostRpc("read", "artifact", {
          kind: artKind || undefined,
          handle: it.handle || undefined,
          workspace_id: it.workspace_id || "",
          path: it.path || "",
          thread_id: it.thread_id || undefined,
          artifact_id: it.artifact_id || it.id || "",
          offset: 0,
          chunk_size: 131072,
        });
        if (disposed || sig?.aborted) return;
        if (res?.success) {
          detail = { ...it, ...res };
        } else if (res?.error && !detail.text && !detail.data_uri) {
          stage.innerHTML = `<div class="mil-feedback mil-feedback--err">${esc(res.error)}</div>`;
          renderGallery();
          return;
        }
      }

      lState.selectedDetail = detail;
      renderArtifactStage();

      const uri = detail.data_uri || (detail.base64 && /^image\//i.test(detail.mime || "") ? `data:${detail.mime};base64,${detail.base64}` : "");
      const dl = $("#lib-download");
      if (dl) {
        if (isSafeImageDataUri(uri)) {
          dl.href = uri;
          dl.download = detail.name || detail.filename || "artifact.png";
          dl.hidden = false;
        } else if (detail.base64) {
          dl.href = `data:${detail.mime || "application/octet-stream"};base64,${detail.base64}`;
          dl.download = detail.name || detail.filename || "artifact.bin";
          dl.hidden = false;
        } else if (lState.copyText) {
          const extMime = itemCategory(detail) === "html" ? "text/html" : "text/plain";
          dl.href = `data:${extMime};charset=utf-8,${encodeURIComponent(lState.copyText)}`;
          dl.download = detail.name || (itemCategory(detail) === "html" ? "report.html" : "artifact.txt");
          dl.hidden = false;
        } else dl.hidden = true;
      }
      renderGallery();
    }

    async function loadLibrary() {
      const res = await hostRpc("read", "library", { query: lState.query || undefined });
      if (disposed || sig?.aborted) return;
      if (!res?.success) { sayLib(res?.error || "产物加载失败", true); return; }
      lState.items = res.items || res.artifacts || [];
      lState.chatSources = res.chat_sources || {};
      renderGallery();
      if (pendingLibraryTarget) {
        const tid = pendingLibraryTarget.id;
        const target = lState.items.find((x) => x.handle === tid || x.id === tid || x.id === `att:${tid}` || x.path === tid || x.artifact_id === tid);
        pendingLibraryTarget = null;
        if (target) openArtifactDrawer(target);
      }
    }

    const view = $("#ms-mgmt-view");
    view.addEventListener("click", async (ev) => {
      if (ev.target.closest("#lib-refresh")) { loadLibrary(); return; }
      const flt = ev.target.closest("[data-lib-filter]");
      if (flt) {
        lState.filter = flt.dataset.libFilter;
        $$("[data-lib-filter]").forEach((b) => b.setAttribute("aria-pressed", String(b === flt)));
        renderGallery();
        return;
      }
      const chatBtn = ev.target.closest("[data-lib-chat]");
      if (chatBtn) {
        lState.chatFilter = chatBtn.dataset.libChat || "";
        renderGallery();
        return;
      }
      const viewBtn = ev.target.closest("#lib-view-seg [data-lib-view]");
      if (viewBtn) {
        lState.viewMode = viewBtn.dataset.libView;
        renderArtifactStage();
        return;
      }
      const fitBtn = ev.target.closest("#lib-img-fit-seg [data-lib-fit]");
      if (fitBtn) {
        lState.imgFit = fitBtn.dataset.libFit;
        renderArtifactStage();
        return;
      }
      if (ev.target.closest("#lib-load-more") && lState.selectedDetail?.next_offset) {
        const cur = lState.selectedDetail;
        const res = await hostRpc("read", "artifact", {
          kind: cur.kind === "workspace_out" ? "workspace_file" : cur.kind,
          handle: cur.handle || undefined,
          workspace_id: cur.workspace_id || "",
          path: cur.path || "",
          thread_id: cur.thread_id || undefined,
          offset: cur.next_offset,
          chunk_size: 131072,
        });
        if (res?.success) {
          lState.selectedDetail = {
            ...cur,
            text: (cur.text || "") + (res.text || ""),
            next_offset: res.next_offset ?? null,
          };
          renderArtifactStage();
        }
        return;
      }
      const card = ev.target.closest("[data-lib-idx]");
      if (card) {
        openArtifactDrawer($("#lib-gallery")?._items?.[Number(card.dataset.libIdx)]);
        return;
      }
      if (ev.target.closest("#lib-drawer-close")) {
        $("#lib-drawer").hidden = true;
        $("#lib-shell").classList.remove("has-drawer");
        lState.selectedItem = null;
        lState.selectedDetail = null;
        renderGallery();
        return;
      }
      if (ev.target.closest("#lib-jump-chat") && lState.selectedItem?.thread_id) {
        state.thFilter = "all";
        state.thChat = "";
        state.thQuery = "";
        if ($("#now-thread-search")) $("#now-thread-search").value = "";
        if ($("#now-thread-chat")) $("#now-thread-chat").value = "";
        $$("#now-thread-filters [data-th-filter]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.thFilter === "all")));
        state.threadId = lState.selectedItem.thread_id;
        switchWorkspaceTab("now");
        return;
      }
      if (ev.target.closest("#lib-copy")) {
        try { await navigator.clipboard?.writeText?.(lState.copyText || ""); sayLib("已复制产物内容"); } catch (_) {}
        return;
      }
    }, { signal: sig });

    view.addEventListener("input", (ev) => {
      if (ev.target.id === "lib-search") { lState.query = ev.target.value || ""; renderGallery(); }
    }, { signal: sig });

    window.addEventListener("maisya:themechange", () => {
      if (disposed || sig?.aborted || activePage !== "library") return;
      renderGallery();
      if (lState.selectedDetail && !$("#lib-drawer")?.hidden) renderArtifactStage();
    }, { signal: sig });

    loadLibrary();
  }

  /* ───────────── 设置页（已启用会话 + 候选选择器 + 结构化输入 + 双源管理员 + 安全存储） ───────────── */
  async function bootSettingsTab(sig) {
    const sState = {
      data: null,
      version: null,
      enabledChats: [],
      knownChats: [],
      chatSources: {},
      recentDms: [],
      hostAdmins: [],
      pluginAdmins: [],
      grants: [],
      vaultMeta: [],
      models: [],
      pickerOpen: false,
      candQuery: "",
      candSourcesLoaded: false,
      modelQuery: "",
      pendingModel: "",
      dirtyInputs: new Set(),
      initLoadPromise: null,
      saveChain: Promise.resolve(),
    };

    const saySet = (txt, err = false) => {
      const el = $("#set-feedback");
      if (el) { el.textContent = txt || ""; el.className = `mil-feedback${!txt ? "" : err ? " mil-feedback--err" : " mil-feedback--ok"}`; }
    };
    const sayAdminErr = (txt) => {
      const el = $("#set-admin-err");
      if (el) el.textContent = txt || "";
    };

    function syncPlatSelectOptions(selId) {
      const sel = document.getElementById(selId);
      if (!sel) return;
      const cur = sel.value || "qq";
      const plats = window.MaisyaUI.collectPlatformOptions(sState.chatSources);
      sel.innerHTML = plats.map((p) => `<option value="${esc(p)}"${p === cur ? " selected" : ""}>${esc(window.MaisyaUI.PLAT_LABELS[p] || p)}</option>`).join("");
    }

    function renderChatCandidates() {
      const listEl = $("#set-chat-cand-list");
      const openBtn = $("#set-open-chat-picker");
      const pickerEl = $("#set-chat-picker");
      const enabledSet = new Set(sState.enabledChats);
      const candChats = sState.knownChats.filter((c) => !enabledSet.has(c));
      if (openBtn) {
        openBtn.textContent = sState.pickerOpen ? "收起候选列表" : `+ 添加聊天流${candChats.length ? ` (${candChats.length})` : ""}`;
      }
      if (pickerEl) pickerEl.hidden = !sState.pickerOpen;
      if (!listEl) return;
      const q = sState.candQuery.trim().toLowerCase();
      const filtered = candChats.filter((cid) => {
        if (!q) return true;
        const m = window.MaisyaUI.resolveChatMeta(sState.chatSources, cid);
        return `${m.name} ${m.rawId} ${cid}`.toLowerCase().includes(q);
      });
      listEl.innerHTML = filtered.length
        ? filtered.slice(0, 80).map((cid) => `<div class="ms-stream-row">
            <div class="ms-stream-info">${window.MaisyaUI.renderChatBadgeHtml(sState.chatSources, cid, { size: 20, platSize: 12, showType: true, showRawId: true })}</div>
            <button type="button" class="mil-key mil-key--sm" data-set-add-chat="${esc(cid)}">添加</button>
          </div>`).join("")
        : `<div class="mil-hint">${candChats.length ? "没有匹配的候选聊天流" : "已知会话均已加入白名单，可在下方手动添加"}</div>`;
    }

    function renderChats() {
      const set = sState.data?.settings || sState.data || {};
      const plgOn = Boolean(
        sState.data?.plugin_enabled
        ?? sState.data?.plugin?.enabled
        ?? set.plugin_enabled
        ?? set.plugin?.enabled
        ?? sState.data?.pulse?.enabled
      );
      const plgEl = $("#set-plugin-enabled");
      const plgTxt = $("#set-plugin-enabled-txt");
      if (plgEl) plgEl.checked = plgOn;
      if (plgTxt) plgTxt.textContent = plgOn ? "已启用（总开关开启）" : "未启用（暂停所有调度与注入）";
      const cntLbl = $("#set-chat-count-label");
      if (cntLbl) cntLbl.textContent = `已开启会话（${sState.enabledChats.length} 个）`;
      syncPlatSelectOptions("set-chat-plat");

      const box = $("#set-chat-list");
      if (box) {
        box.innerHTML = sState.enabledChats.length
          ? sState.enabledChats.map((cid) => `<div class="ms-stream-row" data-chat-row="${esc(cid)}">
              <div class="ms-stream-info">${window.MaisyaUI.renderChatBadgeHtml(sState.chatSources, cid, { size: 22, platSize: 13, showType: true, showRawId: true })}</div>
              <button type="button" class="mil-key mil-key--sm mil-key--danger" data-set-del-chat="${esc(cid)}">移除</button>
            </div>`).join("")
          : `<div class="mil-hint">暂未开启群聊或额外私聊，点击「+ 添加聊天流」或下方手动添加。</div>`;
      }
      renderChatCandidates();
    }

    function renderAdmins() {
      syncPlatSelectOptions("set-adm-plat");
      const hBox = $("#set-host-admins");
      const pBox = $("#set-plugin-admins");
      const dmWrap = $("#set-recent-dms-wrap");
      const dmBox = $("#set-recent-dms");
      const ic = window.MaisyaIcons;
      if (hBox) {
        hBox.innerHTML = sState.hostAdmins.length
          ? sState.hostAdmins.map((a) => `<span class="mil-tag mil-tag--ok mono">${esc(a)} · 宿主只读</span>`).join("")
          : `<span class="mil-hint">无宿主预设管理员</span>`;
      }
      if (pBox) {
        const closeIc = ic?.ctrl ? ic.ctrl("close", 12, 2) : "×";
        pBox.innerHTML = sState.pluginAdmins.length
          ? sState.pluginAdmins.map((a) => `<button type="button" class="mil-key mil-key--sm mono" data-set-del-admin="${esc(a)}"><span>${esc(a)}</span><span class="mil-inline-ic">${closeIc}</span></button>`).join("")
          : `<span class="mil-hint">未配置插件内管理员</span>`;
      }
      if (dmWrap && dmBox) {
        dmWrap.hidden = !sState.recentDms.length;
        dmBox.innerHTML = sState.recentDms.map((d) => {
          const dmSpec = d.chat_id || (d.platform && d.user_id ? `${d.platform}:private:${d.user_id}` : String(d.user_id || d));
          const dmMeta = window.MaisyaUI.resolveChatMeta(sState.chatSources, typeof d === "object" ? { ...d, chat_id: dmSpec } : dmSpec);
          const platSvg = ic?.platform ? ic.platform(dmMeta.platform, 12) : "";
          return `<button type="button" class="ms-dm-chip" data-set-add-dm="${esc(dmSpec)}" title="${esc(dmSpec)}">
            ${window.MaisyaUI.renderChatAvatarHtml(dmMeta, 18)}
            ${platSvg ? `<span class="ms-chat-plat">${platSvg}</span>` : ""}
            <span class="ms-chat-name">${esc(dmMeta.name)}</span>
            ${dmMeta.rawId && dmMeta.rawId !== dmMeta.name ? `<span class="ms-chat-rawid">${esc(dmMeta.rawId)}</span>` : ""}
          </button>`;
        }).join("");
      }
    }

    function renderGrants() {
      const box = $("#set-grants-list");
      if (!box) return;
      box.innerHTML = sState.grants.length
        ? sState.grants.map((g) => `<div class="ms-entry-row">
            <div class="ms-entry-meta">
              <strong class="ms-entry-title">${esc(g.action_key || g.grant_key)}</strong>
              <span class="ms-entry-code">${esc(g.scope || "")} · ${esc(g.tier || g.kind || "always")}</span>
            </div>
            <button type="button" class="mil-key mil-key--sm mil-key--danger" data-revoke-grant="${esc(g.grant_key)}" data-revoke-scope="${esc(g.scope || "")}" data-revoke-act="${esc(g.action_key || "")}">撤销</button>
          </div>`).join("")
        : `<div class="mil-hint">暂无长期记住或会话级授权记录</div>`;
    }

    function renderVault() {
      const box = $("#set-vault-list");
      if (!box) return;
      box.innerHTML = sState.vaultMeta.length
        ? sState.vaultMeta.map((v) => `<div class="ms-entry-row">
            <div class="ms-entry-meta">
              <strong class="ms-entry-title mono">${esc(v.handle)}</strong>
              <span class="ms-entry-code">保存日期：${esc(fmtDateTime(v.updated_at))}</span>
            </div>
            <div class="mil-row" style="gap:6px">
              <button type="button" class="mil-key mil-key--sm" data-vault-inspect="${esc(v.handle)}">查看</button>
              <button type="button" class="mil-key mil-key--sm mil-key--danger" data-vault-del="${esc(v.handle)}">删除</button>
            </div>
          </div>`).join("")
        : `<div class="mil-hint">密码保险箱为空，可在下方保存「别名 + 密码」。</div>`;
    }

    function syncSetModelDisplay(modelName) {
      const models = window.MaisyaUI.normalizeModelCatalog(sState.models, modelName ? [modelName] : []);
      const curName = String(modelName || models[0]?.name || "utils");
      const curObj = models.find((m) => m.name === curName) || { name: curName, provider: "", visual: false };
      const hiddenIn = $("#set-default-model");
      const lbl = $("#set-model-label");
      const prov = $("#set-model-provider");
      const vis = $("#set-model-visual");
      const chev = $("#set-model-chev");
      const searchIc = $("#set-model-search-ic");
      const listEl = $("#set-model-list");
      const ic = window.MaisyaIcons;
      if (hiddenIn) hiddenIn.value = curName;
      if (lbl) lbl.textContent = curName;
      if (prov) prov.textContent = curObj.provider || "";
      if (vis) vis.hidden = !curObj.visual;
      if (chev && ic?.ctrl) chev.innerHTML = ic.ctrl("chevron_d", 14, 1.9);
      if (searchIc && ic?.ctrl) searchIc.innerHTML = ic.ctrl("search", 14, 1.9);
      if (listEl) {
        listEl.innerHTML = window.MaisyaUI.renderModelGroupsHtml(models, {
          selectedNames: curName ? [curName] : [],
          query: sState.modelQuery,
        });
      }
    }

    function formatHeartbeatEffective(mode, hbHasPlan) {
      if (mode === "off") return "关闭 · 不发起后台探索与久违想念（事后惦记不受影响）";
      if (mode === "lively") {
        return hbHasPlan ? "想念 + 逛逛 · 约每 90 分钟 · 24 小时静默想念" : "只会想念（未填逛逛方向） · 约每 90 分钟 · 24 小时静默想念";
      }
      return hbHasPlan ? "想念 + 逛逛 · 约每 180 分钟 · 72 小时静默想念" : "只会想念（未填逛逛方向） · 约每 180 分钟 · 72 小时静默想念";
    }

    function renderSandboxHint(enabled) {
      const hint = $("#set-sandbox-hint");
      if (!hint) return;
      const docker = sState.data?.docker || {};
      if (!enabled) {
        hint.hidden = true;
        hint.textContent = "";
        return;
      }
      const err = String(docker.error || "").trim();
      hint.hidden = false;
      hint.classList.toggle("mil-hint--warn", Boolean(err) || docker.ready === false);
      hint.textContent = err
        ? `沙箱未就绪：${err}`
        : docker.ready === false
          ? "已开启，但尚未探测到可用的本机 Docker"
          : "沙箱已就绪";
    }

    function renderRuntime() {
      const set = sState.data?.settings || sState.data || {};
      const targetModel = sState.pendingModel || set.default_model || sState.data?.default_model || $("#set-default-model")?.value || sState.models[0]?.name || "utils";
      syncSetModelDisplay(targetModel);
      $("#set-perm-mode").value = sState.data?.permission_mode || set.permission_mode || "ask_risky";
      const hbMode = String(set.heartbeat_mode || sState.data?.heartbeat_mode || (set.heartbeat_enabled ? "gentle" : "off"));
      const hbHasPlan = Boolean(sState.data?.heartbeat_has_plan);
      $$("#set-hb-mode-seg [data-hb-mode]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.hbMode === hbMode)));
      if ($("#set-hb-effective-txt")) {
        $("#set-hb-effective-txt").textContent = formatHeartbeatEffective(hbMode, hbHasPlan);
      }
      const hbIntVal = Number(set.heartbeat_interval_minutes ?? 0);
      const longingVal = Number(set.longing_quiet_hours ?? 0);
      if (!sState.dirtyInputs.has("set-hb-interval") && $("#set-hb-interval")) {
        $("#set-hb-interval").value = String(hbIntVal);
      }
      if (!sState.dirtyInputs.has("set-longing") && $("#set-longing")) {
        $("#set-longing").value = String(longingVal);
      }
      if ((hbIntVal > 0 || longingVal > 0) && $("#set-hb-adv")) {
        $("#set-hb-adv").open = true;
      }
      if (!sState.dirtyInputs.has("set-daily-limit")) {
        $("#set-daily-limit").value = String(set.daily_proactive_limit ?? set.pulse?.daily_proactive_limit ?? 3);
      }
      if (!sState.dirtyInputs.has("set-per-chat-limit") && $("#set-per-chat-limit")) {
        $("#set-per-chat-limit").value = String(set.per_chat_daily_proactive_limit ?? 1);
      }
      const sw = String(set.sleep_window || set.pulse?.sleep_window || "23:30-08:00");
      const parts = sw.split(/[-~]/);
      if (!sState.dirtyInputs.has("set-sleep-start")) {
        $("#set-sleep-start").value = (parts[0] || "23:30").trim();
      }
      if (!sState.dirtyInputs.has("set-sleep-end")) {
        $("#set-sleep-end").value = (parts[1] || "08:00").trim();
      }
      const sbOn = Boolean(sState.data?.docker?.enabled ?? sState.data?.sandbox_enabled ?? set.sandbox_enabled ?? set.sandbox?.enabled);
      $("#set-sandbox-enabled").checked = sbOn;
      $("#set-sandbox-txt").textContent = sbOn ? "已启用" : "未启用";
      renderSandboxHint(sbOn);
      const curTheme = normalizeThemePref(sState.data?.ui_style || set.ui_style || savedUiStyle);
      $$("#set-theme-seg [data-theme-choice]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.themeChoice === curTheme)));
    }

    async function loadSettings() {
      const res = await hostRpc("read", "settings", {});
      if (disposed || sig?.aborted) return;
      if (!res?.success) { saySet(res?.error || "设置读取失败", true); return; }
      sState.data = res;
      if (sState.pendingModel) {
        sState.data.default_model = sState.pendingModel;
        if (sState.data.settings) sState.data.settings.default_model = sState.pendingModel;
      }
      sState.version = res.version ?? null;
      const set = res.settings || res;
      sState.enabledChats = [...(set.enabled_chats || res.enabled_chats || [])];
      const nextSources = { ...(res.chat_sources || {}) };
      const rawKnown = Array.isArray(res.known_chats) && res.known_chats.length
        ? res.known_chats
        : (Array.isArray(res.known_chat_specs) && res.known_chat_specs.length ? res.known_chat_specs : sState.enabledChats);
      sState.knownChats = [...new Set(rawKnown
        .map((c) => {
          if (typeof c === "string") return c;
          const spec = c?.stream_spec || c?.chat_id || "";
          if (spec && c && typeof c === "object" && !nextSources[spec]) nextSources[spec] = c;
          return spec;
        })
        .filter(Boolean))];
      sState.chatSources = nextSources;
      sState.recentDms = Array.isArray(res.recent_dms) ? res.recent_dms : [];
      const ai = res.admins_info || {};
      sState.hostAdmins = [...(ai.host_admins || [])];
      sState.pluginAdmins = [...(ai.plugin_admins || ai.settings_admins || set.admins || [])];
      sState.grants = [...(res.grants || [])];
      sState.vaultMeta = [...(res.vault_meta || [])];
      const rawModels = (Array.isArray(res.model_catalog) && res.model_catalog.length) ? res.model_catalog : (res.available_models || []);
      sState.models = window.MaisyaUI.normalizeModelCatalog(rawModels, set.default_model ? [set.default_model] : []);
      renderChats();
      renderAdmins();
      renderGrants();
      renderVault();
      renderRuntime();
      if (res.update && window.MaisyaUpdateBar?.render) window.MaisyaUpdateBar.render(res.update);
    }

    function savePartialSettings(patch, adminErrSlot = false) {
      if (adminErrSlot) sayAdminErr("");
      saySet("正在保存…");
      const run = async () => {
        if (sState.version === null && sState.initLoadPromise) {
          try { await sState.initLoadPromise; } catch (_) {}
        }
        let res = await hostRpc("write", "settings_update", { settings: patch, expected_version: sState.version });
        if (!disposed && !sig?.aborted && !res?.success && String(res?.error || "").includes("设置已变化")) {
          const fresh = await hostRpc("read", "settings", {});
          if (!disposed && !sig?.aborted && fresh?.success && fresh.version != null) {
            sState.version = fresh.version;
            res = await hostRpc("write", "settings_update", { settings: patch, expected_version: sState.version });
          }
        }
        if (disposed || sig?.aborted) return res;
        if (!res?.success) {
          const msg = res?.error || "配置保存失败";
          if (adminErrSlot) sayAdminErr(msg);
          else saySet(msg, true);
          return res;
        }
        sayAdminErr("");
        sState.version = res.version ?? sState.version;
        const prevSet = sState.data?.settings || {};
        const nextSet = { ...prevSet, ...patch, ...(res.settings || {}) };
        sState.data = {
          ...(sState.data || {}),
          ...res,
          default_model: nextSet.default_model ?? sState.data?.default_model ?? "",
          permission_mode: nextSet.permission_mode ?? res.permission_mode ?? sState.data?.permission_mode,
          settings: nextSet,
        };
        saySet("设置已保存");
        return res;
      };
      const p = sState.saveChain.then(run, run);
      sState.saveChain = p.catch(() => {});
      return p;
    }

    const view = $("#ms-mgmt-view");
    view.addEventListener("click", async (ev) => {
      if (ev.target.closest("#set-open-chat-picker")) {
        sState.pickerOpen = !sState.pickerOpen;
        renderChatCandidates();
        if (sState.pickerOpen) {
          $("#set-chat-cand-search")?.focus();
          const enabledSet = new Set(sState.enabledChats);
          const missing = sState.knownChats
            .filter((cid) => !enabledSet.has(cid) && !(sState.chatSources[cid]?.avatar_data))
            .slice(0, 40);
          if (missing.length && !sState.candSourcesLoaded) {
            sState.candSourcesLoaded = true;
            const r = await hostRpc("read", "chat_sources", { chat_ids: missing });
            if (!disposed && !sig?.aborted && r?.success && r.sources) {
              sState.chatSources = { ...sState.chatSources, ...r.sources };
              renderChatCandidates();
            }
          }
        }
        return;
      }
      const addChatBtn = ev.target.closest("[data-set-add-chat]");
      if (addChatBtn) {
        const val = addChatBtn.dataset.setAddChat;
        if (!val) return;
        const next = [...new Set([...sState.enabledChats, val])];
        const r = await savePartialSettings({ enabled_chats: next });
        if (r?.success) await loadSettings();
        return;
      }
      const delChatBtn = ev.target.closest("[data-set-del-chat]");
      if (delChatBtn) {
        const val = delChatBtn.dataset.setDelChat;
        const next = sState.enabledChats.filter((c) => c !== val);
        const r = await savePartialSettings({ enabled_chats: next });
        if (r?.success) await loadSettings();
        return;
      }
      if (ev.target.closest("#set-chat-add")) {
        const built = window.MaisyaUI.readStructStreamBuilder("set-chat");
        if (!built.rawId || !built.spec) { saySet("请填写要添加的群号或用户 ID", true); return; }
        if (sState.version === null && sState.initLoadPromise) {
          try { await sState.initLoadPromise; } catch (_) {}
        }
        const next = [...new Set([...sState.enabledChats, built.spec])];
        const r = await savePartialSettings({ enabled_chats: next });
        if (r?.success) {
          if (built.inputEl) built.inputEl.value = "";
          await loadSettings();
        }
        return;
      }
      const addDmBtn = ev.target.closest("[data-set-add-dm]");
      if (addDmBtn) {
        const val = addDmBtn.dataset.setAddDm;
        if (!val) return;
        const next = [...new Set([...sState.pluginAdmins, val])];
        const r = await savePartialSettings({ admins: next }, true);
        if (r?.success) await loadSettings();
        return;
      }
      if (ev.target.closest("#set-admin-add")) {
        const built = window.MaisyaUI.readStructStreamBuilder("set-adm");
        if (!built.rawId || !built.spec) { sayAdminErr("请先填写管理员用户 ID"); return; }
        if (sState.version === null && sState.initLoadPromise) {
          try { await sState.initLoadPromise; } catch (_) {}
        }
        const next = [...new Set([...sState.pluginAdmins, built.spec])];
        const r = await savePartialSettings({ admins: next }, true);
        if (r?.success) {
          if (built.inputEl) built.inputEl.value = "";
          await loadSettings();
        }
        return;
      }
      const delAdm = ev.target.closest("[data-set-del-admin]");
      if (delAdm) {
        const target = delAdm.dataset.setDelAdmin;
        const next = sState.pluginAdmins.filter((a) => a !== target);
        if (!next.length && !sState.hostAdmins.length) {
          sayAdminErr("至少保留一位有效管理员，防止失去控制权限（防自锁死）");
          return;
        }
        const r = await savePartialSettings({ admins: next }, true);
        if (r?.success) await loadSettings();
        return;
      }
      if (ev.target.closest("#set-model-trigger")) {
        const drop = $("#set-model-drop");
        const trig = $("#set-model-trigger");
        if (drop && trig) {
          const open = Boolean(drop.hidden);
          drop.hidden = !open;
          trig.setAttribute("aria-expanded", String(open));
          if (open) $("#set-model-search")?.focus();
        }
        return;
      }
      const pickSetModel = ev.target.closest("#set-model-list [data-pick-model]");
      if (pickSetModel) {
        const chosen = pickSetModel.dataset.pickModel || "";
        if (chosen) {
          const prevModel = sState.data?.settings?.default_model || sState.data?.default_model || "";
          sState.pendingModel = chosen;
          if (sState.data) {
            sState.data.default_model = chosen;
            if (sState.data.settings) sState.data.settings.default_model = chosen;
          }
          syncSetModelDisplay(chosen);
          const drop = $("#set-model-drop");
          if (drop) drop.hidden = true;
          $("#set-model-trigger")?.setAttribute("aria-expanded", "false");
          const r = await savePartialSettings({ default_model: chosen });
          if (sState.pendingModel === chosen) sState.pendingModel = "";
          if (!r?.success) {
            if (sState.data) {
              sState.data.default_model = prevModel;
              if (sState.data.settings) sState.data.settings.default_model = prevModel;
            }
            await loadSettings();
          }
        }
        return;
      }
      if (!$("#set-model-drop")?.hidden && !ev.target.closest("#set-model-box")) {
        $("#set-model-drop").hidden = true;
        $("#set-model-trigger")?.setAttribute("aria-expanded", "false");
      }
      if (ev.target.closest("#set-reopen-onb")) {
        const r = await hostRpc("write", "onboarding_reopen", {});
        openOnboardingModal(r?.onboarding || r);
        return;
      }
      const revBtn = ev.target.closest("[data-revoke-grant]");
      if (revBtn) {
        const grantKey = revBtn.dataset.revokeGrant || undefined;
        const grantScope = revBtn.dataset.revokeScope || undefined;
        const grantAct = revBtn.dataset.revokeAct || undefined;
        const grantTitle = revBtn.closest(".ms-entry-row")?.querySelector(".ms-entry-title")?.textContent?.trim() || grantAct || grantKey || "该条授权";
        const ok = await window.MaisyaUI.confirmDanger({
          tag: "撤销授权",
          title: `撤销运行授权「${grantTitle}」？`,
          body: `撤销后相关动作${grantScope ? `（作用域 ${grantScope}）` : ""}将重新弹出权限审批。`,
          confirmText: "确认撤销",
        });
        if (!ok || disposed || sig?.aborted) return;
        const r = await hostRpc("write", "grant_revoke", {
          grant_key: grantKey,
          scope: grantScope,
          action_key: grantAct,
        });
        if (!r?.success) saySet(r?.error || "撤销授权失败", true);
        else { saySet("已撤销授权"); await loadSettings(); }
        return;
      }
      const vInspect = ev.target.closest("[data-vault-inspect]");
      if (vInspect) {
        const handle = vInspect.dataset.vaultInspect;
        const r = await hostRpc("read", "vault_item", { handle });
        if (!r?.success) { saySet(r?.error || "读取密码条目失败", true); return; }
        const detBox = $("#set-vault-detail");
        if (detBox) {
          detBox.innerHTML = `<div class="mil-row" style="justify-content:space-between;align-items:center">
            <strong>密码别名：<span class="mono">${esc(r.handle)}</span></strong>
            <button type="button" class="mil-key mil-key--sm" id="set-vault-detail-close">收起</button>
          </div>
          <div class="mil-hint">保存日期：${esc(fmtDateTime(r.updated_at))}</div>
          <div class="mil-hint">需要用到该密码时，在聊天中跟 MaiBot 提到别名「${esc(r.handle)}」即可；此处不显示密码内容。</div>`;
          detBox.hidden = false;
        }
        return;
      }
      if (ev.target.closest("#set-vault-detail-close")) {
        const detBox = $("#set-vault-detail");
        if (detBox) detBox.hidden = true;
        return;
      }
      if (ev.target.closest("#set-vault-eye")) {
        const secIn = $("#set-vault-secret");
        const eyeBtn = $("#set-vault-eye");
        if (secIn && eyeBtn) {
          const showing = secIn.type === "text";
          secIn.type = showing ? "password" : "text";
          eyeBtn.setAttribute("aria-pressed", String(!showing));
          eyeBtn.textContent = showing ? "显示" : "隐藏";
        }
        return;
      }
      const vDel = ev.target.closest("[data-vault-del]");
      if (vDel) {
        const targetHandle = vDel.dataset.vaultDel;
        const ok = await window.MaisyaUI.confirmDanger({
          tag: "销毁凭据",
          title: `删除密码别名「${targetHandle}」？`,
          body: `将从密码保险箱永久销毁「${targetHandle}」及其密文，引用该别名的外部服务或沙箱命令将无法再挂载。`,
          confirmText: "确认删除",
        });
        if (!ok || disposed || sig?.aborted) return;
        const r = await hostRpc("write", "vault_delete", { handle: targetHandle });
        if (!r?.success) saySet(r?.error || "删除密码失败", true);
        else {
          const detBox = $("#set-vault-detail");
          if (detBox) detBox.hidden = true;
          saySet(`已删除密码别名 ${targetHandle}`);
          await loadSettings();
        }
        return;
      }
      if (ev.target.closest("#set-goto-heartbeat")) {
        switchWorkspaceTab("heartbeat");
        return;
      }
      const hbModeBtn = ev.target.closest("#set-hb-mode-seg [data-hb-mode]");
      if (hbModeBtn) {
        const hbMode = hbModeBtn.dataset.hbMode || "off";
        const hbHasPlan = Boolean(sState.data?.heartbeat_has_plan);
        $$("#set-hb-mode-seg [data-hb-mode]").forEach((b) => b.setAttribute("aria-pressed", String(b === hbModeBtn)));
        if ($("#set-hb-effective-txt")) {
          $("#set-hb-effective-txt").textContent = formatHeartbeatEffective(hbMode, hbHasPlan);
        }
        const r = await savePartialSettings({ heartbeat_mode: hbMode });
        if (r?.success) await loadSettings();
        return;
      }
      if (ev.target.closest("#set-save-runtime")) {
        sState.dirtyInputs.clear();
        const swStart = ($("#set-sleep-start")?.value || "23:30").trim();
        const swEnd = ($("#set-sleep-end")?.value || "08:00").trim();
        const rawDaily = $("#set-daily-limit")?.value;
        const limit = Math.max(0, Math.min(50, Math.round(Number(rawDaily === "" || rawDaily == null ? 3 : rawDaily))));
        const rawPerChat = $("#set-per-chat-limit")?.value;
        const perChatLimit = Math.max(0, Math.min(10, Math.round(Number(rawPerChat === "" || rawPerChat == null ? 1 : rawPerChat))));
        const sbOn = Boolean($("#set-sandbox-enabled")?.checked);
        const hbMode = $("#set-hb-mode-seg [data-hb-mode][aria-pressed='true']")?.dataset.hbMode || "off";
        const rawHbInt = $("#set-hb-interval")?.value;
        const hbInt = Math.max(0, Math.min(1440, Math.round(Number(rawHbInt === "" || rawHbInt == null ? 0 : rawHbInt))));
        const rawLonging = $("#set-longing")?.value;
        const longingHours = Math.max(0, Math.min(720, Math.round(Number(rawLonging === "" || rawLonging == null ? 0 : rawLonging))));
        await savePartialSettings({
          default_model: $("#set-default-model")?.value || "",
          heartbeat_mode: hbMode,
          heartbeat_interval_minutes: hbInt,
          longing_quiet_hours: longingHours,
          daily_proactive_limit: limit,
          per_chat_daily_proactive_limit: perChatLimit,
          sleep_window: `${swStart}-${swEnd}`,
          sandbox_enabled: sbOn,
          sandbox: { enabled: sbOn },
        });
        await loadSettings();
        return;
      }
      const themeChoice = ev.target.closest("[data-theme-choice]");
      if (themeChoice) {
        const nextT = themeChoice.dataset.themeChoice;
        $$("#set-theme-seg [data-theme-choice]").forEach((b) => b.setAttribute("aria-pressed", String(b === themeChoice)));
        await setUiStylePreference(nextT);
        return;
      }
      if (ev.target.closest("#set-btn-doctor")) {
        const btn = $("#set-btn-doctor");
        const sumEl = $("#set-doctor-summary");
        const listEl = $("#set-doctor-results");
        if (btn) btn.disabled = true;
        if (sumEl) sumEl.textContent = "正在运行 6 项系统体检…";
        const r = await hostRpc("read", "doctor", {});
        if (btn) btn.disabled = false;
        if (disposed || sig?.aborted) return;
        if (!r?.success) {
          if (sumEl) sumEl.textContent = r?.error || "系统体检失败";
          saySet(r?.error || "系统体检失败", true);
          return;
        }
        if (sumEl) sumEl.textContent = r.summary || "体检完成";
        const tagMap = {
          ok: ["mil-tag--ok", "正常"],
          info: ["", "提示"],
          warn: ["mil-tag--warn", "建议关注"],
          error: ["mil-tag--err", "异常"],
        };
        const items = Array.isArray(r.checks) ? r.checks : [];
        if (listEl) {
          listEl.hidden = items.length === 0;
          listEl.innerHTML = items.map((c) => {
            const [cls, lbl] = tagMap[c.status] || ["", c.status || "状态"];
            const fixLine = c.fix ? `<span class="mil-hint" style="white-space:normal">建议：${esc(c.fix)}</span>` : "";
            return `<div class="ms-entry-row" style="align-items:flex-start;gap:10px">
              <div class="ms-entry-meta" style="min-width:0;flex:1 1 auto">
                <strong class="ms-entry-title">${esc(c.title || c.id)}</strong>
                <span class="ms-entry-code" style="white-space:normal">${esc(c.summary || "")}</span>
                ${fixLine}
              </div>
              <span class="mil-tag ${cls}" style="flex-shrink:0">${esc(lbl)}</span>
            </div>`;
          }).join("");
        }
        return;
      }
    }, { signal: sig });

    view.addEventListener("submit", async (ev) => {
      if (ev.target.id !== "set-vault-form") return;
      ev.preventDefault();
      const handle = ($("#set-vault-handle")?.value || "").trim();
      const secIn = $("#set-vault-secret");
      const raw = secIn?.value || "";
      if (!handle || !raw.trim()) { saySet("请填写密码别名与密码内容", true); return; }
      const r = await hostRpc("write", "vault_set", { handle, value: raw.trim() });
      if (secIn) {
        secIn.value = "";
        secIn.type = "password";
      }
      const eyeBtn = $("#set-vault-eye");
      if (eyeBtn) {
        eyeBtn.setAttribute("aria-pressed", "false");
        eyeBtn.textContent = "显示";
      }
      if (!r?.success) { saySet(r?.error || "密码保存失败", true); return; }
      if ($("#set-vault-handle")) $("#set-vault-handle").value = "";
      saySet(`已保存密码别名 ${handle}（密码内容已清空）`);
      await loadSettings();
    }, { signal: sig });

    view.addEventListener("change", async (ev) => {
      if (ev.target.id === "set-plugin-enabled") {
        let plgOn = Boolean(ev.target.checked);
        if (sState.version === null && sState.initLoadPromise) {
          try { await sState.initLoadPromise; } catch (_) {}
          const curSet = sState.data?.settings || sState.data || {};
          const wasOn = Boolean(
            sState.data?.plugin_enabled
            ?? sState.data?.plugin?.enabled
            ?? curSet.plugin_enabled
            ?? curSet.plugin?.enabled
            ?? sState.data?.pulse?.enabled
          );
          plgOn = !wasOn;
          ev.target.checked = plgOn;
        }
        const plgTxt = $("#set-plugin-enabled-txt");
        if (plgTxt) plgTxt.textContent = plgOn ? "已启用（总开关开启）" : "未启用（暂停所有调度与注入）";
        const r = await savePartialSettings({ plugin_enabled: plgOn, plugin: { enabled: plgOn } });
        if (r?.success) await loadSettings();
        else renderChats();
      } else if (ev.target.id === "set-perm-mode") {
        await savePartialSettings({ permission_mode: ev.target.value });
      } else if (ev.target.id === "set-sandbox-enabled") {
        let sbOn = Boolean(ev.target.checked);
        if (sState.version === null && sState.initLoadPromise) {
          try { await sState.initLoadPromise; } catch (_) {}
          const curSet = sState.data?.settings || sState.data || {};
          const wasSb = Boolean(
            sState.data?.sandbox_enabled
            ?? sState.data?.sandbox?.enabled
            ?? curSet.sandbox_enabled
            ?? curSet.sandbox?.enabled
          );
          sbOn = !wasSb;
          ev.target.checked = sbOn;
        }
        if ($("#set-sandbox-txt")) $("#set-sandbox-txt").textContent = sbOn ? "已启用" : "未启用";
        const r = await savePartialSettings({ sandbox_enabled: sbOn, sandbox: { enabled: sbOn } });
        if (r?.success) await loadSettings();
        else {
          ev.target.checked = !sbOn;
          if ($("#set-sandbox-txt")) $("#set-sandbox-txt").textContent = !sbOn ? "已启用" : "未启用";
        }
      }
    }, { signal: sig });

    view.addEventListener("input", (ev) => {
      if (["set-daily-limit", "set-per-chat-limit", "set-sleep-start", "set-sleep-end", "set-hb-interval", "set-longing"].includes(ev.target.id)) {
        sState.dirtyInputs.add(ev.target.id);
      } else if (ev.target.id === "set-chat-cand-search") {
        sState.candQuery = ev.target.value || "";
        renderChatCandidates();
      } else if (ev.target.id === "set-model-search") {
        sState.modelQuery = ev.target.value || "";
        const curVal = $("#set-default-model")?.value || "";
        const models = window.MaisyaUI.normalizeModelCatalog(sState.models, curVal ? [curVal] : []);
        const listEl = $("#set-model-list");
        if (listEl) {
          listEl.innerHTML = window.MaisyaUI.renderModelGroupsHtml(models, {
            selectedNames: curVal ? [curVal] : [],
            query: sState.modelQuery,
          });
        }
      }
    }, { signal: sig });

    view.addEventListener("keydown", (ev) => {
      if (ev.key === "Enter" && ["set-daily-limit", "set-per-chat-limit", "set-sleep-start", "set-sleep-end", "set-hb-interval", "set-longing"].includes(ev.target.id)) {
        ev.preventDefault();
        $("#set-save-runtime")?.click();
      }
    }, { signal: sig });

    document.addEventListener("keydown", (ev) => {
      if (ev.key === "Escape" && activePage === "settings") {
        if (window.MaisyaUI?.isConfirmOpen?.() || ev.target?.closest?.("#ms-confirm-dialog")) return;
        const mDrop = $("#set-model-drop");
        if (mDrop && !mDrop.hidden) {
          mDrop.hidden = true;
          $("#set-model-trigger")?.setAttribute("aria-expanded", "false");
          $("#set-model-trigger")?.focus();
        }
      }
    }, { signal: sig });

    window.addEventListener("maisya:themechange", (ev) => {
      if (disposed || sig?.aborted || activePage !== "settings") return;
      const t = ev.detail?.theme || normalizeThemePref(manualUiStyle || savedUiStyle);
      $$("#set-theme-seg [data-theme-choice]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.themeChoice === t)));
      renderChats();
      renderAdmins();
      renderRuntime();
    }, { signal: sig });

    window.addEventListener("maisya:ui-style-saved", (ev) => {
      if (disposed || sig?.aborted || activePage !== "settings") return;
      const nextStyle = ev?.detail?.uiStyle;
      if (ev?.detail?.version != null) sState.version = ev.detail.version;
      if (nextStyle && sState.data) {
        sState.data.ui_style = nextStyle;
        if (sState.data.settings) sState.data.settings.ui_style = nextStyle;
      }
      if (nextStyle) {
        $$("#set-theme-seg [data-theme-choice]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.themeChoice === nextStyle)));
      }
    }, { signal: sig });

    sState.initLoadPromise = loadSettings();
  }
  /* ==MGMT_BOOT_END== */
</script>
