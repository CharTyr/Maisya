<!doctype html>
<html lang="zh-CN" data-ui-style="millennium" data-dashboard-style="millennium">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Maisya · {{TITLE}}</title>
<style>
{{MILLENNIUM_CSS}}

/* ==MGMT_CSS_START== */
/* ───────────── 管理页专用交互样式 ───────────── */
.ab-roster {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: 360px;
  overflow-y: auto;
}

.ab-card {
  width: 100%;
  text-align: left;
  padding: 11px 13px;
  border: 1px solid var(--mil-line);
  border-radius: 12px;
  background: var(--mil-panel);
  color: var(--mil-ink);
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 5px;
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
  transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1), box-shadow 140ms ease;
}
.ab-card:active {
  transform: scale(0.99);
}
@media (hover: hover) and (pointer: fine) {
  .ab-card:not([aria-current="true"]):hover {
    border-color: var(--mil-lo);
    background: var(--mil-key-hi);
  }
}
.ab-card[aria-current="true"] {
  background: var(--mil-accent-soft);
  border-color: var(--mil-accent);
  color: var(--mil-ink);
  box-shadow: 0 0 0 1px var(--mil-accent-border);
}
.ab-desc {
  font-size: 12.5px;
  line-height: 1.45;
  color: var(--mil-muted);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  overflow-wrap: anywhere;
}
.ab-card[aria-current="true"] .ab-desc {
  color: var(--mil-ink-2);
}

.ab-layout {
  display: grid;
  grid-template-columns: minmax(260px, 300px) minmax(0, 1fr);
  gap: 20px;
  align-items: start;
}
.ab-sidebar {
  display: flex;
  flex-direction: column;
  gap: 18px;
  min-width: 0;
}
.ab-stage {
  display: flex;
  flex-direction: column;
  gap: 18px;
  min-width: 0;
}
.ab-nav-list {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.ab-nav-item {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 13px;
  border: 1px solid transparent;
  border-radius: 10px;
  background: transparent;
  color: var(--mil-ink-2);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
}
@media (hover: hover) and (pointer: fine) {
  .ab-nav-item:not([aria-current="true"]):hover {
    background: var(--mil-screen);
    color: var(--mil-ink);
  }
}
.ab-nav-item[aria-current="true"] {
  background: var(--mil-on);
  border-color: var(--mil-on);
  border-radius: 999px;
  color: var(--mil-on-ink);
}
.ab-nav-item[aria-current="true"] .mil-tag {
  background: rgba(255, 255, 255, 0.18);
  color: var(--mil-on-ink);
  border-color: transparent;
}
:root.dark .ab-nav-item[aria-current="true"] .mil-tag {
  background: rgba(17, 17, 20, 0.14);
}
:root[data-ui-style="millennium"] .ab-nav-item {
  border-radius: 0;
  border: 2px solid transparent;
}
:root[data-ui-style="millennium"] .ab-nav-item[aria-current="true"] {
  background: var(--mil-on);
  border-color: var(--mil-line);
  border-radius: 0;
  color: var(--mil-on-ink);
  box-shadow: var(--mil-key-on-shadow);
}
:root[data-ui-style="millennium"] .ab-card {
  border-radius: 0;
  border: 2px solid var(--mil-line);
  background: var(--mil-panel-hi, var(--mil-panel));
  box-shadow: var(--mil-keycap);
}
:root[data-ui-style="millennium"] .ab-card[aria-current="true"] {
  background: var(--mil-on);
  color: var(--mil-on-ink);
  box-shadow: var(--mil-key-on-shadow);
}
:root[data-ui-style="millennium"] .ab-card[aria-current="true"] .ab-desc,
:root[data-ui-style="millennium"] .ab-card[aria-current="true"] .mil-hint {
  color: var(--mil-on-ink);
  opacity: 0.85;
}

.sk-gallery-head {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
  padding-bottom: 14px;
  margin-bottom: 16px;
  border-bottom: 1px solid var(--mil-rule);
}
.sk-gallery-title {
  font-family: var(--mil-font-display);
  font-size: 20px;
  font-weight: 800;
  line-height: 1.25;
}
.sk-gallery-tools {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  min-width: 0;
}
.sk-add-drawer {
  margin-bottom: 16px;
}
.ab-dropzone {
  padding: 14px;
  border: 1.5px dashed var(--mil-lo);
  border-radius: 12px;
  background: var(--mil-panel);
}
.ab-dropzone[data-drag="true"],
#skills-gallery-panel[data-drag="true"] {
  outline: 2px dashed var(--mil-accent);
  outline-offset: -4px;
}
.sk-gallery-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  min-height: 180px;
}
.sk-item-card {
  width: 100%;
  text-align: left;
  padding: 15px 16px;
  border: 1px solid var(--mil-line);
  border-radius: 14px;
  background: var(--mil-panel);
  color: var(--mil-ink);
  cursor: pointer;
  display: grid;
  grid-template-columns: 40px minmax(0, 1fr);
  gap: 12px;
  align-items: start;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
  transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1), box-shadow 140ms ease;
}
.sk-item-card:active {
  transform: scale(0.99);
}
@media (hover: hover) and (pointer: fine) {
  .sk-item-card:hover {
    border-color: var(--mil-accent-border);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
  }
}
.sk-item-card[aria-current="true"] {
  background: var(--mil-accent-soft);
  border-color: var(--mil-accent);
  color: var(--mil-ink);
}
.sk-item-ico {
  width: 40px;
  height: 40px;
  border: 1px solid var(--mil-rule);
  border-radius: 10px;
  background: var(--mil-screen);
  display: grid;
  place-items: center;
  font-family: var(--mil-font-mono);
  font-size: 11.5px;
  font-weight: 700;
}
.sk-item-ico--preset {
  background: var(--mil-accent-soft);
  color: var(--mil-accent);
  border-color: var(--mil-accent-border);
}
:root[data-ui-style="millennium"] .sk-item-card {
  border-radius: 0;
  border: 2px solid var(--mil-line);
  background: var(--mil-panel-hi, var(--mil-panel));
  box-shadow: var(--mil-keycap);
}
:root[data-ui-style="millennium"] .sk-item-card[aria-current="true"] {
  background: var(--mil-on);
  border-color: var(--mil-line);
  color: var(--mil-on-ink);
  box-shadow: var(--mil-key-on-shadow);
}
:root[data-ui-style="millennium"] .sk-item-card[aria-current="true"] .sk-item-desc {
  color: var(--mil-on-ink);
  opacity: 0.86;
}
:root[data-ui-style="millennium"] .sk-item-ico {
  border-radius: 0;
  border: 2px solid var(--mil-line);
}
.sk-item-ico--custom {
  background: var(--mil-warn-soft);
  color: var(--mil-warn-ink);
  border-color: rgba(217, 119, 6, 0.25);
}
.sk-item-body {
  display: flex;
  flex-direction: column;
  gap: 5px;
  min-width: 0;
}
.sk-item-desc {
  font-size: 12.5px;
  line-height: 1.5;
  color: var(--mil-muted);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  overflow-wrap: anywhere;
}

@media (max-width: 960px) {
  .ab-layout {
    grid-template-columns: minmax(0, 1fr);
  }
}
@media (max-width: 720px) {
  .sk-gallery-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}

.set-list {
  display: flex;
  flex-direction: column;
}
.set-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 14px 4px;
  border-bottom: 1px solid var(--mil-rule);
  background: transparent;
}
.set-row:first-child {
  padding-top: 4px;
}
.set-row:last-child {
  border-bottom: 0;
  padding-bottom: 4px;
}
.set-row-l {
  flex: 1 1 260px;
  min-width: 0;
}
.set-row-t {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-weight: 600;
  font-size: 14px;
  color: var(--mil-ink);
}
.set-row-d {
  font-size: 12.5px;
  line-height: 1.5;
  color: var(--mil-muted);
  margin-top: 2px;
  overflow-wrap: anywhere;
}
.set-row-r {
  flex: 0 1 360px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  min-width: 0;
}
.set-row--wide {
  align-items: flex-start;
}
.set-row--wide .set-row-l {
  flex: 0 1 210px;
  padding-top: 6px;
}
.set-row--wide .set-row-r {
  flex: 1 1 520px;
  justify-content: flex-start;
}

.exp-card {
  padding: 10px 12px;
  border-bottom: 1px solid var(--mil-rule);
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.exp-card:last-child {
  border-bottom: 0;
}

.ws-split {
  display: grid;
  grid-template-columns: minmax(200px, 280px) minmax(0, 1fr);
  gap: 14px;
  align-items: start;
}

@media (max-width: 900px) {
  .ws-split {
    grid-template-columns: minmax(0, 1fr);
  }
}

.cfg-model-panel {
  padding: 12px 14px;
  border-top: 1px solid var(--mil-rule);
  border-bottom: 1px solid var(--mil-rule);
  display: flex;
  flex-direction: column;
  gap: 10px;
}
:root[data-ui-style="millennium"] .cfg-model-panel {
  border: 2px solid var(--mil-line);
  background: var(--mil-panel);
}
.cfg-model-chain {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.cfg-model-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 8px 10px;
  border-radius: 10px;
  background: var(--mil-panel);
  border: 1px solid var(--mil-rule);
  min-width: 0;
  transition: background-color 140ms cubic-bezier(0.2, 0.8, 0.2, 1), border-color 140ms cubic-bezier(0.2, 0.8, 0.2, 1);
}
:root[data-ui-style="millennium"] .cfg-model-item {
  border-radius: 0;
  border: 2px solid var(--mil-line);
  background: var(--mil-screen);
}
.cfg-model-item--primary {
  border-color: var(--mil-accent-border);
  background: var(--mil-accent-soft);
}
:root[data-ui-style="millennium"] .cfg-model-item--primary {
  border-color: var(--mil-on-side);
  background: var(--mil-on);
  color: var(--mil-on-ink);
}
.cfg-model-main {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
  flex: 1;
  flex-wrap: wrap;
}
.cfg-model-rank {
  font-family: var(--mil-font-mono);
  font-size: 11px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  padding: 2px 7px;
  border-radius: 999px;
  background: var(--mil-screen);
  border: 1px solid var(--mil-rule);
}
:root[data-ui-style="millennium"] .cfg-model-rank {
  border-radius: 0;
  border: 1px solid var(--mil-line);
  background: var(--mil-panel);
}
.cfg-model-controls {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 8px;
  align-items: center;
}
.cfg-model-manual {
  display: flex;
  gap: 6px;
  min-width: 0;
}
.cfg-model-manual .mil-input {
  flex: 1;
  min-width: 0;
}
.cfg-host-models {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
}
@media (max-width: 720px) {
  .cfg-model-controls {
    grid-template-columns: minmax(0, 1fr);
  }
}

/* ───────────── 产物页（统一资料空间）专用样式 ───────────── */
.out-space {
  display: grid;
  grid-template-columns: 248px minmax(0, 1fr);
  gap: 20px;
  align-items: start;
}
.out-rail {
  position: sticky;
  top: 76px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.out-nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.out-nav-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 8px 10px;
  border: 1px solid transparent;
  border-radius: 10px;
  background: transparent;
  color: var(--mil-ink);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  text-align: left;
  transition: background-color 140ms cubic-bezier(0.2, 0.8, 0.2, 1), border-color 140ms cubic-bezier(0.2, 0.8, 0.2, 1);
}
.out-nav-btn:hover {
  background: var(--mil-screen);
}
.out-nav-btn[aria-current="page"] {
  background: var(--mil-accent-soft);
  color: var(--mil-ink);
  font-weight: 700;
  border-color: var(--mil-accent-border);
}
:root[data-ui-style="millennium"] .out-nav-btn {
  border-radius: 0;
  border-width: 1.5px;
}
:root[data-ui-style="millennium"] .out-nav-btn[aria-current="page"] {
  background: var(--mil-on);
  color: var(--mil-on-ink);
  border-color: var(--mil-on-side);
  box-shadow: 0 2px 0 var(--mil-on-side);
}
.out-nav-l {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  min-width: 0;
}
.out-nav-cnt {
  font-size: 11.5px;
  color: var(--mil-muted);
  font-variant-numeric: tabular-nums;
}
:root[data-ui-style="millennium"] .out-nav-btn[aria-current="page"] .out-nav-cnt {
  color: var(--mil-on-ink);
  opacity: 0.88;
}
.out-ico {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}
.out-ico--all { color: #475569; }
.out-ico--page { color: #0f766e; }
.out-ico--img { color: #c2410c; }
.out-ico--doc { color: #0369a1; }
.out-ico--con { color: #15803d; }
.out-ico--ws { color: #854d0e; }
html.dark .out-ico--all { color: #94a3b8; }
html.dark .out-ico--page { color: #5eead4; }
html.dark .out-ico--img { color: #fdba74; }
html.dark .out-ico--doc { color: #7dd3fc; }
html.dark .out-ico--con { color: #86efac; }
html.dark .out-ico--ws { color: #fde047; }

.out-rail-sec {
  padding-top: 12px;
  border-top: 1px solid var(--mil-rule);
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.out-rail-cap {
  font-size: 11.5px;
  font-weight: 700;
  color: var(--mil-muted);
  letter-spacing: 0.04em;
  margin-bottom: 4px;
}
.out-recent-list {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.out-recent-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 8px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: var(--mil-ink-2);
  font-size: 12px;
  cursor: pointer;
  text-align: left;
  min-width: 0;
  transition: background-color 120ms cubic-bezier(0.2, 0.8, 0.2, 1);
}
.out-recent-item:hover {
  background: var(--mil-screen);
  color: var(--mil-ink);
}
:root[data-ui-style="millennium"] .out-recent-item {
  border-radius: 0;
}
.out-recent-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.out-main {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 0;
}
.out-top {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}
.out-top-l {
  display: flex;
  align-items: baseline;
  gap: 10px;
  min-width: 0;
}
.out-space-title {
  margin: 0;
  font-family: var(--mil-font-display);
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -0.02em;
}
.out-top-r {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  min-width: 0;
}
.out-search-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
  min-width: 0;
}
.out-search-wrap .mil-input {
  width: 220px;
  max-width: 100%;
}
.out-filter-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 8px 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--mil-rule);
}

.out-table-head {
  display: grid;
  grid-template-columns: minmax(0, 2.2fr) minmax(0, 1.3fr) 76px 96px;
  gap: 12px;
  padding: 10px 10px 8px;
  font-size: 11.5px;
  font-weight: 700;
  color: var(--mil-muted);
  border-bottom: 1px solid var(--mil-rule);
}
.out-table {
  display: flex;
  flex-direction: column;
  max-height: 430px;
  overflow-y: auto;
}
.out-row {
  width: 100%;
  display: grid;
  grid-template-columns: minmax(0, 2.2fr) minmax(0, 1.3fr) 76px 96px;
  gap: 12px;
  align-items: center;
  padding: 11px 10px;
  border: 0;
  border-bottom: 1px solid var(--mil-rule);
  background: transparent;
  color: var(--mil-ink);
  text-align: left;
  cursor: pointer;
  font-size: 13px;
  transition: background-color 120ms cubic-bezier(0.2, 0.8, 0.2, 1);
}
.out-row:last-child {
  border-bottom: 0;
}
.out-row:hover {
  background: var(--mil-screen);
}
.out-row[aria-current="true"] {
  background: var(--mil-accent-soft);
}
:root[data-ui-style="millennium"] .out-row[aria-current="true"] {
  background: var(--mil-on);
  color: var(--mil-on-ink);
}
.out-row-name {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}
.out-row-titles {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.out-row-titles strong {
  font-size: 13px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.out-row-sub {
  font-size: 11.5px;
  color: var(--mil-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
:root[data-ui-style="millennium"] .out-row[aria-current="true"] .out-row-sub,
:root[data-ui-style="millennium"] .out-row[aria-current="true"] .out-row-meta {
  color: var(--mil-on-ink);
  opacity: 0.88;
}
.out-row-src {
  display: flex;
  align-items: center;
  gap: 6px;
  min-width: 0;
  font-size: 12px;
  color: var(--mil-ink-2);
}
.out-row-meta {
  font-size: 12px;
  color: var(--mil-muted);
  text-align: right;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.out-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 12px;
  padding-top: 12px;
  max-height: 460px;
  overflow-y: auto;
}
.out-grid-card {
  border: 1px solid var(--mil-line);
  border-radius: 12px;
  padding: 12px;
  background: var(--mil-panel);
  color: var(--mil-ink);
  text-align: left;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 0;
  transition: transform 120ms cubic-bezier(0.2, 0.8, 0.2, 1), border-color 120ms cubic-bezier(0.2, 0.8, 0.2, 1), background-color 120ms ease;
}
.out-grid-card:hover {
  background: var(--mil-screen);
}
.out-grid-card[aria-current="true"] {
  border-color: var(--mil-accent);
  background: var(--mil-accent-soft);
}
:root[data-ui-style="millennium"] .out-grid-card {
  border: 2px solid var(--mil-line);
  border-radius: 0;
  box-shadow: 0 3px 0 var(--mil-lo);
}
:root[data-ui-style="millennium"] .out-grid-card[aria-current="true"] {
  background: var(--mil-on);
  color: var(--mil-on-ink);
  border-color: var(--mil-on-side);
}

:root[data-ui-style="millennium"] .out-stage,
:root[data-ui-style="millennium"] .out-img-stage,
:root[data-ui-style="millennium"] .out-html-sandbox,
:root[data-ui-style="millennium"] .ab-dropzone {
  border-radius: 0;
  border: 2px solid var(--mil-line);
}

.out-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  margin-bottom: 12px;
  font-size: 12.5px;
}

.out-stage {
  min-height: 240px;
  max-height: 74vh;
  overflow: auto;
  padding: 20px 22px;
  background: var(--mil-panel);
  border: 1px solid var(--mil-line);
  border-radius: 12px;
}

.out-img-stage {
  width: 100%;
  min-height: 300px;
  height: 380px;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  border: 1px solid var(--mil-rule);
  border-radius: 12px;
  background-color: var(--mil-screen);
}

.out-img-stage--wide {
  max-width: 820px;
  min-height: 240px;
  height: auto;
  margin: 0 auto;
  background-size: 100% auto;
  background-position: top center;
}

.out-html-sandbox {
  position: relative;
  isolation: isolate;
  overflow-x: auto;
  border: 1px solid var(--mil-rule);
  border-radius: 10px;
  max-width: 100%;
  padding: 16px;
}

.out-doc {
  font-size: 14.5px;
  line-height: 1.75;
  overflow-wrap: anywhere;
}
.out-doc h1, .out-doc h2, .out-doc h3, .out-doc h4 {
  margin: 0 0 10px;
  padding-bottom: 6px;
  border-bottom: 1px solid var(--mil-rule);
  font-family: var(--mil-font-display);
  font-weight: 700;
}
.out-doc p, .out-doc ul, .out-doc ol, .out-doc blockquote, .out-doc pre {
  margin: 0 0 12px;
}
.out-doc ul, .out-doc ol {
  padding-left: 22px;
}
.out-doc blockquote {
  padding: 10px 14px;
  border-left: 3px solid var(--mil-accent);
  border-radius: 0 8px 8px 0;
  background: var(--mil-screen);
}
.out-doc table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 12px;
  font-size: 13px;
}
.out-doc th, .out-doc td {
  border: 1px solid var(--mil-line);
  padding: 6px 10px;
  text-align: left;
}
.out-doc th {
  background: var(--mil-screen);
}

.out-link-item {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 8px 10px;
  border-bottom: 1px solid var(--mil-rule);
  font-size: 12.5px;
}
.out-link-item:last-child {
  border-bottom: 0;
}

@media (max-width: 960px) {
  .out-space {
    grid-template-columns: minmax(0, 1fr);
  }
  .out-rail {
    position: static;
  }
}

@media (max-width: 720px) {
  .set-row-r {
    flex: 1 1 100%;
    justify-content: flex-start;
  }
  .out-search-wrap .mil-input {
    width: 100%;
    flex: 1;
  }
  .out-table-head {
    display: none;
  }
  .out-row {
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 10px;
  }
  .out-row-src {
    grid-column: 1 / 2;
  }
  .out-row-size {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ab-card,
  .sk-item-card,
  .out-nav-btn,
  .out-recent-item,
  .out-row,
  .out-grid-card,
  .cfg-model-item {
    transition: none;
  }
}
  /* ── v2.6 管理四页双主题与移动端自适应样式（仅作用域于 #ms-mgmt-view） ── */
#ms-mgmt-view,
#ms-mgmt-view *,
#ms-mgmt-view *::before,
#ms-mgmt-view *::after {
  box-sizing: border-box;
}
#ms-mgmt-view {
  min-width: 0;
  max-width: 100%;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
#ms-mgmt-view .m-mob-only,
#ms-mgmt-view .m-ab-mob-head {
  display: none;
}
#ms-mgmt-view .m-rail-kicker,
#ms-mgmt-view .m-sub-kicker {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.04em;
  color: var(--mil-muted);
  margin-bottom: 6px;
}
#ms-mgmt-view .m-sub-kicker {
  margin-top: 10px;
}
#ms-mgmt-view .m-rail-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
#ms-mgmt-view .m-rail-nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
#ms-mgmt-view .m-rail-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  width: 100%;
  padding: 8px 10px;
  border: 1px solid transparent;
  border-radius: 10px;
  background: transparent;
  color: var(--mil-ink);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  text-align: left;
  transition: background-color 140ms ease, border-color 140ms ease, color 140ms ease;
}
#ms-mgmt-view .m-rail-btn:hover {
  background: var(--mil-well);
}
#ms-mgmt-view .m-rail-btn.is-active,
#ms-mgmt-view .m-rail-btn[aria-pressed="true"] {
  background: var(--mil-accent-soft);
  border-color: var(--mil-accent-border);
  font-weight: 700;
}
:root[data-ui-style="millennium"] #ms-mgmt-view .m-rail-btn {
  border-radius: 0;
  border: 2px solid transparent;
}
:root[data-ui-style="millennium"] #ms-mgmt-view .m-rail-btn.is-active,
:root[data-ui-style="millennium"] #ms-mgmt-view .m-rail-btn[aria-pressed="true"] {
  background: var(--mil-on);
  color: var(--mil-on-ink);
  border-color: var(--mil-line);
}
#ms-mgmt-view .m-rail-ic,
#ms-mgmt-view .m-head-ic,
#ms-mgmt-view .m-tab-ic,
#ms-mgmt-view .m-mob-row-ic,
#ms-mgmt-view .m-mob-row-arr {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  line-height: 0;
}
#ms-mgmt-view .m-rail-lbl {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
#ms-mgmt-view .m-rail-cnt {
  font-size: 11px;
  padding: 1px 6px;
  border-radius: 999px;
  background: var(--mil-well);
  color: var(--mil-muted);
}
:root[data-ui-style="millennium"] #ms-mgmt-view .m-rail-cnt {
  border-radius: 0;
}
#ms-mgmt-view .m-seg-group,
#ms-mgmt-view .m-inline-row {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
  min-width: 0;
}
#ms-mgmt-view .m-inline-row > .mil-input,
#ms-mgmt-view .m-inline-row > .mil-select {
  flex: 1 1 140px;
  min-width: 0;
}
#ms-mgmt-view .m-search-box {
  display: flex;
  align-items: center;
  gap: 6px;
  min-width: 0;
  flex: 1 1 180px;
}
#ms-mgmt-view .m-search-box .mil-input {
  flex: 1 1 auto;
  min-width: 0;
}
#ms-mgmt-view .m-form-row {
  display: flex;
  flex-direction: column;
  gap: 5px;
  min-width: 0;
}
#ms-mgmt-view .ms-field-label {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 700;
  color: var(--mil-ink-2);
}
#ms-mgmt-view .m-cfg-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 10px;
  min-width: 0;
}
#ms-mgmt-view .m-check-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
#ms-mgmt-view .m-check-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 10px;
  border: 1px solid var(--mil-line);
  border-radius: 10px;
  background: var(--mil-screen);
  font-size: 12.5px;
  font-weight: 600;
  cursor: pointer;
}
:root[data-ui-style="millennium"] #ms-mgmt-view .m-check-pill {
  border-radius: 0;
  border: 2px solid var(--mil-line);
}
#ms-mgmt-view .m-card-stack {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 0;
}
#ms-mgmt-view .m-empty {
  padding: 24px 14px;
  text-align: center;
  font-size: 13px;
  color: var(--mil-muted);
}
#ms-mgmt-view .m-copy-drawer {
  margin-top: 10px;
  padding: 10px;
  border: 1px solid var(--mil-line);
  border-radius: 10px;
  background: var(--mil-screen);
  display: flex;
  flex-direction: column;
  gap: 6px;
}
:root[data-ui-style="millennium"] #ms-mgmt-view .m-copy-drawer {
  border-radius: 0;
  border: 2px solid var(--mil-line);
}
#ms-mgmt-view .m-copy-drawer-h {
  font-size: 12px;
  font-weight: 700;
  color: var(--mil-muted);
}
#ms-mgmt-view .m-adv-details {
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
#ms-mgmt-view .m-details-sum {
  cursor: pointer;
  font-size: 12.5px;
  font-weight: 700;
  color: var(--mil-ink);
}
#ms-mgmt-view .m-ver-select {
  width: auto;
  min-width: 112px;
}

/* ── 产物页：三栏工作空间 ── */
#ms-mgmt-view .m-out-shell {
  display: grid;
  grid-template-columns: 230px minmax(300px, 0.92fr) minmax(350px, 1.08fr);
  gap: 14px;
  align-items: start;
  min-width: 0;
}
#ms-mgmt-view .m-out-shell.is-ws-mode {
  grid-template-columns: 230px minmax(0, 1fr);
}
#ms-mgmt-view .m-out-aside,
#ms-mgmt-view .m-out-main,
#ms-mgmt-view .m-out-catalog,
#ms-mgmt-view .m-out-inspector,
#ms-mgmt-view .m-out-ws-panel {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
#ms-mgmt-view .m-out-toolbar {
  flex-wrap: wrap;
}
#ms-mgmt-view .m-filter-bar {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
#ms-mgmt-view .out-filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
#ms-mgmt-view .m-out-meta {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
#ms-mgmt-view .m-out-stage {
  min-height: 240px;
  min-width: 0;
}
#ms-mgmt-view .m-out-foot {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  padding-top: 8px;
  border-top: 1px solid var(--mil-line);
}
#ms-mgmt-view .m-ws-split {
  display: grid;
  grid-template-columns: minmax(200px, 0.44fr) minmax(0, 0.56fr);
  gap: 12px;
}
#ms-mgmt-view .m-ws-col {
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 0;
}
#ms-mgmt-view .m-ws-col-h {
  font-size: 12px;
  font-weight: 700;
  color: var(--mil-muted);
}
#ms-mgmt-view .m-ws-pre {
  padding: 12px;
  max-height: 420px;
  overflow: auto;
  font-size: 12px;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

/* ── 手账页：三栏分册工作室 ── */
#ms-mgmt-view .m-mem-shell {
  display: grid;
  grid-template-columns: 248px minmax(340px, 1.15fr) minmax(290px, 0.85fr);
  gap: 14px;
  align-items: start;
  min-width: 0;
}
#ms-mgmt-view .m-mem-aside,
#ms-mgmt-view .m-mem-editor,
#ms-mgmt-view .m-mem-side {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
#ms-mgmt-view .m-mem-guide-card {
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
#ms-mgmt-view .m-mem-guide-title {
  font-size: 13px;
  font-weight: 800;
  color: var(--mil-ink);
}
#ms-mgmt-view .m-mem-guide-desc {
  margin: 0;
  font-size: 12px;
  line-height: 1.55;
  color: var(--mil-muted);
}
#ms-mgmt-view .m-meter-head {
  display: flex;
  justify-content: space-between;
  font-size: 11.5px;
  color: var(--mil-muted);
  margin-bottom: 4px;
}
#ms-mgmt-view .m-quota-box {
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
#ms-mgmt-view .m-quota-main {
  font-size: 13px;
  font-weight: 700;
}
#ms-mgmt-view .m-mem-textarea {
  min-height: 420px;
  width: 100%;
  resize: vertical;
  line-height: 1.6;
}
#ms-mgmt-view .m-mem-search {
  margin-bottom: 8px;
}

/* ── 能力页：顶部切换、技能库、有序模型链与移动端裸鱼轮播 ── */
#ms-mgmt-view .m-ab-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
}
#ms-mgmt-view .m-ab-tabs {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
#ms-mgmt-view .m-ab-tabs .mil-key {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
#ms-mgmt-view .m-ab-skills,
#ms-mgmt-view .m-ab-discovery,
#ms-mgmt-view .m-ab-package {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
#ms-mgmt-view .m-add-drawer {
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
#ms-mgmt-view .m-drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
#ms-mgmt-view .m-drawer-grid,
#ms-mgmt-view .m-rcp-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}
#ms-mgmt-view .m-drawer-card,
#ms-mgmt-view .m-rcp-card {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 12px;
  min-width: 0;
}
#ms-mgmt-view .m-skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 10px;
}
#ms-mgmt-view .m-ab-studio {
  display: grid;
  grid-template-columns: 270px minmax(0, 1fr);
  gap: 14px;
  align-items: start;
  min-width: 0;
}
#ms-mgmt-view .m-ab-roster,
#ms-mgmt-view .m-ab-editor {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
#ms-mgmt-view .m-ab-stage {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
#ms-mgmt-view .m-ab-roster[hidden],
#ms-mgmt-view .m-ab-editor[hidden],
#ms-mgmt-view .m-ab-skills[hidden],
#ms-mgmt-view .m-ab-package[hidden],
#ms-mgmt-view .m-ab-discovery[hidden] {
  display: none;
}
#ms-mgmt-view .m-profile-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
#ms-mgmt-view .m-roster-actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding-top: 8px;
  border-top: 1px solid var(--mil-line);
}
#ms-mgmt-view .m-roster-btn-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}
#ms-mgmt-view .m-doc-tabs {
  display: inline-flex;
  gap: 6px;
  flex-wrap: wrap;
}
#ms-mgmt-view .m-visual-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
#ms-mgmt-view .m-companions-split {
  display: grid;
  grid-template-columns: minmax(170px, 0.36fr) minmax(0, 0.64fr);
  gap: 10px;
}
#ms-mgmt-view .m-companion-pre {
  padding: 10px;
  max-height: 260px;
  overflow: auto;
  font-size: 12px;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
#ms-mgmt-view .m-model-box {
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
#ms-mgmt-view .m-model-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  flex-wrap: wrap;
}
#ms-mgmt-view .m-model-chain {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
#ms-mgmt-view .m-model-row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px 10px;
  border: 1px solid var(--mil-line);
  border-radius: 10px;
  background: var(--mil-panel);
  min-width: 0;
}
:root[data-ui-style="millennium"] #ms-mgmt-view .m-model-row {
  border-radius: 0;
  border: 2px solid var(--mil-line);
}
#ms-mgmt-view .m-model-grip {
  display: inline-flex;
  align-items: center;
  color: var(--mil-muted);
  flex: 0 0 auto;
}
#ms-mgmt-view .m-model-rank {
  font-size: 11px;
  font-weight: 800;
  padding: 2px 7px;
  border-radius: 999px;
  background: var(--mil-well);
  color: var(--mil-ink-2);
  flex: 0 0 auto;
}
#ms-mgmt-view .m-model-row.is-primary .m-model-rank {
  background: var(--mil-on);
  color: var(--mil-on-ink);
}
:root[data-ui-style="millennium"] #ms-mgmt-view .m-model-rank {
  border-radius: 0;
}
#ms-mgmt-view .m-model-name {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 12.5px;
  font-weight: 700;
  overflow-wrap: anywhere;
}
#ms-mgmt-view .m-model-acts {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  flex: 0 0 auto;
}
#ms-mgmt-view .m-model-add-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 10px;
}
#ms-mgmt-view .m-ab-textarea {
  width: 100%;
  min-height: 260px;
  resize: vertical;
}

/* ── 移动端裸鱼轮播（两套主题下均无方框/圆框背景，选中居大彩鱼，两侧缩小去色） ── */
#ms-mgmt-view .m-mob-carousel-wrap {
  position: relative;
  padding: 4px 0 8px;
}
#ms-mgmt-view .m-mob-carousel {
  display: flex;
  align-items: flex-end;
  gap: 6px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  padding: 6px 42px 8px;
}
#ms-mgmt-view .m-mob-carousel::-webkit-scrollbar {
  display: none;
}
#ms-mgmt-view .mob-role-item {
  scroll-snap-align: center;
  flex: 0 0 auto;
  min-width: 78px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 4px 6px;
  border: 0 !important;
  border-radius: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  color: var(--mil-ink);
  cursor: pointer;
  transition: transform 160ms ease, opacity 160ms ease;
}
#ms-mgmt-view .mob-role-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0 !important;
  border-radius: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  padding: 0 !important;
  transition: transform 160ms ease, filter 160ms ease, opacity 160ms ease;
}
#ms-mgmt-view .mob-role-item:not(.is-active) .mob-role-avatar {
  transform: scale(0.84);
  filter: grayscale(0.8);
  opacity: 0.58;
}
#ms-mgmt-view .mob-role-item.is-active .mob-role-avatar {
  transform: scale(1.06);
  filter: none;
  opacity: 1;
}
#ms-mgmt-view .mob-role-name {
  font-size: 12px;
  font-weight: 700;
  line-height: 1.2;
}
#ms-mgmt-view .mob-role-sub {
  font-size: 10px;
  color: var(--mil-muted);
}
#ms-mgmt-view .mob-role-step {
  position: absolute;
  top: 28px;
  z-index: 2;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1px solid var(--mil-line);
  background: var(--mil-panel);
  color: var(--mil-ink);
  font-weight: 800;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
:root[data-ui-style="millennium"] #ms-mgmt-view .mob-role-step {
  border-radius: 0;
  border: 2px solid var(--mil-line);
}
#ms-mgmt-view .mob-role-step.prev { left: 4px; }
#ms-mgmt-view .mob-role-step.next { right: 4px; }
#ms-mgmt-view .mob-role-dots {
  display: flex;
  justify-content: center;
  gap: 5px;
  margin-top: 2px;
}
#ms-mgmt-view .mob-role-dot {
  width: 6px;
  height: 6px;
  border-radius: 999px;
  border: 0;
  padding: 0;
  background: var(--mil-lo);
  cursor: pointer;
}
#ms-mgmt-view .mob-role-dot.is-active {
  width: 16px;
  background: var(--mil-ink);
}
#ms-mgmt-view .m-mob-role-card1 {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
#ms-mgmt-view .m-mob-role-card1-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
#ms-mgmt-view .m-mob-role-card1-title {
  font-size: 15px;
  font-weight: 800;
}

/* ── 设置页：左导航轨 + 中配置栈 + 右上下文抽屉 + 移动端中心与底部弹层 ── */
#ms-mgmt-view .m-set-shell {
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-width: 0;
}
#ms-mgmt-view .m-set-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  flex-wrap: wrap;
}
#ms-mgmt-view .m-set-top-meta {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}
#ms-mgmt-view .m-set-body {
  display: grid;
  grid-template-columns: 210px minmax(0, 1fr) 310px;
  gap: 14px;
  align-items: start;
  min-width: 0;
}
#ms-mgmt-view .m-set-rail,
#ms-mgmt-view .m-set-drawer {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
#ms-mgmt-view .m-set-main,
#ms-mgmt-view .m-set-stack {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
#ms-mgmt-view .m-set-sec {
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-width: 0;
}
#ms-mgmt-view .m-general-fields {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
#ms-mgmt-view .m-preset-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
#ms-mgmt-view .m-svc-cards {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 8px;
}
#ms-mgmt-view .m-svc-card {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 10px 12px;
  border: 1px solid var(--mil-line);
  border-radius: 12px;
  background: var(--mil-screen);
  min-width: 0;
}
:root[data-ui-style="millennium"] #ms-mgmt-view .m-svc-card {
  border-radius: 0;
  border: 2px solid var(--mil-line);
}
#ms-mgmt-view .m-svc-card.is-selected {
  border-color: var(--mil-accent);
}
#ms-mgmt-view .m-svc-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}
#ms-mgmt-view .m-svc-drawer {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
#ms-mgmt-view .m-drawer-actions {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 8px;
  margin-top: 6px;
}
#ms-mgmt-view .m-handle-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
#ms-mgmt-view .m-json-area {
  width: 100%;
  resize: vertical;
}
#ms-mgmt-view .m-mob-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  padding: 11px 12px;
  border: 0;
  border-bottom: 1px solid var(--mil-line);
  background: transparent;
  color: var(--mil-ink);
  font-size: 13.5px;
  font-weight: 600;
  cursor: pointer;
  text-align: left;
}
#ms-mgmt-view .m-mob-row:last-child {
  border-bottom: 0;
}
#ms-mgmt-view .m-mob-row-l,
#ms-mgmt-view .m-mob-row-r {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}
#ms-mgmt-view .m-mob-row-val {
  font-size: 12px;
  color: var(--mil-muted);
}
#ms-mgmt-view .mob-circle-btn {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: 1px solid var(--mil-line);
  background: var(--mil-panel);
  color: var(--mil-ink);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  cursor: pointer;
  flex: 0 0 auto;
}
:root[data-ui-style="millennium"] #ms-mgmt-view .mob-circle-btn {
  border-radius: 0;
  border: 2px solid var(--mil-line);
}
#ms-mgmt-view .m-mob-scrim,
#ms-mgmt-view .m-mob-sheet-scrim {
  position: fixed;
  inset: 0;
  background: rgba(17, 17, 20, 0.45);
  z-index: 90;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
#ms-mgmt-view .m-mob-scrim[hidden],
#ms-mgmt-view .m-mob-sheet-scrim[hidden] {
  display: none;
}
#ms-mgmt-view .m-mob-sheet {
  width: 100%;
  max-width: 520px;
  max-height: 84vh;
  overflow-y: auto;
  background: var(--mil-panel);
  border-top: 1px solid var(--mil-line);
  border-radius: 18px 18px 0 0;
  padding: 10px 16px 24px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
:root[data-ui-style="millennium"] #ms-mgmt-view .m-mob-sheet {
  border-radius: 0;
  border-top: 2px solid var(--mil-line);
}
#ms-mgmt-view .m-mob-handle {
  width: 36px;
  height: 4px;
  border-radius: 999px;
  background: var(--mil-lo);
  margin: 0 auto 4px;
}
#ms-mgmt-view .m-mob-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

@media (max-width: 900px) {
  #ms-mgmt-view .m-out-shell,
  #ms-mgmt-view .m-mem-shell,
  #ms-mgmt-view .m-set-body {
    grid-template-columns: minmax(0, 1fr);
  }
  #ms-mgmt-view .m-ab-studio {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (max-width: 760px) {
  #ms-mgmt-view .m-mob-only {
    display: flex;
  }
  #ms-mgmt-view .m-ab-mob-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  #ms-mgmt-view .m-ab-mob-head[hidden],
  #ms-mgmt-view .m-out-ws-panel[hidden] {
    display: none;
  }
  #ms-mgmt-view .m-ab-roster {
    display: none;
  }
  #ms-mgmt-view .m-drawer-grid,
  #ms-mgmt-view .m-rcp-grid,
  #ms-mgmt-view .m-companions-split,
  #ms-mgmt-view .m-ws-split {
    grid-template-columns: minmax(0, 1fr);
  }
  #ms-mgmt-view .m-out-shell:not(.is-mob-inspect) .m-out-inspector {
    display: none;
  }
  #ms-mgmt-view .m-out-shell.is-mob-inspect .m-out-aside,
  #ms-mgmt-view .m-out-shell.is-mob-inspect .m-out-main {
    display: none;
  }
  #ms-mgmt-view .m-set-rail,
  #ms-mgmt-view .m-set-drawer {
    display: none;
  }
  #ms-mgmt-view .m-mob-hub {
    flex-direction: column;
    gap: 6px;
  }
  #ms-mgmt-view .m-mob-group {
    padding: 0;
    overflow: hidden;
  }
  #ms-mgmt-view .m-mob-sub {
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  #ms-mgmt-view .m-mob-sub[hidden],
  #ms-mgmt-view .m-mob-hub[hidden] {
    display: none;
  }
  #ms-mgmt-view .m-mob-sub-title {
    font-size: 15px;
    font-weight: 800;
    text-align: center;
    flex: 1 1 auto;
  }
  #ms-mgmt-view .m-mob-sub-actions {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  #ms-mgmt-view .m-set-shell[data-mob-sub="hub"] .m-set-body {
    display: none;
  }
  #ms-mgmt-view .m-set-shell:not([data-mob-sub="hub"]) #settings-mob-hub {
    display: none;
  }
  #ms-mgmt-view .m-set-shell:not([data-mob-sub="hub"]) .m-set-sec {
    display: none;
  }
  #ms-mgmt-view .m-set-shell[data-mob-sub="general"] .m-set-sec[data-set-sec="general"],
  #ms-mgmt-view .m-set-shell[data-mob-sub="streams"] .m-set-sec[data-set-sec="streams"],
  #ms-mgmt-view .m-set-shell[data-mob-sub="routines"] .m-set-sec[data-set-sec="routines"],
  #ms-mgmt-view .m-set-shell[data-mob-sub="routines"] .m-set-sec[data-set-sec="health"],
  #ms-mgmt-view .m-set-shell[data-mob-sub="services"] .m-set-sec[data-set-sec="services"],
  #ms-mgmt-view .m-set-shell[data-mob-sub="vault"] .m-set-sec[data-set-sec="vault"],
  #ms-mgmt-view .m-set-shell[data-mob-sub="webhooks"] .m-set-sec[data-set-sec="webhooks"] {
    display: flex;
  }
}

#ms-mgmt-view [hidden] {
  display: none !important;
}

/* ==MGMT_CSS_END== */
</style>
</head>
<body data-page="{{PAGE_ID}}">
<div class="mil-shell">

  <header class="mil-topbar">
    <div class="mil-brand">
      <div class="ms-wordmark">
        <span class="mil-spectrum" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="mil-nameplate">MAISYA</span>
      </div>
      <h1 class="mil-page-title">{{TITLE}}</h1>
      <nav class="mil-nav" aria-label="Maisya 工作区页面">
        <button type="button" class="mil-key mil-key--sm" data-nav="now">现场</button>
        <button type="button" class="mil-key mil-key--sm" data-nav="outputs">产物</button>
        <button type="button" class="mil-key mil-key--sm" data-nav="abilities">能力</button>
        <button type="button" class="mil-key mil-key--sm" data-nav="memory">手账</button>
        <button type="button" class="mil-key mil-key--sm" data-nav="settings">设置</button>
      </nav>
    </div>
    <div class="mil-top-right">
      <button type="button" class="mil-key mil-key--sm" id="ui-style-toggle" aria-pressed="true" title="切换界面风格（千禧机械 / 默认主题）">千禧机械</button>
      <div class="mil-led-pill">
        <span class="mil-led" id="mgmt-led"></span>
        <span>管理台</span>
      </div>
    </div>
  </header>

  <div class="mil-feedback" id="feedback" aria-live="polite"></div>

  {{BODY}}

</div>

<div class="mil-help-pop" id="mil-help-pop" role="tooltip" hidden></div>

<script>
(() => {
  const page = document.body.dataset.page;
  const $ = (sel) => document.querySelector(sel);
  const $$ = (sel) => [...document.querySelectorAll(sel)];
  const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" }[c]));

{{FISH_JS}}

  // 高亮当前工作区标签并支持跳转
  $$("[data-nav]").forEach((btn) => {
    const target = btn.dataset.nav;
    if (target === page) btn.setAttribute("aria-current", "page");
    btn.addEventListener("click", () => {
      if (target !== page && window.maibot?.navigate) window.maibot.navigate(target);
    });
  });

  let savedUiStyle = "millennium";
  let manualUiStyle = "";
  let lastCtx = null;
  function effectiveUiStyle(ctx) {
    if (manualUiStyle) return manualUiStyle;
    if (savedUiStyle === "maiwork" || savedUiStyle === "millennium") return savedUiStyle;
    const dash = (ctx || lastCtx || window.maibot?.context || {}).dashboardStyle || "millennium";
    return dash === "millennium" ? "millennium" : "maiwork";
  }
  function syncUiToggle(style) {
    const btn = $("#ui-style-toggle");
    if (!btn) return;
    const isMil = style === "millennium";
    btn.textContent = isMil ? "千禧机械" : "默认主题";
    btn.setAttribute("aria-pressed", String(isMil));
  }
  function applyTheme(ctx) {
    if (ctx) lastCtx = ctx;
    const c = ctx || lastCtx || window.maibot?.context || {};
    document.documentElement.className = c.theme === "dark" ? "dark" : "";
    document.documentElement.setAttribute("data-dashboard-style", c.dashboardStyle || "millennium");
    const style = effectiveUiStyle(c);
    document.documentElement.setAttribute("data-ui-style", style);
    syncUiToggle(style);
  }
  applyTheme();
  window.addEventListener("maibot:context", (ev) => applyTheme(ev.detail));
  $("#ui-style-toggle")?.addEventListener("click", () => {
    const next = document.documentElement.getAttribute("data-ui-style") === "millennium" ? "maiwork" : "millennium";
    manualUiStyle = next;
    applyTheme();
  });

  // 严格限制最多 2 路并发请求，确保排队稳定执行
  let activeSlotCount = 0;
  const waiters = [];
  async function acquire() {
    if (activeSlotCount >= 2) await new Promise((res) => waiters.push(res));
    activeSlotCount++;
  }
  function release() {
    activeSlotCount--;
    if (waiters.length) waiters.shift()();
  }
  async function rpc(op, key, body) {
    await acquire();
    try {
      const arg = op === "read"
        ? { section: key, payload: JSON.stringify(body || {}) }
        : { action: key, payload: JSON.stringify(body || {}) };
      const res = op === "read" ? await window.maibot.query("read", arg) : await window.maibot.action("write", arg);
      if (res?.ui_style) {
        savedUiStyle = res.ui_style;
        applyTheme();
      }
      return res;
    } finally {
      release();
    }
  }

  function say(text, isErr = false) {
    const fb = $("#feedback");
    if (!fb) return;
    fb.textContent = text || "";
    fb.className = `mil-feedback${!text ? "" : isErr ? " mil-feedback--err" : " mil-feedback--ok"}`;
    const led = $("#mgmt-led");
    if (led) led.className = `mil-led${isErr ? " mil-led--bad" : ""}`;
  }

  function setDirty(flag) {
    const tag = $("#dirty-tag");
    if (tag) tag.hidden = !flag;
  }

  document.addEventListener("keydown", (ev) => {
    if ((ev.ctrlKey || ev.metaKey) && ev.key.toLowerCase() === "s") {
      ev.preventDefault();
      if (page === "settings") $("#save-settings")?.click();
      else if (page === "abilities" || page === "memory") $("#save")?.click();
    }
  });

  function versionHistory(history, current) {
    const sel = $("#history");
    if (!sel) return;
    const list = (history || []).slice().reverse();
    sel.innerHTML = list.map((h) => `<option value="${esc(h.version)}">v${esc(h.version)} · ${esc(h.source || "manual")}</option>`).join("");
    if (current !== undefined) sel.value = String(current);
  }

  function helpBtn(text, label = "查看说明") {
    return text ? `<button type="button" class="mil-help" data-help="${esc(text)}" aria-label="${esc(label)}" aria-expanded="false">?</button>` : "";
  }

  function initHelpPopovers() {
    const pop = $("#mil-help-pop");
    if (!pop) return;
    let activeBtn = null;
    let pinnedBtn = null;
    const closePop = () => {
      if (activeBtn) activeBtn.setAttribute("aria-expanded", "false");
      activeBtn = null;
      pinnedBtn = null;
      pop.hidden = true;
    };
    const openPop = (btn) => {
      const text = btn?.dataset?.help || "";
      if (!text) return;
      if (activeBtn && activeBtn !== btn) activeBtn.setAttribute("aria-expanded", "false");
      activeBtn = btn;
      activeBtn.setAttribute("aria-expanded", "true");
      pop.textContent = text;
      pop.hidden = false;
      const r = btn.getBoundingClientRect();
      const pw = pop.offsetWidth || 260;
      const ph = pop.offsetHeight || 60;
      const left = Math.max(12, Math.min(window.innerWidth - pw - 12, r.left + r.width / 2 - pw / 2));
      const top = r.bottom + ph + 16 < window.innerHeight ? r.bottom + 8 : Math.max(12, r.top - ph - 8);
      pop.style.left = `${Math.round(left)}px`;
      pop.style.top = `${Math.round(top)}px`;
    };
    document.addEventListener("click", (ev) => {
      const btn = ev.target.closest(".mil-help");
      if (btn) {
        if (btn.closest("summary")) ev.preventDefault();
        ev.stopPropagation();
        if (pinnedBtn === btn && !pop.hidden) closePop();
        else { pinnedBtn = btn; openPop(btn); }
        return;
      }
      if (!pop.hidden && !ev.target.closest("#mil-help-pop")) closePop();
    });
    document.addEventListener("mouseenter", (ev) => {
      const btn = ev.target.closest?.(".mil-help");
      if (btn && !pinnedBtn && window.matchMedia?.("(hover: hover)").matches) openPop(btn);
    }, true);
    document.addEventListener("mouseleave", (ev) => {
      const btn = ev.target.closest?.(".mil-help");
      if (btn && activeBtn === btn && pinnedBtn !== btn && window.matchMedia?.("(hover: hover)").matches) closePop();
    }, true);
    document.addEventListener("focusin", (ev) => {
      const btn = ev.target.closest?.(".mil-help");
      if (btn && !pinnedBtn) openPop(btn);
    });
    document.addEventListener("focusout", (ev) => {
      const btn = ev.target.closest?.(".mil-help");
      if (btn && activeBtn === btn && pinnedBtn !== btn) closePop();
    });
    document.addEventListener("keydown", (ev) => {
      if (ev.key === "Escape" && !pop.hidden) closePop();
    });
    window.addEventListener("scroll", () => {
      if (pop.hidden) return;
      if (pinnedBtn?.isConnected) openPop(pinnedBtn);
      else closePop();
    }, { passive: true });
    window.addEventListener("resize", closePop);
  }
  initHelpPopovers();

  /* ==MGMT_BOOT_START== */
  function bootManagementTab(page, sig) {
    const rpc = async (op, key, body) => {
      if (sig?.aborted) return { success: false, aborted: true };
      const r = await hostRpc(op, key, body);
      return sig?.aborted ? { success: false, aborted: true } : r;
    };
    const say = (text, isErr = false) => {
      if (!sig?.aborted) hostSay(text, isErr);
    };

    const mStyle = () => document.documentElement.getAttribute("data-ui-style") || "millennium";
    const mIsMil = () => mStyle() === "millennium";
    const mIsDark = () => document.documentElement.classList.contains("dark");

    function mFallbackCtrl(key, size) {
      const s = Number(size) || 16;
      const paths = {
        back: '<polyline points="15 18 9 12 15 6"></polyline>',
        chevron_r: '<polyline points="9 6 15 12 9 18"></polyline>',
        chevron_u: '<polyline points="18 15 12 9 6 15"></polyline>',
        chevron_d: '<polyline points="6 9 12 15 18 9"></polyline>',
        plus: '<line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>',
        close: '<line x1="6" y1="6" x2="18" y2="18"></line><line x1="6" y1="18" x2="18" y2="6"></line>',
        check: '<polyline points="20 6 9 17 4 12"></polyline>',
        grip: '<circle cx="9" cy="6" r="1.4" fill="currentColor" stroke="none"></circle><circle cx="15" cy="6" r="1.4" fill="currentColor" stroke="none"></circle><circle cx="9" cy="12" r="1.4" fill="currentColor" stroke="none"></circle><circle cx="15" cy="12" r="1.4" fill="currentColor" stroke="none"></circle><circle cx="9" cy="18" r="1.4" fill="currentColor" stroke="none"></circle><circle cx="15" cy="18" r="1.4" fill="currentColor" stroke="none"></circle>',
        trash: '<polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14H6L5 6"></path><path d="M10 11v6M14 11v6"></path>',
        sliders: '<line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line>',
        search: '<circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>',
        folder: '<path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-6l-2-2H5a2 2 0 0 0-2 2z"></path>',
        copy: '<rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>',
        ext: '<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line>',
        refresh: '<polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>',
        lock: '<rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>',
        key: '<circle cx="7.5" cy="15.5" r="4.5"></circle><path d="m21 2-9.6 9.6M15.5 7.5 19 11"></path>',
        globe: '<circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line>',
        grid: '<rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect>',
        list: '<line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line>',
        sun: '<circle cx="12" cy="12" r="5"></circle>',
        moon: '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>',
        help: '<circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line>',
        clock: '<circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>',
        book: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>',
      };
      const inner = paths[key] || '<rect x="5" y="5" width="14" height="14" rx="2"></rect>';
      return `<svg viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;
    }

    function mIconMod(key, size = 22) {
      const IC = window.MaisyaIcons;
      if (IC) {
        if (typeof IC.mod === "function") return IC.mod(key, size);
        if (mIsMil() && typeof IC.mil === "function") return IC.mil(key, size, mIsDark());
        if (!mIsMil() && typeof IC.soft3d === "function") return IC.soft3d(key, size);
      }
      const cls = mIsMil() ? "m-ic-mil" : "m-ic-fb";
      const r = mIsMil() ? 0 : 5;
      return `<svg class="${cls}" viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="${r}" fill="var(--mil-well)"></rect><circle cx="12" cy="12" r="4"></circle></svg>`;
    }

    function mIconCtrl(key, size = 16) {
      const IC = window.MaisyaIcons;
      if (IC) {
        if (typeof IC.ctrl === "function") return IC.ctrl(key, size);
        if (mIsMil() && typeof IC.milUi === "function") return IC.milUi(key, size);
        if (!mIsMil() && typeof IC.ui === "function") return IC.ui(key, size);
      }
      return mFallbackCtrl(key, size);
    }

    function mIconBrand(key, size = 20) {
      const IC = window.MaisyaIcons;
      if (IC && typeof IC.brand === "function") return IC.brand(key, size, mIsDark());
      return `<svg class="m-ic-brand-fb" viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="${mIsMil() ? 0 : 4}"></rect><path d="M8 12h8"></path></svg>`;
    }

    const themeListeners = [];
    function refreshThemeIcons() {
      window.MaisyaIcons?.ensureDefs?.();
      const root = $("#ms-mgmt-view") || document;
      root.querySelectorAll("[data-m-mod]").forEach((el) => {
        el.innerHTML = mIconMod(el.dataset.mMod, Number(el.dataset.mSize || 22));
      });
      root.querySelectorAll("[data-m-ctrl]").forEach((el) => {
        el.innerHTML = mIconCtrl(el.dataset.mCtrl, Number(el.dataset.mSize || 16));
      });
      root.querySelectorAll("[data-m-brand]").forEach((el) => {
        el.innerHTML = mIconBrand(el.dataset.mBrand, Number(el.dataset.mSize || 20));
      });
      themeListeners.forEach((fn) => {
        try { fn(); } catch (_) {}
      });
    }

    window.addEventListener("maisya:themechange", refreshThemeIcons, { signal: sig });
    window.addEventListener("maibot:context", refreshThemeIcons, { signal: sig });
    if (typeof MutationObserver === "function") {
      const mo = new MutationObserver(() => refreshThemeIcons());
      mo.observe(document.documentElement, { attributes: true, attributeFilter: ["data-ui-style", "class"] });
      sig?.addEventListener?.("abort", () => mo.disconnect(), { once: true });
    }
    refreshThemeIcons();

  /* ════════════════════════════════════════════════════════════════
     1. 能力页 (abilities)
     ════════════════════════════════════════════════════════════════ */
  if (page === "abilities") {
    const ALL_TOOLS = [
      "web_search", "web_fetch", "chat_read", "message_read", "memory_read", "image_read",
      "recall_read", "person_read", "digest_feed", "workspace_file", "html_render", "result_attach",
      "mcp_call", "plugin_api", "sandbox_exec", "credential_call",
    ];
    const TOOL_LABELS = {
      web_search: "联网搜索",
      web_fetch: "网页正文读取",
      chat_read: "近期聊天查阅",
      message_read: "历史消息检索",
      memory_read: "手账备忘查阅",
      image_read: "图片内容识读",
      recall_read: "长期记忆检索",
      person_read: "成员公开资料",
      digest_feed: "资讯源巡检",
      workspace_file: "工作区文件读写",
      html_render: "排版卡片渲染",
      result_attach: "生成交付附件",
      mcp_call: "外部 MCP 工具",
      plugin_api: "跨插件接口",
      sandbox_exec: "沙箱代码执行",
      credential_call: "保险箱凭据请求",
    };
    const ACCESS_LABELS = {
      everyone: "公开可用",
      admins: "仅管理员",
      listed: "指定范围",
    };
    const SLOT_LABELS = {
      utils: "通用工具模型",
      planner: "主规划模型",
      replyer: "对话回复模型",
      fast_model: "轻量快速模型",
      vlm: "图文视觉模型",
    };
    let catalog = { profiles: [], skills: [], skill_items: [], handles: [] };
    let viewMode = "skills-gallery";
    let selectedProfile = "scout";
    let selectedSkill = "";
    let skillFilter = "";
    let skillScope = "all";
    let expectedVersion = 0;
    let loadingConfig = false;
    let loadingSkillVisual = false;
    let fishDrawerOpen = false;
    let fishDraft = null;
    let freshFishProfile = "";

    const profileObj = (id) => (catalog.profiles || []).find((p) => p.id === id) || null;
    const profileFishSeed = (id) => profileObj(id)?.fish_seed || "";

    function fishDraftForProfile(id) {
      const seed = profileFishSeed(id);
      const c = parseFishCustom(seed);
      if (c) return { species: c.species, color: c.color, eyes: c.eyes, base: c.base };
      const base = FISH_BASE_RE.test(seed) ? seed : newFishSeed();
      const t = fishTraits(roleFishSeed(id, base));
      return { species: t.species, color: Math.max(0, FISH_COLORS.indexOf(t.color)), eyes: t.eyes, base };
    }

    function renderRoleFishPanel() {
      const bar = $("#role-fish-bar");
      const summary = $("#role-fish-summary");
      const drawer = $("#role-fish-drawer");
      const customBtn = $("#role-fish-custom");
      const resetBtn = $("#role-fish-reset");
      if (!bar || !summary || !drawer) return;
      const p = viewMode === "roles" ? profileObj(selectedProfile) : null;
      if (!p) {
        bar.hidden = true;
        drawer.hidden = true;
        return;
      }
      bar.hidden = false;
      const curSeed = p.fish_seed || "";
      const tr = fishTraits(roleFishSeed(p.id, curSeed));
      const isOff = p.enabled === false;
      const cls = ["mil-fish--well", isOff ? "mil-fish--off" : "", freshFishProfile === p.id ? "is-new" : ""].filter(Boolean).join(" ");
      const badge = tr.custom ? "已定制" : curSeed ? "已随机" : "默认头像";
      summary.innerHTML = `
        ${roleFishHtml(p.id, curSeed, 48, isOff ? { still: true } : {}, cls)}
        <div style="min-width:0;display:flex;flex-direction:column;gap:3px">
          <div class="mil-row" style="gap:6px">
            <strong>${esc(p.title || p.id)}</strong>
            <span class="mil-tag">${esc(badge)}</span>
          </div>
          <span class="mil-hint">${esc(tr.name)} · ${esc(tr.colorName || "默认色")} · ${esc(tr.eyeName)}</span>
        </div>
      `;
      if (customBtn) customBtn.setAttribute("aria-expanded", String(fishDrawerOpen));
      if (resetBtn) resetBtn.hidden = !curSeed;
      if (!fishDrawerOpen) {
        drawer.hidden = true;
        drawer.innerHTML = "";
        return;
      }
      drawer.hidden = false;
      const d = fishDraft || fishDraftForProfile(p.id);
      fishDraft = d;
      const previewSeed = customFishSeed(d);
      const previewTraits = fishTraits(roleFishSeed(p.id, previewSeed));
      const speciesBtns = Object.entries(FISH_SPECIES).map(([k, name]) =>
        `<button type="button" class="fish-opt" data-fish-pick="species" data-fish-val="${esc(k)}" aria-pressed="${String(d.species === k)}" title="${esc(name)}">${fishSvg(roleFishSeed(p.id, customFishSeed({ ...d, species: k })), { size: 36, still: true })}<span>${esc(name)}</span></button>`
      ).join("");
      const colorSwatches = FISH_COLORS.map((hex, idx) =>
        `<button type="button" class="fish-swatch" data-fish-pick="color" data-fish-val="${idx}" aria-pressed="${String(d.color === idx)}" aria-label="${esc(FISH_COLOR_NAMES[idx] || String(idx))}" title="${esc(FISH_COLOR_NAMES[idx] || String(idx))}" style="--c:${hex}"></button>`
      ).join("");
      const eyesBtns = Object.entries(FISH_EYES).map(([k, name]) =>
        `<button type="button" class="fish-opt" data-fish-pick="eyes" data-fish-val="${esc(k)}" aria-pressed="${String(d.eyes === k)}" title="${esc(name)}">${fishSvg(roleFishSeed(p.id, customFishSeed({ ...d, eyes: k })), { size: 36, still: true })}<span>${esc(name)}</span></button>`
      ).join("");
      drawer.innerHTML = `
        <div class="fish-preview-box">
          ${roleFishHtml(p.id, previewSeed, 80, {}, "mil-fish--well")}
          <div style="display:flex;flex-direction:column;gap:4px">
            <strong>${esc(previewTraits.name)}</strong>
            <span class="mil-hint">${esc(FISH_COLOR_NAMES[d.color] || "")} · ${esc(previewTraits.eyeName)}</span>
            <span class="mil-hint mono" style="font-size:11px">种子：${esc(previewSeed)}</span>
          </div>
        </div>
        <div class="mil-field"><span class="mil-label">鱼种（12 种）</span><div class="fish-opts" role="group" aria-label="选择鱼种">${speciesBtns}</div></div>
        <div class="mil-field"><span class="mil-label">颜色（18 色）</span><div class="fish-swatches" role="group" aria-label="选择颜色">${colorSwatches}</div></div>
        <div class="mil-field"><span class="mil-label">眼神（11 种）</span><div class="fish-opts" role="group" aria-label="选择眼神">${eyesBtns}</div></div>
        <div class="mil-row" style="justify-content:flex-end">
          <button type="button" class="mil-key mil-key--sm" id="role-fish-shape" title="保持鱼种、颜色和眼神不变，仅更换鳍与姿态细节">更换姿态</button>
          <button type="button" class="mil-key mil-key--sm" id="role-fish-cancel">收起</button>
          <button type="button" class="mil-key mil-key--sm mil-key--hot" id="role-fish-save">保存小鱼</button>
        </div>
      `;
    }

    async function saveProfileFishSeed(nextSeed, feedbackMsg) {
      if (!selectedProfile) return;
      const hadDirtyDraft = !$("#dirty-tag")?.hidden;
      const target = selectedProfile;
      say("");
      const r = await rpc("write", "set_profile_fish", { target, fish_seed: nextSeed });
      if (!r?.success) return say(r?.error || "保存角色小鱼头像失败", true);
      freshFishProfile = target;
      const fishTid = setTimeout(() => {
        if (sig?.aborted) return;
        if (freshFishProfile === target) {
          freshFishProfile = "";
          if ($("#profiles")?.isConnected) {
            renderCatalog();
            renderRoleFishPanel();
          }
        }
      }, 700);
      sig?.addEventListener("abort", () => clearTimeout(fishTid), { once: true });
      await loadCatalog();
      if (viewMode === "roles" && $("#document").value === "config" && target === selectedProfile) {
        if (!hadDirtyDraft) {
          await loadAsset(false);
        } else {
          expectedVersion = Number(r.version || expectedVersion);
          $("#version").textContent = `v${expectedVersion}`;
          writeTomlKey("fish_seed", r.fish_seed ? tomlStr(r.fish_seed) : null);
        }
      }
      renderRoleFishPanel();
      say(feedbackMsg || "已更新角色小鱼头像");
    }

    const tomlStr = (v) => JSON.stringify(String(v ?? ""));
    const tomlArr = (xs) => `[${(xs || []).map((x) => tomlStr(x)).join(", ")}]`;

    function skillItemsList() {
      if (Array.isArray(catalog.skill_items) && catalog.skill_items.length) return catalog.skill_items;
      return (catalog.skills || []).map((id) => ({
        id, name: id, title: id, description: "", is_preset: false, is_modified: false, used_by: [], companion_count: 0, companion_files: [], chars: 0, version: 0,
      }));
    }

    function parseSimpleToml(text) {
      const out = { tools: [], skills: [], allow_chats: [], allow_users: [] };
      String(text || "").split(/\r?\n/).forEach((line) => {
        const clean = line.trim();
        if (!clean || clean.startsWith("#")) return;
        const eq = clean.indexOf("=");
        if (eq < 1) return;
        const k = clean.slice(0, eq).trim();
        let v = clean.slice(eq + 1).trim();
        try {
          if (v.startsWith("[") && v.endsWith("]")) out[k] = JSON.parse(v);
          else if (v.startsWith("\"") && v.endsWith("\"")) out[k] = JSON.parse(v);
          else if (v === "true" || v === "false") out[k] = v === "true";
          else if (!Number.isNaN(Number(v))) out[k] = Number(v);
          else out[k] = v;
        } catch {
          // 复杂多行 TOML 保留在源码框中，不强行覆盖
        }
      });
      return out;
    }

    function getTomlModelChain(parsed) {
      const p = parsed || parseSimpleToml($("#content").value);
      const out = [];
      const push = (val) => {
        const s = String(val || "").trim();
        if (s && !out.includes(s)) out.push(s);
      };
      push(p.model_name || p.model || "");
      if (Array.isArray(p.fallback_models)) p.fallback_models.forEach(push);
      if (Array.isArray(p.model_list)) p.model_list.forEach(push);
      return out.slice(0, 16);
    }

    function hostModelEntries() {
      const seen = new Set();
      const rows = [];
      const add = (entry) => {
        if (!entry) return;
        const name = typeof entry === "string" ? entry.trim() : String(entry.name || "").trim();
        if (!name || seen.has(name)) return;
        seen.add(name);
        rows.push({
          name,
          provider: typeof entry === "object" ? String(entry.provider || "").trim() : "",
          identifier: typeof entry === "object" ? String(entry.identifier || "").trim() : "",
          source: typeof entry === "object" ? String(entry.source || "") : "",
          assigned_tasks: typeof entry === "object" && Array.isArray(entry.assigned_tasks) ? entry.assigned_tasks : [],
        });
      };
      (catalog.model_catalog || []).forEach(add);
      (catalog.available_models || []).forEach(add);
      return rows;
    }

    function renderModelChainEditor(parsed) {
      const chain = getTomlModelChain(parsed);
      const entries = hostModelEntries();
      const byName = Object.fromEntries(entries.map((e) => [e.name, e]));
      const host = $("#cfg-model-chain");
      const picker = $("#cfg-model-picker");
      const clearBtn = $("#cfg-model-clear");
      if (!host) return;

      if (clearBtn) clearBtn.disabled = chain.length === 0;

      if (chain.length) {
        host.innerHTML = `<div class="m-model-list">${chain.map((name, idx) => {
          const info = byName[name];
          const detail = [info?.provider, info?.identifier].filter(Boolean).join(" · ");
          const roleLabel = idx === 0 ? "主选" : "备选";
          return `<div class="m-model-row${idx === 0 ? " is-primary" : ""}">
            <span class="m-model-grip" aria-hidden="true">${mIconCtrl("grip", 14)}</span>
            <span class="m-model-num num">${idx + 1}</span>
            <div class="m-model-main">
              <div class="mil-row" style="gap:6px;flex-wrap:wrap;align-items:center">
                <span class="mil-tag ${idx === 0 ? "mil-tag--ok" : ""}">${roleLabel}</span>
                <strong class="mono" style="font-size:13px;overflow-wrap:anywhere">${esc(name)}</strong>
              </div>
              ${detail ? `<span class="mil-hint mono">${esc(detail)}</span>` : ""}
            </div>
            <div class="m-model-ctl">
              <button type="button" class="mil-key mil-key--sm" data-model-move="up" data-model-idx="${idx}" ${idx === 0 ? "disabled" : ""} aria-label="上移优先级">${mIconCtrl("chevron_u", 13)}</button>
              <button type="button" class="mil-key mil-key--sm" data-model-move="down" data-model-idx="${idx}" ${idx === chain.length - 1 ? "disabled" : ""} aria-label="下移优先级">${mIconCtrl("chevron_d", 13)}</button>
              <button type="button" class="mil-key mil-key--sm" data-model-rm="${idx}" aria-label="移除此模型">${mIconCtrl("close", 13)}</button>
            </div>
          </div>`;
        }).join("")}</div>`;
      } else {
        const taskSelect = $("#cfg-task");
        const taskLabel = taskSelect?.selectedOptions?.[0]?.textContent || "通用辅助模型";
        host.innerHTML = `<div class="mil-hint" style="padding:4px 2px">尚未指定独立模型 · 未指定时默认使用「${esc(taskLabel)}」</div>`;
      }

      if (picker) {
        const unused = entries.filter((e) => !chain.includes(e.name));
        picker.innerHTML = `<option value="">${entries.length ? (unused.length ? "从宿主已配置模型中添加…" : "可选模型均已加入顺延列表") : "暂未发现宿主模型（可在右侧手动输入）"}</option>` +
          entries.map((e) => {
            const label = [e.provider, e.identifier].filter(Boolean).join(" · ");
            const inChain = chain.indexOf(e.name);
            const suffix = inChain >= 0 ? ` [顺位 #${inChain + 1}]` : (label ? ` (${label})` : "");
            return `<option value="${esc(e.name)}">${esc(e.name + suffix)}</option>`;
          }).join("");
        picker.value = "";
      }
    }

    function applyModelChainToToml(chain) {
      const clean = [];
      (chain || []).forEach((item) => {
        const s = String(item || "").trim();
        if (s && !clean.includes(s)) clean.push(s);
      });
      const limited = clean.slice(0, 16);
      setDirty(true);
      writeTomlKey("model_name", limited[0] ? tomlStr(limited[0]) : null);
      writeTomlKey("fallback_models", limited.length > 1 ? tomlArr(limited.slice(1)) : null);
      writeTomlKey("model", null);
      writeTomlKey("model_list", null);
      renderModelChainEditor();
    }

    function addModelToChain(rawName) {
      const name = String(rawName || "").trim();
      if (!name) return false;
      const cur = getTomlModelChain();
      if (!cur.includes(name)) cur.push(name);
      applyModelChainToToml(cur);
      return true;
    }

    function scopeKnownName(spec) {
      const known = Array.isArray(catalog.known_chats) ? catalog.known_chats : [];
      const hit = known.find((k) => k.stream_spec === spec || k.chat_id === spec);
      const m = String(spec || "").match(/^([a-z0-9_-]+):(group|private):(.+)$/i);
      if (hit?.name && hit.name !== spec && (!m || hit.name !== m[3])) return hit.name;
      return m ? `${m[1].toUpperCase()} ${m[2].toLowerCase() === "group" ? "群聊" : "私聊"} · ${m[3]}` : spec;
    }

    function normalizeScopeChat(raw) {
      const s = String(raw || "").trim();
      if (!s) return "";
      const m = s.match(/^(?:chat:)?([a-z][a-z0-9_-]*):(group|private):([^\s:][^\s]*)$/i);
      if (m) return `${m[1].toLowerCase()}:${m[2].toLowerCase()}:${m[3].trim()}`;
      const known = Array.isArray(catalog.known_chats) ? catalog.known_chats : [];
      const hit = known.find((k) => k.chat_id === s || k.stream_spec === s);
      return hit?.stream_spec || s;
    }

    function renderRoleScopeEditor(parsed) {
      const wrap = $("#cfg-allow-scope-wrap");
      if (!wrap) return;
      const p = parsed || parseSimpleToml($("#content").value);
      const access = $("#cfg-access")?.value || p.access || "everyone";
      wrap.hidden = access !== "listed";
      if (access !== "listed") return;

      const allowChats = Array.isArray(p.allow_chats) ? p.allow_chats.map((x) => String(x || "").trim()).filter(Boolean) : [];
      const allowUsers = Array.isArray(p.allow_users) ? p.allow_users.map((x) => String(x || "").trim()).filter(Boolean) : [];
      const known = Array.isArray(catalog.known_chats) ? catalog.known_chats : [];
      const availKnown = known.filter((k) => {
        const sp = String(k.stream_spec || k.chat_id || "").trim();
        return sp && sp !== "self" && !allowChats.includes(sp);
      });

      $("#cfg-allow-chats-box").innerHTML = `
        <div class="mil-row" style="justify-content:space-between;gap:6px">
          <span class="mil-label" style="margin:0">允许调用的会话白名单（平台:类型:id）</span>
        </div>
        <div class="ms-entry-list">
          ${allowChats.length ? allowChats.map((c, idx) => {
            const title = scopeKnownName(c);
            return `<div class="ms-entry-row">
              <div class="ms-entry-meta">
                <span class="ms-entry-title">${esc(title)}</span>
                ${title !== c ? `<span class="mil-tag ms-entry-code">${esc(c)}</span>` : ""}
              </div>
              <button type="button" class="mil-key mil-key--sm" data-cfg-rm-chat="${idx}">移除</button>
            </div>`;
          }).join("") : `<span class="mil-hint">暂未指定会话（仅下方白名单成员或管理员可用）</span>`}
        </div>
        ${availKnown.length ? `<div class="ms-entry-add">
          <select id="cfg-pick-known-chat" class="mil-select" style="flex:1 1 180px" aria-label="从已发现会话选择">
            <option value="">从已发现会话挑选…</option>
            ${availKnown.map((k) => {
              const sp = k.stream_spec || k.chat_id;
              return `<option value="${esc(sp)}">${esc(k.name && k.name !== sp ? `${k.name} · ${sp}` : sp)}</option>`;
            }).join("")}
          </select>
          <button type="button" class="mil-key mil-key--sm" id="cfg-add-known-chat">+ 添加所选</button>
        </div>` : ""}
        <div class="ms-entry-add">
          <select id="cfg-chat-plat" class="mil-select" aria-label="会话平台">
            <option value="qq">QQ</option><option value="telegram">Telegram</option><option value="discord">Discord</option><option value="wechat">微信</option>
          </select>
          <select id="cfg-chat-type" class="mil-select" aria-label="会话类型">
            <option value="group">群聊</option><option value="private">私聊</option>
          </select>
          <input id="cfg-chat-id" class="mil-input mono" style="flex:1 1 140px" placeholder="群号或账号，如 12345678" aria-label="允许的群号或账号">
          <button type="button" class="mil-key mil-key--sm mil-key--hot" id="cfg-add-chat-btn">+ 添加会话</button>
        </div>`;

      $("#cfg-allow-users-box").innerHTML = `
        <span class="mil-label" style="margin:0">允许调用的指定成员（平台:用户ID）</span>
        <div class="ms-entry-list">
          ${allowUsers.length ? allowUsers.map((u, idx) =>
            `<div class="ms-entry-row">
              <div class="ms-entry-meta"><span class="ms-entry-title mono">${esc(u)}</span></div>
              <button type="button" class="mil-key mil-key--sm" data-cfg-rm-user="${idx}">移除</button>
            </div>`
          ).join("") : `<span class="mil-hint">暂未指定额外成员</span>`}
        </div>
        <div class="ms-entry-add">
          <select id="cfg-user-plat" class="mil-select" aria-label="成员平台">
            <option value="qq">QQ</option><option value="telegram">Telegram</option><option value="discord">Discord</option><option value="wechat">微信</option>
          </select>
          <input id="cfg-user-id" class="mil-input mono" style="flex:1 1 160px" placeholder="成员账号，如 10001（或 qq:10001）" aria-label="成员账号">
          <button type="button" class="mil-key mil-key--sm" id="cfg-add-user-btn">+ 添加成员</button>
        </div>`;
    }

    function syncVisualFromToml() {
      loadingConfig = true;
      const p = parseSimpleToml($("#content").value);
      $("#cfg-enabled").checked = p.enabled !== false;
      $("#cfg-title").value = p.title || "";
      $("#cfg-env").value = p.environment === "sandbox" ? "sandbox" : "readonly";
      $("#cfg-access").value = ["everyone", "admins", "listed"].includes(p.access) ? p.access : "everyone";
      $("#cfg-task").value = ["utils", "planner", "replyer", "fast_model", "vlm"].includes(p.task) ? p.task : (p.task === "" ? "" : "utils");
      if ($("#cfg-model-name")) $("#cfg-model-name").value = "";
      $("#cfg-web").value = p.web_provider || "";
      $("#cfg-steps").value = p.max_steps ?? "";
      $("#cfg-temp").value = p.temperature ?? "";
      renderRoleScopeEditor(p);
      renderModelChainEditor(p);

      const pickedTools = new Set(Array.isArray(p.tools) ? p.tools : []);
      $("#cfg-tools").innerHTML = ALL_TOOLS.map((t) =>
        `<label class="mil-chk" title="${esc(t)}"><input type="checkbox" data-cfg-tool="${esc(t)}" ${pickedTools.has(t) ? "checked" : ""}><span>${esc(TOOL_LABELS[t] || t)}</span></label>`
      ).join("");

      const pickedSkills = new Set(Array.isArray(p.skills) ? p.skills : []);
      const items = skillItemsList();
      $("#cfg-skills").innerHTML = items.length
        ? items.map((s) =>
            `<label class="mil-chk" title="${esc(s.description || s.title || s.id)}"><input type="checkbox" data-cfg-skill="${esc(s.id)}" ${pickedSkills.has(s.id) ? "checked" : ""}><span>${esc(s.title && s.title !== s.id ? `${s.title} (${s.id})` : s.id)}</span></label>`
          ).join("")
        : `<span class="mil-hint">暂无可用技能</span>`;
      loadingConfig = false;
    }

    function writeTomlKey(key, formatted) {
      if (loadingConfig) return;
      const lines = $("#content").value.split(/\r?\n/);
      const re = new RegExp(`^\\s*${key}\\s*=`);
      const idx = lines.findIndex((l) => re.test(l));
      if (formatted === null) {
        if (idx >= 0) lines.splice(idx, 1);
      } else if (idx >= 0) {
        lines[idx] = `${key} = ${formatted}`;
      } else {
        lines.push(`${key} = ${formatted}`);
      }
      $("#content").value = lines.filter((l, i, arr) => i < arr.length - 1 || l !== "").join("\n") + "\n";
    }

    function unquoteYamlVal(raw) {
      const v = String(raw || "").trim();
      if (v.length >= 2 && v.startsWith("\"") && v.endsWith("\"")) {
        try { return JSON.parse(v); } catch { return v.slice(1, -1); }
      }
      if (v.length >= 2 && v.startsWith("'") && v.endsWith("'")) return v.slice(1, -1);
      return v;
    }

    function parseSkillFrontmatter(text) {
      const m = String(text || "").match(/^\s*---\r?\n([\s\S]*?)\r?\n---(?:\r?\n|$)/);
      const out = { name: "", description: "" };
      if (!m) return out;
      m[1].split(/\r?\n/).forEach((line) => {
        const pair = line.match(/^\s*([A-Za-z0-9_-]+)\s*:\s*(.*?)\s*$/);
        if (pair) {
          const k = pair[1].toLowerCase();
          if (k === "name" || k === "description") out[k] = unquoteYamlVal(pair[2]);
        }
      });
      return out;
    }

    function writeSkillFrontmatter(field, value) {
      if (loadingSkillVisual) return;
      const text = $("#content").value || "";
      const val = String(value ?? "");
      const formatted = field === "description"
        ? `description: ${JSON.stringify(val)}`
        : `name: ${val.trim() || selectedSkill || ""}`;
      const re = /^(\s*---\r?\n)([\s\S]*?)(\r?\n---(?:\r?\n|$))/;
      const m = text.match(re);
      if (m) {
        const lines = m[2].split(/\r?\n/);
        const lineRe = new RegExp(`^\\s*${field}\\s*:`, "i");
        const idx = lines.findIndex((l) => lineRe.test(l));
        if (idx >= 0) lines[idx] = formatted;
        else lines.push(formatted);
        $("#content").value = m[1] + lines.join("\n") + m[3] + text.slice(m[0].length);
      } else {
        const curName = ($("#sk-meta-name").value || selectedSkill || "custom-skill").trim();
        const curDesc = $("#sk-meta-desc").value || "";
        const head = `---\nname: ${curName}\ndescription: ${JSON.stringify(curDesc)}\n---\n\n`;
        $("#content").value = head + text;
      }
    }

    function renderSkillRoleBindings() {
      const host = $("#sk-role-bindings");
      if (!host) return;
      const profiles = catalog.profiles || [];
      if (!selectedSkill || !profiles.length) {
        host.innerHTML = `<span class="mil-hint">暂无可装配的角色</span>`;
        return;
      }
      host.innerHTML = profiles.map((p) => {
        const checked = Array.isArray(p.skills) && p.skills.includes(selectedSkill);
        const label = p.title && p.title !== p.id ? `${p.title} (${p.id})` : p.id;
        return `<label class="mil-chk" title="${esc(p.enabled === false ? "已停用角色" : "启用角色")}">
          <input type="checkbox" data-bind-role="${esc(p.id)}" ${checked ? "checked" : ""}>
          ${roleFishHtml(p.id, p.fish_seed || "", 18, { still: true }, p.enabled === false ? "mil-fish--off" : "")}
          <span>${esc(label)}${p.enabled === false ? " [停用]" : ""}</span>
        </label>`;
      }).join("");
    }

    function renderSkillCompanions() {
      const box = $("#sk-companions-box");
      const listEl = $("#sk-companions-list");
      const prevEl = $("#sk-companion-preview");
      if (!box || !listEl) return;
      const item = skillItemsList().find((s) => s.id === selectedSkill);
      const files = item?.companion_files || [];
      if (!item || !files.length) {
        box.hidden = true;
        listEl.innerHTML = "";
        if (prevEl) {
          prevEl.hidden = true;
          prevEl.textContent = "";
        }
        return;
      }
      box.hidden = false;
      $("#sk-companion-mount").textContent = `in/skills/${selectedSkill}/`;
      $("#sk-companion-count").textContent = `${item.companion_count || files.length} 个文件`;
      listEl.innerHTML = files.map((path) =>
        `<button type="button" class="mil-key mil-key--sm mono" data-companion-path="${esc(path)}">${esc(path)}</button>`
      ).join("");
    }

    function syncSkillVisualFromMarkdown() {
      loadingSkillVisual = true;
      const parsed = parseSkillFrontmatter($("#content").value);
      $("#sk-meta-name").value = parsed.name || selectedSkill || "";
      $("#sk-meta-desc").value = parsed.description || "";
      renderSkillRoleBindings();
      renderSkillCompanions();
      loadingSkillVisual = false;
    }

    function targetQuery() {
      const doc = $("#document").value;
      if (doc === "skill") return { kind: "skill", target: selectedSkill || $("#skill-id").value.trim() };
      if (doc === "config") return { kind: "profile", target: selectedProfile, document: "profile.toml" };
      if (doc === "profile") return { kind: "profile", target: selectedProfile, document: "PROFILE.md" };
      return { kind: doc, target: selectedProfile };
    }

    function renderDocModeUI() {
      const inGallery = viewMode === "skills-gallery";
      const inSkillEditor = viewMode === "skill-editor";
      const inRoles = viewMode === "roles";
      const inDiscovery = viewMode === "discovery";

      $("#skills-gallery-panel").hidden = !inGallery;
      if ($("#ab-mob-head")) $("#ab-mob-head").hidden = inDiscovery || inSkillEditor;
      $("#editor-panel").hidden = !(inSkillEditor || inRoles);
      $("#role-package-panel").hidden = !inRoles;
      $("#discovery-panel").hidden = !inDiscovery;

      $("#nav-skills").setAttribute("aria-current", String(inGallery || inSkillEditor));
      $("#nav-skills").setAttribute("aria-pressed", String(inGallery || inSkillEditor));
      $("#nav-roles").setAttribute("aria-current", String(inRoles));
      $("#nav-roles").setAttribute("aria-pressed", String(inRoles));
      $("#nav-discovery").setAttribute("aria-current", String(inDiscovery));
      $("#nav-discovery").setAttribute("aria-pressed", String(inDiscovery));

      if (inSkillEditor && $("#document").value !== "skill") $("#document").value = "skill";
      if (inRoles && (!$("#document").value || $("#document").value === "skill" || $("#document").value === "PROFILE.md")) $("#document").value = "profile";

      const doc = $("#document").value;
      const isSkill = inSkillEditor || doc === "skill";
      $("#back-to-skills").hidden = !inSkillEditor;
      $("#skill-head-actions").hidden = !inSkillEditor;
      $("#role-doc-tabs").hidden = !inRoles;
      $$("[data-doc-tab]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.docTab === doc)));
      $("#skill-visual").hidden = !isSkill;
      $("#cfg-visual").hidden = !inRoles || doc !== "config";
      const silk = $("#editor-silk");
      if (silk) silk.textContent = isSkill ? "SKILL · 技能工作台" : "ROLE · 角色工作台";
      const tag = $("#active-target-tag");
      if (tag) tag.textContent = (isSkill ? selectedSkill : selectedProfile) || "—";
      const activeSkillItem = skillItemsList().find((s) => s.id === selectedSkill);
      const resetBtn = $("#reset-skill");
      const delSkillBtn = $("#delete-skill");
      if (resetBtn) resetBtn.hidden = !activeSkillItem?.is_preset;
      if (delSkillBtn) delSkillBtn.disabled = Boolean(!selectedSkill || activeSkillItem?.is_preset);
      if (inRoles && doc === "config") syncVisualFromToml();
      if (inSkillEditor && isSkill) syncSkillVisualFromMarkdown();
      renderRoleFishPanel();
    }

    let assetLoadSeq = 0;
    let hostModelsProbed = false;
    let discoveryLoaded = false;
    let discoveryPromise = null;
    async function loadAsset(preserveDraft = false) {
      const seq = ++assetLoadSeq;
      renderDocModeUI();
      if (viewMode === "skills-gallery" || viewMode === "discovery") return;
      const q = targetQuery();
      if (!q.target) {
        $("#content").value = "";
        $("#content").disabled = false;
        $("#save").disabled = false;
        $("#version").textContent = "未选择";
        return;
      }
      const prevDraft = $("#content").value;
      $("#content").disabled = true;
      $("#save").disabled = true;
      try {
        const r = await rpc("read", "asset", q);
        if (sig?.aborted || seq !== assetLoadSeq) return;
        if (!r?.success) return say(r?.error || "读取资产失败", true);
        if ($("#feedback")?.classList.contains("mil-feedback--err")) say("");
        if (preserveDraft && prevDraft !== (r.content || "")) {
          $("#local-draft").value = prevDraft;
          $("#draft-panel").hidden = false;
        }
        $("#content").value = r.content || "";
        expectedVersion = Number(r.version || 0);
        $("#version").textContent = `v${expectedVersion}`;
        setDirty(false);
        versionHistory(r.history, expectedVersion);
        if (viewMode === "roles" && $("#document").value === "config") {
          syncVisualFromToml();
          if (!hostModelsProbed && !(catalog.model_catalog || []).some((m) => m && m.source && m.source !== "profile")) {
            hostModelsProbed = true;
            await (discoveryPromise || refreshDiscovery());
            if (!sig?.aborted && seq === assetLoadSeq && viewMode === "roles" && $("#document").value === "config") {
              renderModelChainEditor();
            }
          }
        }
        if (!sig?.aborted && viewMode === "skill-editor" && $("#document").value === "skill") syncSkillVisualFromMarkdown();
      } finally {
        if (!sig?.aborted && seq === assetLoadSeq) {
          $("#content").disabled = false;
          $("#save").disabled = false;
        }
      }
    }

    function renderCatalog() {
      const items = skillItemsList();
      const profiles = catalog.profiles || [];
      const needle = skillFilter.trim().toLowerCase();

      const scopePills = [
        { key: "all", label: `全部 (${items.length})`, role: null },
        { key: "custom", label: `自建与导入 (${items.filter((s) => !s.is_preset).length})`, role: null },
        { key: "preset", label: `系统预设 (${items.filter((s) => s.is_preset).length})`, role: null },
        ...profiles.map((p) => ({
          key: `role:${p.id}`,
          label: `${p.title || p.id} (${items.filter((s) => (s.used_by || []).includes(p.id)).length})`,
          role: p,
        })),
      ];
      $("#skill-scope-bar").innerHTML = scopePills.map((sp) => {
        const fish = sp.role ? roleFishHtml(sp.role.id, sp.role.fish_seed || "", 16, { still: true }, sp.role.enabled === false ? "mil-fish--off" : "") : "";
        return `<button type="button" class="mil-key mil-key--sm" data-skill-scope="${esc(sp.key)}" aria-pressed="${skillScope === sp.key}">${fish}<span>${esc(sp.label)}</span></button>`;
      }).join("");

      const scopeFiltered = items.filter((s) => {
        if (skillScope === "custom") return !s.is_preset;
        if (skillScope === "preset") return Boolean(s.is_preset);
        if (skillScope.startsWith("role:")) {
          const rid = skillScope.slice(5);
          return Array.isArray(s.used_by) && s.used_by.includes(rid);
        }
        return true;
      });
      const shownSkills = needle
        ? scopeFiltered.filter((s) => `${s.id} ${s.title || ""} ${s.name || ""} ${s.description || ""} ${(s.companion_files || []).join(" ")}`.toLowerCase().includes(needle))
        : scopeFiltered;

      $("#skills-count").textContent = `${items.length} 项`;
      $("#skills-roster").innerHTML = shownSkills.map((s) => {
        const on = viewMode === "skill-editor" && s.id === selectedSkill;
        const originTag = s.is_preset
          ? (s.is_modified ? `<span class="mil-tag mil-tag--warn">预设·已改</span>` : `<span class="mil-tag mil-tag--ok">预设</span>`)
          : `<span class="mil-tag mil-tag--hot">自建</span>`;
        const compTag = (s.companion_count || 0) > 0
          ? `<span class="mil-tag">附件 ${s.companion_count}</span>`
          : "";
        const usedTxt = (s.used_by || []).length ? `已装配: ${s.used_by.join(" · ")}` : "未装配角色";
        const badgeTxt = (s.id || "SK").slice(0, 2).toUpperCase();
        return `<button type="button" class="sk-item-card" data-skill="${esc(s.id)}" aria-current="${on}">
          <span class="sk-item-ico ${s.is_preset ? "sk-item-ico--preset" : "sk-item-ico--custom"}">${esc(badgeTxt)}</span>
          <span class="sk-item-body">
            <span class="mil-row" style="justify-content:space-between;gap:6px">
              <strong>${esc(s.title || s.id)}</strong>
              <span class="mil-row" style="gap:4px">${originTag}${compTag}<span class="mil-tag num">v${Number(s.version || 0)}</span></span>
            </span>
            ${s.description ? `<span class="sk-item-desc">${esc(s.description)}</span>` : ""}
            <span class="mil-row" style="justify-content:space-between;font-size:11.5px;color:var(--mil-muted)">
              <span class="mono">${esc(s.id)}</span>
              <span>${esc(usedTxt)}</span>
            </span>
          </span>
        </button>`;
      }).join("") || `<div class="mil-screen" style="grid-column:1/-1;text-align:center;padding:24px"><p class="mil-hint">${needle || skillScope !== "all" ? "当前筛选条件下没有匹配的技能" : "暂无全局技能，可点击右上角「导入技能包」或「+ 新建技能」添加"}</p></div>`;

      const foot = $("#skills-summary-foot");
      const clearBtn = $("#clear-skill-filter");
      if (foot) {
        foot.textContent = (needle || skillScope !== "all")
          ? `当前显示 ${shownSkills.length} / ${items.length} 项技能`
          : `共 ${items.length} 项技能`;
      }
      if (clearBtn) clearBtn.hidden = !(needle || skillScope !== "all");

      const activeSkillItem = items.find((s) => s.id === selectedSkill);
      const resetBtn = $("#reset-skill");
      const delSkillBtn = $("#delete-skill");
      if (resetBtn) resetBtn.hidden = !activeSkillItem?.is_preset;
      if (delSkillBtn) delSkillBtn.disabled = Boolean(!selectedSkill || activeSkillItem?.is_preset);

      if (!$("#profiles")) return;
      $("#roles-count").textContent = `${profiles.length} 个`;
      $("#profiles").innerHTML = profiles.map((p) => {
        const on = viewMode === "roles" && p.id === selectedProfile;
        const isEnabled = p.enabled !== false;
        const fishCls = [!isEnabled ? "mil-fish--off" : "", freshFishProfile === p.id ? "is-new" : ""].filter(Boolean).join(" ");
        const chain = Array.isArray(p.model_list) && p.model_list.length ? p.model_list : (p.model_name ? [p.model_name] : []);
        const modelBadge = chain.length ? (chain.length > 1 ? `${chain[0]} +${chain.length - 1}` : chain[0]) : "默认模型";
        const envTxt = p.environment === "sandbox" ? "隔离沙箱" : "轻量环境";
        const accessTxt = ACCESS_LABELS[p.access || "everyone"] || "公开可用";
        return `<button type="button" class="ab-card" data-profile="${esc(p.id)}" data-enabled="${isEnabled}" aria-current="${on}">
          <div class="mil-row" style="gap:9px;align-items:center;flex-wrap:nowrap">
            ${roleFishHtml(p.id, p.fish_seed || "", 36, on && isEnabled ? {} : { still: true }, fishCls)}
            <div style="min-width:0;flex:1;display:flex;flex-direction:column;gap:3px">
              <div class="mil-row" style="justify-content:space-between;gap:6px">
                <strong>${esc(p.title || p.id)}</strong>
                <span class="mil-row" style="gap:4px">
                  <span class="mil-tag ${isEnabled ? "mil-tag--ok" : "mil-tag--off"}">${isEnabled ? "启用" : "已停用"}</span>
                  <span class="mil-tag">${envTxt}</span>
                </span>
              </div>
              <div class="mil-row" style="justify-content:space-between;font-size:11.5px">
                <span class="mono">${esc(p.id)} · ${esc(modelBadge)}</span>
                <span>${esc(accessTxt)} · 技能 ${(p.skills || []).length}</span>
              </div>
            </div>
          </div>
        </button>`;
      }).join("") || `<p class="mil-hint">暂无角色</p>`;
      renderRoleFishPanel();

      const currentProfile = profiles.find((p) => p.id === selectedProfile);
      const toggleBtn = $("#toggle-profile-enabled");
      if (toggleBtn && currentProfile) {
        const currentlyOn = currentProfile.enabled !== false;
        toggleBtn.textContent = currentlyOn ? "停用所选" : "开启所选";
        toggleBtn.className = currentlyOn ? "mil-key mil-key--sm" : "mil-key mil-key--sm mil-key--hot";
      }

      if (viewMode === "skill-editor") {
        renderSkillRoleBindings();
        renderSkillCompanions();
      }
      renderMobRoleCarousel(profiles);
    }

    function renderMobRoleCarousel(profiles) {
      const track = $("#mob-role-carousel");
      const dots = $("#mob-role-dots");
      if (track) {
        track.innerHTML = (profiles || []).map((p) => {
          const on = p.id === selectedProfile;
          const isEnabled = p.enabled !== false;
          const fishCls = [!isEnabled ? "mil-fish--off" : "", freshFishProfile === p.id ? "is-new" : ""].filter(Boolean).join(" ");
          return `<button type="button" class="mob-role-item${on ? " is-active" : ""}" data-mob-role="${esc(p.id)}" role="option" aria-selected="${on}">
            <span class="mob-role-avatar">${roleFishHtml(p.id, p.fish_seed || "", on ? 66 : 44, on && isEnabled ? {} : { still: true }, fishCls)}</span>
            <span class="mob-role-name">${esc(p.title || p.id)}</span>
            <span class="mob-role-sub mono">${esc(p.id)}</span>
          </button>`;
        }).join("");
      }
      if (dots) {
        dots.innerHTML = (profiles || []).map((p) =>
          `<button type="button" class="mob-role-dot${p.id === selectedProfile ? " is-active" : ""}" data-mob-role="${esc(p.id)}" aria-label="切换到 ${esc(p.title || p.id)}"></button>`
        ).join("");
      }
      const cur = (profiles || []).find((p) => p.id === selectedProfile) || (profiles || [])[0];
      if (!cur) return;
      const chain = Array.isArray(cur.model_list) && cur.model_list.length ? cur.model_list : (cur.model_name ? [cur.model_name] : []);
      const titleEl = $("#ab-mob-role-title");
      const envEl = $("#ab-mob-role-env");
      const modEl = $("#ab-mob-val-models");
      const skEl = $("#ab-mob-val-skills");
      const noteEl = $("#ab-mob-val-notes");
      const fishEl = $("#ab-mob-val-fish");
      if (titleEl) titleEl.textContent = `${cur.title || cur.id} · ${cur.id}`;
      if (envEl) envEl.textContent = `${cur.environment === "sandbox" ? "隔离沙箱" : "轻量只读"} · ${cur.enabled !== false ? "已启用" : "已停用"}`;
      if (modEl) modEl.textContent = chain.length ? (chain.length > 1 ? `${chain[0]} (+${chain.length - 1})` : chain[0]) : "默认设置";
      if (skEl) skEl.textContent = `${(cur.skills || []).length} 技能 · ${(cur.tools || []).length} 工具`;
      if (noteEl) noteEl.textContent = $("#document")?.value === "notes" ? "正在查看" : "查看详情";
      if (fishEl) fishEl.textContent = fishDrawerOpen ? "定制中" : "外观定制";
    }

    async function refreshDiscovery(opts = {}) {
      const force = Boolean(opts && opts.force);
      const d = await rpc("read", "discovery", force ? { force: true } : {});
      if (sig?.aborted) return;
      if (!d?.success) {
        $("#discovery-info").textContent = d?.error || "宿主环境探测失败";
        return;
      }
      discoveryLoaded = true;
      const modelGroups = Object.entries(d.models || {});
      const availModels = Array.isArray(d.available_models) ? d.available_models : [];
      const modelCatalog = Array.isArray(d.model_catalog) ? d.model_catalog : [];
      if (availModels.length) catalog.available_models = availModels;
      if (modelCatalog.length) catalog.model_catalog = modelCatalog;
      if (availModels.length || modelCatalog.length) hostModelsProbed = true;
      const pluginList = d.plugins || [];
      const apiList = d.apis || [];
      const streamList = d.streams || [];
      $("#discovery-cards").innerHTML = `
        <div class="mil-row">
          <span class="mil-tag mil-tag--ok">会话流 ${streamList.length}</span>
          <span class="mil-tag">宿主模型 ${availModels.length || modelGroups.length}</span>
          <span class="mil-tag">已加载插件 ${pluginList.length}</span>
          <span class="mil-tag">公开接口 ${apiList.length}</span>
        </div>
      `;
      const streamLines = streamList.map((s) => {
        const plat = String(s.platform || "").toLowerCase();
        const gid = String(s.group_id || (s.group_info && s.group_info.group_id) || "");
        const uid = String(s.user_id || (s.user_info && s.user_info.user_id) || "");
        const spec = s.stream_spec || (plat && (gid || uid) ? `${plat}:${gid ? "group" : "private"}:${gid || uid}` : (s.stream_id || s.session_id || ""));
        const title = s.group_name || s.name || s.nickname || spec;
        return title && title !== spec ? `${title} · ${spec}` : spec;
      }).filter(Boolean);
      const modelLines = modelCatalog.length
        ? modelCatalog.map((m) => m.provider ? `${m.name} (${m.provider})` : m.name)
        : availModels;
      const slotLines = modelGroups.map(([k, v]) => `${SLOT_LABELS[k] || k}：${Array.isArray(v) && v.length ? v.join(" → ") : "随宿主默认"}`);
      const pluginLines = pluginList.map((p) => typeof p === "string" ? p : (p.name || p.plugin_id || JSON.stringify(p))).filter(Boolean);
      const apiLines = apiList.map((a) => `${a.plugin_id || "插件"}.${a.name}${a.description ? ` — ${a.description}` : ""}`);
      $("#discovery-info").innerHTML = [
        `<div class="ms-kv-card"><span class="ms-kv-k">已发现会话流</span><strong class="ms-kv-v num">${streamList.length} 条</strong><span class="ms-kv-sub">${esc(streamLines.slice(0, 8).join("\n") || "暂无活跃会话（收到群或私聊消息后出现，或直接在设置页添加 平台:类型:id）")}</span></div>`,
        `<div class="ms-kv-card"><span class="ms-kv-k">宿主模型清单</span><strong class="ms-kv-v num">${modelLines.length} 个</strong><span class="ms-kv-sub">${esc(modelLines.join("、") || "暂未发现已添加模型（在宿主模型设置中添加后自动同步）")}</span></div>`,
        `<div class="ms-kv-card"><span class="ms-kv-k">默认任务分配</span><strong class="ms-kv-v num">${modelGroups.length} 个槽位</strong><span class="ms-kv-sub">${esc(slotLines.join("\n") || "由宿主自动分配")}</span></div>`,
        `<div class="ms-kv-card"><span class="ms-kv-k">已挂载插件与接口</span><strong class="ms-kv-v num">${pluginLines.length} 插件 · ${apiLines.length} 接口</strong><span class="ms-kv-sub">${esc([...pluginLines.slice(0, 6), ...apiLines.slice(0, 4)].join("\n") || "暂无其他扩展插件")}</span></div>`,
      ].join("");
    }

    async function loadCatalog() {
      const r = await rpc("read", "abilities", {});
      if (!r?.success) return say(r?.error || "读取能力清单失败", true);
      catalog = r;
      if (!catalog.profiles.some((p) => p.id === selectedProfile) && catalog.profiles.length) {
        selectedProfile = catalog.profiles[0].id;
      }
      const items = skillItemsList();
      if (!items.some((s) => s.id === selectedSkill) && items.length) {
        selectedSkill = items[0].id;
      }
      $("#skill-id").value = selectedSkill;
      renderCatalog();
    }

    document.addEventListener("click", async (ev) => {
      const navBtn = ev.target.closest("[data-ab-nav]");
      if (navBtn) {
        const nextMode = navBtn.dataset.abNav;
        if (nextMode === "skills") viewMode = "skills-gallery";
        else if (nextMode === "roles") {
          viewMode = "roles";
          if ($("#document").value === "skill") $("#document").value = "profile";
        } else if (nextMode === "discovery") {
          viewMode = "discovery";
        }
        renderCatalog();
        if (nextMode === "discovery" && !discoveryLoaded) {
          await (discoveryPromise || (discoveryPromise = refreshDiscovery().finally(() => {
            discoveryPromise = null;
          })));
          return;
        }
        await loadAsset(false);
        return;
      }
      const scopeBtn = ev.target.closest("[data-skill-scope]");
      if (scopeBtn) {
        skillScope = scopeBtn.dataset.skillScope;
        renderCatalog();
        return;
      }
      const compBtn = ev.target.closest("[data-companion-path]");
      if (compBtn && selectedSkill) {
        const relPath = compBtn.dataset.companionPath;
        const r = await rpc("read", "skill_file", { target: selectedSkill, path: relPath });
        const prevEl = $("#sk-companion-preview");
        if (!r?.success) return say(r?.error || "读取附属文件失败", true);
        if (prevEl) {
          prevEl.hidden = false;
          prevEl.textContent = r.is_binary
            ? `[二进制文件] ${r.path}（${r.bytes} 字节，工作区只读路径 in/skills/${selectedSkill}/${r.path}）`
            : `${r.path}（${r.bytes} 字节${r.truncated ? "，已截断前 32KB" : ""}）\n────────────────────────\n${r.content || ""}`;
        }
        return;
      }
      const skillBtn = ev.target.closest("[data-skill]");
      if (skillBtn) {
        selectedSkill = skillBtn.dataset.skill;
        $("#skill-id").value = selectedSkill;
        $("#document").value = "skill";
        viewMode = "skill-editor";
        const prevEl = $("#sk-companion-preview");
        if (prevEl) { prevEl.hidden = true; prevEl.textContent = ""; }
        $("#skill-copy-drawer").hidden = true;
        renderCatalog();
        say("");
        await loadAsset(false);
        return;
      }
      const profBtn = ev.target.closest("[data-profile]");
      if (profBtn) {
        selectedProfile = profBtn.dataset.profile;
        viewMode = "roles";
        fishDrawerOpen = false;
        fishDraft = null;
        if ($("#document").value === "skill") $("#document").value = "profile";
        revokeRecipeBlob();
        if ($("#rcp-draft-box")) $("#rcp-draft-box").hidden = true;
        if ($("#rcp-secret-notes-box")) $("#rcp-secret-notes-box").hidden = true;
        renderCatalog();
        say("");
        await loadAsset(false);
        return;
      }
      const mobRoleBtn = ev.target.closest("[data-mob-role]");
      if (mobRoleBtn) {
        selectedProfile = mobRoleBtn.dataset.mobRole;
        viewMode = "roles";
        fishDrawerOpen = false;
        fishDraft = null;
        if ($("#document").value === "skill") $("#document").value = "profile";
        renderCatalog();
        say("");
        await loadAsset(false);
        const activeEl = $(`#mob-role-carousel [data-mob-role="${CSS.escape(selectedProfile)}"]`);
        try { activeEl?.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" }); } catch (_) {}
        return;
      }
      const mobStepBtn = ev.target.closest("[data-mob-step]");
      if (mobStepBtn) {
        const profiles = catalog.profiles || [];
        if (profiles.length) {
          const curIdx = Math.max(0, profiles.findIndex((p) => p.id === selectedProfile));
          const delta = Number(mobStepBtn.dataset.mobStep || 0);
          const nextIdx = (curIdx + delta + profiles.length) % profiles.length;
          selectedProfile = profiles[nextIdx].id;
          viewMode = "roles";
          fishDrawerOpen = false;
          fishDraft = null;
          renderCatalog();
          say("");
          await loadAsset(false);
          const activeEl = $(`#mob-role-carousel [data-mob-role="${CSS.escape(selectedProfile)}"]`);
          try { activeEl?.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" }); } catch (_) {}
        }
        return;
      }
      const mobJumpBtn = ev.target.closest("[data-mob-role-jump]");
      if (mobJumpBtn) {
        const kind = mobJumpBtn.dataset.mobRoleJump;
        viewMode = "roles";
        if (kind === "notes") {
          $("#document").value = "notes";
          renderCatalog();
          await loadAsset(false);
          $("#editor-panel")?.scrollIntoView({ behavior: "smooth", block: "start" });
        } else if (kind === "fish") {
          fishDrawerOpen = true;
          if (!fishDraft && selectedProfile) fishDraft = fishDraftForProfile(selectedProfile);
          renderDocModeUI();
          $("#role-fish-bar")?.scrollIntoView({ behavior: "smooth", block: "start" });
        } else {
          $("#document").value = "config";
          renderCatalog();
          await loadAsset(false);
          if (kind === "skills") {
            const det = $("#cfg-advanced-fields");
            if (det) det.open = true;
            $("#cfg-tools")?.scrollIntoView({ behavior: "smooth", block: "start" });
          } else {
            $("#cfg-model-chain")?.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        }
        return;
      }
      const docTab = ev.target.closest("[data-doc-tab]");
      if (docTab) {
        $("#document").value = docTab.dataset.docTab;
        if (docTab.dataset.docTab !== "skill") viewMode = "roles";
        renderCatalog();
        say("");
        await loadAsset(false);
        return;
      }
      const snipBtn = ev.target.closest("[data-sk-snippet]");
      if (snipBtn) {
        const snippets = {
          scene: "\n## 适用场景\n- 说明在什么话题、指令或周期节奏下启用本技能。\n",
          steps: "\n## 执行步骤\n1. 先检索一手来源或工作区记录。\n2. 按规则筛选并结构化输出。\n",
          guard: "\n## 质量边界\n- 仅引用本轮工具核实过的数据与链接，区分事实与推断。\n",
        };
        const chunk = snippets[snipBtn.dataset.skSnippet] || "";
        if (chunk) {
          $("#content").value = ($("#content").value || "").replace(/\s+$/, "") + "\n" + chunk;
          setDirty(true);
          syncSkillVisualFromMarkdown();
        }
        return;
      }
      const fishPick = ev.target.closest("[data-fish-pick]");
      if (fishPick && selectedProfile) {
        const k = fishPick.dataset.fishPick;
        const v = fishPick.dataset.fishVal;
        const d = { ...(fishDraft || fishDraftForProfile(selectedProfile)) };
        if (k === "color") d[k] = Number(v);
        else d[k] = v;
        fishDraft = d;
        renderRoleFishPanel();
        $(`.fish-drawer [data-fish-pick="${k}"][data-fish-val="${CSS.escape(v)}"]`)?.focus();
      }
    }, { signal: sig });

    $("#back-to-skills").onclick = async () => {
      viewMode = "skills-gallery";
      const prevEl = $("#sk-companion-preview");
      if (prevEl) { prevEl.hidden = true; prevEl.textContent = ""; }
      renderDocModeUI();
      await loadCatalog();
    };
    $("#refresh-skills").onclick = loadCatalog;
    $("#open-import-skill").onclick = () => {
      $("#skill-add-drawer").hidden = false;
      $("#import-skill-id")?.focus();
    };
    $("#open-create-skill").onclick = () => {
      $("#skill-add-drawer").hidden = false;
      $("#new-skill-id")?.focus();
    };
    $("#close-add-drawer").onclick = () => { $("#skill-add-drawer").hidden = true; };
    $("#clear-skill-filter").onclick = () => {
      skillFilter = "";
      skillScope = "all";
      $("#skill-filter").value = "";
      renderCatalog();
    };

    $("#skill-filter").addEventListener("input", () => {
      skillFilter = $("#skill-filter").value;
      renderCatalog();
    });

    $("#document").addEventListener("change", async () => {
      if ($("#document").value === "skill" && !selectedSkill && catalog.skills?.length) {
        selectedSkill = catalog.skills[0];
        $("#skill-id").value = selectedSkill;
      }
      renderCatalog();
      say("");
      await loadAsset(false);
    });

    $("#content").addEventListener("input", () => {
      setDirty(true);
      if ($("#document").value === "config") syncVisualFromToml();
      if ($("#document").value === "skill") syncSkillVisualFromMarkdown();
    });

    ["sk-meta-name", "sk-meta-desc"].forEach((id) => {
      const field = id === "sk-meta-name" ? "name" : "description";
      $(`#${id}`).addEventListener("input", () => {
        setDirty(true);
        writeSkillFrontmatter(field, $(`#${id}`).value);
      });
    });

    $("#sk-role-bindings").addEventListener("change", async (ev) => {
      const cb = ev.target.closest("[data-bind-role]");
      if (!cb || !selectedSkill) return;
      const roleId = cb.dataset.bindRole;
      const nextBound = cb.checked;
      cb.disabled = true;
      say("");
      try {
        const r = await rpc("write", "bind_skill", { skill: selectedSkill, profile: roleId, bound: nextBound });
        if (sig?.aborted) return;
        if (!r?.success) {
          cb.checked = !nextBound;
          return say(r?.error || "装配角色失败", true);
        }
        await loadCatalog();
        if (!sig?.aborted && $("#document")?.value === "config" && selectedProfile === roleId) await loadAsset(false);
        say(nextBound ? `已将技能 ${selectedSkill} 装配给角色 ${roleId}` : `已从角色 ${roleId} 卸下技能 ${selectedSkill}`);
      } finally {
        cb.disabled = false;
      }
    });

    ["cfg-title", "cfg-env", "cfg-access", "cfg-task", "cfg-web"].forEach((id) => {
      const key = { "cfg-title": "title", "cfg-env": "environment", "cfg-access": "access", "cfg-task": "task", "cfg-web": "web_provider" }[id];
      $(`#${id}`).addEventListener("input", () => {
        setDirty(true);
        const val = $(`#${id}`).value.trim();
        writeTomlKey(key, (val || key !== "web_provider") ? tomlStr(val) : null);
        if (id === "cfg-task") renderModelChainEditor();
        if (id === "cfg-access") renderRoleScopeEditor();
      });
    });
    if ($("#cfg-model-picker")) {
      $("#cfg-model-picker").addEventListener("change", () => {
        const picked = $("#cfg-model-picker").value.trim();
        if (picked) addModelToChain(picked);
      });
    }
    if ($("#cfg-model-add")) {
      $("#cfg-model-add").onclick = () => {
        const raw = $("#cfg-model-name")?.value.trim() || "";
        if (!raw) return;
        addModelToChain(raw);
        if ($("#cfg-model-name")) $("#cfg-model-name").value = "";
      };
    }
    if ($("#cfg-model-name")) {
      $("#cfg-model-name").addEventListener("keydown", (ev) => {
        if (ev.key === "Enter") {
          ev.preventDefault();
          $("#cfg-model-add")?.click();
        }
      });
    }
    if ($("#cfg-model-sync")) {
      $("#cfg-model-sync").onclick = async () => {
        const btn = $("#cfg-model-sync");
        btn.disabled = true;
        try {
          const r = await rpc("read", "abilities", {});
          if (r?.success) {
            if (Array.isArray(r.available_models)) catalog.available_models = r.available_models;
            if (Array.isArray(r.model_catalog)) catalog.model_catalog = r.model_catalog;
            if (r.model_tasks) catalog.model_tasks = r.model_tasks;
          }
          if (!(catalog.model_catalog || []).some((m) => m && m.source === "host_config")) {
            hostModelsProbed = true;
            await refreshDiscovery();
          }
          renderModelChainEditor();
          say("已同步宿主模型列表");
        } finally {
          btn.disabled = false;
        }
      };
    }
    if ($("#cfg-model-clear")) {
      $("#cfg-model-clear").onclick = () => {
        if ($("#cfg-model-name")) $("#cfg-model-name").value = "";
        applyModelChainToToml([]);
      };
    }
    if ($("#cfg-model-apply")) {
      $("#cfg-model-apply").onclick = async () => {
        if (!selectedProfile) return;
        const pending = $("#cfg-model-name")?.value.trim();
        if (pending) {
          addModelToChain(pending);
          if ($("#cfg-model-name")) $("#cfg-model-name").value = "";
        }
        const btn = $("#cfg-model-apply");
        btn.disabled = true;
        say("");
        try {
          const r = await rpc("write", "set_profile_models", {
            profile_id: selectedProfile,
            models: getTomlModelChain(),
            fallback_slot: $("#cfg-task")?.value || "",
            expected_version: expectedVersion,
          });
          if (!r?.success) {
            if (String(r?.error || "").includes("未知管理操作")) {
              $("#save")?.click();
              return;
            }
            return say(r?.error || "应用模型顺序失败", true);
          }
          expectedVersion = Number(r.version ?? expectedVersion);
          $("#version").textContent = `v${expectedVersion}`;
          $("#draft-panel").hidden = true;
          await loadCatalog();
          if (viewMode === "roles" && $("#document")?.value === "config") await loadAsset(false);
          say("已应用角色模型顺序");
        } finally {
          btn.disabled = false;
        }
      };
    }
    themeListeners.push(() => {
      if (viewMode === "roles" && $("#document")?.value === "config") renderModelChainEditor();
    });
    ["cfg-steps", "cfg-temp"].forEach((id) => {
      const key = id === "cfg-steps" ? "max_steps" : "temperature";
      $(`#${id}`).addEventListener("input", () => {
        setDirty(true);
        const val = $(`#${id}`).value.trim();
        writeTomlKey(key, val === "" ? null : String(Number(val)));
      });
    });
    $("#cfg-visual").addEventListener("click", (ev) => {
      const moveBtn = ev.target.closest("[data-model-move]");
      if (moveBtn) {
        const idx = Number(moveBtn.dataset.modelIdx);
        const chain = getTomlModelChain();
        const swapWith = moveBtn.dataset.modelMove === "up" ? idx - 1 : idx + 1;
        if (swapWith >= 0 && swapWith < chain.length) {
          [chain[idx], chain[swapWith]] = [chain[swapWith], chain[idx]];
          applyModelChainToToml(chain);
        }
        return;
      }
      const rmBtn = ev.target.closest("[data-model-rm]");
      if (rmBtn) {
        const idx = Number(rmBtn.dataset.modelRm);
        const chain = getTomlModelChain();
        chain.splice(idx, 1);
        applyModelChainToToml(chain);
        return;
      }
      if (ev.target.id === "cfg-add-known-chat") {
        const spec = normalizeScopeChat($("#cfg-pick-known-chat")?.value || "");
        if (!spec) return say("请先选择一条会话", true);
        const p = parseSimpleToml($("#content").value);
        const list = Array.isArray(p.allow_chats) ? [...p.allow_chats] : [];
        if (!list.includes(spec)) {
          list.push(spec);
          setDirty(true);
          writeTomlKey("allow_chats", tomlArr(list));
          renderRoleScopeEditor();
        }
        return;
      }
      if (ev.target.id === "cfg-add-chat-btn") {
        const plat = ($("#cfg-chat-plat")?.value || "qq").trim().toLowerCase();
        const ctype = ($("#cfg-chat-type")?.value || "group").trim().toLowerCase();
        const raw = ($("#cfg-chat-id")?.value || "").trim();
        if (!raw) return say("请输入群号或用户 ID", true);
        const spec = /^(?:chat:)?[a-z][a-z0-9_-]*:(group|private):[^\s:][^\s]*$/i.test(raw)
          ? normalizeScopeChat(raw)
          : `${plat}:${ctype}:${raw}`;
        const p = parseSimpleToml($("#content").value);
        const list = Array.isArray(p.allow_chats) ? [...p.allow_chats] : [];
        if (!list.includes(spec)) {
          list.push(spec);
          setDirty(true);
          writeTomlKey("allow_chats", tomlArr(list));
          renderRoleScopeEditor();
        }
        return;
      }
      const rmChatBtn = ev.target.closest("[data-cfg-rm-chat]");
      if (rmChatBtn) {
        const idx = Number(rmChatBtn.dataset.cfgRmChat);
        const p = parseSimpleToml($("#content").value);
        const list = Array.isArray(p.allow_chats) ? [...p.allow_chats] : [];
        list.splice(idx, 1);
        setDirty(true);
        writeTomlKey("allow_chats", list.length ? tomlArr(list) : null);
        renderRoleScopeEditor();
        return;
      }
      if (ev.target.id === "cfg-add-user-btn") {
        const plat = ($("#cfg-user-plat")?.value || "qq").trim().toLowerCase();
        const raw = ($("#cfg-user-id")?.value || "").trim();
        if (!raw) return say("请输入成员账号", true);
        let entry = `${plat}:${raw}`;
        if (raw.includes(":")) {
          const idx = raw.indexOf(":");
          const pPart = raw.slice(0, idx).trim().toLowerCase();
          const rest = raw.slice(idx + 1).trim();
          const mPriv = rest.match(/^(private):(.+)$/i);
          if (mPriv) {
            entry = `${pPart || plat}:${mPriv[1].toLowerCase()}:${mPriv[2].trim()}`;
          } else {
            entry = `${pPart || plat}:${rest}`;
          }
        }
        const p = parseSimpleToml($("#content").value);
        const list = Array.isArray(p.allow_users) ? [...p.allow_users] : [];
        if (!list.includes(entry)) {
          list.push(entry);
          setDirty(true);
          writeTomlKey("allow_users", tomlArr(list));
          renderRoleScopeEditor();
        }
        return;
      }
      const rmUserBtn = ev.target.closest("[data-cfg-rm-user]");
      if (rmUserBtn) {
        const idx = Number(rmUserBtn.dataset.cfgRmUser);
        const p = parseSimpleToml($("#content").value);
        const list = Array.isArray(p.allow_users) ? [...p.allow_users] : [];
        list.splice(idx, 1);
        setDirty(true);
        writeTomlKey("allow_users", list.length ? tomlArr(list) : null);
        renderRoleScopeEditor();
      }
    });
    $("#cfg-visual").addEventListener("keydown", (ev) => {
      if (ev.key !== "Enter") return;
      if (ev.target.id === "cfg-chat-id") {
        ev.preventDefault();
        $("#cfg-add-chat-btn")?.click();
      } else if (ev.target.id === "cfg-user-id") {
        ev.preventDefault();
        $("#cfg-add-user-btn")?.click();
      }
    });
    $("#cfg-visual").addEventListener("change", (ev) => {
      if (ev.target.id === "cfg-enabled") {
        setDirty(true);
        writeTomlKey("enabled", ev.target.checked ? "true" : "false");
      } else if (ev.target.matches("[data-cfg-tool]")) {
        setDirty(true);
        const tools = $$("[data-cfg-tool]:checked").map((x) => x.dataset.cfgTool);
        writeTomlKey("tools", tomlArr(tools));
      } else if (ev.target.matches("[data-cfg-skill]")) {
        setDirty(true);
        const skills = $$("[data-cfg-skill]:checked").map((x) => x.dataset.cfgSkill);
        writeTomlKey("skills", tomlArr(skills));
      }
    });

    $("#save").onclick = async () => {
      if (viewMode === "roles" && $("#document")?.value === "config") {
        const pendingModel = $("#cfg-model-name")?.value.trim();
        if (pendingModel) {
          addModelToChain(pendingModel);
          if ($("#cfg-model-name")) $("#cfg-model-name").value = "";
        }
      }
      const q = targetQuery();
      $("#save").disabled = true;
      say("");
      try {
        const r = await rpc("write", "asset", { ...q, content: $("#content").value, expected_version: expectedVersion });
        if (!r?.success) return say(r?.error || "保存失败", true);
        expectedVersion = Number(r.version || 0);
        $("#version").textContent = `v${expectedVersion}`;
        $("#draft-panel").hidden = true;
        await loadCatalog();
        await loadAsset(false);
        say("已保存");
      } finally {
        $("#save").disabled = false;
      }
    };
    $("#reload").onclick = async () => { await loadAsset(true); say("已读取最新版本。"); };
    $("#restore").onclick = async () => {
      const q = targetQuery();
      const ver = Number($("#history").value);
      say("");
      const r = await rpc("write", "rollback", { ...q, version: ver, expected_version: expectedVersion });
      if (!r?.success) return say(r?.error || "回滚失败", true);
      await loadCatalog();
      await loadAsset(false);
      say(`已回滚至 v${ver}`);
    };

    $("#create-skill").onclick = async () => {
      const target = $("#new-skill-id").value.trim();
      const title = $("#new-skill-title")?.value.trim() || "";
      if (!target) return say("请先填写新技能编号", true);
      const r = await rpc("write", "create_skill", { target, title });
      if (!r?.success) return say(r?.error || "创建技能失败", true);
      selectedSkill = r.id;
      $("#skill-id").value = selectedSkill;
      $("#new-skill-id").value = "";
      if ($("#new-skill-title")) $("#new-skill-title").value = "";
      $("#skill-add-drawer").hidden = true;
      $("#document").value = "skill";
      viewMode = "skill-editor";
      say(`已创建技能 ${selectedSkill}`);
      await loadCatalog();
      await loadAsset(false);
    };
    $("#clone-skill").onclick = async () => {
      const target = $("#clone-skill-id").value.trim();
      if (!target) return say("请先填写复制后的新技能编号", true);
      if (!selectedSkill) return say("请先选择要复制的技能", true);
      const r = await rpc("write", "create_skill", { target, base: selectedSkill });
      if (!r?.success) return say(r?.error || "复制技能失败", true);
      selectedSkill = r.id;
      $("#skill-id").value = selectedSkill;
      $("#clone-skill-id").value = "";
      $("#document").value = "skill";
      viewMode = "skill-editor";
      say(`已复制生成技能 ${selectedSkill}`);
      await loadCatalog();
      await loadAsset(false);
    };
    $("#reset-skill").onclick = async () => {
      if (!selectedSkill) return;
      const r = await rpc("write", "reset_skill", { target: selectedSkill });
      if (!r?.success) return say(r?.error || "重置预设技能失败", true);
      $("#document").value = "skill";
      viewMode = "skill-editor";
      say(`已重置预设技能 ${selectedSkill}`);
      await loadCatalog();
      await loadAsset(false);
    };
    $("#delete-skill").onclick = async () => {
      const target = selectedSkill || $("#skill-id").value.trim();
      if (!target) return say("请先选择要删除的技能", true);
      const r = await rpc("write", "delete_skill", { target });
      if (!r?.success) return say(r?.error || "删除技能失败", true);
      selectedSkill = "";
      $("#skill-id").value = "";
      viewMode = "skills-gallery";
      say(`已删除技能 ${target}`);
      await loadCatalog();
      renderDocModeUI();
    };
    $("#export-skill").onclick = async () => {
      if (!selectedSkill) return;
      let token = "", offset = 0, chunks = [];
      for (let guard = 0; guard < 120; guard++) {
        const r = await rpc("read", "skill_package", { target: selectedSkill, token, offset });
        if (!r?.success) return say(r?.error || "导出技能包失败", true);
        token = r.token;
        chunks.push(r.data);
        offset = r.offset;
        if (offset >= r.total) break;
      }
      $("#skill-copy-summary").textContent = `技能包 Base64 ZIP（含 SKILL.md 与全部附属文件，可全选复制导入另一份 Maisya）`;
      $("#skill-copy-box").value = chunks.join("");
      $("#skill-copy-drawer").hidden = false;
      $("#skill-copy-drawer").open = true;
      $("#skill-copy-box").focus();
      $("#skill-copy-box").select();
      say(`已打包导出技能 ${selectedSkill}`);
    };
    $("#copy-skill").onclick = async () => {
      const text = $("#content").value || "";
      if (!text) return say("当前技能内容为空", true);
      let copied = false;
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          copied = true;
        }
      } catch {}
      if (copied) {
        say("已复制 SKILL.md 内容到剪贴板。");
      } else {
        $("#skill-copy-summary").textContent = "手动复制 SKILL.md（沙箱受限时可全选复制）";
        $("#skill-copy-box").value = text;
        $("#skill-copy-drawer").hidden = false;
        $("#skill-copy-drawer").open = true;
        $("#skill-copy-box").focus();
        $("#skill-copy-box").select();
        say("已展开复制框并全选，请按 Ctrl/Cmd + C 复制。");
      }
    };
    function uint8ToB64(bytes) {
      let bin = "";
      for (let i = 0; i < bytes.length; i += 8192) {
        bin += String.fromCharCode(...bytes.subarray(i, i + 8192));
      }
      return btoa(bin);
    }
    async function uploadSkillBytes(bytes, filename, targetOverride = "") {
      const target = (targetOverride || $("#import-skill-id")?.value || "").trim();
      let token = "", offset = 0, lastResult = null;
      const chunkBytes = 18432;
      for (let i = 0; i < bytes.length || i === 0; i += chunkBytes) {
        const slice = bytes.subarray(i, i + chunkBytes);
        const done = i + chunkBytes >= bytes.length;
        const r = await rpc("write", "import_skill", {
          target,
          filename: filename || "",
          token,
          offset,
          data: uint8ToB64(slice),
          done,
          overwrite: true,
        });
        if (!r?.success) return say(r?.error || "导入技能包失败", true);
        token = r.token || token;
        offset = r.offset ?? offset;
        lastResult = r;
      }
      if ($("#import-skill-id")) $("#import-skill-id").value = "";
      $("#skill-add-drawer").hidden = true;
      await loadCatalog();
      if ((lastResult?.count || 0) > 1) {
        const names = (lastResult.imported || []).map((x) => x.id).join("、");
        viewMode = "skills-gallery";
        renderCatalog();
        renderDocModeUI();
        say(`已从压缩包批量导入 ${lastResult.count} 项技能：${names}`);
      } else if (lastResult?.id) {
        selectedSkill = lastResult.id;
        $("#skill-id").value = selectedSkill;
        $("#document").value = "skill";
        viewMode = "skill-editor";
        renderCatalog();
        const compCount = lastResult.imported?.[0]?.companions || 0;
        await loadAsset(false);
        say(compCount > 0 ? `已导入技能 ${selectedSkill}（含 ${compCount} 个附属文件）` : `已导入技能 ${selectedSkill}`);
      }
    }
    async function uploadSkillB64(b64, filename = "package.zip", targetOverride = "") {
      const clean = String(b64 || "").replace(/\s+/g, "");
      if (!clean) return say("请先粘贴技能包 Base64 文本", true);
      const bin = atob(clean);
      const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      await uploadSkillBytes(bytes, filename, targetOverride);
    }
    $("#import-skill-b64").onclick = async () => {
      try {
        await uploadSkillB64($("#skill-pkg-text").value);
      } catch (err) {
        say(err?.message || "技能包文本格式无效", true);
      }
    };
    $("#skill-file").addEventListener("change", () => {
      const file = $("#skill-file").files?.[0];
      if (!file) return;
      const lower = (file.name || "").toLowerCase();
      const reader = new FileReader();
      reader.onload = async () => {
        const bytes = new Uint8Array(reader.result);
        await uploadSkillBytes(bytes, file.name);
        $("#skill-file").value = "";
      };
      reader.readAsArrayBuffer(file);
    });
    ["skills-gallery-panel", "skill-dropzone"].forEach((zoneId) => {
      const el = $(`#${zoneId}`);
      if (!el) return;
      el.addEventListener("dragover", (ev) => {
        ev.preventDefault();
        el.setAttribute("data-drag", "true");
      });
      el.addEventListener("dragleave", () => {
        el.removeAttribute("data-drag");
      });
      el.addEventListener("drop", async (ev) => {
        ev.preventDefault();
        el.removeAttribute("data-drag");
        const file = ev.dataTransfer?.files?.[0];
        if (!file) return;
        const buf = await file.arrayBuffer();
        await uploadSkillBytes(new Uint8Array(buf), file.name);
      });
    });

    $("#clone").onclick = async () => {
      const target = $("#new-id").value.trim();
      const r = await rpc("write", "clone", { base: selectedProfile, target });
      if (!r?.success) return say(r?.error || "克隆失败", true);
      selectedProfile = r.id;
      $("#new-id").value = "";
      $("#document").value = "profile";
      viewMode = "roles";
      say("新角色已创建");
      await loadCatalog();
      await loadAsset(false);
    };
    $("#toggle-profile-enabled").onclick = async () => {
      const currentProfile = (catalog.profiles || []).find((p) => p.id === selectedProfile);
      const nextEnabled = currentProfile ? currentProfile.enabled === false : true;
      const r = await rpc("write", "toggle_profile", { target: selectedProfile, enabled: nextEnabled });
      if (sig?.aborted) return;
      if (!r?.success) return say(r?.error || "切换启用状态失败", true);
      say(nextEnabled ? `已开启角色 ${selectedProfile}` : `已停用角色 ${selectedProfile}`);
      await loadCatalog();
      if (!sig?.aborted && $("#document")?.value === "config") await loadAsset(false);
    };
    $("#delete-profile").onclick = async () => {
      const r = await rpc("write", "delete_profile", { target: selectedProfile });
      if (!r?.success) return say(r?.error || "删除角色失败", true);
      await loadCatalog();
      await loadAsset(false);
      say("已删除所选角色");
    };

    let activeRecipePreview = null;
    let activeRecipeBlobUrl = "";

    function revokeRecipeBlob() {
      if (activeRecipeBlobUrl) {
        try { URL.revokeObjectURL(activeRecipeBlobUrl); } catch {}
        activeRecipeBlobUrl = "";
      }
      const dl = $("#rcp-download-link");
      if (dl) {
        dl.hidden = true;
        dl.removeAttribute("href");
      }
    }
    sig?.addEventListener("abort", revokeRecipeBlob, { once: true });

    function recipeDraftOptions() {
      const secret_notes = {};
      $$("[data-secret-note]").forEach((inp) => {
        const h = inp.dataset.secretNote;
        const v = inp.value.trim();
        if (h && v) secret_notes[h] = v;
      });
      return {
        include_skills: $("#rcp-inc-skills")?.checked !== false,
        include_notes: $("#rcp-inc-notes")?.checked !== false,
        include_presets: $("#rcp-inc-presets")?.checked !== false,
        include_routines: $("#rcp-inc-routines")?.checked !== false,
        secret_notes,
      };
    }

    function renderDraftCheckup(d) {
      const box = $("#rcp-draft-box");
      const secBox = $("#rcp-secret-notes-box");
      if (!box) return;
      box.hidden = false;
      const st = d.stripped || {};
      const creds = d.manifest?.dependencies?.credentials || [];
      if (secBox) {
        if (creds.length) {
          const prevVals = {};
          $$("[data-secret-note]").forEach((el) => { prevVals[el.dataset.secretNote] = el.value; });
          secBox.hidden = false;
          secBox.innerHTML = `<span class="mil-label">凭据句柄用途说明（仅导出句柄名与用途提示，绝不导出密钥明文）</span>` + creds.map((c) =>
            `<div class="mil-row"><span class="mil-tag mono">${esc(c.handle)}</span><input class="mil-input" style="flex:1 1 180px" data-secret-note="${esc(c.handle)}" value="${esc(prevVals[c.handle] ?? c.purpose ?? "")}" placeholder="填写接收方如何获取或配置此凭据"></div>`
          ).join("");
        } else {
          secBox.hidden = true;
          secBox.innerHTML = "";
        }
      }
      const findings = d.findings || [];
      const strippedTxt = `已剥离本机会话白名单 ${st.allow_chats || 0} 项 · 用户白名单 ${st.allow_users || 0} 项 · 例行任务会话号 ${st.routine_chat_ids || 0} 项`;
      const assetSummary = d.file_list
        ? `拟打包文件 ${d.file_list.length} 个（技能 ${(d.manifest?.skills || []).length} 项 · 例行工作流 ${(d.manifest?.routines || []).length} 项）`
        : `导出大小 ${d.bytes || 0} B（技能 ${(d.manifest?.skills || []).length} 项 · 例行工作流 ${(d.manifest?.routines || []).length} 项）`;
      const findingHtml = findings.length
        ? findings.map((f) => {
            const cls = f.severity === "blocker" ? "mil-tag--bad" : "mil-tag--warn";
            const lbl = f.severity === "blocker" ? "阻断" : "提示";
            return `<div class="mil-row" style="margin-top:4px"><span class="mil-tag ${cls}">${lbl}</span><span class="mono">${esc(f.path)}</span><span>${esc(f.message)}</span></div>`;
          }).join("")
        : `<div class="mil-row" style="margin-top:4px"><span class="mil-tag mil-tag--ok">隐私体检通过</span><span>未检出凭据明文、内网地址、群号或本机路径特征</span></div>`;
      const mdHtml = d.recipe_markdown
        ? `<details style="margin-top:6px"><summary class="mil-label" style="cursor:pointer">查看人类可读依赖清单 (RECIPE.md)</summary><pre class="mil-pre" style="margin-top:4px;max-height:160px">${esc(d.recipe_markdown)}</pre></details>`
        : "";
      box.innerHTML = `<div class="mil-row"><span class="mil-tag">${esc(assetSummary)}</span><span class="mil-tag">${esc(strippedTxt)}</span></div>${findingHtml}${mdHtml}`;
    }

    async function refreshRecipeDraft() {
      if (!selectedProfile) return;
      say("");
      const r = await rpc("read", "recipe_draft", { target: selectedProfile, ...recipeDraftOptions() });
      if (!r?.success) return say(r?.error || "生成配方草稿失败", true);
      renderDraftCheckup(r);
      say(r.can_export ? `已完成 ${selectedProfile} 配方草稿与隐私体检` : `检测到阻断级敏感内容，请先清理后再导出`, !r.can_export);
    }

    function syncRecipeRoutineGuard() {
      if (!activeRecipePreview?.routines?.length) return;
      const sel = $("#rcp-routine-chat");
      if (!sel) return;
      const mode = $("#rcp-mode-update")?.checked && !$("#rcp-mode-update")?.disabled ? "update" : "copy";
      let readyToMount = false;
      if (mode === "copy") {
        readyToMount = (activeRecipePreview.profile?.enabled !== false) && !activeRecipePreview.alignment?.requires_rebind;
      } else {
        const typed = $("#import-id")?.value?.trim() || activeRecipePreview.suggested_target;
        const catalogProf = (catalog.profiles || []).find((p) => p.id === typed);
        const ex = (activeRecipePreview.existing_profile?.id === typed ? activeRecipePreview.existing_profile : null) || catalogProf;
        const baseEnabled = ex ? ex.enabled !== false : activeRecipePreview.profile?.enabled !== false;
        const baseBound = ex ? ex.bound !== false : !activeRecipePreview.alignment?.requires_rebind;
        readyToMount = baseEnabled && baseBound && !activeRecipePreview.alignment?.missing_binding;
      }
      Array.from(sel.options || []).forEach((opt) => {
        if (opt.value !== "") opt.disabled = !readyToMount;
      });
      if (!readyToMount) {
        sel.value = "";
        sel.title = "角色导入后处于停用或待绑定凭据状态，请先仅导入角色，完成启用/绑定后再挂载定时工作流";
      } else {
        sel.title = "";
      }
    }

    function syncRecipeImportModeUI() {
      if (!activeRecipePreview) return;
      const pv = activeRecipePreview;
      const typed = $("#import-id").value.trim();
      const existsInCatalog = (catalog.profiles || []).some((p) => p.id === (typed || pv.suggested_target));
      const canUpdate = Boolean(pv.existing_profile || existsInCatalog);
      const updRadio = $("#rcp-mode-update");
      const copyRadio = $("#rcp-mode-copy");
      if (updRadio) updRadio.disabled = !canUpdate;
      if (!canUpdate && updRadio?.checked && copyRadio) copyRadio.checked = true;
      syncRecipeRoutineGuard();
    }

    function renderRecipePreview(pv) {
      activeRecipePreview = pv;
      const card = $("#rcp-preview-card");
      const confirmBtn = $("#rcp-confirm-import");
      if (!card || !confirmBtn) return;
      card.hidden = false;
      confirmBtn.hidden = false;
      $("#package-panel").open = true;

      $("#rcp-pv-source").textContent = `${pv.source_url ? "公开链接" : "本地包"} · ${pv.source_id}`;
      const prof = pv.profile || {};
      const skills = pv.skills || [];
      const skillTags = skills.length
        ? skills.map((s) => `<span class="mil-tag ${s.bundled ? "mil-tag--ok" : "mil-tag--warn"}">${esc(s.id)}${s.companions_count ? ` (+${s.companions_count})` : ""}${s.exists_locally ? " · 本地已有" : ""}</span>`).join(" ")
        : `<span class="mil-hint">无附加技能</span>`;
      const exBanner = pv.existing_profile
        ? `<div class="mil-row" style="margin-top:4px"><span class="mil-tag mil-tag--warn">检测到本地同名角色 ${esc(pv.existing_profile.id)}</span><span class="mil-hint">可选「平滑升级」保留本地白名单(${pv.existing_profile.allow_chats_count || 0} 会话)/启停/工作区并可回滚，或另存为 ${esc(pv.suggested_copy_id)}</span></div>`
        : "";
      $("#rcp-pv-summary").innerHTML = `
        <div class="mil-row" style="gap:10px;align-items:center">
          ${roleFishHtml(prof.id || pv.source_id, prof.fish_seed || "", 44, {}, "mil-fish--well")}
          <div class="mil-row" style="gap:6px;flex:1;min-width:0">
            <strong>${esc(prof.title || prof.id)}</strong>
            <span class="mil-tag mono">${esc(prof.environment || "readonly")}</span>
            <span class="mil-tag mono">task:${esc(prof.task || "utils")}</span>
            <span class="mil-tag">工具 ${(prof.tools || []).length} 项</span>
            ${prof.has_notes ? `<span class="mil-tag">含 NOTES.md</span>` : ""}
            ${(prof.preset_files || []).length ? `<span class="mil-tag">预设文件 ${prof.preset_files.length}</span>` : ""}
          </div>
        </div>
        ${prof.summary ? `<p class="mil-hint" style="margin-top:4px">${esc(prof.summary)}</p>` : ""}
        <div class="mil-row" style="margin-top:4px"><span class="mil-label">技能集：</span>${skillTags}</div>
        ${exBanner}
      `;

      const alignItems = pv.alignment?.items || [];
      $("#rcp-pv-alignment").innerHTML = `<span class="mil-label">本机环境与依赖对齐检查：</span>` + (
        alignItems.length
          ? alignItems.map((it) => {
              const cls = it.status === "ready" ? "mil-tag--ok" : it.status === "fallback" ? "mil-tag--warn" : "mil-tag--bad";
              const txt = it.status === "ready" ? "就绪" : it.status === "fallback" ? "轻量降级可用" : "缺件待绑";
              return `<div class="mil-row"><span class="mil-tag ${cls}">${txt}</span><strong>${esc(it.name)}</strong><span class="mil-hint">${esc(it.detail || "")}</span></div>`;
            }).join("")
          : `<div class="mil-row"><span class="mil-tag mil-tag--ok">即装即用</span><span class="mil-hint">纯内置能力配方，本机无需额外凭据或外部服务</span></div>`
      );

      const warns = pv.privacy_warnings || [];
      const warnEl = $("#rcp-pv-warnings");
      if (warnEl) {
        warnEl.hidden = !warns.length;
        warnEl.innerHTML = warns.map((w) => `<div class="mil-row"><span class="mil-tag mil-tag--warn">来源提示</span><span class="mono">${esc(w.path)}</span><span class="mil-hint">${esc(w.message)}</span></div>`).join("");
      }

      const routines = pv.routines || [];
      const rtWrap = $("#rcp-pv-routines-wrap");
      if (rtWrap) {
        rtWrap.hidden = !routines.length;
        if (routines.length) {
          const chats = pv.enabled_chats || [];
          $("#rcp-routine-chat").innerHTML = [
            `<option value="">暂不挂载（仅导入角色）</option>`,
            ...chats.map((c) => `<option value="${esc(c)}">挂载至 ${esc(scopeKnownName(c))}</option>`),
          ].join("");
          $("#rcp-pv-routines").innerHTML = routines.map((rt) => {
            const period = rt.every_seconds ? `每 ${rt.every_seconds} 秒` : "单次";
            return `<label class="mil-chk" style="justify-content:flex-start"><input type="checkbox" data-rcp-routine="${esc(rt.id)}" checked><span><strong>${esc(rt.title)}</strong> (${esc(period)}${rt.workspace ? ` · 工作区:${esc(rt.workspace)}` : ""})</span></label>`;
          }).join("");
        }
      }

      if (pv.existing_profile) {
        $("#rcp-mode-update").disabled = false;
        $("#rcp-mode-update").checked = true;
        $("#import-id").value = pv.existing_profile.id;
      } else {
        $("#rcp-mode-copy").checked = true;
        $("#rcp-mode-update").disabled = true;
        if (!$("#import-id").value.trim()) $("#import-id").value = pv.suggested_target || pv.source_id;
      }
      if ($("#rcp-confirm-import")) $("#rcp-confirm-import").hidden = false;
      syncRecipeImportModeUI();
    }

    $("#role-fish-reroll")?.addEventListener("click", async () => {
      if (!selectedProfile) return;
      const next = newFishSeed();
      fishDraft = null;
      await saveProfileFishSeed(next, "已随机更换一条新小鱼头像");
    });
    $("#role-fish-custom")?.addEventListener("click", () => {
      if (!selectedProfile) return;
      fishDrawerOpen = !fishDrawerOpen;
      if (fishDrawerOpen && !fishDraft) fishDraft = fishDraftForProfile(selectedProfile);
      renderRoleFishPanel();
    });
    $("#role-fish-reset")?.addEventListener("click", async () => {
      if (!selectedProfile) return;
      fishDraft = null;
      fishDrawerOpen = false;
      await saveProfileFishSeed("", "已恢复该角色的默认小鱼头像");
    });
    $("#role-fish-drawer")?.addEventListener("click", async (ev) => {
      if (!selectedProfile) return;
      if (ev.target.closest("#role-fish-shape")) {
        const d = { ...(fishDraft || fishDraftForProfile(selectedProfile)), base: newFishSeed() };
        fishDraft = d;
        renderRoleFishPanel();
        $("#role-fish-shape")?.focus();
      } else if (ev.target.closest("#role-fish-cancel")) {
        fishDrawerOpen = false;
        fishDraft = null;
        renderRoleFishPanel();
      } else if (ev.target.closest("#role-fish-save")) {
        const d = fishDraft || fishDraftForProfile(selectedProfile);
        const next = customFishSeed(d);
        fishDrawerOpen = false;
        await saveProfileFishSeed(next, "已保存自定义小鱼头像");
      }
    });

    $("#jump-recipe-panel").onclick = async () => {
      viewMode = "roles";
      if ($("#document").value === "skill") $("#document").value = "profile";
      renderCatalog();
      await loadAsset(false);
      await refreshRecipeDraft();
      $("#role-package-panel")?.scrollIntoView({ behavior: "smooth", block: "start" });
    };
    $("#rcp-draft-btn").onclick = refreshRecipeDraft;
    ["rcp-inc-skills", "rcp-inc-notes", "rcp-inc-presets", "rcp-inc-routines"].forEach((cid) => {
      $(`#${cid}`)?.addEventListener("change", () => {
        if (!$("#rcp-draft-box")?.hidden) refreshRecipeDraft();
      });
    });

    $("#export").onclick = async () => {
      revokeRecipeBlob();
      let token = "", offset = 0, chunks = [], meta = null;
      const opts = recipeDraftOptions();
      for (let guard = 0; guard < 200; guard++) {
        const r = await rpc("read", "recipe_package", { target: selectedProfile, token, offset, ...(token ? {} : opts) });
        if (!r?.success) return say(r?.error || "导出配方失败", true);
        token = r.token;
        if (r.meta) meta = r.meta;
        chunks.push(r.data);
        offset = r.offset;
        if (offset >= r.total) break;
      }
      const b64 = chunks.join("");
      $("#package-text").value = b64;
      $("#package-panel").open = true;
      if (meta) renderDraftCheckup(meta);
      try {
        const bin = atob(b64);
        const bytes = new Uint8Array(bin.length);
        for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
        const blob = new Blob([bytes], { type: "application/zip" });
        activeRecipeBlobUrl = URL.createObjectURL(blob);
        const dl = $("#rcp-download-link");
        if (dl) {
          dl.href = activeRecipeBlobUrl;
          dl.download = `${selectedProfile}-recipe.zip`;
          dl.hidden = false;
        }
      } catch {}
      say(`已导出角色 ${selectedProfile} 配方包（已自动剥离白名单与会话号）`);
    };
    async function copyRecipePackageText(fromSandboxFallback = false) {
      const text = $("#package-text")?.value?.trim() || "";
      if (!text) return say("请先点击「导出配方包」生成配方包文本", true);
      let copied = false;
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          copied = true;
        }
      } catch {}
      $("#package-panel").open = true;
      $("#package-text").focus();
      $("#package-text").select();
      if (fromSandboxFallback) {
        say(copied
          ? "当前宿主沙箱限制直接下载文件，已自动复制配方包文本到剪贴板。"
          : "当前宿主沙箱限制直接下载文件，已全选配方包文本，请按 Ctrl/Cmd + C 复制。");
      } else {
        say(copied ? "已复制配方包文本到剪贴板。" : "已全选配方包文本，请按 Ctrl/Cmd + C 复制。");
      }
    }
    $("#copy-package").onclick = () => copyRecipePackageText(false);
    $("#select-package").onclick = () => { $("#package-text").select(); };
    $("#rcp-download-link").addEventListener("click", async (ev) => {
      if (window.origin === "null") {
        ev.preventDefault();
        await copyRecipePackageText(true);
      }
    });

    async function previewRecipeBytes(bytes, filename = "recipe.zip") {
      if (!bytes?.length) return say("配方包内容为空", true);
      say("");
      const target = $("#import-id").value.trim();
      let token = "", offset = 0, last = null;
      const stepBytes = 18432;
      for (let i = 0; i < bytes.length || i === 0; i += stepBytes) {
        const slice = bytes.subarray(i, i + stepBytes);
        const done = i + stepBytes >= bytes.length;
        const r = await rpc("write", "recipe_preview", {
          target,
          filename,
          token,
          offset,
          data: uint8ToB64(slice),
          done,
        });
        if (!r?.success) return say(r?.error || "配方预览解析失败", true);
        token = r.token || token;
        offset = r.offset ?? offset;
        last = r;
      }
      if (last?.preview_token) {
        renderRecipePreview(last);
        say(`已生成配方「${last.profile?.title || last.source_id}」预览，确认对齐状态后点击「确认导入配方」`);
      }
    }

    $("#rcp-fetch-btn").onclick = async () => {
      const url = $("#rcp-url").value.trim();
      if (!url) return say("请先粘贴公开配方链接", true);
      say("正在由后端安全拉取并校验配方包…");
      const r = await rpc("write", "recipe_preview", { url, target: $("#import-id").value.trim() });
      if (!r?.success) return say(r?.error || "公开链接拉取失败", true);
      renderRecipePreview(r);
      say(`已拉取并解析「${r.profile?.title || r.source_id}」，请核对缺件对齐状态后确认导入`);
    };

    $("#rcp-preview-btn").onclick = async () => {
      const clean = $("#package-text").value.replace(/\s+/g, "");
      if (!clean) return say("请先粘贴或导出配方包 Base64 文本", true);
      try {
        const bin = atob(clean);
        const bytes = new Uint8Array(bin.length);
        for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
        await previewRecipeBytes(bytes, "recipe-text.zip");
      } catch {
        say("配方包 Base64 文本格式无效", true);
      }
    };

    $("#rcp-mode-copy").addEventListener("change", () => {
      if ($("#rcp-mode-copy").checked && activeRecipePreview) {
        if (activeRecipePreview.existing_profile && $("#import-id").value.trim() === activeRecipePreview.existing_profile.id) {
          $("#import-id").value = activeRecipePreview.suggested_copy_id || `${activeRecipePreview.source_id}-copy`;
        }
      }
      syncRecipeRoutineGuard();
    });
    $("#rcp-mode-update").addEventListener("change", () => {
      if ($("#rcp-mode-update").checked && activeRecipePreview?.existing_profile) {
        $("#import-id").value = activeRecipePreview.existing_profile.id;
      }
      syncRecipeRoutineGuard();
    });
    $("#import-id").addEventListener("input", syncRecipeImportModeUI);

    $("#rcp-confirm-import").onclick = async () => {
      if (!activeRecipePreview?.preview_token) return say("请先预览配方包", true);
      const target = $("#import-id").value.trim();
      if (!target) return say("请填写目标角色编号", true);
      const mode = $("#rcp-mode-update").checked && !$("#rcp-mode-update").disabled ? "update" : "copy";
      const routineChat = $("#rcp-routine-chat")?.value || "";
      const pickedRoutines = routineChat
        ? $$("[data-rcp-routine]:checked").map((x) => x.dataset.rcpRoutine)
        : [];
      say("");
      const r = await rpc("write", "recipe_import", {
        preview_token: activeRecipePreview.preview_token,
        target,
        mode,
        install_skills: $("#rcp-install-skills")?.checked !== false,
        overwrite_skills: mode === "update",
        mount_routines: pickedRoutines,
        routine_chat_id: routineChat,
      });
      if (!r?.success) return say(r?.error || "配方导入失败", true);
      activeRecipePreview = null;
      $("#rcp-preview-card").hidden = true;
      $("#rcp-confirm-import").hidden = true;
      selectedProfile = r.id;
      viewMode = "roles";
      $("#document").value = "profile";
      await loadCatalog();
      await loadAsset(false);
      const rtHint = (r.mounted_routines || []).length ? `，已挂载 ${r.mounted_routines.length} 项例行任务` : "";
      const bindHint = r.bound === false ? "（存在待绑定凭据/服务，当前设为待绑定保护态）" : "";
      say(mode === "update"
        ? `已平滑升级角色 ${r.id}${rtHint}${bindHint}，原白名单与工作区完整保留且可回滚`
        : `已导入配方副本 ${r.id}${rtHint}${bindHint}`);
    };

    async function uploadB64(b64) {
      const target = $("#import-id").value.trim();
      if (!target) return say("请填写导入后的新角色编号", true);
      let token = "", offset = 0;
      const step = 16384;
      for (let i = 0; i < b64.length || i === 0; i += step) {
        const chunk = b64.slice(i, i + step);
        const done = i + step >= b64.length;
        const r = await rpc("write", "import", { target, token, offset, data: chunk, done });
        if (!r?.success) return say(r?.error || "导入失败", true);
        token = r.token || token;
        offset = r.offset || offset;
      }
      selectedProfile = target;
      $("#document").value = "profile";
      say("角色包已导入");
      await loadCatalog();
      await loadAsset(false);
    }
    $("#import").onclick = () => uploadB64($("#package-text").value.trim());
    $("#package-file").addEventListener("change", () => {
      const file = $("#package-file").files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = async () => {
        const bytes = new Uint8Array(reader.result);
        await previewRecipeBytes(bytes, file.name);
        $("#package-file").value = "";
      };
      reader.readAsArrayBuffer(file);
    });
    $("#refresh-discovery").onclick = async () => {
      discoveryPromise = refreshDiscovery({ force: true }).finally(() => {
        discoveryPromise = null;
      });
      await discoveryPromise;
    };

    (async () => {
      await Promise.resolve(window.maibot?.ready);
      if (sig?.aborted) return;
      applyTheme();
      if (typeof pendingAbilityTarget !== "undefined" && pendingAbilityTarget?.profile) {
        selectedProfile = pendingAbilityTarget.profile;
        viewMode = "roles";
        if ($("#document")) $("#document").value = "profile";
        pendingAbilityTarget = null;
      }
      await loadCatalog();
      if (sig?.aborted) return;
      await loadAsset(false);
      if (sig?.aborted) return;
      discoveryPromise = refreshDiscovery().finally(() => {
        discoveryPromise = null;
      });
    })();
  }

  /* ════════════════════════════════════════════════════════════════
     1.5. 产物页 (outputs)
     ════════════════════════════════════════════════════════════════ */
  if (page === "outputs") {
    let outData = { items: [], workspaces: [], chats: [], chat_sources: {}, stats: {} };
    let filterChat = "";
    let filterKind = "all";
    let activeSpace = "all";
    let filterRole = "";
    let outLayout = "table";
    let visibleItems = [];
    let selectedItem = null;
    let curView = "preview";
    let imgFit = "auto";
    let curArtifact = null;
    let textAccumulator = "";
    let copyBuffer = "";
    let openSeq = 0;

    const KIND_LABELS = {
      attachment: "附件/图片",
      workspace_out: "工作区成品",
      workspace_file: "工作区文件",
      conclusion: "结论与出处",
    };

    const SPACE_HEADINGS = {
      all: "全部资料",
      pages: "页面与卡片",
      images: "图像与海报",
      docs: "文档与代码",
      conclusions: "结论与出处",
      workspaces: "持续工作区",
    };

    const MEDIA_LABELS = {
      image: "图片",
      html: "HTML",
      markdown: "Markdown",
      text: "文本",
      binary: "二进制",
      conclusion: "结论",
    };

    const fmtBytes = (n) => {
      const v = Number(n || 0);
      if (v >= 1024 * 1024) return `${(v / (1024 * 1024)).toFixed(2)} MB`;
      if (v >= 1024) return `${(v / 1024).toFixed(1)} KB`;
      return `${v} B`;
    };

    const fmtRelTime = (ts) => {
      const n = Number(ts || 0);
      if (!n) return "—";
      const diff = Math.max(0, Math.floor(Date.now() / 1000 - n));
      if (diff < 60) return "刚刚";
      if (diff < 3600) return `${Math.floor(diff / 60)} 分钟前`;
      if (diff < 86400) return `${Math.floor(diff / 3600)} 小时前`;
      if (diff < 2592000) return `${Math.floor(diff / 86400)} 天前`;
      const d = new Date(n * 1000);
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
    };

    function fileTypeIcon(mediaKind) {
      if (mediaKind === "html") return `<span class="m-out-file-ic" aria-hidden="true">${mIconBrand("html", 18)}</span>`;
      if (mediaKind === "image") return `<span class="m-out-file-ic" aria-hidden="true">${mIconBrand("image", 18)}</span>`;
      if (mediaKind === "markdown") return `<span class="m-out-file-ic" aria-hidden="true">${mIconBrand("markdown", 18)}</span>`;
      if (mediaKind === "conclusion") return `<span class="m-out-file-ic" aria-hidden="true">${mIconMod("journal", 18)}</span>`;
      return `<span class="m-out-file-ic" aria-hidden="true">${mIconBrand("file", 18)}</span>`;
    }

    const SAFE_HTML_TAGS = new Set([
      "H1", "H2", "H3", "H4", "H5", "H6", "P", "UL", "OL", "LI", "DL", "DT", "DD",
      "PRE", "CODE", "BLOCKQUOTE", "TABLE", "THEAD", "TBODY", "TFOOT", "TR", "TH", "TD",
      "CAPTION", "COLGROUP", "COL", "STRONG", "B", "EM", "I", "SMALL", "SUB", "SUP",
      "MARK", "DEL", "HR", "BR", "ARTICLE", "SECTION", "HEADER", "FOOTER", "MAIN",
      "ASIDE", "NAV", "FIGURE", "FIGCAPTION", "DETAILS", "SUMMARY", "DIV", "SPAN",
      "TIME", "A", "LABEL", "INPUT",
    ]);
    const SVG_TAG_CASE = {
      SVG: "svg", G: "g", PATH: "path", RECT: "rect", CIRCLE: "circle", ELLIPSE: "ellipse",
      LINE: "line", POLYLINE: "polyline", POLYGON: "polygon", TEXT: "text", TSPAN: "tspan",
      DEFS: "defs", LINEARGRADIENT: "linearGradient", RADIALGRADIENT: "radialGradient",
      STOP: "stop", CLIPPATH: "clipPath", PATTERN: "pattern", MARKER: "marker",
      TITLE: "title", DESC: "desc",
    };
    const SVG_ATTR_MAP = {
      "viewbox": "viewBox", "width": "width", "height": "height",
      "x": "x", "y": "y", "x1": "x1", "y1": "y1", "x2": "x2", "y2": "y2",
      "cx": "cx", "cy": "cy", "r": "r", "rx": "rx", "ry": "ry",
      "d": "d", "points": "points", "fill": "fill", "fill-opacity": "fill-opacity",
      "fill-rule": "fill-rule", "stroke": "stroke", "stroke-width": "stroke-width",
      "stroke-dasharray": "stroke-dasharray", "stroke-dashoffset": "stroke-dashoffset",
      "stroke-linecap": "stroke-linecap", "stroke-linejoin": "stroke-linejoin",
      "stroke-opacity": "stroke-opacity", "opacity": "opacity", "transform": "transform",
      "text-anchor": "text-anchor", "dominant-baseline": "dominant-baseline",
      "dy": "dy", "dx": "dx", "font-size": "font-size", "font-weight": "font-weight",
      "font-family": "font-family", "offset": "offset", "stop-color": "stop-color",
      "stop-opacity": "stop-opacity", "gradientunits": "gradientUnits",
      "gradienttransform": "gradientTransform", "preserveaspectratio": "preserveAspectRatio",
      "clip-path": "clip-path", "marker-end": "marker-end", "marker-start": "marker-start",
      "aria-hidden": "aria-hidden", "role": "role", "class": "class", "id": "id", "style": "style",
    };
    const SKIP_HTML_TAGS = new Set([
      "SCRIPT", "STYLE", "IFRAME", "OBJECT", "EMBED", "IMG", "FORM", "FOREIGNOBJECT",
      "NOSCRIPT", "TEMPLATE", "LINK", "META", "BASE",
    ]);

    function splitTopLevel(str, delimChar) {
      const parts = [];
      let cur = "";
      let paren = 0;
      let bracket = 0;
      let quote = "";
      for (let i = 0; i < str.length; i++) {
        const ch = str[i];
        if (quote) {
          cur += ch;
          if (ch === "\\" && i + 1 < str.length) {
            cur += str[++i];
          } else if (ch === quote) {
            quote = "";
          }
          continue;
        }
        if (ch === "'" || ch === '"') {
          quote = ch;
          cur += ch;
          continue;
        }
        if (ch === "(") paren++;
        else if (ch === ")" && paren > 0) paren--;
        else if (ch === "[") bracket++;
        else if (ch === "]" && bracket > 0) bracket--;
        if (ch === delimChar && paren === 0 && bracket === 0) {
          parts.push(cur);
          cur = "";
        } else {
          cur += ch;
        }
      }
      if (cur) parts.push(cur);
      return parts;
    }

    function sanitizeInlineStyle(rawStyle) {
      const clean = String(rawStyle || "").replace(/</g, "").trim();
      if (!clean) return "";
      const kept = [];
      for (const decl of splitTopLevel(clean, ";")) {
        const d = decl.trim();
        if (!d || !d.includes(":")) continue;
        if (/url\s*\(|expression\s*\(|javascript:|vbscript:|-moz-binding|behavior\s*:/i.test(d)) continue;
        if (/^position\s*:\s*(?:fixed|sticky)\b/i.test(d)) continue;
        kept.push(d);
      }
      return kept.join("; ");
    }

    function scopeSandboxCss(rawCss) {
      const cleaned = String(rawCss || "")
        .replace(/\/\*[\s\S]*?\*\//g, "")
        .replace(/</g, "")
        .replace(/@(?:import|charset|namespace)\b[^;]*;/gi, "");
      const out = [];
      let pos = 0;
      const n = cleaned.length;
      while (pos < n) {
        const openIdx = cleaned.indexOf("{", pos);
        if (openIdx < 0) break;
        const rawPrelude = cleaned.slice(pos, openIdx).trim();
        let depth = 1;
        let i = openIdx + 1;
        let quote = "";
        while (i < n && depth > 0) {
          const ch = cleaned[i];
          if (quote) {
            if (ch === "\\" && i + 1 < n) i++;
            else if (ch === quote) quote = "";
          } else {
            if (ch === "'" || ch === '"') quote = ch;
            else if (ch === "{") depth++;
            else if (ch === "}") depth--;
          }
          i++;
        }
        const body = cleaned.slice(openIdx + 1, depth === 0 ? i - 1 : n);
        pos = i;
        if (!rawPrelude) continue;
        const prelude = rawPrelude.includes(";") ? rawPrelude.slice(rawPrelude.lastIndexOf(";") + 1).trim() : rawPrelude;
        if (!prelude) continue;
        if (/^@(?:-webkit-)?(?:keyframes|font-face|page)\b/i.test(prelude)) continue;
        if (/^@(?:media|supports)\b/i.test(prelude)) {
          const nested = scopeSandboxCss(body);
          if (nested) out.push(`${prelude} { ${nested} }`);
          continue;
        }
        if (prelude.startsWith("@")) continue;
        const safeDecls = sanitizeInlineStyle(body);
        if (!safeDecls) continue;
        const scopedSels = [];
        for (const rawSel of splitTopLevel(prelude, ",")) {
          const sel = rawSel.trim();
          if (!sel) continue;
          const rw = sel.replace(/(^|[\s>+~(])(?:html|body|:root)(?=[\s.#\[:>+~),]|$)/gi, "$1.out-html-sandbox");
          if (/^\[data-theme\b/i.test(rw)) {
            scopedSels.push(`.out-html-sandbox${rw}`, `.out-html-sandbox ${rw}`);
          } else if (/(?:^|[\s>+~(])\.out-html-sandbox(?=$|[\s.#\[:>+~),])/.test(rw)) {
            scopedSels.push(rw);
          } else {
            scopedSels.push(`.out-html-sandbox ${rw}`);
          }
        }
        if (scopedSels.length) out.push(`${scopedSels.join(", ")} { ${safeDecls} }`);
      }
      return out.join("\n");
    }

    function safeClassTokens(val) {
      return String(val || "")
        .split(/\s+/)
        .filter((t) => /^[A-Za-z_][A-Za-z0-9_-]{0,63}$/.test(t))
        .join(" ");
    }

    function safeHtmlNode(node, inSvg = false) {
      if (node.nodeType === 3) return esc(node.nodeValue || "");
      if (node.nodeType !== 1) return "";
      const tag = node.tagName.toUpperCase();
      if (SKIP_HTML_TAGS.has(tag)) return "";
      const nowSvg = inSvg || tag === "SVG";
      const inner = [...node.childNodes].map((ch) => safeHtmlNode(ch, nowSvg)).join("");

      if (nowSvg && Object.prototype.hasOwnProperty.call(SVG_TAG_CASE, tag)) {
        const outTag = SVG_TAG_CASE[tag];
        const attrs = [];
        for (const attr of [...node.attributes]) {
          const al = attr.name.toLowerCase();
          if (al.startsWith("on")) continue;
          const canon = SVG_ATTR_MAP[al];
          if (!canon) continue;
          let v = String(attr.value || "").trim();
          if (canon === "style") {
            v = sanitizeInlineStyle(v);
            if (!v) continue;
          } else if (canon === "class") {
            v = safeClassTokens(v);
            if (!v) continue;
          } else if (canon === "id") {
            if (!/^[A-Za-z_][A-Za-z0-9_-]{0,63}$/.test(v)) continue;
            v = `ms-sbx-${v}`;
          } else {
            if (/javascript:|vbscript:/i.test(v)) continue;
            if (/url\s*\(/i.test(v)) {
              const loc = v.match(/^url\(\s*#([A-Za-z_][A-Za-z0-9_-]{0,63})\s*\)$/i);
              if (!loc) continue;
              v = `url(#ms-sbx-${loc[1]})`;
            }
          }
          attrs.push(`${canon}="${esc(v)}"`);
        }
        if (outTag === "svg" && !attrs.some((a) => a.startsWith("xmlns="))) {
          attrs.unshift('xmlns="http://www.w3.org/2000/svg"');
        }
        return `<${outTag}${attrs.length ? " " + attrs.join(" ") : ""}>${inner}</${outTag}>`;
      }
      if (inSvg) return "";

      if (!SAFE_HTML_TAGS.has(tag)) return inner;
      if (tag === "BR" || tag === "HR") return `<${tag.toLowerCase()}>`;
      if (tag === "A") {
        const href = String(node.getAttribute("href") || "").trim();
        if (/^https?:\/\//i.test(href)) {
          return `<span>${inner || esc(href)}</span> <span class="mil-tag mono">${esc(href)}</span>`;
        }
        return `<span>${inner}</span>`;
      }
      if (tag === "INPUT") {
        const itype = String(node.getAttribute("type") || "").toLowerCase();
        if (itype !== "radio" && itype !== "checkbox") return "";
        const attrs = [`type="${itype}"`];
        const cls = safeClassTokens(node.getAttribute("class"));
        if (cls) attrs.push(`class="${esc(cls)}"`);
        const nid = String(node.getAttribute("id") || "").trim();
        if (/^[A-Za-z0-9_-]{1,64}$/.test(nid)) attrs.push(`id="ms-sbx-${esc(nid)}"`);
        const nname = String(node.getAttribute("name") || "").trim();
        if (/^[A-Za-z0-9_-]{1,64}$/.test(nname)) attrs.push(`name="ms-sbx-${esc(nname)}"`);
        if (node.hasAttribute("checked")) attrs.push("checked");
        return `<input ${attrs.join(" ")}>`;
      }
      const lower = tag.toLowerCase();
      const attrs = [];
      const cls = safeClassTokens(node.getAttribute("class"));
      if (cls) attrs.push(`class="${esc(cls)}"`);
      const sty = sanitizeInlineStyle(node.getAttribute("style"));
      if (sty) attrs.push(`style="${esc(sty)}"`);
      const theme = String(node.getAttribute("data-theme") || "").trim().toLowerCase();
      if (theme === "dark" || theme === "light") attrs.push(`data-theme="${theme}"`);
      if (tag === "LABEL") {
        const lfor = String(node.getAttribute("for") || "").trim();
        if (/^[A-Za-z0-9_-]{1,64}$/.test(lfor)) attrs.push(`for="ms-sbx-${esc(lfor)}"`);
      }
      if (tag === "DETAILS" && node.hasAttribute("open")) attrs.push("open");
      if (tag === "TD" || tag === "TH") {
        for (const spanAttr of ["colspan", "rowspan"]) {
          const sv = Number(node.getAttribute(spanAttr));
          if (Number.isInteger(sv) && sv >= 1 && sv <= 24) attrs.push(`${spanAttr}="${sv}"`);
        }
      }
      const ariaLbl = String(node.getAttribute("aria-label") || "").trim();
      if (ariaLbl) attrs.push(`aria-label="${esc(ariaLbl.slice(0, 120))}"`);
      if (node.getAttribute("aria-hidden") === "true") attrs.push('aria-hidden="true"');
      const roleVal = String(node.getAttribute("role") || "").trim();
      if (/^[a-z]{1,24}$/.test(roleVal)) attrs.push(`role="${roleVal}"`);
      return `<${lower}${attrs.length ? " " + attrs.join(" ") : ""}>${inner}</${lower}>`;
    }

    function renderSafeHtml(src) {
      try {
        const doc = new DOMParser().parseFromString(String(src || ""), "text/html");
        const cssBlocks = [...doc.querySelectorAll("style")].map((el) => scopeSandboxCss(el.textContent || "")).filter(Boolean);
        const bodyCls = safeClassTokens(`${doc.documentElement?.getAttribute("class") || ""} ${doc.body?.getAttribute("class") || ""}`);
        const rawTheme = String(doc.body?.getAttribute("data-theme") || doc.documentElement?.getAttribute("data-theme") || "").trim().toLowerCase();
        const themeAttr = (rawTheme === "dark" || rawTheme === "light") ? ` data-theme="${rawTheme}"` : "";
        const sandboxClass = bodyCls ? `out-html-sandbox ${bodyCls}` : "out-html-sandbox";
        const bodyHtml = [...(doc.body?.childNodes || [])].map((ch) => safeHtmlNode(ch, false)).join("");
        const styleTag = cssBlocks.length ? `<style>${cssBlocks.join("\n")}</style>` : "";
        return `${styleTag}<div class="${esc(sandboxClass)}"${themeAttr}>${bodyHtml || `<p class="mil-hint">空白文档</p>`}</div>`;
      } catch {
        return `<pre class="mil-pre">${esc(src || "")}</pre>`;
      }
    }

    function renderMarkdown(src) {
      const lines = String(src || "").replace(/\r\n/g, "\n").split("\n");
      const out = [];
      let inCode = false;
      let codeBuf = [];
      let listOpen = false;
      const closeList = () => { if (listOpen) { out.push("</ul>"); listOpen = false; } };
      const inlineMd = (s) => esc(s)
        .replace(/`([^`]+)`/g, "<code>$1</code>")
        .replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, '<span>$1</span> <span class="mil-tag mono">$2</span>');
      for (const line of lines) {
        if (line.trim().startsWith("```")) {
          closeList();
          if (inCode) {
            out.push(`<pre class="mil-pre">${esc(codeBuf.join("\n"))}</pre>`);
            codeBuf = [];
            inCode = false;
          } else {
            inCode = true;
          }
          continue;
        }
        if (inCode) { codeBuf.push(line); continue; }
        const h = line.match(/^(#{1,4})\s+(.+)$/);
        if (h) { closeList(); out.push(`<h${h[1].length}>${inlineMd(h[2])}</h${h[1].length}>`); continue; }
        const li = line.match(/^\s*[-*+]\s+(.+)$/);
        if (li) { if (!listOpen) { out.push("<ul>"); listOpen = true; } out.push(`<li>${inlineMd(li[1])}</li>`); continue; }
        closeList();
        if (line.startsWith(">")) { out.push(`<blockquote>${inlineMd(line.replace(/^>\s?/, ""))}</blockquote>`); continue; }
        if (!line.trim()) continue;
        out.push(`<p>${inlineMd(line)}</p>`);
      }
      closeList();
      if (inCode && codeBuf.length) out.push(`<pre class="mil-pre">${esc(codeBuf.join("\n"))}</pre>`);
      return `<div class="out-doc">${out.join("") || `<p class="mil-hint">空白文档</p>`}</div>`;
    }

    function renderFilterButtons() {
      $$("[data-out-space]").forEach((b) => b.setAttribute("aria-current", b.dataset.outSpace === activeSpace ? "page" : "false"));
      $$("[data-out-layout]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.outLayout === outLayout)));
      $$("[data-out-kind]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.outKind === filterKind)));
      $$("[data-out-role]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.outRole === filterRole)));
      $$("[data-out-view]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.outView === curView)));
      $$("[data-out-chat]").forEach((b) => b.setAttribute("aria-current", String(b.dataset.outChat === filterChat)));
    }

    function spaceMatchesItem(item) {
      if (activeSpace === "pages") return item.media_kind === "html";
      if (activeSpace === "images") return item.media_kind === "image";
      if (activeSpace === "docs") return ["markdown", "text", "binary"].includes(item.media_kind);
      if (activeSpace === "conclusions") return item.kind === "conclusion";
      return true;
    }

    function chatLabel(cid) {
      if (!cid) return "全部会话";
      const s = (outData.chat_sources || {})[cid];
      const spec = s?.stream_spec || cid;
      return s?.name && s.name !== spec ? `${s.name} · ${spec}` : spec;
    }

    function renderChatFilter() {
      const chats = outData.chats || [];
      const srcs = outData.chat_sources || {};
      $("#out-chat").innerHTML = [`<option value="">全部会话</option>`, ...chats.map((c) => `<option value="${esc(c)}">${esc(chatLabel(c))}</option>`)].join("");
      $("#out-chat").value = filterChat;
      const chipHtml = [
        `<button type="button" class="mil-key mil-key--sm" data-out-chat="" style="justify-content:flex-start">全部会话 (${outData.stats?.total || 0})</button>`,
        ...chats.map((c) => {
          const s = srcs[c] || {};
          const name = s.name || c;
          const spec = s.stream_spec || "";
          const rawAv = String(s.avatar || "");
          const safeAv = /^data:image\//i.test(rawAv) && !/["'()\s]/.test(rawAv) ? rawAv : "";
          const mono = (name || c || "?").trim().slice(0, 1).toUpperCase();
          return `<button type="button" class="mil-key mil-key--sm ms-chat-chip" data-out-chat="${esc(c)}" title="${esc(spec || c)}">
            <span class="ms-chat-chip-top">
              <span class="mil-avatar mil-avatar--sm" aria-hidden="true">${esc(mono)}${safeAv ? `<span class="mil-avatar-img" style="background-image:url('${esc(safeAv)}')"></span>` : ""}</span>
              <span class="ms-chat-chip-name">${esc(name)}</span>
            </span>
            ${spec || s.platform ? `<span class="ms-chat-chip-spec mono">${esc(spec || s.platform)}</span>` : ""}
          </button>`;
        }),
      ].join("");
      $("#out-chat-chips").innerHTML = chipHtml;
    }

    function renderCatalog() {
      const st = outData.stats || {};
      const allItems = outData.items || [];
      $("#out-st-total").textContent = String(st.total ?? allItems.length);
      $("#out-st-att").textContent = String(st.attachments || 0);
      $("#out-st-wsout").textContent = String(st.workspace_out || 0);
      $("#out-st-ws").textContent = String(st.workspaces || 0);
      if ($("#out-st-pages")) $("#out-st-pages").textContent = String(st.pages ?? allItems.filter((i) => i.media_kind === "html").length);
      if ($("#out-st-images")) $("#out-st-images").textContent = String(st.images ?? allItems.filter((i) => i.media_kind === "image").length);
      if ($("#out-st-docs")) $("#out-st-docs").textContent = String(st.docs ?? allItems.filter((i) => ["markdown", "text", "binary"].includes(i.media_kind)).length);
      if ($("#out-st-conclusions")) $("#out-st-conclusions").textContent = String(st.conclusions ?? allItems.filter((i) => i.kind === "conclusion").length);

      const recentSource = Array.isArray(outData.recent) && outData.recent.length ? outData.recent : allItems.slice(0, 5);
      if ($("#out-recent-list")) {
        $("#out-recent-list").innerHTML = recentSource.length
          ? recentSource.slice(0, 5).map((item) => `<button type="button" class="out-recent-item" data-recent-id="${esc(item.id)}" title="${esc(item.title || item.name)}">${fileTypeIcon(item.media_kind)}<span class="out-recent-title">${esc(item.title || item.name)}</span></button>`).join("")
          : `<span class="mil-hint" style="padding:4px 6px">暂无最近文件</span>`;
      }

      const roles = [...new Set(allItems.map((i) => i.profile).filter(Boolean))];
      if ($("#out-role-pills")) {
        $("#out-role-pills").innerHTML = roles.length
          ? [`<button type="button" class="mil-key mil-key--sm" data-out-role="" aria-pressed="${filterRole === "" ? "true" : "false"}">全部角色</button>`, ...roles.map((r) => `<button type="button" class="mil-key mil-key--sm" data-out-role="${esc(r)}" aria-pressed="${filterRole === r ? "true" : "false"}">${roleFishHtml(r, (outData.profile_fish || {})[r] || "", 16, { still: true })}<span>${esc(r)}</span></button>`)].join("")
          : "";
      }

      const inWorkspaces = activeSpace === "workspaces";
      if ($("#out-catalog-panel")) $("#out-catalog-panel").hidden = inWorkspaces;
      if ($("#out-ws-panel")) {
        $("#out-ws-panel").hidden = !(inWorkspaces || activeSpace === "all");
        $("#out-ws-panel").style.order = inWorkspaces ? "-1" : "";
      }
      if ($("#out-space-heading")) $("#out-space-heading").textContent = SPACE_HEADINGS[activeSpace] || "全部资料";

      visibleItems = allItems.filter((item) => spaceMatchesItem(item) && (!filterRole || item.profile === filterRole));
      if ($("#out-visible-count")) $("#out-visible-count").textContent = `${visibleItems.length} 项`;

      const listEl = $("#out-list");
      const headEl = $("#out-table-head");
      if (headEl) headEl.hidden = outLayout === "grid";
      listEl.className = outLayout === "grid" ? "out-grid" : "out-table";
      listEl.innerHTML = visibleItems.length
        ? visibleItems.map((item, idx) => {
            const active = selectedItem && selectedItem.id === item.id;
            const kindTxt = KIND_LABELS[item.kind] || item.kind;
            const subLine = item.path || item.excerpt || kindTxt;
            const roleName = item.profile || "agent";
            const fish = roleFishHtml(roleName, (outData.profile_fish || {})[roleName] || "", 18, { still: true });
            const relTime = fmtRelTime(item.at);
            if (outLayout === "grid") {
              return `<button type="button" class="out-grid-card" data-out-idx="${idx}" aria-current="${active ? "true" : "false"}">
                <div class="mil-row" style="justify-content:space-between;gap:6px">
                  <span class="mil-row" style="gap:6px">${fileTypeIcon(item.media_kind)}<span class="mil-tag">${esc(MEDIA_LABELS[item.media_kind] || kindTxt)}</span></span>
                  <span class="mil-row-meta num" style="font-size:11.5px;color:var(--mil-muted)">${esc(fmtBytes(item.bytes))}</span>
                </div>
                <strong style="font-size:13px;overflow-wrap:anywhere">${esc(item.title || item.name)}</strong>
                <span class="out-row-sub">${esc(subLine)}</span>
                <div class="mil-row" style="justify-content:space-between;font-size:11.5px;margin-top:auto">
                  <span class="mil-row" style="gap:5px">${fish}<span>${esc(roleName)}</span></span>
                  <span style="color:var(--mil-muted)">${esc(relTime)}</span>
                </div>
              </button>`;
            }
            return `<button type="button" class="out-row" data-out-idx="${idx}" aria-current="${active ? "true" : "false"}">
              <div class="out-row-name">
                ${fileTypeIcon(item.media_kind)}
                <div class="out-row-titles">
                  <strong>${esc(item.title || item.name)}</strong>
                  <span class="out-row-sub">${esc(subLine)}</span>
                </div>
              </div>
              <div class="out-row-src">
                ${fish}
                <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(roleName)} · ${esc(chatLabel(item.chat_id))}</span>
                ${item.delivered ? `<span class="mil-tag mil-tag--ok">已回接</span>` : ""}
              </div>
              <div class="out-row-meta out-row-size">${esc(fmtBytes(item.bytes))}</div>
              <div class="out-row-meta">${esc(relTime)}</div>
            </button>`;
          }).join("")
        : `<p class="mil-hint" style="padding:14px 10px">当前筛选条件下暂无资料条目。</p>`;

      $("#workspaces").innerHTML = (outData.workspaces || []).map((w) =>
        `<button type="button" class="mil-key mil-key--sm" data-ws="${esc(w.workspace_id)}">
          <span class="mil-row" style="gap:6px">${roleFishHtml(w.profile || "agent", (outData.profile_fish || {})[w.profile || ""] || "", 18, { still: true })}<span>${esc(w.name)} (${esc(w.profile)})</span></span>
          <span class="mil-tag num">${w.out_count || 0}/${w.file_count || 0}</span>
        </button>`
      ).join("") || `<span class="mil-hint">暂无持久工作区</span>`;
      renderFilterButtons();
    }

    function bytesToBase64(bytes) {
      const step = 16384;
      let bin = "";
      for (let i = 0; i < bytes.length; i += step) {
        const sub = bytes.subarray(i, Math.min(bytes.length, i + step));
        bin += String.fromCharCode.apply(null, sub);
      }
      return btoa(bin);
    }

    function probeImageDimensions(bytes) {
      if (!bytes || bytes.length < 16) return null;
      const dv = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
      if (bytes.length >= 24 && bytes[0] === 0x89 && bytes[1] === 0x50 && bytes[2] === 0x4E && bytes[3] === 0x47) {
        const w = dv.getUint32(16, false), h = dv.getUint32(20, false);
        return w > 0 && h > 0 ? { w, h } : null;
      }
      if (bytes[0] === 0x47 && bytes[1] === 0x49 && bytes[2] === 0x46) {
        const w = dv.getUint16(6, true), h = dv.getUint16(8, true);
        return w > 0 && h > 0 ? { w, h } : null;
      }
      if (bytes.length >= 30 && bytes[0] === 0x52 && bytes[1] === 0x49 && bytes[2] === 0x46 && bytes[3] === 0x46 && bytes[8] === 0x57 && bytes[9] === 0x45 && bytes[10] === 0x42 && bytes[11] === 0x50) {
        const tag = String.fromCharCode(bytes[12], bytes[13], bytes[14], bytes[15]);
        if (tag === "VP8 ") return { w: dv.getUint16(26, true) & 0x3FFF, h: dv.getUint16(28, true) & 0x3FFF };
        if (tag === "VP8L") {
          const bits = dv.getUint32(21, true);
          return { w: (bits & 0x3FFF) + 1, h: ((bits >> 14) & 0x3FFF) + 1 };
        }
        if (tag === "VP8X") {
          return {
            w: 1 + (bytes[24] | (bytes[25] << 8) | (bytes[26] << 16)),
            h: 1 + (bytes[27] | (bytes[28] << 8) | (bytes[29] << 16)),
          };
        }
      }
      if (bytes[0] === 0xFF && bytes[1] === 0xD8) {
        let i = 2;
        while (i + 9 < bytes.length) {
          if (bytes[i] !== 0xFF) { i++; continue; }
          while (i < bytes.length && bytes[i] === 0xFF) i++;
          if (i >= bytes.length) break;
          const m = bytes[i++];
          if (m === 0xD8 || m === 0xD9 || m === 0x00) continue;
          if (i + 1 >= bytes.length) break;
          const segLen = dv.getUint16(i, false);
          if (m >= 0xC0 && m <= 0xC3 && i + 7 < bytes.length) {
            const h = dv.getUint16(i + 3, false), w = dv.getUint16(i + 5, false);
            return w > 0 && h > 0 ? { w, h } : null;
          }
          i += Math.max(2, segLen);
        }
      }
      return null;
    }

    function renderArtifactStage() {
      if (!curArtifact) return;
      const a = curArtifact;
      const stage = $("#out-stage");
      const fitSeg = $("#out-img-fit-seg");
      $("#out-cur-badge").textContent = `${KIND_LABELS[a.kind] || a.kind || "文件"} · ${MEDIA_LABELS[a.media_kind] || a.media_kind || "文本"}`;
      $("#out-cur-size").textContent = fmtBytes(a.bytes || a.total || 0);
      $("#out-more-btn").hidden = a.next_offset === null || a.next_offset === undefined;

      const roleId = a.profile || selectedItem?.profile || "";
      const metaParts = [
        a.chat_id ? `会话：${chatLabel(a.chat_id)}` : "",
        roleId ? `角色：${roleId}` : "",
        a._dims ? `尺寸：${a._dims.w} × ${a._dims.h} px` : "",
        a.path ? `路径：${a.path}` : "",
        a.handle ? `句柄：${a.handle}` : "",
        a.thread_id ? `线程：${a.thread_id}` : "",
      ].filter(Boolean);
      const roleChip = roleId
        ? `<span class="mil-tag mono mil-row" style="gap:5px">${roleFishHtml(roleId, (outData.profile_fish || {})[roleId] || "", 16, { still: true })}<span>角色：${esc(roleId)}</span></span>`
        : "";
      $("#out-meta").innerHTML = [
        roleChip,
        ...metaParts.filter((m) => !m.startsWith("角色：")).map((m) => `<span class="mil-tag mono">${esc(m)}</span>`),
      ].filter(Boolean).join("") || "无附加元信息";

      if (a.media_kind === "image" && a._imageUrl) {
        copyBuffer = a._imageUrl;
        if (fitSeg) fitSeg.hidden = curView === "raw";
        if (curView === "raw") {
          stage.innerHTML = `<pre class="mil-pre mono">图片 MIME：${esc(a.mime)} · 体积：${a.bytes} B\n${esc((a._base64Head || "").slice(0, 2000))}</pre>`;
        } else {
          const effFit = imgFit === "auto"
            ? ((a._dims && (a._dims.h > a._dims.w || a._dims.w >= 640)) ? "wide" : "contain")
            : imgFit;
          $$("[data-img-fit]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.imgFit === effFit)));
          if (effFit === "wide") {
            const boxW = Math.min(820, Math.max(320, (stage.clientWidth || 780) - 44));
            const boxH = a._dims ? Math.max(320, Math.round(boxW * (a._dims.h / a._dims.w))) : 680;
            stage.innerHTML = `<div class="out-img-stage out-img-stage--wide" role="img" aria-label="${esc(a.name || "产物图片")}" style="height:${boxH}px;aspect-ratio:${a._dims ? `${a._dims.w} / ${a._dims.h}` : "auto"};background-image:url('${esc(a._imageUrl)}')"></div>`;
          } else {
            stage.innerHTML = `<div class="out-img-stage" role="img" aria-label="${esc(a.name || "产物图片")}" style="background-image:url('${esc(a._imageUrl)}')"></div>`;
          }
        }
        return;
      }

      if (fitSeg) fitSeg.hidden = true;

      if (a.media_kind === "binary") {
        copyBuffer = a._base64Head || "";
        stage.innerHTML = `<pre class="mil-pre">二进制文件：${esc(a.name)} (${a.bytes} B)\nMIME：${esc(a.mime)}\nBase64 片段：\n${esc((a._base64Head || "").slice(0, 1200))}</pre>`;
        return;
      }

      if (a.media_kind === "conclusion") {
        copyBuffer = textAccumulator + ((a.links || []).length ? "\n\n出处链接：\n" + a.links.join("\n") : "");
        if (curView === "raw") {
          stage.innerHTML = `<pre class="mil-pre">${esc(copyBuffer)}</pre>`;
        } else {
          const attsHtml = (a.attachments || []).length
            ? `<div style="margin-bottom:12px;border-bottom:1px solid var(--mil-rule);padding-bottom:10px"><div class="mil-label" style="margin-bottom:6px">关联附件 (${a.attachments.length})</div><div class="mil-row">${a.attachments.map((att) => `<button type="button" class="mil-key mil-key--sm mil-key--hot" data-open-att="${esc(att.handle)}">预览 ${esc(att.name)} (${fmtBytes(att.bytes || 0)})</button>`).join("")}</div></div>`
            : "";
          const linksHtml = (a.links || []).length
            ? `<div style="margin-top:12px;border-top:1px solid var(--mil-rule);padding-top:10px"><div class="mil-label" style="margin-bottom:6px">提取的出处链接 (${a.links.length})</div>${a.links.map((u) => `<div class="out-link-item"><span class="mono" style="overflow-wrap:anywhere">${esc(u)}</span></div>`).join("")}</div>`
            : "";
          stage.innerHTML = `${attsHtml}${renderMarkdown(textAccumulator)}${linksHtml}`;
        }
        return;
      }

      copyBuffer = textAccumulator;
      if (curView === "preview" && a.media_kind === "html") {
        const tid = a.thread_id || selectedItem?.thread_id || "";
        const sibImg = tid
          ? (outData.items || []).find((it) => it.media_kind === "image" && it.thread_id === tid)
          : null;
        const sibBar = sibImg
          ? `<div class="mil-row" style="justify-content:space-between;margin-bottom:10px"><span class="mil-hint">当前为安全排版预览</span><button type="button" class="mil-key mil-key--sm mil-key--hot" data-open-item-id="${esc(sibImg.id)}">查看成图 ${esc(sibImg.name || sibImg.title)}</button></div>`
          : "";
        stage.innerHTML = `${sibBar}${renderSafeHtml(textAccumulator)}`;
      } else if (curView === "preview" && a.media_kind === "markdown") {
        stage.innerHTML = renderMarkdown(textAccumulator);
      } else {
        stage.innerHTML = `<pre class="mil-pre">${esc(textAccumulator)}</pre>`;
      }
    }

    function b64ToBytes(b64) {
      const bin = atob(b64);
      const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      return bytes;
    }

    async function loadArtifact(req, append = false) {
      const seq = ++openSeq;
      if (!append) {
        imgFit = "auto";
        textAccumulator = "";
        $("#out-copy-drawer").hidden = true;
        $("#out-stage").innerHTML = `<p class="mil-hint">正在加载产物内容…</p>`;
      }
      const r = await rpc("read", "artifact", req);
      if (sig?.aborted || seq !== openSeq) return;
      if (!r?.success) {
        $("#out-stage").innerHTML = `<p class="mil-hint">${esc(r?.error || "读取产物内容失败")}</p>`;
        return say(r?.error || "读取产物内容失败", true);
      }
      say("");

      if (r.media_kind === "image") {
        const chunks = [r.base64 || ""];
        let nextOff = r.next_offset;
        while (nextOff !== null && nextOff !== undefined && chunks.length < 48) {
          $("#out-stage").innerHTML = `<p class="mil-hint">正在加载大图分块（第 ${chunks.length + 1} 块）…</p>`;
          const nxt = await rpc("read", "artifact", { ...req, offset: nextOff });
          if (sig?.aborted || seq !== openSeq) return;
          if (!nxt?.success) {
            $("#out-stage").innerHTML = `<p class="mil-hint">${esc(nxt?.error || "图片分块读取失败")}</p>`;
            return say(nxt?.error || "图片分块读取失败", true);
          }
          chunks.push(nxt.base64 || "");
          nextOff = nxt.next_offset;
        }
        const arrays = chunks.map(b64ToBytes);
        const totalLen = arrays.reduce((acc, a) => acc + a.length, 0);
        const merged = new Uint8Array(totalLen);
        let writeOff = 0;
        for (const arr of arrays) {
          merged.set(arr, writeOff);
          writeOff += arr.length;
        }
        r._dims = probeImageDimensions(merged);
        r._imageUrl = chunks.length === 1
          ? `data:${r.mime || "image/png"};base64,${chunks[0]}`
          : `data:${r.mime || "image/png"};base64,${bytesToBase64(merged)}`;
        r._base64Head = chunks[0];
        r.next_offset = null;
        r._req = req;
        curArtifact = r;
        renderArtifactStage();
        return;
      }

      if (r.media_kind === "binary") {
        r._base64Head = r.base64 || "";
        r._req = req;
        curArtifact = r;
        renderArtifactStage();
        return;
      }

      textAccumulator = append ? textAccumulator + (r.text || "") : (r.text || "");
      r._req = req;
      curArtifact = r;
      renderArtifactStage();
    }

    function openItem(item, fromUser = false) {
      if (!item) return;
      selectedItem = item;
      const openWsBtn = $("#out-open-ws-btn");
      if (openWsBtn) openWsBtn.hidden = !item.workspace_id;
      if (fromUser && $("#out-shell")) $("#out-shell").classList.add("is-mob-inspect");
      renderCatalog();
      if (item.kind === "attachment") {
        return loadArtifact({ kind: "attachment", handle: item.handle, offset: 0 });
      }
      if (item.kind === "workspace_out") {
        return loadArtifact({ kind: "workspace_file", workspace_id: item.workspace_id, path: item.path, offset: 0 });
      }
      if (item.kind === "conclusion") {
        return loadArtifact({ kind: "conclusion", thread_id: item.thread_id, offset: 0 });
      }
    }

    async function loadOutputs(autoOpen = true) {
      const query = $("#out-search").value.trim();
      const r = await rpc("read", "outputs", { chat_id: filterChat, kind: filterKind, query });
      if (sig?.aborted) return;
      if (!r?.success) {
        const msg = r?.error || "读取产物目录失败";
        $("#out-stage").innerHTML = `<p class="mil-hint">${esc(msg)}</p>`;
        return say(msg, true);
      }
      say("");
      outData = r;
      renderChatFilter();
      renderCatalog();
      let targetItem = null;
      if (typeof pendingOutputTarget !== "undefined" && pendingOutputTarget) {
        const want = pendingOutputTarget;
        pendingOutputTarget = null;
        const pool = outData.items || [];
        if (want.handle) targetItem = pool.find((x) => x.handle === want.handle) || null;
        if (!targetItem && want.threadId) {
          targetItem = pool.find((x) => x.thread_id === want.threadId && x.media_kind === "image")
            || pool.find((x) => x.thread_id === want.threadId)
            || null;
        }
      }
      if (targetItem) {
        await openItem(targetItem);
      } else if (autoOpen && visibleItems.length && !selectedItem) {
        await openItem(visibleItems[0]);
      }
    }

    document.addEventListener("click", async (ev) => {
      const spaceBtn = ev.target.closest("[data-out-space]");
      if (spaceBtn) {
        activeSpace = spaceBtn.dataset.outSpace;
        selectedItem = null;
        if ($("#out-shell")) $("#out-shell").classList.remove("is-mob-inspect");
        renderCatalog();
        if (visibleItems.length && activeSpace !== "workspaces") await openItem(visibleItems[0]);
        return;
      }
      const layoutBtn = ev.target.closest("[data-out-layout]");
      if (layoutBtn) {
        outLayout = layoutBtn.dataset.outLayout;
        renderCatalog();
        return;
      }
      const roleBtn = ev.target.closest("[data-out-role]");
      if (roleBtn) {
        filterRole = roleBtn.dataset.outRole;
        selectedItem = null;
        renderCatalog();
        if (visibleItems.length) await openItem(visibleItems[0]);
        return;
      }
      const recentBtn = ev.target.closest("[data-recent-id]");
      if (recentBtn) {
        const rid = recentBtn.dataset.recentId;
        const hit = (outData.recent || []).concat(outData.items || []).find((x) => x.id === rid);
        if (hit) await openItem(hit, true);
        return;
      }
      const chatBtn = ev.target.closest("[data-out-chat]");
      if (chatBtn) {
        filterChat = chatBtn.dataset.outChat;
        selectedItem = null;
        renderFilterButtons();
        $("#out-list").innerHTML = `<p class="mil-hint" style="padding:10px">正在筛选会话产物…</p>`;
        await loadOutputs(true);
        return;
      }
      const kindBtn = ev.target.closest("[data-out-kind]");
      if (kindBtn) {
        filterKind = kindBtn.dataset.outKind;
        selectedItem = null;
        renderFilterButtons();
        $("#out-list").innerHTML = `<p class="mil-hint" style="padding:10px">正在筛选产物类型…</p>`;
        await loadOutputs(true);
        return;
      }
      const viewBtn = ev.target.closest("[data-out-view]");
      if (viewBtn) {
        curView = viewBtn.dataset.outView;
        renderFilterButtons();
        renderArtifactStage();
        return;
      }
      const fitBtn = ev.target.closest("[data-img-fit]");
      if (fitBtn) {
        imgFit = fitBtn.dataset.imgFit === "contain" ? "contain" : "wide";
        renderArtifactStage();
        return;
      }
      const openItemBtn = ev.target.closest("[data-open-item-id]");
      if (openItemBtn) {
        const hit = (outData.items || []).find((x) => x.id === openItemBtn.dataset.openItemId);
        if (hit) await openItem(hit, true);
        return;
      }
      const cardBtn = ev.target.closest("[data-out-idx]");
      if (cardBtn) {
        const idx = Number(cardBtn.dataset.outIdx);
        await openItem(visibleItems[idx] || (outData.items || [])[idx], true);
        return;
      }
      const attBtn = ev.target.closest("[data-open-att]");
      if (attBtn) {
        const handle = attBtn.dataset.openAtt;
        const hit = (outData.items || []).find((x) => x.handle === handle);
        if (hit) await openItem(hit, true);
        else await loadArtifact({ kind: "attachment", handle, offset: 0 });
        return;
      }
      const wsBtn = ev.target.closest("[data-ws]");
      if (wsBtn) {
        const wsid = wsBtn.dataset.ws;
        $$("[data-ws]").forEach((b) => b.setAttribute("aria-current", String(b === wsBtn)));
        const r = await rpc("read", "workspace", { workspace_id: wsid });
        if (!r?.success) return say(r?.error || "读取工作区失败", true);
        $("#workspace-files").innerHTML = (r.files || []).map((f) => {
          const area = String(f.path || "").split("/")[0] || "file";
          return `<button type="button" class="mil-key mil-key--sm" data-ws-id="${esc(wsid)}" data-ws-path="${esc(f.path)}" style="justify-content:space-between;gap:6px"><span class="mil-tag">${esc(area)}</span><span class="mono" style="flex:1;text-align:left;overflow:hidden;text-overflow:ellipsis">${esc(f.path)}</span><span class="num">${f.bytes}B</span></button>`;
        }).join("") || `<p class="mil-hint">空工作区</p>`;
        $("#workspace-content").textContent = r.text || "点击左侧文件查看内容并同步到下方内容检视器";
        return;
      }
      const fileBtn = ev.target.closest("[data-ws-path]");
      if (fileBtn) {
        $$("[data-ws-path]").forEach((b) => b.setAttribute("aria-current", String(b === fileBtn)));
        const wsid = fileBtn.dataset.wsId;
        const fpath = fileBtn.dataset.wsPath;
        await loadArtifact({ kind: "workspace_file", workspace_id: wsid, path: fpath, offset: 0 });
        if (sig?.aborted) return;
        if (curArtifact && curArtifact.workspace_id === wsid && curArtifact.path === fpath) {
          $("#workspace-content").textContent = curArtifact.text || `[${curArtifact.media_kind}] ${curArtifact.name} (${curArtifact.bytes} B · 已在下方内容检视器打开)`;
          if (!curArtifact.text) {
            $("#out-inspector")?.scrollIntoView({ behavior: calm() ? "auto" : "smooth", block: "nearest" });
          }
        }
      }
    }, { signal: sig });

    $("#out-chat").addEventListener("change", async () => {
      filterChat = $("#out-chat").value;
      selectedItem = null;
      await loadOutputs(true);
    });
    if ($("#out-refresh-btn")) $("#out-refresh-btn").onclick = () => { selectedItem = null; loadOutputs(true); };
    $("#out-search-btn").onclick = () => { selectedItem = null; loadOutputs(true); };
    $("#out-search").addEventListener("keydown", (ev) => {
      if (ev.key === "Enter") { ev.preventDefault(); selectedItem = null; loadOutputs(true); }
    });
    $("#out-more-btn").onclick = () => {
      if (curArtifact?._req && curArtifact.next_offset != null) {
        loadArtifact({ ...curArtifact._req, offset: curArtifact.next_offset }, true);
      }
    };
    $("#out-goto-now").onclick = () => {
      switchWorkspaceTab("now");
    };
    if ($("#out-mob-back")) {
      $("#out-mob-back").onclick = () => {
        $("#out-shell")?.classList.remove("is-mob-inspect");
      };
    }
    if ($("#out-open-ws-btn")) {
      $("#out-open-ws-btn").onclick = () => {
        const wsid = selectedItem?.workspace_id;
        if (!wsid) return;
        activeSpace = "workspaces";
        $("#out-shell")?.classList.remove("is-mob-inspect");
        renderCatalog();
        $(`[data-ws="${CSS.escape(wsid)}"]`)?.click();
      };
    }
    themeListeners.push(() => { if (outData?.items) renderCatalog(); });
    $("#out-copy-btn").onclick = async () => {
      if (!copyBuffer) return say("当前无可复制的文本内容。", true);
      let copied = false;
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(copyBuffer);
          copied = true;
        }
      } catch {}
      if (copied) {
        say("已复制产物内容到剪贴板。");
      } else {
        $("#out-copy-box").value = copyBuffer;
        $("#out-copy-drawer").hidden = false;
        $("#out-copy-drawer").open = true;
        $("#out-copy-box").focus();
        $("#out-copy-box").select();
        say("已展开手动复制框并全选，请按 Ctrl/Cmd + C 复制。");
      }
    };

    (async () => {
      await Promise.resolve(window.maibot?.ready);
      if (sig?.aborted) return;
      applyTheme();
      await loadOutputs(true);
    })();
  }

  /* ════════════════════════════════════════════════════════════════
     2. 手账页 (memory)
     ════════════════════════════════════════════════════════════════ */
  if (page === "memory") {
    let expectedVersion = 0;
    let memData = { chats: [] };

    const LAYER_BADGES = {
      memory: "本会话办事约定",
      journal: "近七天后台经历",
      heartbeat: "自主探索方向",
    };

    const LAYER_GUIDES = {
      memory: "会话备忘（MEMORY.md）按会话严格隔离，仅记录本会话长期置顶的办事约定；普通历史对话由系统自动检索关联。",
      journal: "近期手账（JOURNAL.md）由系统在公开探索线程完成后自动沉淀近 7 天经历摘要（新装或尚未触发探索时为空属正常现象）；请勿在此写入单会话私密信息。",
      heartbeat: "探索节奏（HEARTBEAT.md）配置闲暇分寸与「## 自主探索方向」。预设示例默认处于注释静默态；取消注释或点击右上角「填入示例模板」保存后即按心跳间隔巡检公开主题。",
    };

    function renderLayerBtns() {
      const k = $("#kind").value;
      $$("[data-kind-tab]").forEach((b) => {
        const active = b.dataset.kindTab === k;
        b.setAttribute("aria-pressed", String(active));
        b.classList.toggle("is-active", active);
      });
      const cid = $("#chat").value;
      $$("[data-chat-chip]").forEach((b) => b.setAttribute("aria-current", String(b.dataset.chatChip === cid)));
      const guide = $("#mem-layer-guide");
      if (guide) guide.textContent = LAYER_BADGES[k] || "";
      const help = $("#mem-layer-help");
      if (help) help.dataset.help = LAYER_GUIDES[k] || "";
      const hbBtn = $("#insert-heartbeat-example");
      if (hbBtn) hbBtn.hidden = k !== "heartbeat";
    }
    function updateMeter() {
      const len = ($("#content").value || "").length;
      $("#mem-char-count").textContent = `${len} / 16000`;
      $("#mem-meter-bar").style.width = `${Math.min(100, Math.round((len / 16000) * 100))}%`;
    }
    let memLoadSeq = 0;
    async function loadAsset(preserveDraft = false) {
      const seq = ++memLoadSeq;
      const kind = $("#kind").value;
      const chat_id = $("#chat").value;
      renderLayerBtns();
      if (kind === "memory" && !chat_id) {
        $("#content").value = "";
        $("#content").disabled = true;
        $("#save").disabled = false;
        $("#version").textContent = "请选择会话";
        updateMeter();
        return;
      }
      const prevDraft = $("#content").value;
      $("#content").disabled = true;
      $("#save").disabled = true;
      try {
        const r = await rpc("read", "asset", kind === "memory" ? { kind, chat_id } : { kind });
        if (sig?.aborted || seq !== memLoadSeq) return;
        if (!r?.success) return say(r?.error || "读取手账失败", true);
        if ($("#feedback")?.classList.contains("mil-feedback--err")) say("");
        if (preserveDraft && prevDraft !== (r.content || "")) {
          $("#local-draft").value = prevDraft;
          $("#draft-panel").hidden = false;
        }
        $("#content").value = r.content || "";
        expectedVersion = Number(r.version || 0);
        $("#version").textContent = `v${expectedVersion}`;
        setDirty(false);
        versionHistory(r.history, expectedVersion);
        updateMeter();
      } finally {
        if (!sig?.aborted && seq === memLoadSeq) {
          $("#content").disabled = kind === "memory" && !$("#chat").value;
          $("#save").disabled = false;
        }
      }
    }

    function renderCards(el, rows, kind) {
      if (!rows?.length) {
        el.innerHTML = `<p class="mil-hint">${kind === "search" ? "暂无检索结果" : "暂无自身经历"}</p>`;
        return;
      }
      el.innerHTML = rows.map((x) => {
        if (typeof x === "string") return `<div class="exp-card"><span>${esc(x)}</span></div>`;
        const body = x.snippet || x.summary || x.text || x.title || x.reason || "";
        return `<div class="exp-card">
          <div class="mil-row" style="justify-content:space-between;font-size:11.5px">
            <strong>${esc(x.profile || x.kind || "记录")}</strong>
            <span class="mono mil-hint">${esc(x.thread_id || x.chat_id || "")}</span>
          </div>
          <span style="font-size:12.5px">${esc(body || "已记录活动条目")}</span>
        </div>`;
      }).join("");
    }

    const MEM_INTENT_KINDS = {
      routine: "周期安排",
      proactive: "主动触发",
      self_reflection: "自我探索",
      webhook: "外部事件",
      user_schedule: "定时任务",
      workflow: "定时任务",
      reminder: "提醒",
    };
    const MEM_INTENT_STATES = {
      pending: "等待中",
      scheduled: "已排期",
      running: "进行中",
      done: "已完成",
      completed: "已完成",
      cancelled: "已取消",
      failed: "已结束",
    };

    function applyOverviewData(r) {
      if (!r?.success) return say(r?.error || "读取手账概览失败", true);
      memData = r;
      const prevChat = $("#chat").value;
      const chats = r.chats || [];
      const srcs = r.chat_sources || {};
      const chatLabel = (cid) => {
        const s = srcs[cid];
        const spec = s?.stream_spec || cid;
        return s?.name && s.name !== spec ? `${s.name} · ${spec}` : spec;
      };
      $("#chat").innerHTML = chats.length
        ? chats.map((c) => `<option value="${esc(c)}">${esc(chatLabel(c))}</option>`).join("")
        : `<option value="">暂无会话</option>`;
      if (prevChat && chats.includes(prevChat)) $("#chat").value = prevChat;
      $("#chat-chips").innerHTML = chats.map((c) => {
        const s = srcs[c] || {};
        const name = s.name || c;
        const spec = s.stream_spec || "";
        const rawAv = String(s.avatar || "");
        const safeAv = /^data:image\//i.test(rawAv) && !/["'()\s]/.test(rawAv) ? rawAv : "";
        const mono = (name || c || "?").trim().slice(0, 1).toUpperCase();
        return `<button type="button" class="mil-key mil-key--sm ms-chat-chip" data-chat-chip="${esc(c)}" title="${esc(spec || c)}">
          <span class="ms-chat-chip-top">
            <span class="mil-avatar mil-avatar--sm" aria-hidden="true">${esc(mono)}${safeAv ? `<span class="mil-avatar-img" style="background-image:url('${esc(safeAv)}')"></span>` : ""}</span>
            <span class="ms-chat-chip-name">${esc(name)}</span>
          </span>
          ${spec || s.platform ? `<span class="ms-chat-chip-spec mono">${esc(spec || s.platform)}</span>` : ""}
        </button>`;
      }).join("") || `<span class="mil-hint">暂无已启用会话</span>`;
      renderLayerBtns();
      const quotaBox = $("#mem-quota-box");
      if (quotaBox && r.proactive_quota) {
        const q = r.proactive_quota;
        quotaBox.innerHTML = `<span class="m-quota-main num">已用 ${Number(q.used || 0)} / ${Number(q.limit || 0)}</span><span class="m-quota-sub">剩余 ${Number(q.remaining || 0)} 次</span>`;
      }
      renderCards($("#search-results"), r.results, "search");
      renderCards($("#experiences"), r.experiences, "exp");
    }

    async function loadOverview() {
      const query = $("#search").value.trim();
      const chat_id = $("#chat").value;
      const r = await rpc("read", "memory", { chat_id, query });
      if (sig?.aborted) return;
      applyOverviewData(r);
    }

    function applyIntentsData(r) {
      if (!r?.success) return;
      const srcs = memData?.chat_sources || {};
      const targetName = (raw) => {
        const clean = String(raw || "").replace(/^chat:/, "").trim();
        const s = srcs[clean];
        const spec = s?.stream_spec || clean;
        return s?.name && s.name !== spec ? `${s.name} · ${spec}` : (spec || "自身活动");
      };
      $("#intent-list").innerHTML = (r.intents || []).map((i) => {
        const kindTxt = i.kind_label || MEM_INTENT_KINDS[i.kind] || i.kind || "计划";
        const statusTxt = MEM_INTENT_STATES[i.status] || i.status || "等待中";
        const srcTxt = MEM_INTENT_KINDS[i.source] || i.source || "系统";
        const ctlHtml = i.status === "pending"
          ? (i.protected ? `<span class="mil-tag">受保护</span>` : `<button type="button" class="mil-key mil-key--sm mil-key--danger" data-cancel-intent="${esc(i.intent_id)}">取消</button>`)
          : `<span class="mil-tag">${esc(statusTxt)}</span>`;
        return `<div class="exp-card">
          <div class="mil-row" style="justify-content:space-between">
            <span><span class="mil-tag">${esc(kindTxt)}</span> <strong>${esc(i.reason || "定时执行")}</strong></span>
            ${ctlHtml}
          </div>
          <span class="mil-hint">${esc(targetName(i.target))} · ${esc(srcTxt)}</span>
        </div>`;
      }).join("") || `<p class="mil-hint">暂无意图记录</p>`;

      const learnRows = Array.isArray(r.learning) ? r.learning : [];
      $("#learning").innerHTML = learnRows.length
        ? learnRows.map((entry) => {
            if (!entry || typeof entry !== "object") return `<div class="ms-receipt-card"><span>${esc(String(entry || ""))}</span></div>`;
            const title = entry.topic || entry.title || entry.summary || entry.note || entry.content || entry.kind || "笔记回执";
            const status = MEM_INTENT_STATES[entry.status] || entry.status || "已记录";
            const metaParts = [entry.chat_id ? targetName(entry.chat_id) : "", entry.profile || "", entry.at || ""].filter(Boolean);
            const undoBtn = entry.profile
              ? `<button type="button" class="mil-key mil-key--sm" data-undo-learning="${esc(entry.profile)}" data-history-id="${esc(entry.version ?? entry.thread_id ?? "")}">撤回</button>`
              : "";
            return `<div class="ms-receipt-card">
              <div class="ms-receipt-head"><strong>${esc(String(title))}</strong><div class="mil-row" style="gap:6px"><span class="mil-tag">${esc(String(status))}</span>${undoBtn}</div></div>
              ${metaParts.length ? `<span class="ms-receipt-meta">${esc(metaParts.join(" · "))}</span>` : ""}
            </div>`;
          }).join("")
        : `<span class="mil-hint">暂无自动笔记回执</span>`;
    }

    async function loadIntents() {
      const r = await rpc("read", "intents", {});
      if (sig?.aborted) return;
      applyIntentsData(r);
    }

    document.addEventListener("click", async (ev) => {
      const kindBtn = ev.target.closest("[data-kind-tab]");
      if (kindBtn) {
        $("#kind").value = kindBtn.dataset.kindTab;
        say("");
        await loadAsset(false);
        return;
      }
      const chatBtn = ev.target.closest("[data-chat-chip]");
      if (chatBtn) {
        $("#chat").value = chatBtn.dataset.chatChip;
        say("");
        await loadAsset(false);
        await loadOverview();
        return;
      }
      const cancelBtn = ev.target.closest("[data-cancel-intent]");
      if (cancelBtn) {
        const r = await rpc("write", "cancel_intent", { intent_id: cancelBtn.dataset.cancelIntent });
        if (!r?.success) return say(r?.error || "取消失败", true);
        say("意图已取消");
        await loadIntents();
        return;
      }
      const undoBtn = ev.target.closest("[data-undo-learning]");
      if (undoBtn) {
        const profileId = undoBtn.dataset.undoLearning;
        const histId = undoBtn.dataset.historyId || "";
        const payload = { profile_id: profileId };
        if (histId) payload.history_id = histId;
        const r = await rpc("write", "undo_learning_note", payload);
        if (!r?.success) return say(r?.error || "撤回笔记失败", true);
        say(`已撤回 ${profileId} 的自动笔记修订`);
        await loadIntents();
      }
    }, { signal: sig });
    if ($("#mem-goto-outputs")) {
      $("#mem-goto-outputs").onclick = () => switchWorkspaceTab("outputs");
    }

    $("#chat").addEventListener("change", () => { say(""); loadAsset(false); });
    $("#kind").addEventListener("change", () => { say(""); loadAsset(false); });
    $("#content").addEventListener("input", () => { setDirty(true); updateMeter(); });
    $("#insert-heartbeat-example").onclick = () => {
      const sample = "- 留意开源多模态工具、AI 工程实践与科技新发布的公开一手动态，遇到扎实有趣的进展先记入近期手账。";
      const cur = $("#content").value || "";
      if (cur.includes(sample)) return say("当前已包含该公开探索示例。");
      if (/^##\s*自主探索方向\s*$/m.test(cur)) {
        $("#content").value = cur.replace(/\s*$/, "\n" + sample + "\n");
      } else {
        $("#content").value = cur.replace(/\s*$/, "\n\n## 自主探索方向\n\n" + sample + "\n");
      }
      setDirty(true);
      updateMeter();
      say("已插入公开探索示例，点击「保存修改」后生效。");
    };
    $("#save").onclick = async () => {
      const kind = $("#kind").value;
      const body = { kind, content: $("#content").value, expected_version: expectedVersion };
      if (kind === "memory") body.chat_id = $("#chat").value;
      $("#save").disabled = true;
      say("");
      try {
        const r = await rpc("write", "asset", body);
        if (!r?.success) return say(r?.error || "保存失败", true);
        expectedVersion = Number(r.version || 0);
        $("#version").textContent = `v${expectedVersion}`;
        $("#draft-panel").hidden = true;
        await loadAsset(false);
        say("已保存");
      } finally {
        $("#save").disabled = false;
      }
    };
    $("#reload").onclick = async () => { await loadAsset(true); say("已读取最新版本。"); };
    $("#restore").onclick = async () => {
      const kind = $("#kind").value;
      const ver = Number($("#history").value);
      const body = { kind, version: ver, expected_version: expectedVersion };
      if (kind === "memory") body.chat_id = $("#chat").value;
      say("");
      const r = await rpc("write", "rollback", body);
      if (!r?.success) return say(r?.error || "回滚失败", true);
      await loadAsset(false);
      say(`已回滚至 v${ver}`);
    };
    $("#search-button").onclick = loadOverview;
    $("#search").addEventListener("keydown", (ev) => {
      if (ev.key === "Enter") {
        ev.preventDefault();
        loadOverview();
      }
    });

    (async () => {
      await Promise.resolve(window.maibot?.ready);
      if (sig?.aborted) return;
      applyTheme();
      const b = await rpc("read", "batch", {
        sections: {
          memory: { chat_id: $("#chat").value, query: $("#search").value.trim() },
          intents: {},
        },
      });
      if (sig?.aborted) return;
      if (b?.success && b.sections?.memory) {
        applyOverviewData({ success: true, ...b.sections.memory });
        if (b.sections.intents) applyIntentsData({ success: true, ...b.sections.intents });
        if (sig?.aborted) return;
        await loadAsset(false);
      } else {
        await loadOverview();
        if (sig?.aborted) return;
        await loadAsset(false);
        if (sig?.aborted) return;
        await loadIntents();
      }
    })();
  }

  /* ════════════════════════════════════════════════════════════════
     3. 设置页 (settings)
     ════════════════════════════════════════════════════════════════ */
  if (page === "settings") {
    let curSettings = null;
    let curVersion = "";
    let svcVersion = "";
    let whVersion = "";
    let settingsMode = "general";
    let knownChats = [];
    let knownProfiles = [];
    let whitelistEntries = [];
    const WEB_PRESETS = ["auto", "host", "google_search_plugin", "mcp", "plugin_api"];
    const INTENT_KIND_LABELS = {
      routine: "周期安排",
      proactive: "主动触发",
      self_reflection: "自我探索",
      webhook: "外部事件",
      user_schedule: "定时任务",
      workflow: "定时任务",
      reminder: "提醒",
    };
    const INTENT_STATUS_LABELS = {
      pending: "等待中",
      scheduled: "已排期",
      running: "进行中",
      done: "已完成",
      completed: "已完成",
      cancelled: "已取消",
      failed: "已结束",
    };
    const PROACTIVE_OPTION_LABELS = {
      "": "跟随全局分寸",
      quiet: "安静 · 仅被动响应",
      care: "平衡 · 适度关心",
      lively: "活跃 · 空闲时主动",
    };

    const row = (name, desc, ctl, wide = false) => `<div class="set-row${wide ? " set-row--wide" : ""}"><div class="set-row-l"><div class="set-row-t"><span>${name}</span>${helpBtn(desc)}</div></div><div class="set-row-r">${ctl}</div></div>`;

    function findKnownChat(token) {
      const t = String(token || "").trim();
      if (!t) return null;
      return knownChats.find((k) => k.stream_spec === t || k.chat_id === t) || null;
    }

    function friendlyStreamName(token) {
      const t = String(token || "").trim();
      if (!t) return "未命名会话";
      if (t === "self") return "自身活动";
      const k = findKnownChat(t);
      const m = t.match(/^([a-z0-9_-]+):(group|private):(.+)$/i);
      if (k && k.name && k.name !== t && (!m || k.name !== m[3])) return k.name;
      if (m) return `${m[1].toUpperCase()} ${m[2].toLowerCase() === "group" ? "群聊" : "私聊"} · ${m[3]}`;
      return t;
    }

    function normalizeStreamInput(raw) {
      const val = String(raw || "").trim();
      if (!val) return "";
      if (val === "self") return "self";
      const m = val.match(/^(?:chat:)?([a-z][a-z0-9_-]*):(group|private):([^\s:][^\s]*)$/i);
      if (m) return `${m[1].toLowerCase()}:${m[2].toLowerCase()}:${m[3].trim()}`;
      const matched = findKnownChat(val);
      return matched?.stream_spec || val;
    }

    function syncWhitelistHidden() {
      const hidden = $("#set-chats");
      if (hidden) hidden.value = whitelistEntries.map((e) => e.spec).join(", ");
    }

    function renderWhitelistBox() {
      const box = $("#chat-whitelist-box");
      if (!box) return;
      const addedSet = new Set(whitelistEntries.map((e) => e.spec));
      const availableKnown = knownChats.filter((k) => {
        const spec = String(k.stream_spec || k.chat_id || "").trim();
        return spec && !addedSet.has(spec);
      });
      const rowsHtml = whitelistEntries.length
        ? whitelistEntries.map((entry, idx) => {
            const title = friendlyStreamName(entry.spec);
            const showCode = title !== entry.spec;
            const opts = Object.entries(PROACTIVE_OPTION_LABELS).map(
              ([v, lbl]) => `<option value="${v}" ${entry.level === v ? "selected" : ""}>${lbl}</option>`
            ).join("");
            return `<div class="ms-entry-row" data-wl-idx="${idx}">
              <div class="ms-entry-meta">
                <span class="ms-entry-title">${esc(title)}</span>
                ${showCode ? `<span class="mil-tag ms-entry-code">${esc(entry.spec)}</span>` : ""}
              </div>
              <div class="ms-entry-ctl">
                <select class="mil-select" data-wl-level="${idx}" aria-label="${esc(title)} 的主动分寸">${opts}</select>
                <button type="button" class="mil-key mil-key--sm" data-wl-remove="${idx}" aria-label="移除 ${esc(title)}">移除</button>
              </div>
            </div>`;
          }).join("")
        : `<div class="mil-hint" style="padding:6px 2px">暂未添加允许服务的会话；添加后 Maisya 才会在对应群或私聊生效。</div>`;

      const knownHtml = availableKnown.length
        ? `<div class="ms-entry-add">
            <select id="wl-pick-known" class="mil-select" style="flex:1 1 200px" aria-label="从已发现会话选择">
              <option value="">从已发现会话挑选…</option>
              ${availableKnown.map((k) => {
                const spec = k.stream_spec || k.chat_id;
                const lbl = k.name && k.name !== spec ? `${k.name} · ${spec}` : spec;
                return `<option value="${esc(spec)}">${esc(lbl)}</option>`;
              }).join("")}
            </select>
            <button type="button" class="mil-key mil-key--sm" id="wl-add-known">+ 添加所选</button>
          </div>`
        : "";

      const addHtml = `<div class="ms-entry-add">
        <select id="wl-add-platform" class="mil-select" aria-label="平台">
          <option value="qq">QQ</option>
          <option value="telegram">Telegram</option>
          <option value="discord">Discord</option>
          <option value="wechat">微信</option>
        </select>
        <select id="wl-add-type" class="mil-select" aria-label="会话类型">
          <option value="group">群聊</option>
          <option value="private">私聊</option>
        </select>
        <input id="wl-add-id" class="mil-input mono" style="flex:1 1 160px" placeholder="群号或账号，如 12345678" aria-label="群号或账号">
        <button type="button" class="mil-key mil-key--sm mil-key--hot" id="wl-add-btn">+ 添加条目</button>
      </div>`;

      box.innerHTML = `<div class="ms-entry-list">${rowsHtml}</div>${knownHtml}${addHtml}`;
      syncWhitelistHidden();
    }

    function syncSleepHidden() {
      const hidden = $("#set-sleep");
      const enabled = $("#sleep-enabled")?.checked;
      const startSel = $("#sleep-start");
      const endSel = $("#sleep-end");
      const wrap = $("#sleep-range-wrap");
      if (wrap) wrap.hidden = !enabled;
      if (startSel) startSel.disabled = !enabled;
      if (endSel) endSel.disabled = !enabled;
      if (hidden) {
        hidden.value = enabled ? `${startSel?.value || "01"}-${endSel?.value || "08"}` : "";
      }
    }

    function populateChatAndProfilePickers() {
      const curChat = ($("#intent-chat")?.value || "").trim();
      const chatSel = $("#intent-chat-select");
      const chatOptions = [
        `<option value="">手动填写目标会话…</option>`,
        `<option value="self">自身探索记录 (self)</option>`,
      ];
      const seenSpecs = new Set(["self"]);
      (knownChats || []).forEach((k) => {
        const spec = String(k.stream_spec || k.chat_id || "").trim();
        if (!spec || seenSpecs.has(spec)) return;
        seenSpecs.add(spec);
        const lbl = k.name && k.name !== spec ? `${k.name} · ${spec}` : spec;
        chatOptions.push(`<option value="${esc(spec)}">${esc(lbl)}</option>`);
      });
      (curSettings?.enabled_chats || []).forEach((c) => {
        const spec = String(c || "").trim();
        if (!spec || seenSpecs.has(spec)) return;
        seenSpecs.add(spec);
        const lbl = friendlyStreamName(spec);
        chatOptions.push(`<option value="${esc(spec)}">${esc(lbl !== spec ? `${lbl} · ${spec}` : spec)}</option>`);
      });
      if (chatSel) {
        chatSel.innerHTML = chatOptions.join("");
        chatSel.value = seenSpecs.has(curChat) ? curChat : "";
      }
      $("#intent-chat-list").innerHTML = [...seenSpecs].map((c) => `<option value="${esc(c)}">`).join("");

      const profiles = knownProfiles.length
        ? knownProfiles
        : [
            { id: "scout", title: "探索者", enabled: true },
            { id: "maker", title: "造物主", enabled: true },
            { id: "digest", title: "整理官", enabled: true },
          ];
      const profileOptions = (val) => {
        const list = [...profiles];
        if (val && !list.some((p) => p.id === val)) list.push({ id: val, title: val, enabled: true });
        return list.map((p) => `<option value="${esc(p.id)}" ${p.id === val ? "selected" : ""}>${esc(p.title && p.title !== p.id ? `${p.title} · ${p.id}` : p.id)}</option>`).join("");
      };
      const curProf = ($("#intent-profile")?.value || "scout").trim() || "scout";
      if ($("#intent-profile-select")) $("#intent-profile-select").innerHTML = profileOptions(curProf);
      if ($("#wh-b-profile")) $("#wh-b-profile").innerHTML = profileOptions("scout");
    }

    let curServicesCfg = {};
    let editingService = { kind: "mcp", origName: "" };
    let mobSheetHolder = null;
    let mobSheetParent = null;

    function setSettingsMode(mode) {
      settingsMode = mode === "advanced" ? "advanced" : "general";
      $$("[data-settings-mode]").forEach((b) => {
        b.setAttribute("aria-pressed", String(b.dataset.settingsMode === settingsMode));
      });
      $("#settings-general-view").hidden = settingsMode !== "general";
      $("#settings-advanced-view").hidden = settingsMode !== "advanced";
      $$("[data-set-rail]").forEach((b) => {
        const key = b.dataset.setRail;
        const match = (settingsMode === "general" && ["general", "streams", "routines"].includes(key))
          || (settingsMode === "advanced" && ["services", "vault", "webhooks"].includes(key));
        if (!match) b.classList.remove("is-active");
      });
    }

    function openMobRoute(route) {
      const shell = $("#settings-shell");
      const hub = $("#settings-mob-hub");
      const sub = $("#settings-mob-sub");
      const titleEl = $("#mob-sub-title");
      const addBtn = $("#mob-sub-act-add");
      const refBtn = $("#mob-sub-act-refresh");
      const next = route || "hub";
      if (shell) shell.dataset.mobSub = next;
      const inHub = next === "hub";
      if (hub) hub.hidden = !inHub;
      if (sub) sub.hidden = inHub;
      if (inHub) return;
      const titles = {
        general: "外观、主动与联网",
        streams: "对话流白名单",
        routines: "定时安排与状态",
        services: "外部服务与工具",
        vault: "凭据保险箱",
        webhooks: "外部事件触发",
      };
      if (titleEl) titleEl.textContent = titles[next] || "设置详情";
      const isAdv = ["services", "vault", "webhooks"].includes(next);
      setSettingsMode(isAdv ? "advanced" : "general");
      if (addBtn) {
        addBtn.hidden = !["services", "webhooks"].includes(next);
        addBtn.dataset.mobSheet = next === "webhooks" ? "wh" : "svc";
      }
      if (refBtn) refBtn.hidden = next !== "routines";
    }

    function closeMobileSheet() {
      const scrim = $("#settings-mob-scrim");
      if (mobSheetHolder && mobSheetParent) {
        mobSheetParent.appendChild(mobSheetHolder);
      }
      mobSheetHolder = null;
      mobSheetParent = null;
      if (scrim) scrim.hidden = true;
    }

    function openMobileSheet(el, titleText) {
      const scrim = $("#settings-mob-scrim");
      const body = $("#mob-sheet-body");
      const ttl = $("#mob-sheet-title");
      if (!scrim || !body || !el) return;
      closeMobileSheet();
      mobSheetHolder = el;
      mobSheetParent = el.parentElement;
      body.appendChild(el);
      if (ttl) ttl.textContent = titleText || "编辑配置";
      scrim.hidden = false;
    }

    function syncSvcDrawerFields() {
      const isTpl = $("#svc-d-kind")?.value === "template";
      if ($("#svc-d-tools-wrap")) $("#svc-d-tools-wrap").hidden = isTpl;
      if ($("#svc-d-targets-wrap")) $("#svc-d-targets-wrap").hidden = !isTpl;
    }

    function openServiceDrawer(kind, name) {
      const isTpl = kind === "template";
      const pool = isTpl ? (curServicesCfg.templates || {}) : (curServicesCfg.servers || {});
      const spec = (name && pool[name]) || {};
      editingService = { kind: isTpl ? "template" : "mcp", origName: name || "" };
      if ($("#svc-d-kind")) $("#svc-d-kind").value = editingService.kind;
      if ($("#svc-d-name")) $("#svc-d-name").value = name || "";
      if ($("#svc-d-desc")) $("#svc-d-desc").value = spec.description || "";
      const cmdList = isTpl ? (spec.argv || []) : (spec.command || []);
      if ($("#svc-d-cmd")) $("#svc-d-cmd").value = Array.isArray(cmdList) ? cmdList.join(" ") : String(cmdList || "");
      if ($("#svc-d-tools")) $("#svc-d-tools").value = Array.isArray(spec.tools) ? spec.tools.join(", ") : "";
      if ($("#svc-d-targets")) $("#svc-d-targets").value = Array.isArray(spec.targets) ? spec.targets.join(", ") : "";
      const credsObj = spec.credentials && typeof spec.credentials === "object" ? spec.credentials : {};
      const credsLines = isTpl
        ? (Array.isArray(spec.secrets) ? spec.secrets.map((s) => `${s}=${s}`) : [])
        : Object.entries(credsObj).map(([k, v]) => `${k}=${v}`);
      if ($("#svc-d-creds")) $("#svc-d-creds").value = credsLines.join("\n");
      if ($("#svc-d-access")) $("#svc-d-access").value = spec.access === "admins" ? "admins" : "everyone";
      if ($("#svc-d-mem")) $("#svc-d-mem").value = String(Number(spec.memory_mib || 256));
      if ($("#svc-d-readonly")) $("#svc-d-readonly").checked = spec.readonly !== false;
      if ($("#svc-d-del")) $("#svc-d-del").hidden = !name;
      if ($("#set-drawer-title")) $("#set-drawer-title").textContent = name ? `编辑：${name}` : "新增外部服务";
      if ($("#set-drawer-badge")) $("#set-drawer-badge").textContent = isTpl ? "固定模板" : "MCP 服务";
      syncSvcDrawerFields();
      if (window.innerWidth <= 760) {
        openMobileSheet($("#svc-drawer-form"), name ? `编辑服务：${name}` : "新增外部服务");
      } else {
        $("#settings-ctx-drawer")?.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    }

    function syncWebCustomVis() {
      const sel = $("#web_provider")?.value;
      const wrap = $("#web-custom-wrap");
      if (wrap) wrap.hidden = sel !== "custom";
    }

    function updateSchedSummary() {
      const pill = $("#sched-summary-pill");
      const prof = ($("#intent-profile")?.value || "scout").trim() || "scout";
      const profSel = $("#intent-profile-select");
      if (profSel && [...profSel.options].some((o) => o.value === prof)) profSel.value = prof;
      const chatVal = ($("#intent-chat")?.value || "").trim();
      const chatSel = $("#intent-chat-select");
      if (chatSel) chatSel.value = [...chatSel.options].some((o) => o.value === chatVal) ? chatVal : "";
      if (!pill) return;
      const every = Number($("#intent-every")?.value || 0);
      const delay = Number($("#intent-in")?.value || 60);
      const head = every >= 86400 ? `每 ${Math.round(every / 86400)} 天周期` : every >= 3600 ? `每 ${Math.round(every / 3600)} 小时周期` : every > 0 ? `每 ${every} 秒周期` : "单次";
      pill.textContent = `${head} · ${delay} 秒后由 ${prof} 执行`;
    }

    function renderGeneral() {
      const s = curSettings || {};
      const chats = Array.isArray(s.enabled_chats) ? s.enabled_chats : [];
      const levels = s.chat_proactive_levels || {};
      whitelistEntries = [];
      const seenWl = new Set();
      chats.forEach((raw) => {
        const spec = normalizeStreamInput(raw);
        if (!spec || seenWl.has(spec)) return;
        seenWl.add(spec);
        const lv = levels[raw] || levels[spec] || "";
        whitelistEntries.push({ spec, level: PROACTIVE_OPTION_LABELS[lv] ? lv : "" });
      });

      const web = s.web_provider || "auto";
      const uiStyle = s.ui_style || "millennium";
      const isPreset = WEB_PRESETS.includes(web);
      const sleepMatch = String(s.sleep_window || "").trim().match(/^(\d{1,2})-(\d{1,2})$/);
      const sleepOn = Boolean(sleepMatch);
      const sleepStart = sleepMatch ? sleepMatch[1].padStart(2, "0") : "01";
      const sleepEnd = sleepMatch ? sleepMatch[2].padStart(2, "0") : "08";
      const hourOpts = (sel) => Array.from({ length: 24 }, (_, h) => {
        const v = String(h).padStart(2, "0");
        return `<option value="${v}" ${v === sel ? "selected" : ""}>${v}:00</option>`;
      }).join("");

      const hbList = knownProfiles.length
        ? knownProfiles
        : [{ id: "scout", title: "探索者" }, { id: "digest", title: "整理官" }, { id: "maker", title: "造物主" }];
      const curHb = s.heartbeat_profile || "scout";
      const hbChoices = hbList.some((p) => p.id === curHb) ? hbList : [...hbList, { id: curHb, title: curHb }];
      const hbOpts = hbChoices.map((p) => `<option value="${esc(p.id)}" ${p.id === curHb ? "selected" : ""}>${esc(p.title && p.title !== p.id ? `${p.title} · ${p.id}` : p.id)}</option>`).join("");

      const wlRowHtml = row("启用会话白名单", "以条目方式管理允许服务的会话（统一格式 平台:类型:id，如 qq:group:12345678）。也可针对单条会话单独设定主动分寸；未加入白名单的会话零读取、零打扰。", `<div id="chat-whitelist-box" class="ms-entry-box"></div><input id="set-chats" type="hidden" value="${esc(whitelistEntries.map((e) => e.spec).join(", "))}">`, true);
      const genRows = [
        row("界面设计风格", "默认千禧机械（协调宿主主题）；也可切换为默认主题，或改为自动跟随宿主主题。", `<select id="ui_style" class="mil-select"><option value="millennium" ${uiStyle === "millennium" ? "selected" : ""}>千禧机械（默认 · 协调宿主）</option><option value="maiwork" ${uiStyle === "maiwork" ? "selected" : ""}>默认主题</option><option value="auto" ${uiStyle === "auto" ? "selected" : ""}>自动跟随宿主主题</option></select>`),
        row("启用 Maisya 插件", "开启后在以下启用会话挂载技能、手账备忘与主动脉搏。", `<label class="mil-switch"><input id="set-enabled" type="checkbox" ${s.plugin?.enabled ? "checked" : ""}><span class="mil-switch-track"></span><span class="mil-switch-txt">${s.plugin?.enabled ? "已开启" : "已停用"}</span></label>`),
      ];
      if ($("#streams-fields")) {
        $("#streams-fields").innerHTML = wlRowHtml;
      } else {
        genRows.push(wlRowHtml);
      }
      genRows.push(
        row("主动分寸与每日上限", "空闲后是否主动惦记，以及普通闲聊每日最多搭话次数 (0-50)。", `<select id="proactive_level" class="mil-select" style="width:auto;flex:1 1 180px"><option value="quiet" ${s.proactive_level === "quiet" ? "selected" : ""}>安静（只回应触发）</option><option value="care" ${s.proactive_level === "care" ? "selected" : ""}>平衡（适度主动关心）</option><option value="lively" ${s.proactive_level === "lively" ? "selected" : ""}>活跃（空闲时会主动搭话）</option></select><input id="daily_proactive_limit" class="mil-input mono" style="width:76px;flex:0 0 auto" type="number" min="0" max="50" value="${Number(s.daily_proactive_limit ?? 1)}" aria-label="每日主动搭话上限"><span class="ms-inline-unit">次/天</span>`),
        row("免打扰时段", "开启后在指定整点时段内保持安静，不发主动问候（如凌晨 01:00 至 08:00）。", `<label class="mil-switch"><input id="sleep-enabled" type="checkbox" ${sleepOn ? "checked" : ""}><span class="mil-switch-track"></span><span class="mil-switch-txt">${sleepOn ? "已开启" : "未限制"}</span></label><div id="sleep-range-wrap" class="mil-row" style="gap:6px;flex-wrap:nowrap" ${sleepOn ? "" : "hidden"}><select id="sleep-start" class="mil-select" aria-label="免打扰开始时间">${hourOpts(sleepStart)}</select><span class="ms-inline-unit">至</span><select id="sleep-end" class="mil-select" aria-label="免打扰结束时间">${hourOpts(sleepEnd)}</select></div><input id="set-sleep" type="hidden" value="${esc(s.sleep_window || "")}">`),
        row("联网搜索方式", "默认自动探测宿主或插件联网；选高级自定义可填写专有来源标识。", `<select id="web_provider" class="mil-select"><option value="auto" ${web === "auto" ? "selected" : ""}>自动识别（优先随宿主，其次联网插件）</option><option value="host" ${web === "host" ? "selected" : ""}>仅使用宿主自带联网</option><option value="google_search_plugin" ${web === "google_search_plugin" ? "selected" : ""}>使用第三方搜索插件</option><option value="mcp" ${web === "mcp" ? "selected" : ""}>使用已配置的 MCP 搜索工具</option><option value="plugin_api" ${web === "plugin_api" ? "selected" : ""}>调用其他插件接口</option><option value="custom" ${!isPreset ? "selected" : ""}>高级自定义来源…</option></select><div id="web-custom-wrap" style="width:100%" ${isPreset ? "hidden" : ""}><input id="web_provider_custom" class="mil-input mono" value="${isPreset ? "" : esc(web)}" placeholder="如 web:my_search / plugin:..."></div>`),
        row("自我探索心跳", "定期自主巡检手账与感兴趣主题的间隔分钟数，以及默认出动角色。", `<input id="heartbeat_interval_minutes" class="mil-input mono" style="width:76px;flex:0 0 auto" type="number" min="5" max="1440" value="${Number(s.heartbeat_interval_minutes ?? 60)}" aria-label="心跳间隔分钟数"><span class="ms-inline-unit">分钟/次 · 角色</span><select id="heartbeat_profile" class="mil-select" style="width:auto;flex:1 1 160px" aria-label="心跳默认角色">${hbOpts}</select>`),
      );
      $("#general-fields").innerHTML = genRows.join("");
      if ($("#mob-sum-general")) $("#mob-sum-general").textContent = `${s.plugin?.enabled ? "已开启" : "已停用"} · ${s.proactive_level === "quiet" ? "安静" : (s.proactive_level === "lively" ? "活跃" : "平衡")}`;
      if ($("#mob-sum-streams")) $("#mob-sum-streams").textContent = `${whitelistEntries.length} 条`;

      $("#advanced-runtime-fields").innerHTML = [
        row("久违问候安静阈值 (小时)", "设为 0 默认关闭；设为 12-720 时，熟人会话安静超过设定小时数后才可能温柔打招呼。", `<input id="set-longing" class="mil-input mono" style="width:110px" type="number" min="0" max="720" value="${Number(s.longing_quiet_hours ?? 0)}">`),
        row("线程步数 / 超时 / 上下文窗口 (Tokens)", "单次后台推理与自适应上下文 Token 窗口上限（未识别家族名默认 256K）。", `<input id="set-steps" class="mil-input mono" style="width:76px" type="number" min="1" max="64" value="${Number(s.agent_max_steps ?? 16)}" aria-label="最大步数"><input id="set-timeout" class="mil-input mono" style="width:84px" type="number" min="10" max="900" value="${Number(s.agent_timeout ?? 180)}" aria-label="超时秒数"><input id="set-ctx" class="mil-input mono" style="width:104px" type="number" min="16384" max="2000000" step="1024" value="${Number(s.thread_context_tokens ?? 262144)}" aria-label="上下文 Token 窗口上限">`),
      ].join("");

      const sb = s.sandbox || {};
      $("#sandbox-fields").innerHTML = [
        row("启用 Docker 沙箱", "仅代码运行需要，纯文字/网页卡片渲染无需开启。", `<label class="mil-switch"><input id="sb-enabled" type="checkbox" ${sb.enabled ? "checked" : ""}><span class="mil-switch-track"></span><span class="mil-switch-txt">${sb.enabled ? "开启" : "关闭"}</span></label>`),
        row("沙箱镜像与配额", "容器镜像、内存上限(MiB)与单次超时(秒)。", `<input id="sb-image" class="mil-input mono" style="width:150px" value="${esc(sb.image || "")}" placeholder="容器镜像"><input id="sb-mem" class="mil-input mono" style="width:88px" type="number" min="128" max="4096" value="${Number(sb.memory_mib ?? 512)}"><input id="sb-timeout" class="mil-input mono" style="width:78px" type="number" min="1" max="180" value="${Number(sb.timeout ?? 60)}">`),
      ].join("");

      renderWhitelistBox();
      syncSleepHidden();
      $("#sleep-enabled")?.addEventListener("change", (ev) => {
        const txt = ev.target.closest(".mil-switch")?.querySelector(".mil-switch-txt");
        if (txt) txt.textContent = ev.target.checked ? "已开启" : "未限制";
        syncSleepHidden();
      });
      $("#sleep-start")?.addEventListener("change", syncSleepHidden);
      $("#sleep-end")?.addEventListener("change", syncSleepHidden);

      $("#web_provider")?.addEventListener("change", syncWebCustomVis);
      $("#ui_style")?.addEventListener("change", () => {
        manualUiStyle = "";
        savedUiStyle = $("#ui_style").value || "millennium";
        applyTheme();
      });
      $("#set-enabled")?.addEventListener("change", (ev) => {
        const txt = ev.target.closest(".mil-switch")?.querySelector(".mil-switch-txt");
        if (txt) txt.textContent = ev.target.checked ? "已开启" : "已停用";
      });
      $("#sb-enabled")?.addEventListener("change", (ev) => {
        const txt = ev.target.closest(".mil-switch")?.querySelector(".mil-switch-txt");
        if (txt) txt.textContent = ev.target.checked ? "开启" : "关闭";
      });
      syncWebCustomVis();
    }

    function updateQuotaBadges(q) {
      const qb = $("#set-quota-badge");
      const dq = $("#set-drawer-quota-text");
      if (!q || typeof q !== "object") return;
      const used = Number(q.used || 0);
      const limit = Number(q.limit || 0);
      const rem = Number(q.remaining || 0);
      if (qb) {
        qb.hidden = false;
        qb.textContent = `今日主动额度 ${used} / ${limit} · 剩余 ${rem}`;
      }
      if (dq) {
        dq.textContent = `已用 ${used} / ${limit} · 剩余 ${rem} 次`;
      }
    }

    function renderHandles(handles) {
      const list = handles || [];
      $("#handles").innerHTML = list.length
        ? list.map((h) => `<button type="button" class="mil-key mil-key--sm mono" data-pick-handle="${esc(h)}">${esc(h)}</button>`).join("")
        : `<span class="mil-hint">暂无已登记句柄</span>`;
      if ($("#mob-sum-vault")) $("#mob-sum-vault").textContent = `${list.length} 项`;
    }

    function applySettingsData(r) {
      if (!r?.success) return say(r?.error || "读取设置失败", true);
      curSettings = r.settings;
      curVersion = r.version;
      knownChats = Array.isArray(r.known_chats) ? r.known_chats : [];
      knownProfiles = Array.isArray(r.profile_cards)
        ? r.profile_cards
        : (Array.isArray(r.profiles) ? r.profiles.map((p) => (typeof p === "string" ? { id: p, title: p } : p)) : []);
      $("#admins").textContent = (r.admins || []).join(", ") || "未配置（继承宿主）";
      populateChatAndProfilePickers();
      renderGeneral();
      renderHandles(r.handles);
      updateQuotaBadges(r.proactive_quota);
      updateSchedSummary();
    }

    async function loadSettings() {
      const r = await rpc("read", "settings", {});
      if (sig?.aborted) return;
      applySettingsData(r);
    }

    function applyServicesData(r) {
      if (!r?.success) return;
      svcVersion = r.version;
      const cfg = r.configuration || {};
      curServicesCfg = cfg;
      $("#service-config").value = JSON.stringify(cfg, null, 2);
      const apis = Object.keys(cfg.apis || {});
      const webs = Object.keys((cfg.web || {}).providers || {});
      const mcps = Object.entries(cfg.servers || {});
      const tpls = Object.entries(cfg.templates || {});
      const cards = [
        ...mcps.map(([k, spec]) => `<div class="m-svc-card">
          <div class="m-svc-card-head">
            <div class="mil-row" style="gap:6px"><span class="mil-tag">MCP 服务</span><strong class="mono">${esc(k)}</strong></div>
            <div class="mil-row" style="gap:4px">
              <button type="button" class="mil-key mil-key--sm" data-svc-edit="${esc(k)}" data-svc-kind="mcp">编辑</button>
              <button type="button" class="mil-key mil-key--sm mil-key--danger" data-svc-del="${esc(k)}" data-svc-kind="mcp">删除</button>
            </div>
          </div>
          <span class="mil-hint">${esc(spec?.description || (Array.isArray(spec?.command) ? spec.command.join(" ") : "外部命令行服务"))}</span>
        </div>`),
        ...tpls.map(([k, spec]) => `<div class="m-svc-card">
          <div class="m-svc-card-head">
            <div class="mil-row" style="gap:6px"><span class="mil-tag mil-tag--ok">执行模板</span><strong class="mono">${esc(k)}</strong></div>
            <div class="mil-row" style="gap:4px">
              <button type="button" class="mil-key mil-key--sm" data-svc-edit="${esc(k)}" data-svc-kind="template">编辑</button>
              <button type="button" class="mil-key mil-key--sm mil-key--danger" data-svc-del="${esc(k)}" data-svc-kind="template">删除</button>
            </div>
          </div>
          <span class="mil-hint">${esc(spec?.description || (Array.isArray(spec?.argv) ? spec.argv.join(" ") : "固定动作模板"))}</span>
        </div>`),
      ];
      const summaryRow = `<div class="mil-row" style="grid-column:1/-1">
        <span class="mil-tag">MCP 服务 ${mcps.length}</span>
        <span class="mil-tag">执行模板 ${tpls.length}</span>
        <span class="mil-tag">跨插件接口 ${apis.length}</span>
        <span class="mil-tag mil-tag--ok">联网别名 ${webs.length}</span>
      </div>`;
      $("#service-cards").innerHTML = summaryRow + (cards.join("") || `<span class="mil-hint" style="grid-column:1/-1">暂未配置 MCP 服务或执行模板，点击右上角「新增服务」或下方编辑。</span>`);
      if ($("#mob-sum-services")) $("#mob-sum-services").textContent = `${mcps.length + tpls.length} 项`;
    }

    async function loadServices() {
      const r = await rpc("read", "services", {});
      if (sig?.aborted) return;
      applyServicesData(r);
    }

    function renderWebhookCards(cfg) {
      const keys = Object.keys(cfg || {});
      $("#webhook-cards").innerHTML = keys.length
        ? keys.map((k) => {
            const rawTarget = String(cfg[k]?.target || "");
            const cleanTarget = rawTarget.replace(/^chat:/, "");
            return `<div class="m-svc-card">
              <div class="m-svc-card-head">
                <strong class="mono">${esc(k)}</strong>
                <button type="button" class="mil-key mil-key--sm mil-key--danger" data-wh-del="${esc(k)}">移除</button>
              </div>
              <span class="mil-hint">${esc(friendlyStreamName(cleanTarget))}${cleanTarget ? ` (${esc(cleanTarget)})` : ""}</span>
            </div>`;
          }).join("")
        : `<span class="mil-hint">暂无外部事件通道</span>`;
      if ($("#mob-sum-webhooks")) $("#mob-sum-webhooks").textContent = `${keys.length} 条`;
    }

    function applyWebhooksData(r) {
      if (!r?.success) return;
      whVersion = r.version;
      const cfg = r.configuration || {};
      $("#webhook-config").value = JSON.stringify(cfg, null, 2);
      renderWebhookCards(cfg);
    }

    async function loadWebhooks() {
      const r = await rpc("read", "webhooks", {});
      if (sig?.aborted) return;
      applyWebhooksData(r);
    }

    function applyHealthData(h, ir) {
      if (h?.success) {
        const prov = curSettings?.web_provider || h.web?.provider || "auto";
        const webEngines = Array.isArray(h.web?.third_party_engines) ? h.web.third_party_engines.filter(Boolean) : [];
        const webSub = h.web?.third_party_enabled
          ? `第三方引擎可用：${webEngines.join(" / ") || h.web?.third_party_default || "已就绪"}`
          : "按当前策略路由联网搜索";
        const sbVal = h.enabled ? (h.ready ? "Docker 沙箱已就绪" : "Docker 沙箱未就绪") : "无容器轻量模式可用";
        const sbSub = h.enabled ? (h.error || "隔离执行已启") : "读网与卡片渲染无需容器";
        const kb = ((h.bytes || 0) / 1024).toFixed(1);
        const mb = ((h.limit || 0) / (1024 * 1024)).toFixed(0);
        $("#health").innerHTML = [
          `<div class="ms-kv-card"><span class="ms-kv-k">联网状态</span><strong class="ms-kv-v">联网来源：${esc(prov)}</strong><span class="ms-kv-sub">${esc(webSub)}</span></div>`,
          `<div class="ms-kv-card"><span class="ms-kv-k">执行环境</span><strong class="ms-kv-v">${esc(sbVal)}</strong><span class="ms-kv-sub">${esc(sbSub)}</span></div>`,
          `<div class="ms-kv-card"><span class="ms-kv-k">容器与隔离</span><strong class="ms-kv-v num">运行中 ${h.running || 0} · 隔离目录 ${h.quarantined || 0}</strong><span class="ms-kv-sub">仅代码类任务启用容器</span></div>`,
          `<div class="ms-kv-card"><span class="ms-kv-k">工作区存储</span><strong class="ms-kv-v num">${kb} KB</strong><span class="ms-kv-sub num">配额上限 ${mb} MB</span></div>`,
        ].join("");
      }
      if (ir?.success) {
        const pendingCnt = (ir.intents || []).filter((i) => i.status === "pending").length;
        if ($("#mob-sum-routines")) $("#mob-sum-routines").textContent = pendingCnt ? `${pendingCnt} 项待执行` : "状态正常";
        $("#intent-list").innerHTML = (ir.intents || []).map((i) => {
          const kindTxt = i.kind_label || INTENT_KIND_LABELS[i.kind] || i.kind || "计划";
          const statusTxt = INTENT_STATUS_LABELS[i.status] || i.status || "等待中";
          const rawTarget = String(i.target || "").replace(/^chat:/, "");
          const ctlHtml = i.status === "pending"
            ? (i.protected ? `<span class="mil-tag">受保护</span>` : `<button type="button" class="mil-key mil-key--sm mil-key--danger" data-cancel-intent="${esc(i.intent_id)}">取消</button>`)
            : `<span class="mil-tag">${esc(statusTxt)}</span>`;
          return `<div class="exp-card">
            <div class="mil-row" style="justify-content:space-between">
              <span><span class="mil-tag">${esc(kindTxt)}</span> <strong>${esc(i.reason || "定时执行")}</strong></span>
              ${ctlHtml}
            </div>
            <span class="mil-hint">${esc(friendlyStreamName(rawTarget))}${rawTarget ? ` · <span class="mono">${esc(rawTarget)}</span>` : ""} · ${esc(INTENT_KIND_LABELS[i.source] || i.source || "系统")}</span>
          </div>`;
        }).join("") || `<p class="mil-hint">暂无意图记录</p>`;

        const learnRows = Array.isArray(ir.learning) ? ir.learning : [];
        $("#learning").innerHTML = learnRows.length
          ? learnRows.map((entry) => {
              if (!entry || typeof entry !== "object") return `<div class="ms-receipt-card"><span>${esc(String(entry || ""))}</span></div>`;
              const title = entry.topic || entry.title || entry.summary || entry.note || entry.content || entry.kind || "笔记回执";
              const status = INTENT_STATUS_LABELS[entry.status] || entry.status || "已记录";
              const chatRaw = String(entry.chat_id || entry.target || "").replace(/^chat:/, "");
              const metaParts = [chatRaw ? friendlyStreamName(chatRaw) : "", entry.profile || "", entry.at || ""].filter(Boolean);
              const undoBtn = entry.profile
                ? `<button type="button" class="mil-key mil-key--sm" data-undo-learning="${esc(entry.profile)}" data-history-id="${esc(entry.version ?? entry.thread_id ?? "")}">撤回</button>`
                : "";
              return `<div class="ms-receipt-card">
                <div class="ms-receipt-head"><strong>${esc(String(title))}</strong><div class="mil-row" style="gap:6px"><span class="mil-tag">${esc(String(status))}</span>${undoBtn}</div></div>
                ${metaParts.length ? `<span class="ms-receipt-meta">${esc(metaParts.join(" · "))}</span>` : ""}
              </div>`;
            }).join("")
          : `<span class="mil-hint">暂无自动笔记回执</span>`;
      }
    }

    async function loadHealth() {
      const [h, ir] = await Promise.all([rpc("read", "health", {}), rpc("read", "intents", {})]);
      if (sig?.aborted) return;
      applyHealthData(h, ir);
    }

    document.addEventListener("change", (ev) => {
      const lvSel = ev.target.closest("[data-wl-level]");
      if (lvSel) {
        const idx = Number(lvSel.dataset.wlLevel);
        if (whitelistEntries[idx]) whitelistEntries[idx].level = lvSel.value || "";
        return;
      }
      if (ev.target?.id === "intent-chat-select") {
        const v = ev.target.value;
        if (v) $("#intent-chat").value = v;
        updateSchedSummary();
        return;
      }
      if (ev.target?.id === "intent-profile-select") {
        const v = ev.target.value;
        if (v) $("#intent-profile").value = v;
        updateSchedSummary();
      }
    }, { signal: sig });

    document.addEventListener("keydown", (ev) => {
      if (ev.target?.id === "wl-add-id" && ev.key === "Enter") {
        ev.preventDefault();
        $("#wl-add-btn")?.click();
      }
    }, { signal: sig });

    document.addEventListener("click", async (ev) => {
      const modeBtn = ev.target.closest("[data-settings-mode]");
      if (modeBtn) {
        setSettingsMode(modeBtn.dataset.settingsMode);
        return;
      }
      const railBtn = ev.target.closest("[data-set-rail]");
      if (railBtn) {
        const sec = railBtn.dataset.setRail;
        const isAdv = ["services", "vault", "webhooks", "runtime"].includes(sec);
        setSettingsMode(isAdv ? "advanced" : "general");
        $$("[data-set-rail]").forEach((b) => b.classList.toggle("is-active", b === railBtn));
        $(`[data-set-sec="${CSS.escape(sec)}"]`)?.scrollIntoView({ behavior: "smooth", block: "start" });
        return;
      }
      const mobRouteBtn = ev.target.closest("[data-mob-route]");
      if (mobRouteBtn) {
        openMobRoute(mobRouteBtn.dataset.mobRoute);
        return;
      }
      if (ev.target.closest("[data-mob-back]")) {
        openMobRoute("hub");
        return;
      }
      if (ev.target.closest("#mob-sub-act-refresh")) {
        await loadHealth();
        say("运行状态已刷新");
        return;
      }
      const mobSheetBtn = ev.target.closest("[data-mob-sheet]");
      if (mobSheetBtn) {
        const sheetKind = mobSheetBtn.dataset.mobSheet || "svc";
        if (sheetKind === "wh") {
          openMobileSheet($("#wh-quick-builder"), "添加触发通道");
        } else {
          openServiceDrawer("mcp", "");
        }
        return;
      }
      if (ev.target.closest("#mob-sheet-close") || ev.target.id === "settings-mob-scrim" || ev.target.classList?.contains("m-mob-sheet-scrim")) {
        closeMobileSheet();
        return;
      }
      const svcEditBtn = ev.target.closest("[data-svc-edit]");
      if (svcEditBtn) {
        openServiceDrawer(svcEditBtn.dataset.svcKind || "mcp", svcEditBtn.dataset.svcEdit || "");
        return;
      }
      const svcDelBtn = ev.target.closest("[data-svc-del]");
      if (svcDelBtn) {
        const kind = svcDelBtn.dataset.svcKind === "template" ? "template" : "mcp";
        const name = svcDelBtn.dataset.svcDel;
        const r = await rpc("write", "delete_service_item", { kind, name, expected_version: svcVersion });
        if (!r?.success) return say(r?.error || "删除服务条目失败", true);
        say(`已删除服务 ${name}`);
        await loadServices();
        return;
      }
      const whDelBtn = ev.target.closest("[data-wh-del]");
      if (whDelBtn) {
        const name = whDelBtn.dataset.whDel;
        const r = await rpc("write", "delete_webhook_item", { name, expected_version: whVersion });
        if (!r?.success) return say(r?.error || "移除触发通道失败", true);
        say(`已移除通道 ${name}`);
        await loadWebhooks();
        return;
      }
      const cancelBtn = ev.target.closest("[data-cancel-intent]");
      if (cancelBtn) {
        const r = await rpc("write", "cancel_intent", { intent_id: cancelBtn.dataset.cancelIntent });
        if (!r?.success) return say(r?.error || "取消意图失败", true);
        say("意图已取消");
        await loadHealth();
        return;
      }
      const undoBtn = ev.target.closest("[data-undo-learning]");
      if (undoBtn) {
        const profileId = undoBtn.dataset.undoLearning;
        const histId = undoBtn.dataset.historyId || "";
        const payload = { profile_id: profileId };
        if (histId) payload.history_id = histId;
        const r = await rpc("write", "undo_learning_note", payload);
        if (!r?.success) return say(r?.error || "撤回笔记失败", true);
        say(`已撤回 ${profileId} 的自动笔记修订`);
        await loadHealth();
        return;
      }
      if (ev.target?.id === "wl-add-known") {
        const sel = $("#wl-pick-known");
        const spec = normalizeStreamInput(sel?.value || "");
        if (!spec) return say("请先选择一条已发现的会话", true);
        if (!whitelistEntries.some((e) => e.spec === spec)) {
          whitelistEntries.push({ spec, level: "" });
          renderWhitelistBox();
          say(`已添加会话 ${spec}（记得点击上方「保存设置」）`);
        }
        return;
      }
      if (ev.target?.id === "wl-add-btn") {
        const plat = ($("#wl-add-platform")?.value || "qq").trim().toLowerCase();
        const ctype = ($("#wl-add-type")?.value || "group").trim().toLowerCase();
        const rawId = ($("#wl-add-id")?.value || "").trim();
        if (!rawId) return say("请输入群号或用户 ID", true);
        let spec = "";
        if (/^(?:chat:)?[a-z][a-z0-9_-]*:(group|private):[^\s:][^\s]*$/i.test(rawId) || rawId === "self") {
          spec = normalizeStreamInput(rawId);
        } else if (/\s/.test(rawId)) {
          return say("账号中不要包含空格，或直接使用 平台:类型:id 格式", true);
        } else {
          spec = `${plat}:${ctype}:${rawId}`;
        }
        if (whitelistEntries.some((e) => e.spec === spec)) return say(`会话 ${spec} 已在白名单中`);
        whitelistEntries.push({ spec, level: "" });
        renderWhitelistBox();
        say(`已添加条目 ${spec}（请点击「保存设置」生效）`);
        return;
      }
      const rmBtn = ev.target.closest("[data-wl-remove]");
      if (rmBtn) {
        const idx = Number(rmBtn.dataset.wlRemove);
        const removed = whitelistEntries.splice(idx, 1)[0];
        renderWhitelistBox();
        if (removed) say(`已从列表移除 ${removed.spec}（请点击「保存设置」生效）`);
        return;
      }
      const handleBtn = ev.target.closest("[data-pick-handle]");
      if (handleBtn) {
        $$("[data-pick-handle]").forEach((b) => b.setAttribute("aria-current", String(b === handleBtn)));
        $("#vault-handle").value = handleBtn.dataset.pickHandle;
        return;
      }
      const preset = ev.target.closest("[data-sched-preset]");
      if (preset) {
        const k = preset.dataset.schedPreset;
        if (k === "once") { $("#intent-profile").value = "scout"; $("#intent-workspace").value = ""; $("#intent-in").value = "60"; $("#intent-every").value = "0"; }
        else if (k === "hourly") { $("#intent-profile").value = "scout"; $("#intent-workspace").value = ""; $("#intent-in").value = "120"; $("#intent-every").value = "3600"; }
        else if (k === "daily") { $("#intent-profile").value = "scout"; $("#intent-workspace").value = ""; $("#intent-in").value = "3600"; $("#intent-every").value = "86400"; }
        else if (k === "digest") {
          $("#intent-profile").value = "digest";
          $("#intent-workspace").value = "digest";
          $("#intent-in").value = "60";
          $("#intent-every").value = "86400";
          if (!$("#intent-prompt").value.trim()) {
            $("#intent-prompt").value = "结合近期对话与手账兴趣巡检 RSS 与一手信源，经硬门槛与五维打分后生成今日资讯简报卡（若无达标新资讯则静默结束）。";
          }
          say("已填入资讯简报周期模板，确认参数后点「加入计划队列」（需先在能力页开启 digest）。");
        }
        updateSchedSummary();
      }
    }, { signal: sig });

    ["#intent-chat", "#intent-profile", "#intent-in", "#intent-every"].forEach((sel) => {
      $(sel)?.addEventListener("input", updateSchedSummary);
    });

    async function saveAllSettings() {
      syncSleepHidden();
      syncWhitelistHidden();
      const selWeb = $("#web_provider").value;
      const customWeb = ($("#web_provider_custom")?.value || "").trim();
      const webProvider = selWeb === "custom" ? (customWeb || "auto") : selWeb;
      const chatLevels = {};
      whitelistEntries.forEach((e) => {
        if (e.level && ["quiet", "care", "lively"].includes(e.level)) {
          chatLevels[e.spec] = e.level;
        }
      });
      const next = {
        ...curSettings,
        ui_style: $("#ui_style")?.value || curSettings?.ui_style || "millennium",
        plugin: { ...(curSettings?.plugin || {}), enabled: $("#set-enabled").checked },
        enabled_chats: whitelistEntries.map((e) => e.spec),
        chat_proactive_levels: chatLevels,
        proactive_level: $("#proactive_level").value,
        web_provider: webProvider,
        daily_proactive_limit: Number($("#daily_proactive_limit").value),
        heartbeat_interval_minutes: Number($("#heartbeat_interval_minutes").value),
        heartbeat_profile: $("#heartbeat_profile").value.trim() || "scout",
        sleep_window: $("#set-sleep").value.trim(),
        longing_quiet_hours: Number($("#set-longing")?.value ?? curSettings?.longing_quiet_hours ?? 0),
        agent_max_steps: Number($("#set-steps")?.value ?? curSettings?.agent_max_steps ?? 16),
        agent_timeout: Number($("#set-timeout")?.value ?? curSettings?.agent_timeout ?? 180),
        thread_context_tokens: Number($("#set-ctx")?.value ?? curSettings?.thread_context_tokens ?? 262144),
        sandbox: {
          ...(curSettings?.sandbox || {}),
          enabled: $("#sb-enabled")?.checked ?? Boolean(curSettings?.sandbox?.enabled),
          image: ($("#sb-image")?.value ?? curSettings?.sandbox?.image ?? "").trim(),
          memory_mib: Number($("#sb-mem")?.value || curSettings?.sandbox?.memory_mib || 512),
          timeout: Number($("#sb-timeout")?.value || curSettings?.sandbox?.timeout || 60),
        },
      };
      const r = await rpc("write", "settings", { settings: next, expected_version: curVersion });
      if (!r?.success) return say(r?.error || "保存设置失败", true);
      curSettings = r.settings;
      curVersion = r.version;
      manualUiStyle = "";
      savedUiStyle = curSettings.ui_style || "millennium";
      applyTheme();
      populateChatAndProfilePickers();
      renderGeneral();
      updateQuotaBadges(r.proactive_quota);
      say("已保存设置。");
      await loadHealth();
    }
    $("#save-settings").onclick = saveAllSettings;
    if ($("#save-settings-streams")) $("#save-settings-streams").onclick = saveAllSettings;
    if ($("#save-settings-adv")) $("#save-settings-adv").onclick = saveAllSettings;
    if ($("#svc-new-btn")) $("#svc-new-btn").onclick = () => openServiceDrawer("mcp", "");
    if ($("#svc-d-kind")) $("#svc-d-kind").addEventListener("change", syncSvcDrawerFields);
    if ($("#svc-d-save")) {
      $("#svc-d-save").onclick = async () => {
        const kind = $("#svc-d-kind")?.value === "template" ? "template" : "mcp";
        const name = ($("#svc-d-name")?.value || "").trim();
        if (!name) return say("请先填写服务代号", true);
        const cmdParts = ($("#svc-d-cmd")?.value || "").trim().split(/\s+/).filter(Boolean);
        if (!cmdParts.length) return say("请填写程序路径与参数", true);
        const creds = {};
        const secretNames = [];
        ($("#svc-d-creds")?.value || "").split(/\r?\n/).forEach((line) => {
          const clean = line.trim();
          if (!clean) return;
          const eq = clean.indexOf("=");
          if (eq > 0) {
            const k = clean.slice(0, eq).trim();
            const v = clean.slice(eq + 1).trim();
            if (k && v) { creds[k] = v; secretNames.push(v); }
          } else {
            secretNames.push(clean);
          }
        });
        const item = kind === "template"
          ? {
              argv: cmdParts,
              description: ($("#svc-d-desc")?.value || "").trim(),
              secrets: [...new Set(secretNames)],
              targets: ($("#svc-d-targets")?.value || "").split(",").map((x) => x.trim()).filter(Boolean),
              access: $("#svc-d-access")?.value === "admins" ? "admins" : "everyone",
            }
          : {
              command: cmdParts,
              description: ($("#svc-d-desc")?.value || "").trim(),
              credentials: creds,
              tools: ($("#svc-d-tools")?.value || "").split(",").map((x) => x.trim()).filter(Boolean),
              readonly: $("#svc-d-readonly")?.checked !== false,
              access: $("#svc-d-access")?.value === "admins" ? "admins" : "everyone",
              memory_mib: Number($("#svc-d-mem")?.value || 256),
            };
        const r = await rpc("write", "upsert_service_item", { kind, name, item, expected_version: svcVersion });
        if (!r?.success) return say(r?.error || "保存服务条目失败", true);
        svcVersion = r.version;
        closeMobileSheet();
        say(`已保存服务 ${name}`);
        await loadServices();
      };
    }
    if ($("#svc-d-del")) {
      $("#svc-d-del").onclick = async () => {
        const kind = editingService.kind || "mcp";
        const name = editingService.origName || ($("#svc-d-name")?.value || "").trim();
        if (!name) return;
        const r = await rpc("write", "delete_service_item", { kind, name, expected_version: svcVersion });
        if (!r?.success) return say(r?.error || "移除服务条目失败", true);
        svcVersion = r.version;
        closeMobileSheet();
        say(`已移除服务 ${name}`);
        await loadServices();
      };
    }
    if ($("#wh-b-add")) {
      $("#wh-b-add").onclick = () => {
        const name = ($("#wh-b-name")?.value || "").trim();
        const rawTarget = ($("#wh-b-target")?.value || "").trim();
        if (!name || !rawTarget) return say("请先填写通道代号和目标会话", true);
        let cfg = {};
        try {
          cfg = JSON.parse($("#webhook-config").value || "{}");
          if (!cfg || typeof cfg !== "object" || Array.isArray(cfg)) cfg = {};
        } catch (e) {
          return say(`下方 JSON 存在语法错误，请先修正：${e?.message || ""}`, true);
        }
        const normTarget = rawTarget === "self" ? "self" : (rawTarget.startsWith("chat:") ? rawTarget : `chat:${normalizeStreamInput(rawTarget)}`);
        const entry = {
          target: normTarget,
          kind: $("#wh-b-kind")?.value || "proactive",
          profile: $("#wh-b-profile")?.value || "scout",
        };
        const secret = ($("#wh-b-secret")?.value || "").trim();
        if (secret) entry.secret_handle = secret;
        cfg[name] = entry;
        $("#webhook-config").value = JSON.stringify(cfg, null, 2);
        renderWebhookCards(cfg);
        say(`已将 ${name} 写入通道配置，点击「保存事件通道」生效。`);
      };
    }

    $("#save-vault").onclick = async () => {
      const handle = $("#vault-handle").value.trim();
      const value = $("#vault-value").value;
      const r = await rpc("write", "vault", { handle, value });
      if (!r?.success) return say(r?.error || "保存凭据失败", true);
      $("#vault-value").value = "";
      renderHandles(r.handles);
      say(`已更新凭据句柄 ${handle}`);
    };
    $("#delete-vault").onclick = async () => {
      const handle = $("#vault-handle").value.trim();
      const r = await rpc("write", "vault", { handle, delete: true });
      if (!r?.success) return say(r?.error || "删除句柄失败", true);
      renderHandles(r.handles);
      say(`已删除句柄 ${handle}`);
    };
    function prettyJsonField(sel, label) {
      try {
        const obj = JSON.parse($(sel).value);
        $(sel).value = JSON.stringify(obj, null, 2);
        say(`${label} JSON 格式有效，已美化。`);
      } catch (e) {
        say(`${label} JSON 语法错误：${e?.message || "格式无效"}`, true);
      }
    }
    $("#format-services").onclick = () => prettyJsonField("#service-config", "服务登记");
    $("#format-webhooks").onclick = () => prettyJsonField("#webhook-config", "事件通道");
    $("#save-services").onclick = async () => {
      let configuration;
      try { configuration = JSON.parse($("#service-config").value); } catch (e) { return say(`服务登记 JSON 格式无效：${e?.message || ""}`, true); }
      const r = await rpc("write", "services", { configuration, expected_version: svcVersion });
      if (!r?.success) return say(r?.error || "保存服务失败", true);
      svcVersion = r.version;
      say("服务登记已保存。");
      await loadServices();
    };
    $("#save-webhooks").onclick = async () => {
      let configuration;
      try { configuration = JSON.parse($("#webhook-config").value); } catch (e) { return say(`事件通道 JSON 格式无效：${e?.message || ""}`, true); }
      const r = await rpc("write", "webhooks", { configuration, expected_version: whVersion });
      if (!r?.success) return say(r?.error || "保存事件通道失败", true);
      whVersion = r.version;
      say("事件通道已保存。");
      await loadWebhooks();
    };
    $("#intent-prompt").addEventListener("keydown", (ev) => {
      if ((ev.ctrlKey || ev.metaKey) && ev.key === "Enter") {
        ev.preventDefault();
        $("#schedule-intent").click();
      }
    });
    $("#schedule-intent").onclick = async () => {
      const r = await rpc("write", "schedule_intent", {
        chat_id: $("#intent-chat").value.trim(),
        profile: $("#intent-profile").value.trim(),
        workspace: $("#intent-workspace").value.trim(),
        in_seconds: Number($("#intent-in").value || 60),
        every_seconds: Number($("#intent-every").value || 0),
        prompt: $("#intent-prompt").value.trim(),
      });
      if (!r?.success) return say(r?.error || "加入计划失败", true);
      say("工作流计划已加入队列。");
      await loadHealth();
    };
    $("#check").onclick = loadHealth;

    (async () => {
      await Promise.resolve(window.maibot?.ready);
      if (sig?.aborted) return;
      applyTheme();
      const b = await rpc("read", "batch", {
        sections: {
          settings: {},
          services: {},
          webhooks: {},
          health: {},
          intents: {},
        },
      });
      if (sig?.aborted) return;
      if (b?.success && b.sections?.settings) {
        applySettingsData({ success: true, ...b.sections.settings });
        if (b.sections.services) applyServicesData({ success: true, ...b.sections.services });
        if (b.sections.webhooks) applyWebhooksData({ success: true, ...b.sections.webhooks });
        if (b.sections.health || b.sections.intents) {
          applyHealthData(
            b.sections.health ? { success: true, ...b.sections.health } : null,
            b.sections.intents ? { success: true, ...b.sections.intents } : null
          );
        }
      } else {
        await loadSettings();
        if (sig?.aborted) return;
        await loadServices();
        if (sig?.aborted) return;
        await loadWebhooks();
        if (sig?.aborted) return;
        await loadHealth();
      }
    })();
  }
  }
  /* ==MGMT_BOOT_END== */
})();
</script>
</body>
</html>
