<!DOCTYPE html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Maisya · {{TITLE}}</title><style>
:root{color-scheme:light;--paper:var(--maibot-background,#f8f8f5);--panel:var(--maibot-card,#fff);--ink:var(--maibot-foreground,#252922);--muted:var(--maibot-muted-foreground,#74786f);--line:var(--maibot-border,#e0e3d9);--accent:#4d6540;--wash:#edf1e7;--danger:#a43c32}
:root.dark{color-scheme:dark;--paper:var(--maibot-background,#1d201b);--panel:var(--maibot-card,#242820);--ink:var(--maibot-foreground,#edf0e6);--muted:var(--maibot-muted-foreground,#a3ac98);--line:var(--maibot-border,#3a4134);--accent:#acc394;--wash:#303b29;--danger:#e79c91}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:14px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,select,textarea{font:inherit;color:inherit;max-width:100%}button,select{cursor:pointer}button,input,select,textarea{border:1px solid var(--line);border-radius:7px;background:var(--panel);padding:8px 11px}button:disabled{opacity:.5;cursor:default}button:active{transform:scale(.98)}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:3px}button.primary{background:var(--accent);color:var(--panel);border-color:var(--accent)}.danger{color:var(--danger)}header{padding:24px 28px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:20px}h1{font-size:24px;letter-spacing:-.7px;margin:0}h2{font-size:17px;margin:0 0 16px}.eyebrow{font-size:11px;letter-spacing:1.8px;color:var(--muted)}p{margin:7px 0}.hint,small{font-size:12px;color:var(--muted);overflow-wrap:anywhere}nav{display:flex;gap:6px;flex-wrap:wrap}nav button{border-color:transparent;background:transparent}nav button[aria-current=true]{background:var(--wash);border-color:var(--line)}main{max-width:1320px;margin:auto;padding:24px 28px 50px}.columns{display:grid;grid-template-columns:245px minmax(0,1fr);gap:24px}aside{min-width:0}.list{display:flex;flex-direction:column;gap:6px;margin:14px 0}.list button{text-align:left;overflow-wrap:anywhere}.list button[aria-current=true]{border-color:var(--accent);background:var(--wash)}section.card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:22px;min-width:0;margin-bottom:20px}.toolbar{display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin:12px 0}.toolbar label{margin:0}label{display:block;font-size:12px;margin:12px 0 6px}input:not([type=checkbox]),select{width:100%}textarea{display:block;width:100%;resize:vertical;min-height:280px;line-height:1.8;font-family:ui-monospace,SFMono-Regular,monospace}textarea[data-type=map]{min-height:84px;line-height:1.55;font-size:12px}#content{min-height:360px}#package-text{min-height:110px}.toolbar select{width:auto;max-width:260px}.toolbar input{width:170px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 20px}.grid label{min-width:0}.wide{grid-column:1/-1}details{border-top:1px solid var(--line);padding-top:12px;margin-top:18px}summary{cursor:pointer;font-size:13px}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.8 ui-monospace,SFMono-Regular,monospace;margin:12px 0}.entry{padding:12px 0;border-top:1px solid var(--line);overflow-wrap:anywhere}.entry strong{font-weight:550}.entry p{font-size:13px;white-space:pre-wrap}.status{min-height:24px;margin:12px 0;color:var(--muted);overflow-wrap:anywhere}.status.error{color:var(--danger)}.version{font-size:12px;color:var(--muted);margin-left:auto}.workspace{border:1px solid var(--line);padding:9px;margin:8px 0;border-radius:6px}[hidden]{display:none!important}
@media(max-width:700px){header{padding:18px;align-items:flex-start;flex-direction:column;gap:10px}main{padding:18px 14px}.columns{grid-template-columns:1fr;gap:8px}.list{flex-direction:row;overflow:auto}.list button{flex-shrink:0}.grid{grid-template-columns:1fr}.card{padding:16px!important}.toolbar{gap:7px}.toolbar select{max-width:100%}#content{min-height:300px}h1{font-size:22px}}
@media(prefers-reduced-motion:reduce){button:active{transform:none}}
</style></head>
<body data-page="{{PAGE_ID}}"><header><div><div class="eyebrow">MAISYA</div><h1>{{TITLE}}</h1><p class="hint" id="connection">正在连接…</p></div><nav aria-label="工作区"><button data-nav="now">现场</button><button data-nav="abilities">能力</button><button data-nav="memory">记忆</button><button data-nav="settings">设置</button></nav></header><main><p id="feedback" class="status" role="status" aria-live="polite"></p>{{BODY}}</main><script>
(()=>{'use strict';
const $=id=>document.getElementById(id),pageKind=document.body.dataset.page;
let busy=false,current=null,currentVersion=0,selected='scout',settings=null,settingsVersion='',servicesVersion='';
let activeOptions=null,webhooksVersion='';const drafts=new Map();
const text=(id,value)=>{$(id).textContent=String(value??'');};
const theme=ctx=>document.documentElement.classList.toggle('dark',ctx?.theme==='dark');
window.addEventListener('maibot:context',event=>theme(event.detail));
function feedback(value,error=false){text('feedback',value);$('feedback').classList.toggle('error',error);}
async function query(section,options={}){const r=await window.maibot.query('read',{section,payload:JSON.stringify(options)});if(!r.success)throw Error(r.error||'读取失败');return r;}
async function action(name,options={}){const r=await window.maibot.action('write',{action:name,payload:JSON.stringify(options)});if(!r.success)throw Error(r.error||'保存失败');return r;}
async function run(fn){if(busy)return;busy=true;document.querySelectorAll('button,input,select,textarea').forEach(el=>el.disabled=true);text('connection','正在处理…');feedback('');try{await fn();}catch(error){feedback(error.message||'操作失败，请重试',true);}finally{busy=false;document.querySelectorAll('button,input,select,textarea').forEach(el=>el.disabled=false);text('connection','已连接');}}
document.querySelectorAll('[data-nav]').forEach(button=>{button.setAttribute('aria-current',String(button.dataset.nav===pageKind));button.onclick=()=>run(()=>window.maibot.navigate(button.dataset.nav));});
function makeButton(label,handler,attribute,value){const button=document.createElement('button');button.type='button';button.textContent=label;if(attribute)button.dataset[attribute]=value;button.onclick=()=>run(handler);return button;}
function remember(){if(current&&$('content').value!==current.content)drafts.set(JSON.stringify(activeOptions),{text:$('content').value,version:currentVersion});}
function assetOptions(){if(pageKind==='abilities'){const kind=$('document').value;return {kind:kind==='config'||kind==='profile'?'profile':kind,target:kind==='skill'?$('skill-id').value:selected,...(kind==='config'?{document:'profile.toml'}:{})};}return {kind:$('kind').value,...($('kind').value==='memory'?{chat_id:$('chat').value}:{})};}
async function loadAsset(){const options=assetOptions();if(options.kind==='skill'&&!options.target)return;current=await query('asset',options);activeOptions=options;currentVersion=current.version;const draft=drafts.get(JSON.stringify(options));$('content').value=draft?.text??current.content;if(draft)currentVersion=draft.version;text('version','版本 '+currentVersion+(draft?' · 已恢复草稿':''));$('history').replaceChildren();current.history.forEach(row=>{const option=document.createElement('option');option.value=row.version;option.textContent='版本 '+row.version+' · '+new Date(row.updated*1000).toLocaleString();$('history').append(option);});}
if($('content')){$('reload').onclick=()=>run(async()=>{const draft=$('content').value;drafts.delete(JSON.stringify(assetOptions()));await loadAsset();$('local-draft').value=draft;$('draft-panel').hidden=false;$('draft-panel').open=true;feedback('已读取最新版本，原草稿保留在下方。');});$('content').oninput=()=>{text('version','版本 '+currentVersion+' · 有未保存的修改');};$('save').onclick=()=>run(async()=>{const options=assetOptions();await action('asset',{...options,content:$('content').value,expected_version:currentVersion});drafts.delete(JSON.stringify(options));await loadAsset();feedback('已保存。');});$('history').onchange=()=>run(async()=>{const result=await query('asset',{...assetOptions(),version:Number($('history').value)});$('content').value=result.content;text('version','正在查看版本 '+result.version+' · 当前版本 '+currentVersion);});$('restore').onclick=()=>run(async()=>{await action('rollback',{...assetOptions(),version:Number($('history').value),expected_version:currentVersion});drafts.delete(JSON.stringify(assetOptions()));await loadAsset();feedback('已回滚，并保留新版本。');});}
async function catalog(){const data=await query('abilities');$('profiles').replaceChildren();data.profiles.forEach(profile=>{const button=makeButton(profile.title||profile.id,async()=>{remember();selected=profile.id;await loadAsset();document.querySelectorAll('[data-profile]').forEach(el=>el.setAttribute('aria-current',String(el.dataset.profile===selected)));},'profile',profile.id);button.title=profile.id+' · '+(profile.environment||profile.error);button.setAttribute('aria-current',String(selected===profile.id));$('profiles').append(button);});$('skill-list').replaceChildren();data.skills.forEach(id=>{const option=document.createElement('option');option.value=id;$('skill-list').append(option);});}
async function initializeAbilities(){await catalog();$('document').onchange=()=>run(async()=>{remember();current=null;await loadAsset();});$('skill-id').onchange=()=>run(loadAsset);$('clone').onclick=()=>run(async()=>{const id=$('new-id').value.trim();await action('clone',{target:id,base:selected});selected=id;$('new-id').value='';await catalog();await loadAsset();feedback('新能力已创建。');});$('export').onclick=()=>run(async()=>{let data=await query('package',{target:selected}),parts=[data.data];while(data.offset<data.total){data=await query('package',{token:data.token,offset:data.offset});parts.push(data.data);}$('package-text').value=JSON.stringify({format:'maisya-profile-1',data:parts.join('')});$('package-panel').open=true;feedback('档案包已导出。复制包文本，可在另一份 Maisya 中粘贴导入。');});$('select-package').onclick=()=>{$('package-text').focus();$('package-text').select();};$('import').onclick=()=>run(async()=>{const source=$('package-text').value.trim();let encoded;try{const bundle=JSON.parse(source);if(bundle.format!=='maisya-profile-1')throw Error();encoded=bundle.data;}catch{throw Error('请粘贴完整的 Maisya 档案包文本，或选择 ZIP 文件。');}await importBytes(Uint8Array.from(atob(encoded),ch=>ch.charCodeAt(0)));});$('package-file').onchange=()=>run(async()=>{const file=$('package-file').files[0];if(!file)return;if(file.size>8388608)throw Error('档案包超过 8 MiB');await importBytes(new Uint8Array(await file.arrayBuffer()));});await loadAsset();}
async function importBytes(bytes){const target=$('import-id').value.trim();if(!target)throw Error('请填写新能力编号');let token='';for(let offset=0;offset<bytes.length;offset+=24576){const part=bytes.slice(offset,offset+24576);let binary='';part.forEach(value=>binary+=String.fromCharCode(value));const response=await action('import',{target,token,offset,data:btoa(binary),done:offset+part.length===bytes.length});token=response.token||token;}selected=target;await catalog();await loadAsset();feedback('已导入。带服务或凭据的能力需要先完成本机绑定。');}
function showEntries(id,rows){$(id).replaceChildren();rows.forEach(row=>{const entry=document.createElement('div');entry.className='entry';const title=document.createElement('strong'),body=document.createElement('p');title.textContent=row.thread_id||row.kind||row.name||row.intent_id;body.textContent=row.content||row.result?.text||row.reason||'';entry.append(title,body);if(row.intent_id&&row.status==='pending')entry.append(makeButton('取消',async()=>{await action('cancel_intent',{intent_id:row.intent_id});await loadIntents();feedback('已取消该意图。');}));$(id).append(entry);});if(!rows.length){const empty=document.createElement('p');empty.className='hint';empty.textContent='这里还没有记录。';$(id).append(empty);}}
async function loadIntents(){const data=await query('intents');showEntries('intent-list',data.intents);text('learning',data.learning.map(row=>row.thread_id+' · '+row.status).join('\n')||'还没有自动笔记记录。');}
async function memoryOverview(){const data=await query('memory',{chat_id:$('chat').value,query:$('search').value});showEntries('experiences',data.experiences);showEntries('search-results',data.results);$('workspaces').replaceChildren();data.workspaces.forEach(row=>{$('workspaces').append(makeButton(row.name+' · '+row.owner,async()=>{const result=await query('workspace',{workspace_id:row.workspace_id});text('workspace-content',result.files.map(file=>file.path+' · '+file.bytes+' B').join('\n')||'工作区暂无文件');$('workspace-files').replaceChildren();result.files.forEach(file=>$('workspace-files').append(makeButton(file.path,async()=>{const result=await query('workspace',{workspace_id:row.workspace_id,path:file.path});text('workspace-content',result.text);})));}));});}
async function initializeMemory(){const data=await query('memory');$('chat').replaceChildren();(data.chats.length?data.chats:['']).forEach(id=>{const option=document.createElement('option');option.value=id;option.textContent=id||'暂无会话';$('chat').append(option);});$('kind').onchange=()=>run(async()=>{remember();current=null;await loadAsset();});$('chat').onchange=()=>run(async()=>{remember();current=null;await loadAsset();await memoryOverview();});$('search-button').onclick=()=>run(memoryOverview);await loadAsset();await memoryOverview();await loadIntents();}
const labels={enabled_chats:'启用会话，以逗号分隔',agent_max_steps:'每轮模型步数',agent_timeout:'每轮最长秒数',agent_max_active:'同时活动线程数',thread_idle_seconds:'闲置检查秒数',thread_context_chars:'上下文字符预算',sleep_window:'睡眠时段，例如 23-8',proactive_level:'默认主动程度',chat_proactive_levels:'会话独立主动级别（每行 会话=quiet|care|lively）',acquaintance_users:'熟识账号列表（platform:user_id，逗号分隔）',longing_quiet_hours:'想念触发静默小时数（0 为关闭）','plugin.enabled':'启用 Maisya','sandbox.enabled':'启用沙箱','sandbox.image':'固定镜像 digest','sandbox.socket':'本机 Docker socket','sandbox.runtime':'专用运行时','sandbox.subnet':'独立沙箱网段','sandbox.dns':'公网 DNS，以逗号分隔','sandbox.host_addresses':'额外封锁的宿主地址，以逗号分隔','sandbox.memory_mib':'单次执行内存 MiB','sandbox.work_mib':'工作副本 MiB','sandbox.timeout':'单命令最长秒数','sandbox.output_bytes':'命令输出字节上限','sandbox.max_concurrent':'同时运行容器数'};
const getPath=(object,path)=>path.split('.').reduce((value,key)=>value[key],object);
function setPath(object,path,value){const keys=path.split('.'),last=keys.pop();keys.reduce((item,key)=>item[key],object)[last]=value;}
function parseField(input){if(input.dataset.type==='boolean')return input.checked;if(input.dataset.type==='number')return Number(input.value);if(input.dataset.type==='array')return input.value.split(/[,\n]/).map(value=>value.trim()).filter(Boolean);if(input.dataset.type==='map'){const out={};input.value.split('\n').map(line=>line.trim()).filter(Boolean).forEach(line=>{const idx=line.indexOf('=');if(idx>0){const k=line.slice(0,idx).trim(),v=line.slice(idx+1).trim();if(k&&v)out[k]=v;}});return out;}return input.value;}
async function initializeSettings(){const data=await query('settings');settings=data.settings;settingsVersion=data.version;text('admins',data.admins.join('、')||'宿主尚未配置管理员');text('handles',data.handles.join('、')||'还没有凭据');Object.entries(labels).forEach(([key,label])=>{const wrap=document.createElement('label');wrap.append(document.createTextNode(label));const value=getPath(settings,key);let input,kind=Array.isArray(value)?'array':(typeof value==='object'&&value!==null?'map':typeof value);if(key==='proactive_level'){input=document.createElement('select');[['quiet','安静'],['care','关心'],['lively','活跃']].forEach(([value,label])=>{const option=document.createElement('option');option.value=value;option.textContent=label;input.append(option);});input.value=value;}else if(kind==='map'){input=document.createElement('textarea');input.rows=3;input.placeholder='chat_id=lively';input.value=Object.entries(value).map(([k,v])=>k+'='+v).join('\n');}else{input=document.createElement('input');input.type=typeof value==='boolean'?'checkbox':typeof value==='number'?'number':'text';if(input.type==='checkbox')input.checked=value;else input.value=Array.isArray(value)?value.join(', '):value;}input.id=key.replaceAll('.','_');input.dataset.path=key;input.dataset.type=kind;wrap.append(input);$(key.startsWith('sandbox.')?'sandbox-fields':'general-fields').append(wrap);});$('save-settings').onclick=()=>run(async()=>{const next=structuredClone(settings);document.querySelectorAll('[data-path]').forEach(input=>setPath(next,input.dataset.path,parseField(input)));const result=await action('settings',{settings:next,expected_version:settingsVersion});settings=result.settings;settingsVersion=result.version;feedback('设置已保存。');await health();});$('save-vault').onclick=()=>run(async()=>{const value=$('vault-value').value;$('vault-value').value='';const data=await action('vault',{handle:$('vault-handle').value.trim(),value});text('handles',data.handles.join('、'));feedback('凭据已保存。');});$('delete-vault').onclick=()=>run(async()=>{const data=await action('vault',{handle:$('vault-handle').value.trim(),delete:true});text('handles',data.handles.join('、')||'还没有凭据');feedback('凭据已删除。');});const services=await query('services');servicesVersion=services.version;$('service-config').value=JSON.stringify(services.configuration,null,2);$('save-services').onclick=()=>run(async()=>{const result=await action('services',{configuration:JSON.parse($('service-config').value),expected_version:servicesVersion});servicesVersion=result.version;feedback('服务登记已保存。');});$('check').onclick=()=>run(health);const webhooks=await query('webhooks');webhooksVersion=webhooks.version;$('webhook-config').value=JSON.stringify(webhooks.configuration,null,2);$('save-webhooks').onclick=()=>run(async()=>{const result=await action('webhooks',{configuration:JSON.parse($('webhook-config').value),expected_version:webhooksVersion});webhooksVersion=result.version;feedback('事件通道已保存。');});await health();await loadIntents();}
async function health(){const data=await query('health');text('health',(data.ready?'执行器已就绪':data.error||'执行器尚未启用')+'\n'+Math.round(data.bytes/1048576)+' / '+Math.round(data.limit/1048576)+' MiB 持久文件 · '+data.running+' 个容器 · '+data.quarantined+' 个隔离副本');}
(async()=>{if(!window.maibot){text('connection','请从 MaiBot 管理台打开');return;}await window.maibot.ready;theme(window.maibot.context);await run(pageKind==='abilities'?initializeAbilities:pageKind==='memory'?initializeMemory:initializeSettings);})();
})();
</script></body></html>

