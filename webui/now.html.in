<!doctype html>
<html lang="zh-CN" data-theme="millennium" data-ui-style="millennium" data-dashboard-style="millennium">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Maisya · {{TITLE}}</title>
<style>
{{MILLENNIUM_CSS}}

{{MGMT_CSS}}

/* ───────────── 现场页上下文方块图与通用窗口样式 ───────────── */
.ctx-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
  gap: 14px;
  align-items: start;
}

.ctx-board {
  position: relative;
  min-height: 226px;
  border: 0;
  border-radius: 18px;
  background: var(--mil-screen);
  padding: 4px;
  overflow: hidden;
}
:root[data-ui-style="millennium"] .ctx-board {
  border: 2px solid var(--mil-line);
  border-radius: 0;
  box-shadow: inset 2px 2px 0 var(--mil-screen-shade);
  padding: 0;
}

.ctx-map-stage {
  position: relative;
  width: 100%;
  height: 220px;
  overflow: hidden;
  border-radius: 12px;
  background: var(--ctx-free);
}
:root[data-ui-style="millennium"] .ctx-map-stage {
  border-radius: 0;
}

.cm-tile {
  position: absolute;
  border: 1.5px solid var(--mil-panel);
  border-radius: 6px;
  padding: 5px 7px;
  overflow: hidden;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  text-align: left;
  color: var(--ctx-tile-ink);
  font-size: 11.5px;
  line-height: 1.25;
  transition: opacity 150ms ease;
}
:root[data-ui-style="millennium"] .cm-tile {
  border: 1.5px solid var(--mil-line);
  border-radius: 0;
}
.cm-tile[data-cat="system"] { background: var(--ctx-system); }
.cm-tile[data-cat="memory"] { background: var(--ctx-memory); }
.cm-tile[data-cat="user"] { background: var(--ctx-user); }
.cm-tile[data-cat="assistant"] { background: var(--ctx-assistant); }
.cm-tile[data-cat="tool"] { background: var(--ctx-tool); }
.cm-tile[data-cat="free"] {
  background: var(--ctx-free);
  color: var(--mil-muted);
  cursor: default;
}
.cm-tile.dim { opacity: 0.28; }
.cm-tile b {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 11.5px;
  font-weight: 600;
}
.cm-tile span {
  font-family: var(--mil-font-mono);
  font-size: 10.5px;
  opacity: 0.85;
}

.cm-grid {
  display: grid;
  grid-template-columns: repeat(20, minmax(0, 1fr));
  gap: 2px;
  padding: 6px;
  border-radius: 9px;
  background: var(--mil-screen);
}
.cm-cell {
  aspect-ratio: 1;
  border: 0;
  border-radius: 2px;
  background: var(--ctx-free);
  cursor: pointer;
  padding: 0;
}
.cm-cell[data-cat="system"] { background: var(--ctx-system); }
.cm-cell[data-cat="memory"] { background: var(--ctx-memory); }
.cm-cell[data-cat="user"] { background: var(--ctx-user); }
.cm-cell[data-cat="assistant"] { background: var(--ctx-assistant); }
.cm-cell[data-cat="tool"] { background: var(--ctx-tool); }
.cm-cell[data-cat="free"] { cursor: default; }
.cm-cell.dim { opacity: 0.24; }

.cm-tip {
  position: fixed;
  z-index: 980;
  pointer-events: none;
  max-width: 280px;
  padding: 8px 10px;
  border: 1px solid var(--mil-line);
  border-radius: 10px;
  background: var(--mil-panel);
  color: var(--mil-ink);
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.14);
  font-size: 12.5px;
  overflow-wrap: anywhere;
}
.cm-tip[hidden] { display: none; }

.ctx-cats {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: 8px 0;
}

.ctx-swatch {
  display: inline-block;
  width: 9px;
  height: 9px;
  border-radius: 3px;
  border: 1px solid var(--mil-line);
}

:root[data-ui-style="millennium"] .cm-grid,
:root[data-ui-style="millennium"] .cm-cell,
:root[data-ui-style="millennium"] .cm-tip,
:root[data-ui-style="millennium"] .ctx-swatch {
  border-radius: 0;
}
:root[data-ui-style="millennium"] .cm-tip {
  border: 2px solid var(--mil-line);
  box-shadow: 0 4px 0 var(--mil-drop);
}

.ctx-items {
  display: flex;
  flex-direction: column;
  max-height: 180px;
  overflow-y: auto;
  border: 0;
  border-radius: 16px;
  background: var(--mil-screen);
}
:root[data-ui-style="millennium"] .ctx-items {
  border: 2px solid var(--mil-line);
  border-radius: 0;
  box-shadow: var(--mil-sunk);
}

.ci-row {
  width: 100%;
  border: 0;
  border-bottom: 1px solid var(--mil-rule);
  background: transparent;
  color: var(--mil-ink);
  padding: 8px 12px;
  cursor: pointer;
  text-align: left;
  display: grid;
  grid-template-columns: 10px minmax(0, 1fr) auto;
  gap: 8px;
  align-items: center;
}
:root[data-ui-style="millennium"] .ci-row {
  border-bottom: 2px dashed var(--mil-rule);
  padding: 7px 10px;
}
.ci-row:last-child { border-bottom: 0; }
.ci-row-name {
  font-size: 12.5px;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ci-row-bar {
  grid-column: 2 / 4;
  height: 4px;
  border-radius: 999px;
  background: var(--mil-well);
  overflow: hidden;
}
:root[data-ui-style="millennium"] .ci-row-bar,
:root[data-ui-style="millennium"] .ci-row-bar > i {
  border-radius: 0;
}
.ci-row-bar > i {
  display: block;
  height: 100%;
  background: var(--mil-accent);
}

.launch-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

@media (max-width: 960px) {
  .ctx-layout,
  .launch-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (prefers-reduced-motion: reduce) {
  .cm-tile {
    transition: none;
  }
}

.ms-view {
  display: flex;
  flex-direction: column;
  gap: 18px;
}
.ms-view[hidden],
.mil-led-pill[hidden],
.mil-key[hidden],
.ms-mob-dock[hidden],
.ms-upd-pop[hidden],
.ms-upd-dot[hidden] {
  display: none;
}

.ms-upd-anchor {
  position: relative;
  display: inline-flex;
  align-items: center;
}
.ms-upd-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.ms-upd-dot {
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: currentColor;
  flex-shrink: 0;
}
:root[data-ui-style="millennium"] .ms-upd-dot {
  border-radius: 0;
}
.ms-upd-pop {
  position: absolute;
  right: 0;
  top: calc(100% + 10px);
  z-index: 95;
  width: min(312px, calc(100vw - 24px));
  padding: 12px 13px;
  border: 1px solid var(--mil-line);
  border-radius: 14px;
  background: var(--mil-panel);
  color: var(--mil-ink);
  box-shadow: 0 12px 32px rgba(15, 23, 42, 0.16);
  display: flex;
  flex-direction: column;
  gap: 8px;
  text-align: left;
}
.ms-upd-pop::before,
.ms-upd-pop::after {
  content: "";
  position: absolute;
  right: 20px;
  width: 10px;
  height: 10px;
  transform: rotate(45deg);
  pointer-events: none;
}
.ms-upd-pop::before {
  top: -6px;
  background: var(--mil-line);
}
.ms-upd-pop::after {
  top: -4.5px;
  background: var(--mil-panel);
}
:root[data-ui-style="millennium"] .ms-upd-pop {
  border: 2px solid var(--mil-line);
  border-radius: 0;
  box-shadow: 0 5px 0 var(--mil-drop);
}
:root[data-ui-style="millennium"] .ms-upd-pop::before {
  top: -7px;
}
:root[data-ui-style="millennium"] .ms-upd-pop::after {
  top: -4px;
}
.ms-upd-pop-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.ms-upd-pop-head-l {
  display: flex;
  align-items: center;
  gap: 6px;
  min-width: 0;
  flex-wrap: wrap;
}
.ms-upd-rel {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 8px 9px;
  border: 1px solid var(--mil-rule);
  border-radius: 10px;
  background: var(--mil-screen);
}
:root[data-ui-style="millennium"] .ms-upd-rel {
  border: 2px solid var(--mil-line);
  border-radius: 0;
}
.ms-upd-rel[hidden] {
  display: none;
}
.ms-upd-notes {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  font-family: var(--mil-font-sans, inherit);
  font-size: 12px;
  line-height: 1.45;
  color: var(--mil-ink);
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  max-height: 112px;
  overflow-y: auto;
}
.ms-upd-notes[hidden] {
  display: none;
}
.ms-upd-pop-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
  padding-top: 7px;
  border-top: 1px dashed var(--mil-rule);
  font-size: 12px;
  color: var(--mil-muted);
}
.ms-upd-opt {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  cursor: pointer;
  user-select: none;
}
.ms-upd-opt input {
  margin: 0;
  accent-color: var(--mil-accent);
  cursor: pointer;
}
@media (max-width: 640px) {
  .ms-upd-pop {
    position: fixed;
    left: 12px;
    right: 12px;
    top: 64px;
    width: auto;
  }
  .ms-upd-pop::before,
  .ms-upd-pop::after {
    display: none;
  }
}
</style>
</head>
<body data-page="{{PAGE_ID}}" data-default-page="{{PAGE_ID}}">
<div class="mil-shell">

  <!-- 顶部导航条（5 页 + 主题切换 + 引导入口） -->
  <header class="mil-topbar">
    <div class="mil-brand">
      <div class="ms-wordmark">
        <span class="mil-spectrum" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="mil-nameplate">MAISYA</span>
      </div>
      <h1 class="mil-page-title" id="ms-page-title">{{TITLE}}</h1>
      <nav class="mil-nav ms-nav" aria-label="Maisya 工作区页面">
        <button type="button" class="mil-key mil-key--sm"{{NAV_NOW_CURRENT}} data-nav="now">现场</button>
        <button type="button" class="mil-key mil-key--sm"{{NAV_LIBRARY_CURRENT}} data-nav="library">产物</button>
        <button type="button" class="mil-key mil-key--sm"{{NAV_ABILITIES_CURRENT}} data-nav="abilities">能力<span class="ms-nav-dot" id="nav-ab-prop-badge" aria-hidden="true" hidden></span></button>
        <button type="button" class="mil-key mil-key--sm"{{NAV_MEMORY_CURRENT}} data-nav="memory">手账</button>
        <button type="button" class="mil-key mil-key--sm"{{NAV_SETTINGS_CURRENT}} data-nav="settings">设置</button>
      </nav>
    </div>
    <div class="mil-top-right">
      <div class="ms-upd-anchor" id="ms-upd-anchor">
        <button type="button" class="mil-key mil-key--sm ms-upd-chip" id="ms-upd-chip" aria-haspopup="dialog" aria-expanded="false" aria-controls="ms-upd-pop" title="版本与更新提醒">
          <span class="ms-upd-dot" id="ms-upd-dot" aria-hidden="true" hidden></span>
          <span class="mono" id="ms-upd-chip-txt">版本</span>
        </button>
        <div class="ms-upd-pop" id="ms-upd-pop" role="dialog" aria-label="版本与更新" hidden>
          <div class="ms-upd-pop-head">
            <div class="ms-upd-pop-head-l">
              <strong class="mono" id="ms-upd-pop-ver">—</strong>
              <span class="mil-tag" id="ms-upd-pop-tag">未检查</span>
            </div>
            <button type="button" class="mil-key mil-key--sm" id="ms-upd-check-btn">检查</button>
          </div>
          <div class="mil-hint" id="ms-upd-pop-meta" style="font-size:12px;overflow-wrap:anywhere">点击「检查」检测 GitHub 新版本</div>
          <div class="ms-upd-rel" id="ms-upd-rel-box" hidden>
            <div class="mil-row" style="justify-content:space-between;align-items:center;gap:6px">
              <strong id="ms-upd-rel-title" style="font-size:12.5px"></strong>
              <span class="mil-hint mono" id="ms-upd-rel-date" style="font-size:11px"></span>
            </div>
            <pre class="ms-upd-notes" id="ms-upd-notes" hidden></pre>
            <div class="mil-hint" style="font-size:11.5px;overflow-wrap:anywhere">在 MaiBot 插件管理点更新，或目录 <code class="mono">git pull</code> 后重载。</div>
            <div class="mil-row" style="gap:6px;flex-wrap:wrap">
              <button type="button" class="mil-key mil-key--sm mil-key--hot" id="ms-upd-copy-url">复制链接</button>
              <a class="mil-key mil-key--sm" id="ms-upd-open-url" href="#" target="_blank" rel="noopener noreferrer" style="text-decoration:none">发布页</a>
              <button type="button" class="mil-key mil-key--sm" id="ms-upd-toggle-dismiss">忽略此版</button>
            </div>
          </div>
          <div class="ms-upd-pop-foot">
            <label class="ms-upd-opt"><input type="checkbox" id="ms-upd-auto" checked /><span>自动检查 (12h)</span></label>
            <label class="ms-upd-opt"><input type="checkbox" id="ms-upd-notify" checked /><span>私聊提醒管理员</span></label>
          </div>
        </div>
      </div>
      <button type="button" class="mil-key mil-key--sm" id="ui-style-toggle" aria-pressed="true" title="切换界面主题（千禧机械 / 现代极简 / 自动）">千禧机械</button>
      <button type="button" class="mil-key mil-key--sm" id="open-onboarding-btn" title="打开五步初始化引导">引导</button>
      <div class="mil-led-pill" id="top-led-pill"{{NOW_HIDDEN}}>
        <span class="mil-led" id="top-led"></span>
        <span id="top-state-text">待命</span>
      </div>
    </div>
  </header>

  <!-- 管理分页挂载区（档案 / 资料库 / 设置） -->
  <div id="ms-mgmt-view-wrap" class="ms-view"{{MGMT_HIDDEN}}>
    <div class="mil-feedback" id="{{MGMT_FEEDBACK_ID}}" data-feedback-slot="mgmt" aria-live="polite"></div>
    <div id="ms-mgmt-view" class="ms-view">{{MGMT_DEFAULT_BODY}}</div>
  </div>

  <!-- 现场页（默认首页） -->
  <div id="ms-now-view" class="ms-view"{{NOW_HIDDEN}}>
<!-- ==NOW_BODY_START== -->
  <div class="mil-feedback" id="feedback" data-feedback-slot="now" aria-live="polite"></div>
  <div class="mil-row" id="now-skill-draft-bar" hidden style="justify-content:space-between;align-items:center;padding:8px 12px;border:1px solid var(--mil-rule);border-radius:var(--mil-r);background:var(--mil-panel-soft);gap:8px;flex-wrap:wrap">
    <div class="mil-row" style="gap:8px;align-items:center;flex-wrap:wrap">
      <span class="mil-tag mil-tag--warn">新技能待确认</span>
      <span id="now-skill-draft-txt" style="font-size:12.5px"></span>
    </div>
    <button type="button" class="mil-key mil-key--sm mil-key--hot" id="now-goto-proposals">前往预览保存</button>
  </div>

  <div class="now-v3-grid">
    <!-- 左栏：预定与盯梢 + 活动时间线 -->
    <div class="now-col-stack">
      <section class="mil-panel" aria-label="预定与盯梢">
        <div class="mil-head">
          <div class="mil-head-l">
            <span data-icon-slot="routines"></span>
            <div class="mil-silk">预定与盯梢</div>
            <button type="button" class="mil-help" data-help="由会话或管理员安排的定期提醒与条件触发检查，到期时自动唤醒对应角色" aria-label="查看说明" aria-expanded="false">?</button>
          </div>
          <div class="mil-head-r">
            <span class="mil-tag" id="now-intent-count">0 项</span>
            <button type="button" class="mil-key mil-key--sm" id="now-add-intent-btn">+ 新建</button>
          </div>
        </div>
        <form id="now-intent-form" class="set-subcard" hidden style="margin-bottom:10px;display:flex;flex-direction:column;gap:8px">
          <div class="mil-grid-2">
            <div class="mil-field">
              <label class="mil-label" for="now-new-int-mode">安排类型</label>
              <select class="mil-select" id="now-new-int-mode">
                <option value="once">单次预定提醒</option>
                <option value="recurring">周期定时执行</option>
                <option value="watch">条件盯梢（满足再汇报）</option>
              </select>
            </div>
            <div class="mil-field">
              <label class="mil-label" for="now-new-int-mins">延迟或周期（分钟）</label>
              <input type="number" class="mil-input num" id="now-new-int-mins" min="1" max="43200" value="60" />
            </div>
          </div>
          <div class="mil-grid-2">
            <div class="mil-field">
              <label class="mil-label" for="now-new-int-chat">目标会话</label>
              <select class="mil-select" id="now-new-int-chat"></select>
            </div>
            <div class="mil-field">
              <label class="mil-label" for="now-new-int-profile">执行角色</label>
              <select class="mil-select" id="now-new-int-profile"></select>
            </div>
          </div>
          <div class="mil-field">
            <label class="mil-label" for="now-new-int-reason">事项说明</label>
            <input type="text" class="mil-input" id="now-new-int-reason" placeholder="例如：每周五晚汇总独立游戏精选" />
          </div>
          <div class="mil-field" id="now-new-int-cond-wrap" hidden>
            <label class="mil-label" for="now-new-int-cond">盯梢触发条件</label>
            <input type="text" class="mil-input" id="now-new-int-cond" placeholder="满足什么变化时才发消息汇报？" />
          </div>
          <div class="mil-row" style="justify-content:flex-end;gap:6px">
            <button type="button" class="mil-key mil-key--sm" id="now-new-int-cancel">取消</button>
            <button type="submit" class="mil-key mil-key--sm mil-key--hot" id="now-new-int-save">保存安排</button>
          </div>
        </form>
        <div class="mil-row" id="now-hb-ticks" hidden style="gap:6px;flex-wrap:wrap;margin-bottom:8px" aria-label="近期心跳节律"></div>
        <div class="now-intent-list" id="now-intents">
          <div class="mil-hint">暂无预定或盯梢项</div>
        </div>
      </section>

      <section class="mil-panel" aria-label="活动时间线">
        <div class="mil-head">
          <div class="mil-head-l">
            <span data-icon-slot="heartbeat"></span>
            <div class="mil-silk">活动时间线</div>
            <button type="button" class="mil-help" data-help="按最新活动排序展示各聊天流开启的后台线程，点选即可查看步骤与上下文占用" aria-label="查看说明" aria-expanded="false">?</button>
          </div>
          <div class="mil-head-r">
            <span class="mil-tag" id="now-thread-count">0 条</span>
            <button type="button" class="mil-key mil-key--sm" id="now-prune-btn" title="清理已结束且无保留产物的旧记录">清理废记录</button>
          </div>
        </div>

        <div class="now-filter-row" style="margin-bottom:10px">
          <input type="search" class="mil-input" id="now-thread-search" placeholder="搜索线程标题、会话或角色…" aria-label="筛选活动时间线" />
          <select class="mil-select" id="now-thread-chat" aria-label="按会话筛选活动" style="max-width:170px">
            <option value="">全部会话</option>
          </select>
          <div class="mil-seg" id="now-thread-filters" role="group" aria-label="线程状态筛选">
            <button type="button" class="mil-key mil-key--sm" data-th-filter="all" aria-pressed="true">全部</button>
            <button type="button" class="mil-key mil-key--sm" data-th-filter="running" aria-pressed="false">进行中</button>
            <button type="button" class="mil-key mil-key--sm" data-th-filter="approval" aria-pressed="false">待确认</button>
            <button type="button" class="mil-key mil-key--sm" data-th-filter="history" aria-pressed="false">历史可续</button>
          </div>
        </div>

        <div class="now-thread-list" id="now-threads">
          <div class="mil-hint">暂无活动记录</div>
        </div>
      </section>
    </div>

    <!-- 右栏：确认条 + 垂直步骤时间线 + 总览/Treemap/单步详情 -->
    <section class="mil-panel now-inspector-card" aria-label="线程复盘与操作台">
      <div class="mil-head">
        <div class="mil-head-l">
          <span id="now-sel-fish"></span>
          <div style="min-width:0;flex:1 1 0">
            <div class="mil-silk" id="now-sel-title">尚未选中线程</div>
            <div class="now-card-meta" id="now-sel-meta">在左侧点选活动，查看步骤与详情</div>
          </div>
        </div>
        <div class="mil-head-r">
          <button type="button" class="mil-key mil-key--sm mil-key--danger" id="now-del-thread-btn" hidden>删除记录</button>
          <span class="mil-tag" id="now-sel-state">待命</span>
        </div>
      </div>

      <!-- 等待授权确认条 -->
      <div class="now-approval-bar" id="now-approval-bar" hidden>
        <div class="now-card-head">
          <strong id="now-appr-title">需要确认后才能继续执行</strong>
          <span class="mil-tag mil-tag--warn" id="now-appr-risk">需要授权</span>
        </div>
        <div class="mil-hint" id="now-appr-detail"></div>
        <pre class="mil-pre" id="now-appr-cmd" hidden></pre>
        <div class="now-approval-actions">
          <button type="button" class="mil-key mil-key--sm mil-key--hot" data-appr-decision="once">仅本次允许</button>
          <button type="button" class="mil-key mil-key--sm" data-appr-decision="session">本轮会话允许</button>
          <button type="button" class="mil-key mil-key--sm" data-appr-decision="always">长期记住</button>
          <button type="button" class="mil-key mil-key--sm mil-key--danger" data-appr-decision="deny">拒绝</button>
        </div>
      </div>

      <!-- 运行控制：补充说明 + 立即转向 + 停止 -->
      <div class="now-note-bar" id="now-controls-bar" hidden>
        <input type="text" class="mil-input" id="now-note-input" placeholder="输入补充要求；运行中可点「立即转向」改按新方向执行…" aria-label="补充说明" />
        <button type="button" class="mil-key mil-key--sm mil-key--hot" id="now-note-send">补充说明</button>
        <button type="button" class="mil-key mil-key--sm" id="now-steer-btn" title="打断当前偏离的步骤，保留已有成果并立即按新要求转向" hidden>立即转向</button>
        <button type="button" class="mil-key mil-key--sm mil-key--danger" id="now-stop-btn" hidden>停止</button>
      </div>

      <div class="now-stage">
        <!-- Muse 式垂直步骤时间线 -->
        <div>
          <div class="mil-label" style="margin-bottom:8px">执行步骤链</div>
          <div class="now-steps-wrap" id="now-step-timeline">
            <div class="mil-hint">选择线程后展示触发、思考与工具步骤。</div>
          </div>
        </div>

        <!-- 右侧详情视图：总览（含 Token Treemap）或 单步命令与脱敏输出 -->
        <div class="now-inspector-card">
          <div id="now-view-overview">
            <div class="now-summary-box" id="now-state-note-box" style="margin-bottom:10px" hidden>
              <div class="now-card-head">
                <span class="mil-label">当前活动状态便签 (STATE.md)</span>
              </div>
              <div id="now-state-note" class="mil-hint" style="white-space:pre-wrap"></div>
            </div>
            <div class="now-summary-box" style="margin-bottom:12px">
              <div class="now-card-head">
                <span class="mil-label">一句话结论与交付</span>
                <div class="mil-row" id="now-attachments"></div>
              </div>
              <div id="now-conclusion" class="mil-hint">选中线程后在这里汇总结论与生成产物。</div>
            </div>

            <!-- 保留并美化的上下文与 Token 消耗方块图 (Treemap) -->
            <div class="mil-panel mil-panel--soft" id="ctx-panel" style="padding:12px">
              <div class="mil-head" style="margin-bottom:8px">
                <div class="mil-head-l">
                  <span class="mil-silk">上下文空间</span>
                  <span class="mil-tag" id="ctx-health">待命</span>
                </div>
                <div class="mil-head-r">
                  <div class="mil-seg" role="group" aria-label="上下文视图模式">
                    <button type="button" class="mil-key mil-key--sm" data-ctx-view="map" aria-pressed="true">方块</button>
                    <button type="button" class="mil-key mil-key--sm" data-ctx-view="grid" aria-pressed="false">方格</button>
                  </div>
                </div>
              </div>
              <div class="mil-row" style="justify-content:space-between;margin-bottom:6px">
                <span class="mil-hint num" id="ctx-readout">0 / 262.1K tokens (0%)</span>
              </div>
              <div class="mil-meter" id="ctx-meter" style="margin-bottom:8px"><i id="ctx-meter-bar" style="width:0%"></i></div>
              <div class="ctx-cats" id="ctx-cats"></div>
              <div class="ctx-board" style="margin-bottom:10px">
                <div class="ctx-map-stage" id="ctx-map"></div>
                <div class="cm-grid" id="ctx-grid" hidden></div>
              </div>
              <div class="ctx-items" id="ctx-items"></div>
            </div>
          </div>

          <div id="now-view-step" class="now-summary-box" hidden>
            <div class="now-card-head">
              <div>
                <div class="mil-silk" id="now-step-title">步骤详情</div>
                <div class="mil-hint mono" id="now-step-meta">—</div>
              </div>
              <button type="button" class="mil-key mil-key--sm" id="now-back-overview">返回总览</button>
            </div>
            <div class="mil-field">
              <span class="mil-label">命令 / 参数</span>
              <pre class="mil-pre" id="now-step-args"></pre>
            </div>
            <div class="mil-field">
              <span class="mil-label">脱敏输出</span>
              <pre class="mil-pre" id="now-step-output"></pre>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- 折叠临时调度入口 -->
  <details class="mil-panel" id="launch-wrap">
    <summary class="mil-head" style="cursor:pointer;margin-bottom:0">
      <div class="mil-head-l">
        <span class="mil-silk">临时发起线程</span>
        <button type="button" class="mil-help" data-help="日常由 MaiBot 主脑按语境调度；管理员也可在这里选择角色与会话手动触发验证" aria-label="查看说明" aria-expanded="false">?</button>
      </div>
      <div class="mil-head-r"><span class="mil-vent" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span></div>
    </summary>
    <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--mil-rule)">
      <div class="launch-grid" style="margin-bottom:10px">
        <div class="mil-field">
          <label class="mil-label" for="launch-profile-trigger">执行角色</label>
          <div class="ms-model-box" id="launch-profile-box">
            <input type="hidden" id="launch-profile" value="default" />
            <button type="button" class="mil-key ms-model-trigger" id="launch-profile-trigger" aria-expanded="false" aria-controls="launch-profile-drop">
              <span class="mil-row" id="launch-profile-label" style="gap:6px;min-width:0">全能默认助手</span>
              <span class="mil-inline-ic" id="launch-profile-chev"></span>
            </button>
            <div class="ms-model-dropdown" id="launch-profile-drop" hidden>
              <div class="ms-model-groups" role="listbox" id="launch-profile-options"></div>
            </div>
          </div>
        </div>
        <div class="mil-field">
          <label class="mil-label" for="launch-chat-trigger">关联会话</label>
          <div class="ms-model-box" id="launch-chat-box">
            <input type="hidden" id="launch-chat" value="" />
            <button type="button" class="mil-key ms-model-trigger" id="launch-chat-trigger" aria-expanded="false" aria-controls="launch-chat-drop">
              <span class="mil-row" id="launch-chat-label" style="gap:6px;min-width:0">选择目标会话</span>
              <span class="mil-inline-ic" id="launch-chat-chev"></span>
            </button>
            <div class="ms-model-dropdown" id="launch-chat-drop" hidden>
              <div class="ms-model-search-wrap">
                <span class="mil-inline-ic" id="launch-chat-search-ic"></span>
                <input type="search" id="launch-chat-search" placeholder="搜索会话名称或 ID..." aria-label="搜索关联会话" />
              </div>
              <div class="ms-model-groups" role="listbox" id="launch-chat-options"></div>
            </div>
          </div>
        </div>
        <div class="mil-field">
          <label class="mil-label" for="launch-ws-select">持久工作区（可选）</label>
          <select id="launch-ws-select" class="mil-select" aria-label="选择持久工作区">
            <option value="">不绑定（单次临时任务）</option>
            <option value="__new__">+ 新建持久工作区…</option>
          </select>
          <input id="launch-workspace" class="mil-input mono" placeholder="输入新工作区名称，如 indie-weekly" style="margin-top:6px" hidden />
        </div>
      </div>
      <div class="mil-field" style="margin-bottom:10px">
        <label class="mil-label" for="launch-prompt">事情描述</label>
        <textarea id="launch-prompt" class="mil-textarea" rows="2" placeholder="输入需要探索或处理的内容…"></textarea>
      </div>
      <div class="mil-row" style="justify-content:space-between">
        <div class="mil-feedback" id="launch-feedback" aria-live="polite"></div>
        <button type="button" class="mil-key mil-key--sm mil-key--hot" id="launch-run">立即发起</button>
      </div>
    </div>
  </details>
<!-- ==NOW_BODY_END== -->
  </div>

  <!-- 移动端底部 5 栏固定导航（<= 720px 在所有页面展示） -->
  <nav id="ms-mob-dock" class="ms-mob-dock" aria-label="移动端导航">
    <button type="button" class="ms-mob-dock-btn"{{NAV_NOW_CURRENT}} data-mob-nav="now">
      <span class="ms-mob-dock-ic" data-dock-icon="cpu"></span>
      <span class="ms-mob-dock-lbl">现场</span>
    </button>
    <button type="button" class="ms-mob-dock-btn"{{NAV_LIBRARY_CURRENT}} data-mob-nav="library">
      <span class="ms-mob-dock-ic" data-dock-icon="grid"></span>
      <span class="ms-mob-dock-lbl">产物</span>
    </button>
    <button type="button" class="ms-mob-dock-btn"{{NAV_ABILITIES_CURRENT}} data-mob-nav="abilities">
      <span class="ms-mob-dock-ic" data-dock-icon="sparkle"></span>
      <span class="ms-mob-dock-lbl">能力</span>
    </button>
    <button type="button" class="ms-mob-dock-btn"{{NAV_MEMORY_CURRENT}} data-mob-nav="memory">
      <span class="ms-mob-dock-ic" data-dock-icon="book"></span>
      <span class="ms-mob-dock-lbl">手账</span>
    </button>
    <button type="button" class="ms-mob-dock-btn"{{NAV_SETTINGS_CURRENT}} data-mob-nav="settings">
      <span class="ms-mob-dock-ic" data-dock-icon="sliders"></span>
      <span class="ms-mob-dock-lbl">设置</span>
    </button>
  </nav>

</div>

<!-- 悬浮提示、说明气泡、上下文条目原文弹窗 & 五步新手引导弹窗 -->
<div class="cm-tip" id="cm-tip" hidden></div>
<div class="mil-help-pop" id="mil-help-pop" role="tooltip" hidden></div>

<div class="mil-scrim" id="ctx-scrim" hidden>
  <div class="mil-modal" role="dialog" aria-modal="true" aria-labelledby="ctx-modal-title">
    <div class="mil-head" style="margin-bottom:0">
      <div class="mil-head-l">
        <span class="mil-tag" id="ctx-modal-cat">—</span>
        <strong id="ctx-modal-title">上下文条目</strong>
      </div>
      <div class="mil-head-r">
        <span class="num mil-hint" id="ctx-modal-chars">0 字符</span>
        <button type="button" class="mil-key mil-key--sm" id="ctx-modal-close">关闭</button>
      </div>
    </div>
    <pre class="mil-pre" id="ctx-modal-body" style="max-height:56vh"></pre>
  </div>
</div>

<dialog class="mil-confirm-dialog" id="ms-confirm-dialog" closedby="any" aria-labelledby="ms-confirm-title" aria-describedby="ms-confirm-desc">
  <div class="mil-head" style="margin-bottom:0">
    <div class="mil-head-l" style="min-width:0">
      <span class="mil-tag mil-tag--bad" id="ms-confirm-tag">危险操作</span>
      <h2 class="mil-confirm-heading" id="ms-confirm-title">确认继续操作？</h2>
    </div>
  </div>
  <p class="mil-confirm-body" id="ms-confirm-desc"></p>
  <div class="mil-confirm-actions">
    <button type="button" class="mil-key mil-key--sm" id="ms-confirm-cancel" autofocus>取消</button>
    <button type="button" class="mil-key mil-key--sm mil-key--danger" id="ms-confirm-ok">确认删除</button>
  </div>
</dialog>

<div class="onb-scrim" id="onb-scrim" hidden>
  <div class="onb-card" id="onb-card" role="dialog" aria-modal="true" aria-labelledby="onb-title">
    <div class="onb-head">
      <div>
        <div class="mil-silk" id="onb-title">Maisya 五步启用引导</div>
        <div class="mil-hint" id="onb-subtitle">按顺序完成核验，随时可跳过并在设置中重新打开</div>
      </div>
      <div class="mil-row" style="gap:10px">
        <div class="onb-dots" id="onb-dots" aria-label="引导进度"></div>
        <button type="button" class="mil-key mil-key--sm" id="onb-close" aria-label="关闭引导">关闭</button>
      </div>
    </div>
    <div class="mil-feedback" id="onb-feedback" role="status" aria-live="polite"></div>
    <div class="onb-stage" id="onb-stage"></div>
    <div class="onb-foot">
      <button type="button" class="mil-key mil-key--sm" id="onb-skip">暂时跳过</button>
      <div class="mil-row" style="gap:8px">
        <button type="button" class="mil-key mil-key--sm" id="onb-prev">上一步</button>
        <button type="button" class="mil-key mil-key--sm mil-key--hot" id="onb-next">下一步</button>
      </div>
    </div>
  </div>
</div>

<script>
{{ICONS_JS}}
</script>
<script>
(() => {
  if (typeof window.__maisyaDispose === "function") {
    try { window.__maisyaDispose(); } catch (_) {}
  }
  const shellAbort = new AbortController();
  const shellSig = shellAbort.signal;
  let disposed = false;
  const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" }[c]));
  const $ = (sel) => document.querySelector(sel);
  const $$ = (sel) => [...document.querySelectorAll(sel)];
  window.MaisyaIcons?.ensureDefs?.();
  {{FISH_JS}}

  const PAGES = { now: "现场", library: "产物", abilities: "能力", memory: "手账", settings: "设置" };
  let pendingAbilitiesSubTab = "profiles";
  let pendingMemoryKind = "";
  function resolvePageAlias(raw) {
    const key = String(raw || "").trim().toLowerCase();
    if (key === "profiles") return { page: "abilities", abSub: "profiles" };
    if (key === "skills") return { page: "abilities", abSub: "skills" };
    if (key === "connectors" || key === "services") return { page: "abilities", abSub: "connectors" };
    if (key === "outputs") return { page: "library", abSub: "" };
    if (key === "role_memory" || key === "role-memory") return { page: "memory", memKind: "role_memory" };
    if (key === "journal" || key === "heartbeat") return { page: "memory", memKind: key };
    return { page: key, abSub: "" };
  }
  const MGMT_FRAGMENTS = {{MGMT_FRAGMENTS_JSON}};
  const initAlias = resolvePageAlias(document.body.dataset.defaultPage || "now");
  if (initAlias.abSub) pendingAbilitiesSubTab = initAlias.abSub;
  if (initAlias.memKind) pendingMemoryKind = initAlias.memKind;
  let activePage = Object.prototype.hasOwnProperty.call(PAGES, initAlias.page) ? initAlias.page : "now";
  let mgmtAbort = null;
  let bootStarted = false;
  let userNavigated = false;
  let timer = 0;

  // 双并发排队 + 10s 超时兜底 + 429 重试
  let queryQueue = Promise.resolve();
  let actionQueue = Promise.resolve();
  let activeQueue = 0;
  let queryInFlight = 0;
  const waiters = [];
  async function acquire() {
    while (activeQueue >= 2) await new Promise((res) => waiters.push(res));
    activeQueue++;
  }
  function release() {
    activeQueue--;
    if (waiters.length) waiters.shift()();
  }
  async function withSlot(fn) {
    await acquire();
    try { return await fn(); }
    finally { release(); }
  }
  function withTimeout(promise, ms = 10000) {
    let tid = 0;
    const t = new Promise((resolve) => {
      tid = setTimeout(() => resolve({ success: false, timeout: true, error: "请求超时（10s），请检查宿主服务后重试" }), ms);
    });
    return Promise.race([Promise.resolve(promise), t]).finally(() => { if (tid) clearTimeout(tid); });
  }
  const RETRYABLE_RPC_RE = /429|进行中的\s*WebUI\s*请求|Two requests|Concurrency limit/i;
  async function callMaibotRaw(kind, name, arg) {
    for (let attempt = 0; attempt < 3; attempt++) {
      try {
        if (!window.maibot || typeof window.maibot[kind] !== "function") {
          return { success: false, error: "宿主通信通道未就绪" };
        }
        const rawP = window.maibot[kind](name, arg);
        const res = await withTimeout(rawP, 10000);
        if (res && res.success === false && attempt < 2 && RETRYABLE_RPC_RE.test(String(res.error || ""))) {
          await new Promise((r) => setTimeout(r, attempt === 0 ? 350 : 700));
          continue;
        }
        return res || { success: false, error: "空响应" };
      } catch (err) {
        const msg = String(err?.message || err || "请求失败");
        if (attempt < 2 && RETRYABLE_RPC_RE.test(msg)) {
          await new Promise((r) => setTimeout(r, attempt === 0 ? 350 : 700));
          continue;
        }
        return { success: false, error: msg };
      }
    }
    return { success: false, error: "请求繁忙，请稍后重试" };
  }
  const enqueueQuery = (fn) => {
    queryInFlight += 1;
    const p = queryQueue.then(() => withSlot(fn), () => withSlot(fn));
    queryQueue = p.catch(() => {});
    return p.finally(() => { queryInFlight = Math.max(0, queryInFlight - 1); });
  };
  const enqueueAction = (fn) => {
    const p = actionQueue.then(() => withSlot(fn), () => withSlot(fn));
    actionQueue = p.catch(() => {});
    return p;
  };
  async function hostRpc(op, key, body) {
    const startStyleSeq = uiStyleSeq;
    const run = async () => {
      if (disposed) return { success: false, aborted: true };
      const arg = op === "read"
        ? { section: key, payload: JSON.stringify(body || {}) }
        : { action: key, payload: JSON.stringify(body || {}) };
      const res = op === "read" ? await callMaibotRaw("query", "read", arg) : await callMaibotRaw("action", "write", arg);
      if (!disposed && res?.ui_style && startStyleSeq === uiStyleSeq) {
        savedUiStyle = normalizeThemePref(res.ui_style);
        applyTheme();
      }
      return res;
    };
    return op === "read" ? enqueueQuery(run) : enqueueAction(run);
  }

  function hostSay(text, isErr = false) {
    const fb = $('[data-feedback-slot="mgmt"]');
    if (!fb) return;
    fb.textContent = text || "";
    fb.className = `mil-feedback${!text ? "" : isErr ? " mil-feedback--err" : " mil-feedback--ok"}`;
  }
  function setNowFeedback(text, isErr = false) {
    const fb = $('[data-feedback-slot="now"]');
    if (!fb) return;
    fb.textContent = text || "";
    fb.className = `mil-feedback${!text ? "" : isErr ? " mil-feedback--err" : " mil-feedback--ok"}`;
  }

  // 双主题：millennium（默认）| modern（兼容 maiwork）| auto（跟随明暗）
  let savedUiStyle = "millennium";
  let manualUiStyle = "";
  let uiStyleSeq = 0;
  let lastCtx = null;
  function normalizeThemePref(val) {
    const raw = String(val || "").trim().toLowerCase();
    if (raw === "maiwork" || raw === "modern") return "modern";
    if (raw === "auto") return "auto";
    return "millennium";
  }
  function resolveTheme(pref, ctx) {
    const c = ctx || lastCtx || window.maibot?.context || {};
    const sysDark = typeof window.matchMedia === "function" && window.matchMedia("(prefers-color-scheme: dark)").matches;
    const isDark = c.theme === "dark" ? true : c.theme === "light" ? false : sysDark;
    const hostStyle = normalizeThemePref(c.dashboardStyle || "");
    let uiStyle = pref;
    if (pref === "auto") {
      if (c.dashboardStyle) uiStyle = hostStyle === "auto" ? (isDark ? "modern" : "millennium") : hostStyle;
      else uiStyle = isDark ? "modern" : "millennium";
    }
    return { pref, uiStyle: uiStyle === "modern" ? "modern" : "millennium", isDark };
  }
  function renderIconSlots() {
    const ic = window.MaisyaIcons;
    if (!ic) return;
    $$("[data-icon-slot]").forEach((el) => {
      const k = el.dataset.iconSlot || "gear";
      el.innerHTML = ic.mod ? ic.mod(k, 22) : ic.ctrl(k, 18, 1.9);
    });
    $$("#ms-mob-dock [data-dock-icon]").forEach((el) => {
      el.innerHTML = ic.ctrl(el.dataset.dockIcon || "grid", 18, 1.9);
    });
  }
  const THEME_LABEL = { millennium: "千禧机械", modern: "现代极简", auto: "自动跟随" };
  function applyTheme(ctx) {
    if (disposed) return;
    if (ctx) lastCtx = ctx;
    const pref = normalizeThemePref(manualUiStyle || savedUiStyle || "millennium");
    const r = resolveTheme(pref, ctx);
    const root = document.documentElement;
    root.classList.toggle("dark", r.isDark);
    root.setAttribute("data-theme", pref);
    root.setAttribute("data-ui-style", r.uiStyle);
    root.setAttribute("data-dashboard-style", (lastCtx?.dashboardStyle) || "millennium");
    const btn = $("#ui-style-toggle");
    if (btn) {
      btn.textContent = THEME_LABEL[pref] || "千禧机械";
      btn.setAttribute("aria-pressed", String(r.uiStyle === "millennium"));
    }
    renderIconSlots();
    window.dispatchEvent(new CustomEvent("maisya:themechange", { detail: { theme: pref, uiStyle: r.uiStyle, dark: r.isDark } }));
  }
  async function setUiStylePreference(nextPref) {
    const pref = normalizeThemePref(nextPref);
    const prevManual = manualUiStyle;
    const prevSaved = savedUiStyle;
    const seq = ++uiStyleSeq;
    manualUiStyle = pref;
    applyTheme();
    try {
      const res = await hostRpc("write", "ui_style", { ui_style: pref });
      if (disposed || seq !== uiStyleSeq) return;
      if (!res?.success) {
        const err = String(res?.error || "主题切换保存失败");
        if (!/未就绪|unexpected keyword/i.test(err)) {
          manualUiStyle = prevManual;
          savedUiStyle = prevSaved;
          applyTheme();
          if (activePage === "now") setNowFeedback(err, true);
          else hostSay(err, true);
        }
        return;
      }
      savedUiStyle = normalizeThemePref(res.ui_style || pref);
      manualUiStyle = "";
      applyTheme();
      window.dispatchEvent(new CustomEvent("maisya:ui-style-saved", { detail: { uiStyle: savedUiStyle, version: res.version ?? null } }));
    } catch (err) {
      if (disposed || seq !== uiStyleSeq) return;
      manualUiStyle = prevManual;
      savedUiStyle = prevSaved;
      applyTheme();
    }
  }
  applyTheme();
  window.addEventListener("maibot:context", (ev) => applyTheme(ev.detail), { signal: shellSig });
  window.matchMedia?.("(prefers-color-scheme: dark)")?.addEventListener?.("change", () => applyTheme(), { signal: shellSig });
  $("#ui-style-toggle")?.addEventListener("click", () => {
    const cur = normalizeThemePref(manualUiStyle || savedUiStyle || "millennium");
    const order = ["millennium", "modern", "auto"];
    const next = order[(order.indexOf(cur) + 1) % order.length];
    setUiStylePreference(next);
  }, { signal: shellSig });

  const calm = () => window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;
  const fmtTime = (ts) => {
    if (!ts) return "—";
    if (typeof ts === "string" && isNaN(Number(ts))) return ts;
    const d = new Date(Number(ts) * 1000);
    if (Number.isNaN(d.getTime())) return String(ts);
    return d.toLocaleTimeString("zh-CN", { hour12: false, hour: "2-digit", minute: "2-digit", second: "2-digit" });
  };
  const fmtK = (n) => {
    const v = Number(n || 0);
    return v >= 1000 ? `${(v / 1000).toFixed(1)}K` : String(v);
  };
  const fmtMs = (ms) => {
    if (ms === null || ms === undefined || ms === "") return "";
    const n = Number(ms);
    return Number.isNaN(n) ? String(ms) : n >= 1000 ? `${(n / 1000).toFixed(2)}s` : `${Math.round(n)}ms`;
  };
  const isSafeImageDataUri = (s) => /^data:image\/(?:png|jpeg|jpg|gif|webp|svg\+xml);base64,[A-Za-z0-9+/=]+$/i.test(String(s || "").trim());

  // 工具辅助与状态管理
  const STATE_LABEL = {
    active: ["运行中", "mil-tag--hot", "mil-led--run"],
    running: ["运行中", "mil-tag--hot", "mil-led--run"],
    waiting: ["等待确认", "mil-tag--warn", "mil-led--run"],
    pending_approval: ["待审批", "mil-tag--warn", "mil-led--run"],
    idle: ["暂停可续", "", "mil-led--off"],
    done: ["已完成", "mil-tag--ok", ""],
    completed: ["已完成", "mil-tag--ok", ""],
    finished: ["已完成", "mil-tag--ok", ""],
    closed: ["已结束", "mil-tag--off", "mil-led--off"],
    stopped: ["已停止", "mil-tag--off", "mil-led--off"],
    cancelled: ["已取消", "mil-tag--off", "mil-led--off"],
    failed: ["执行失败", "mil-tag--bad", "mil-led--bad"],
    error: ["异常", "mil-tag--bad", "mil-led--bad"],
    archived: ["已归档", "mil-tag--off", "mil-led--off"],
