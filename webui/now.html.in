<!doctype html>
<html lang="zh-CN" data-ui-style="millennium" data-dashboard-style="millennium">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Maisya · {{TITLE}}</title>
<style>
{{MILLENNIUM_CSS}}

{{MGMT_CSS}}

/* ───────────── 现场页专用布局与交互样式 ───────────── */

/* 1. 处理流向图 (FLOW) */
.flow-box {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 0.95fr) minmax(0, 0.92fr) minmax(0, 1fr) minmax(0, 1.15fr);
  gap: 32px;
  align-items: stretch;
  padding: 20px;
  border: 0;
  border-radius: 20px;
  background-color: var(--mil-screen);
}
:root[data-ui-style="millennium"] .flow-box {
  border: 2px solid var(--mil-line);
  border-radius: 0;
  background-color: var(--mil-screen);
  background-image: radial-gradient(var(--mil-rule) 1px, transparent 1px);
  background-size: 12px 12px;
  box-shadow: inset 2px 2px 0 var(--mil-screen-shade);
  gap: 38px;
  padding: 16px;
}
:root[data-ui-style="millennium"] .fl-svg path.on {
  stroke: var(--mil-on-side);
  stroke-width: 2.8px;
}
:root[data-ui-style="millennium"] .fl-svg path.live {
  stroke: var(--mil-hot);
  stroke-width: 2.8px;
}
:root[data-ui-style="millennium"] .pkt {
  fill: var(--mil-on);
  stroke: var(--mil-line);
}
:root[data-ui-style="millennium"] .pkt.hot {
  fill: var(--mil-hot);
}
:root[data-ui-style="millennium"] .fl-col-h {
  font-size: 11.5px;
  letter-spacing: 0.08em;
  color: var(--mil-print);
  padding: 4px 8px;
  border: 1.5px solid var(--mil-lo);
  background: var(--mil-panel);
}

.fl-svg, .fl-sky {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: visible;
  z-index: 1;
}
.fl-sky {
  z-index: 3;
}

.fl-svg path {
  fill: none;
  stroke: var(--mil-lo);
  stroke-width: 1.6px;
  stroke-dasharray: 4 4;
  opacity: 0.72;
}
.fl-svg path.on {
  stroke: var(--mil-accent);
  stroke-width: 2.2px;
  stroke-dasharray: none;
  opacity: 0.9;
}
.fl-svg path.live {
  stroke: var(--mil-live);
  stroke-width: 2.4px;
  stroke-dasharray: 6 5;
  opacity: 1;
  animation: fl-dash 0.8s linear infinite;
}
@keyframes fl-dash {
  to { stroke-dashoffset: -22; }
}

.pkt {
  fill: var(--mil-accent);
  stroke: var(--mil-panel);
  stroke-width: 1.5px;
}
.pkt.hot { fill: var(--mil-live); }
.pkt.warn { fill: var(--mil-warn); }
.pkt.held {
  animation: mil-pulse 1.1s ease-in-out infinite;
}

.fl-col {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-width: 0;
}

.fl-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10px;
  min-width: 0;
}

.fl-col-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  font-family: var(--mil-font-display);
  font-size: 12px;
  font-weight: 700;
  color: var(--mil-muted);
  padding: 2px 4px;
}
.fl-stage-arrow {
  color: var(--mil-lo);
  font-family: var(--mil-font-mono);
}

.fl-node {
  position: relative;
  width: 100%;
  text-align: left;
  padding: 12px 14px;
  border: 1px solid transparent;
  border-radius: 14px;
  background: var(--mil-panel);
  color: var(--mil-ink);
  box-shadow: 0 2px 8px rgba(17, 17, 20, 0.04);
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 5px;
  min-width: 0;
  transition: transform 120ms cubic-bezier(0.23, 1, 0.32, 1), box-shadow 120ms ease;
}
:root[data-ui-style="millennium"] .fl-node {
  border: 2px solid var(--mil-line);
  border-radius: 0;
  box-shadow: 0 3px 0 var(--mil-lo);
}
.fl-node[data-port-in="1"]::before,
.fl-node[data-port-out="1"]::after {
  content: "";
  position: absolute;
  top: 50%;
  width: 8px;
  height: 8px;
  margin-top: -4px;
  border-radius: 50%;
  border: 1.5px solid var(--mil-lo);
  background: var(--mil-panel);
  z-index: 4;
}
:root[data-ui-style="millennium"] .fl-node[data-port-in="1"]::before,
:root[data-ui-style="millennium"] .fl-node[data-port-out="1"]::after {
  width: 7px;
  height: 7px;
  margin-top: -3.5px;
  border-radius: 0;
  border-color: var(--mil-line);
  background: var(--mil-screen);
}
.fl-node[data-port-in="1"]::before { left: -5px; }
.fl-node[data-port-out="1"]::after { right: -5px; }
.fl-node.on[data-port-in="1"]::before,
.fl-node.on[data-port-out="1"]::after {
  background: var(--mil-accent);
  border-color: var(--mil-panel);
}
:root[data-ui-style="millennium"] .fl-node.on[data-port-in="1"]::before,
:root[data-ui-style="millennium"] .fl-node.on[data-port-out="1"]::after {
  background: var(--mil-on);
  border-color: var(--mil-on-side);
}
.fl-node.run[data-port-in="1"]::before,
.fl-node.run[data-port-out="1"]::after {
  background: var(--mil-live);
  border-color: var(--mil-panel);
}
:root[data-ui-style="millennium"] .fl-node.run[data-port-in="1"]::before,
:root[data-ui-style="millennium"] .fl-node.run[data-port-out="1"]::after {
  background: var(--mil-hot);
  border-color: var(--mil-hot-side);
}

.fl-node--static {
  cursor: default;
}

.fl-node.on {
  background: var(--mil-accent-soft);
  color: var(--mil-ink);
  border-color: var(--mil-accent);
  box-shadow: 0 0 0 1px var(--mil-accent-border);
}
:root[data-ui-style="millennium"] .fl-node.on {
  background: var(--mil-on);
  color: var(--mil-on-ink);
  border-color: var(--mil-on-side);
  box-shadow: 0 3px 0 var(--mil-on-side);
}

.fl-node.run {
  border-color: var(--mil-accent-border);
  box-shadow: inset 3px 0 0 var(--mil-accent), 0 2px 6px rgba(37, 99, 235, 0.08);
}
:root[data-ui-style="millennium"] .fl-node.run {
  border-color: var(--mil-hot-side);
  box-shadow: inset 4px 0 0 var(--mil-hot), 0 3px 0 var(--mil-lo);
}

.fl-node--gate {
  background: var(--mil-panel);
  box-shadow: inset 3px 0 0 var(--mil-ok), 0 1px 3px rgba(15, 23, 42, 0.04);
}
:root[data-ui-style="millennium"] .fl-node--gate {
  box-shadow: 0 3px 0 var(--mil-lo), inset 4px 0 0 var(--mil-on-side);
}
.fl-node--gate[data-port-in="1"]::before,
.fl-node--gate[data-port-out="1"]::after {
  background: var(--mil-ok);
  border-color: var(--mil-panel);
}
:root[data-ui-style="millennium"] .fl-node--gate[data-port-in="1"]::before,
:root[data-ui-style="millennium"] .fl-node--gate[data-port-out="1"]::after {
  background: var(--mil-on);
  border-color: var(--mil-on-side);
}

.fl-subband {
  margin-top: 6px;
  padding-top: 6px;
  border-top: 1px dashed var(--mil-rule);
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.fl-node-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  min-width: 0;
}

.fl-node-name {
  font-weight: 700;
  font-size: 13.5px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fl-node-sub {
  font-size: 12px;
  color: var(--mil-muted);
  overflow-wrap: anywhere;
}
.fl-node.on .fl-node-sub {
  color: var(--mil-ink-2);
}
:root[data-ui-style="millennium"] .fl-node.on .fl-node-sub {
  color: var(--mil-on-ink);
  opacity: 0.86;
}

/* 2. 当前动态条与遥测数字 */
.strip-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
  gap: 20px;
  align-items: stretch;
}
.strip-grid > .mil-panel {
  display: flex;
  flex-direction: column;
}

.strip-screen {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 12px;
  flex: 1;
}

.strip-main {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: flex-start;
  justify-content: space-between;
}

.strip-state {
  font-family: var(--mil-font-display);
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -0.01em;
  line-height: 1.2;
}

.strip-steps {
  margin: 0;
  padding-left: 18px;
  font-size: 12.5px;
  color: var(--mil-muted);
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.strip-steps li {
  overflow-wrap: anywhere;
}

.strip-leds {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  padding-top: 10px;
  border-top: 1px solid var(--mil-rule);
  font-size: 12.5px;
  color: var(--mil-ink-2);
}

.strip-led-item {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.kpi-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  flex: 1;
}

.kpi-cell {
  border: 0;
  border-radius: 18px;
  background: var(--mil-screen);
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 6px;
}
:root[data-ui-style="millennium"] .kpi-cell {
  background-color: var(--mil-screen);
  background-image: var(--mil-lcd-grid);
  background-size: 3px 3px;
  border: 2px solid var(--mil-line);
  border-radius: 0;
  box-shadow: var(--mil-sunk);
  padding: 12px 14px;
}

.kpi-val {
  font-family: var(--mil-font-display);
  font-size: 28px;
  font-weight: 800;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.kpi-lbl {
  font-size: 13px;
  color: var(--mil-muted);
  font-weight: 600;
}

/* 3. 上下文窗口 (方块 / 方格 + 趋势图) */
.ctx-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
  gap: 16px;
  align-items: start;
}

.ctx-board {
  position: relative;
  min-height: 226px;
  border: 0;
  border-radius: 18px;
  background: var(--mil-screen);
  padding: 4px;
  overflow: hidden;
}
:root[data-ui-style="millennium"] .ctx-board {
  border: 2px solid var(--mil-line);
  border-radius: 0;
  box-shadow: inset 2px 2px 0 var(--mil-screen-shade);
  padding: 0;
}

.ctx-map-stage {
  position: relative;
  width: 100%;
  height: 220px;
  overflow: hidden;
  border-radius: 12px;
  background: var(--ctx-free);
}
:root[data-ui-style="millennium"] .ctx-map-stage {
  border-radius: 0;
}

.cm-tile {
  position: absolute;
  border: 1.5px solid var(--mil-panel);
  border-radius: 6px;
  padding: 5px 7px;
  overflow: hidden;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  text-align: left;
  color: var(--ctx-tile-ink);
  font-size: 11.5px;
  line-height: 1.25;
  transition: opacity 150ms ease;
}
:root[data-ui-style="millennium"] .cm-tile {
  border: 1.5px solid var(--mil-line);
  border-radius: 0;
}
.cm-tile[data-cat="system"] { background: var(--ctx-system); }
.cm-tile[data-cat="memory"] { background: var(--ctx-memory); }
.cm-tile[data-cat="user"] { background: var(--ctx-user); }
.cm-tile[data-cat="assistant"] { background: var(--ctx-assistant); }
.cm-tile[data-cat="tool"] { background: var(--ctx-tool); }
.cm-tile[data-cat="free"] {
  background: var(--ctx-free);
  color: var(--mil-muted);
  cursor: default;
}
.cm-tile.dim { opacity: 0.28; }
.cm-tile b {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 11.5px;
  font-weight: 600;
}
.cm-tile span {
  font-family: var(--mil-font-mono);
  font-size: 10.5px;
  opacity: 0.85;
}

.cm-grid {
  display: grid;
  grid-template-columns: repeat(20, minmax(0, 1fr));
  gap: 2px;
  padding: 6px;
  border-radius: 9px;
  background: var(--mil-screen);
}
.cm-cell {
  aspect-ratio: 1;
  border: 0;
  border-radius: 2px;
  background: var(--ctx-free);
  cursor: pointer;
  padding: 0;
}
.cm-cell[data-cat="system"] { background: var(--ctx-system); }
.cm-cell[data-cat="memory"] { background: var(--ctx-memory); }
.cm-cell[data-cat="user"] { background: var(--ctx-user); }
.cm-cell[data-cat="assistant"] { background: var(--ctx-assistant); }
.cm-cell[data-cat="tool"] { background: var(--ctx-tool); }
.cm-cell[data-cat="free"] { cursor: default; }
.cm-cell.dim { opacity: 0.24; }

.cm-tip {
  position: fixed;
  z-index: 980;
  pointer-events: none;
  max-width: 280px;
  padding: 8px 10px;
  border: 1px solid var(--mil-line);
  border-radius: 10px;
  background: var(--mil-panel);
  color: var(--mil-ink);
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.14);
  font-size: 12.5px;
  overflow-wrap: anywhere;
}
.cm-tip[hidden] { display: none; }

.ctx-cats {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.ctx-swatch {
  display: inline-block;
  width: 9px;
  height: 9px;
  border-radius: 3px;
  border: 1px solid var(--mil-line);
}

:root[data-ui-style="millennium"] .cm-grid,
:root[data-ui-style="millennium"] .cm-cell,
:root[data-ui-style="millennium"] .cm-tip,
:root[data-ui-style="millennium"] .ctx-swatch {
  border-radius: 0;
}
:root[data-ui-style="millennium"] .cm-tip {
  border: 2px solid var(--mil-line);
  box-shadow: 0 4px 0 var(--mil-drop);
}

.ctx-items {
  display: flex;
  flex-direction: column;
  max-height: 180px;
  overflow-y: auto;
  border: 0;
  border-radius: 16px;
  background: var(--mil-screen);
}
:root[data-ui-style="millennium"] .ctx-items {
  border: 2px solid var(--mil-line);
  border-radius: 0;
  box-shadow: var(--mil-sunk);
}

.ci-row {
  width: 100%;
  border: 0;
  border-bottom: 1px solid var(--mil-rule);
  background: transparent;
  color: var(--mil-ink);
  padding: 8px 12px;
  cursor: pointer;
  text-align: left;
  display: grid;
  grid-template-columns: 10px minmax(0, 1fr) auto;
  gap: 8px;
  align-items: center;
}
:root[data-ui-style="millennium"] .ci-row {
  border-bottom: 2px dashed var(--mil-rule);
  padding: 7px 10px;
}
.ci-row:last-child { border-bottom: 0; }
.ci-row-name {
  font-size: 12.5px;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ci-row-bar {
  grid-column: 2 / 4;
  height: 4px;
  border-radius: 999px;
  background: var(--mil-well);
  overflow: hidden;
}
:root[data-ui-style="millennium"] .ci-row-bar,
:root[data-ui-style="millennium"] .ci-row-bar > i {
  border-radius: 0;
}
.ci-row-bar > i {
  display: block;
  height: 100%;
  border-radius: 999px;
  background: var(--mil-accent);
}
@media (hover: hover) and (pointer: fine) {
  .ci-row:hover {
    background: var(--mil-accent-soft);
  }
}

.scope-svg {
  width: 100%;
  height: 96px;
  display: block;
}

/* 4. 近期活动列表与活动现场检查器 */
.thread-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
  max-height: 580px;
  overflow-y: auto;
  padding: 0;
}
:root[data-ui-style="millennium"] .thread-list {
  gap: 0;
}

.thread-row {
  width: 100%;
  text-align: left;
  border: 0;
  border-radius: 14px;
  background: var(--mil-panel);
  color: var(--mil-ink);
  padding: 12px 14px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 0;
  transition: transform 120ms cubic-bezier(0.23, 1, 0.32, 1);
}
.thread-row.on {
  background: var(--mil-accent-soft);
  box-shadow: inset 3px 0 0 var(--mil-accent);
  color: var(--mil-ink);
}
:root[data-ui-style="millennium"] .thread-row {
  border-bottom: 2px dashed var(--mil-rule);
  border-radius: 0;
  background: transparent;
  padding: 11px 12px;
}
:root[data-ui-style="millennium"] .thread-row:last-child {
  border-bottom: 0;
}
:root[data-ui-style="millennium"] .thread-row.on {
  background: var(--mil-on);
  box-shadow: none;
  color: var(--mil-on-ink);
}
@media (hover: hover) and (pointer: fine) {
  .thread-row:not(.on):hover {
    background: var(--mil-key-hi);
  }
  :root[data-ui-style="millennium"] .thread-row:not(.on):hover {
    background: var(--mil-accent-soft);
  }
}

.thread-title {
  font-weight: 700;
  font-size: 13.5px;
  overflow-wrap: anywhere;
}
.thread-excerpt {
  font-size: 12.5px;
  line-height: 1.5;
  color: var(--mil-muted);
  overflow-wrap: anywhere;
}
.thread-row.on .thread-excerpt {
  color: var(--mil-ink-2);
}
:root[data-ui-style="millennium"] .thread-row.on .thread-excerpt {
  color: var(--mil-on-ink);
  opacity: 0.88;
}

.inspector-h2 {
  font-family: var(--mil-font-display);
  font-size: 19px;
  font-weight: 800;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.events-box {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: 360px;
  overflow-y: auto;
}

.ev-det {
  border: 0;
  border-radius: 14px;
  background: var(--mil-screen);
  padding: 10px 14px;
}
:root[data-ui-style="millennium"] .ev-det {
  border: 2px solid var(--mil-line);
  border-radius: 0;
}
.ev-det summary {
  cursor: pointer;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  font-size: 12.5px;
  font-weight: 600;
}
.ev-det pre {
  margin: 10px 0 4px;
  padding: 10px 12px;
  border: 0;
  border-radius: 10px;
  background: var(--mil-panel);
  font-family: var(--mil-font-mono);
  font-size: 12.5px;
  line-height: 1.55;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  max-height: 220px;
  overflow-y: auto;
}
:root[data-ui-style="millennium"] .ev-det pre {
  border: 1px dashed var(--mil-rule);
  border-radius: 0;
}

.launch-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

@media (max-width: 960px) {
  .flow-box {
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    padding: 14px;
  }
  .fl-svg, .fl-sky,
  .fl-node[data-port-in="1"]::before,
  .fl-node[data-port-out="1"]::after {
    display: none;
  }
  .strip-grid,
  .ctx-layout,
  .launch-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (prefers-reduced-motion: reduce) {
  .fl-svg path.live,
  .pkt.held {
    animation: none;
  }
  .fl-node,
  .cm-tile,
  .thread-row {
    transition: none;
  }
}

.ms-view {
  display: flex;
  flex-direction: column;
  gap: 22px;
}
:root[data-ui-style="millennium"] .ms-view {
  gap: 18px;
}
@media (max-width: 720px) {
  .ms-view {
    gap: 16px;
  }
}
.ms-view[hidden],
.mil-led-pill[hidden],
.mil-key[hidden],
.ms-mob-dock[hidden] {
  display: none;
}
</style>
</head>
<body data-page="{{PAGE_ID}}" data-default-page="{{PAGE_ID}}">
<div class="mil-shell">

  <!-- 顶部导航条 -->
  <header class="mil-topbar">
    <div class="mil-brand">
      <div class="ms-wordmark">
        <span class="mil-spectrum" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="mil-nameplate">MAISYA</span>
      </div>
      <h1 class="mil-page-title" id="ms-page-title">{{TITLE}}</h1>
      <nav class="mil-nav" aria-label="Maisya 工作区页面">
        <button type="button" class="mil-key mil-key--sm"{{NAV_NOW_CURRENT}} data-nav="now">现场</button>
        <button type="button" class="mil-key mil-key--sm"{{NAV_OUTPUTS_CURRENT}} data-nav="outputs">产物</button>
        <button type="button" class="mil-key mil-key--sm"{{NAV_ABILITIES_CURRENT}} data-nav="abilities">能力</button>
        <button type="button" class="mil-key mil-key--sm"{{NAV_MEMORY_CURRENT}} data-nav="memory">手账</button>
        <button type="button" class="mil-key mil-key--sm"{{NAV_SETTINGS_CURRENT}} data-nav="settings">设置</button>
      </nav>
    </div>
    <div class="mil-top-right">
      <button type="button" class="mil-key mil-key--sm" id="ui-style-toggle" aria-pressed="true" title="切换界面风格（千禧机械 / 默认主题）">千禧机械</button>
      <div class="mil-led-pill" id="top-led-pill"{{NOW_HIDDEN}}>
        <span class="mil-led" id="top-led"></span>
        <span id="top-state-text">待命</span>
      </div>
      <button type="button" class="mil-key" id="open-launch"{{NOW_HIDDEN}}>唤醒角色</button>
      <div class="mil-led-pill" id="mgmt-led-pill"{{MGMT_HIDDEN}}>
        <span class="mil-led" id="mgmt-led"></span>
        <span>管理台</span>
      </div>
    </div>
  </header>

  <div id="ms-mgmt-view-wrap" class="ms-view"{{MGMT_HIDDEN}}>
    <div class="mil-feedback" id="{{MGMT_FEEDBACK_ID}}" data-feedback-slot="mgmt" aria-live="polite"></div>
    <div id="ms-mgmt-view" class="ms-view">{{MGMT_DEFAULT_BODY}}</div>
  </div>

  <div id="ms-now-view" class="ms-view"{{NOW_HIDDEN}}>
<!-- ==NOW_BODY_START== -->

  <!-- 1. 处理流向 (FLOW：会话来源 → 脉搏闸门 → 角色 → 活动与产出) -->
  <section class="mil-panel" id="flow-panel" aria-label="处理流向">
    <div class="mil-head">
      <div class="mil-head-l">
        <span class="mil-silk"><span class="mil-silk-en">FLOW · </span>处理流向</span>
        <span class="mil-tag" id="flow-filter-hint" hidden></span>
        <button type="button" class="mil-help" data-help="由 MaiBot Planner 作为主脑调度各角色与原生工具，Pulse 仅负责回返唤醒与主动冒泡节奏；点左侧会话筛选全页，点角色预设唤醒对象，点右侧活动检视或引导" aria-label="查看处理流向说明" aria-expanded="false">?</button>
      </div>
      <div class="mil-head-r">
        <button type="button" class="mil-key mil-key--sm" id="flow-all-chats" aria-pressed="true">全部会话</button>
        <span class="mil-vent" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
      </div>
    </div>
    <div class="flow-box" id="flow">
      <svg class="fl-svg" aria-hidden="true"></svg>
      <div class="fl-col">
        <div class="fl-col-h"><span>01 会话来源 <span class="fl-stage-arrow">→</span></span><span class="num" id="fl-cnt-chat">0</span></div>
        <div class="fl-list" id="fl-chats"></div>
      </div>
      <div class="fl-col">
        <div class="fl-col-h"><span>02 主脑调度 <span class="fl-stage-arrow">→</span></span><span class="num" id="fl-cnt-gate">PLANNER</span></div>
        <div class="fl-list" id="fl-gate"></div>
      </div>
      <div class="fl-col">
        <div class="fl-col-h"><span>03 角色 <span class="fl-stage-arrow">→</span></span><span class="num" id="fl-cnt-prof">0</span></div>
        <div class="fl-list" id="fl-profiles"></div>
      </div>
      <div class="fl-col">
        <div class="fl-col-h"><span>04 活动与产出</span><span class="num" id="fl-cnt-th">0</span></div>
        <div class="fl-list" id="fl-threads"></div>
      </div>
    </div>
  </section>

  <!-- 2. 当前动态 + 实时读数 -->
  <section class="strip-grid" aria-label="实时状态与读数">
    <div class="mil-panel mil-panel--flat">
      <div class="mil-head">
        <div class="mil-head-l"><span class="mil-silk"><span class="mil-silk-en">STATUS · </span>当前动态</span></div>
        <div class="mil-head-r"><span class="mil-vent" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span></div>
      </div>
      <div class="mil-screen strip-screen">
        <div class="strip-main">
          <div>
            <div class="strip-state" id="now-headline">待命</div>
            <div class="mil-hint" id="now-subline">尚未选中活动线程</div>
          </div>
          <div class="mil-row" id="now-badges"></div>
        </div>
        <ol class="strip-steps" id="now-steps"></ol>
        <div class="strip-leds" id="now-leds"></div>
      </div>
    </div>

    <div class="mil-panel mil-panel--flat">
      <div class="mil-head">
        <div class="mil-head-l"><span class="mil-silk"><span class="mil-silk-en">TELEMETRY · </span>实时读数</span></div>
        <div class="mil-head-r"><span class="mil-vent" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span></div>
      </div>
      <div class="kpi-grid">
        <div class="kpi-cell"><span class="kpi-lbl">活动线程</span><span class="kpi-val" id="kpi-active">0</span></div>
        <div class="kpi-cell"><span class="kpi-lbl">24h 线程</span><span class="kpi-val" id="kpi-today">0</span></div>
        <div class="kpi-cell"><span class="kpi-lbl">结果交付</span><span class="kpi-val" id="kpi-deliv">0</span></div>
        <div class="kpi-cell"><span class="kpi-lbl">待唤醒意图</span><span class="kpi-val" id="kpi-intent">0</span></div>
      </div>
    </div>
  </section>

  <!-- 3. 上下文窗口 (方块 / 方格 + 趋势折线) -->
  <section class="mil-panel" id="ctx-panel" aria-label="上下文窗口">
    <div class="mil-head">
      <div class="mil-head-l">
        <span class="mil-silk"><span class="mil-silk-en">CONTEXT · </span>上下文窗口</span>
        <span class="mil-tag" id="ctx-health">未选线程</span>
        <button type="button" class="mil-help" id="ctx-help" data-help="支持方块面积与 400 格晶圆视图；点击任意区块或右侧条目可弹出脱敏原文阅读器" aria-label="查看上下文窗口说明" aria-expanded="false">?</button>
      </div>
      <div class="mil-head-r">
        <div class="mil-seg" role="group" aria-label="上下文视图模式">
          <button type="button" class="mil-key mil-key--sm" data-ctx-view="map" aria-pressed="true">方块</button>
          <button type="button" class="mil-key mil-key--sm" data-ctx-view="grid" aria-pressed="false">方格</button>
        </div>
        <span class="mil-vent" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
      </div>
    </div>

    <div class="mil-row" id="ctx-threads" style="margin-bottom:12px"></div>

    <div class="mil-screen" style="margin-bottom:14px">
      <div class="mil-row" style="justify-content:space-between;margin-bottom:8px">
        <strong class="num" id="ctx-readout">0 / 262.1K tokens (0%)</strong>
        <button type="button" class="mil-help" id="ctx-bar-help" data-help="按角色来源统计 Token 占比：55% 自动折叠旧工具输出，75% 触发结构化交班归档" aria-label="查看容量计量说明" aria-expanded="false">?</button>
      </div>
      <div class="mil-meter" id="ctx-meter"><i id="ctx-meter-bar"></i></div>
      <div class="ctx-cats" id="ctx-cats" style="margin-top:10px"></div>
    </div>

    <div class="ctx-layout">
      <div class="ctx-board" id="ctx-board">
        <div class="ctx-map-stage" id="ctx-map"></div>
        <div class="cm-grid" id="ctx-grid" hidden></div>
      </div>
      <div style="display:flex;flex-direction:column;gap:12px;min-width:0">
        <div class="mil-scope">
          <div class="mil-row" style="justify-content:space-between;margin-bottom:6px">
            <span class="mil-label" style="color:var(--mil-scope-ink)"><span class="mil-silk-en">TREND · </span>轮次上下文增长</span>
            <span class="num mil-hint" id="ctx-spark-label">—</span>
          </div>
          <svg class="scope-svg" id="ctx-spark" viewBox="0 0 320 96" preserveAspectRatio="none" aria-label="上下文历史趋势折线"></svg>
        </div>
        <div class="ctx-items" id="ctx-items"></div>
      </div>
    </div>
  </section>

  <!-- 4. 近期活动 + 活动现场详情与引导 -->
  <section class="mil-split" aria-label="近期活动与详情">
    <aside class="mil-panel mil-panel--soft" id="threads-panel">
      <div class="mil-head">
        <div class="mil-head-l"><span class="mil-silk"><span class="mil-silk-en">ACTIVITY · </span>近期活动</span></div>
        <div class="mil-head-r">
          <div class="mil-seg" id="th-filters" role="group" aria-label="线程状态筛选">
            <button type="button" class="mil-key mil-key--sm" data-th-filter="all" aria-pressed="true">全部</button>
            <button type="button" class="mil-key mil-key--sm" data-th-filter="active" aria-pressed="false">运行中</button>
            <button type="button" class="mil-key mil-key--sm" data-th-filter="delivered" aria-pressed="false">已交付</button>
            <button type="button" class="mil-key mil-key--sm" data-th-filter="error" aria-pressed="false">异常</button>
          </div>
          <span class="mil-vent" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
        </div>
      </div>
      <div class="thread-list" id="threads">
        <p class="mil-hint">正在读取线程记录…</p>
      </div>
    </aside>

    <div class="mil-panel mil-panel--flat" id="inspector-panel">
      <div class="mil-head">
        <div class="mil-head-l">
          <span class="mil-silk"><span class="mil-silk-en">LIVE · </span>活动现场</span>
          <span class="mil-tag" id="ins-state-tag">—</span>
        </div>
        <div class="mil-head-r" id="ins-meta-tags"></div>
      </div>

      <div class="mil-screen" style="margin-bottom:16px">
        <div class="mil-row" style="gap:12px;align-items:center;flex-wrap:nowrap">
          <span class="mil-fish mil-fish--well" id="ins-role-fish" style="width:44px;height:44px" hidden aria-hidden="true"></span>
          <div style="min-width:0;flex:1">
            <h2 class="inspector-h2" id="title">等待选择线程</h2>
            <div class="mil-hint" id="meta" style="margin-top:4px"></div>
          </div>
        </div>
        <pre class="mil-pre" id="result-box" style="margin-top:12px;max-height:220px" hidden></pre>
        <div class="mil-row" id="deliveries-row" style="margin-top:10px"></div>
      </div>

      <div class="mil-field" style="margin-bottom:16px">
        <div class="mil-row" style="justify-content:space-between">
          <span class="mil-label">步骤时间线</span>
          <button type="button" class="mil-help" data-help="记录执行过程与工具调用；超长结果可展开后分页阅读" aria-label="查看步骤时间线说明" aria-expanded="false">?</button>
        </div>
        <div class="events-box" id="events">
          <p class="mil-hint">选择一条线程后展示执行事件。</p>
        </div>
      </div>

      <div class="mil-screen" style="display:flex;flex-direction:column;gap:10px">
        <div class="mil-row" style="justify-content:space-between">
          <label class="mil-label" for="message">对当前活动搭句话 / 补充方向</label>
          <button type="button" class="mil-help" data-help="按线程独立暂存未发送草稿；支持 Ctrl/Cmd + Enter 快捷发送" aria-label="查看搭话说明" aria-expanded="false">?</button>
        </div>
        <textarea id="message" class="mil-textarea" rows="3" style="min-height:84px" placeholder="顺口补充想法或调整方向…"></textarea>
        <div class="mil-row" style="justify-content:space-between">
          <div class="mil-row" style="gap:6px">
            <label class="mil-switch">
              <input type="checkbox" id="steer">
              <span class="mil-switch-track"></span>
              <span class="mil-switch-txt">立即转向</span>
            </label>
            <button type="button" class="mil-help" data-help="开启后将中断当前后续步骤，优先切换到新方向" aria-label="查看立即转向说明" aria-expanded="false">?</button>
          </div>
          <div class="mil-row">
            <button type="button" class="mil-key mil-key--hot" id="send-note">引导</button>
            <button type="button" class="mil-key mil-key--danger" id="stop">停止线程</button>
          </div>
        </div>
        <div class="mil-feedback" id="feedback" data-feedback-slot="now" aria-live="polite"></div>
      </div>
    </div>
  </section>

  <!-- 5. 临时唤醒角色（默认收起，日常由对话与脉搏自主触发） -->
  <details class="mil-panel" id="launch-panel" aria-label="临时唤醒角色">
    <summary class="mil-head" style="cursor:pointer;list-style:none;margin-bottom:0;padding-bottom:0;border-bottom:0">
      <div class="mil-head-l">
        <span class="mil-silk"><span class="mil-silk-en">WAKE · </span>▸ 临时唤醒某个角色</span>
        <button type="button" class="mil-help" data-help="可选旁路入口：日常由对话与脉搏自主触发，管理员也可在此直接点名唤醒" aria-label="查看临时唤醒说明" aria-expanded="false">?</button>
      </div>
      <div class="mil-head-r"><span class="mil-vent" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span></div>
    </summary>
    <div style="margin-top:16px;padding-top:16px;border-top:1px solid var(--mil-rule)">
      <div class="mil-row" id="launch-profile-chips" style="margin-bottom:12px"></div>
      <div class="launch-grid" style="margin-bottom:12px">
        <div class="mil-field">
          <label class="mil-label" for="launch-profile">执行角色</label>
          <input id="launch-profile" class="mil-input mono" list="launch-profile-list" value="scout" placeholder="scout">
          <datalist id="launch-profile-list"></datalist>
        </div>
        <div class="mil-field">
          <div class="mil-row" style="gap:6px">
            <label class="mil-label" for="launch-chat">关联会话</label>
            <button type="button" class="mil-help" data-help="填写群/私聊 chat_id，或输入 self 发起自身探索活动" aria-label="查看关联会话说明" aria-expanded="false">?</button>
          </div>
          <input id="launch-chat" class="mil-input mono" list="launch-chat-list" placeholder="chat_id 或 self">
          <datalist id="launch-chat-list"></datalist>
        </div>
        <div class="mil-field">
          <label class="mil-label" for="launch-workspace">持久工作区（可选）</label>
          <input id="launch-workspace" class="mil-input mono" placeholder="digest_daily">
        </div>
      </div>
      <div class="mil-field" style="margin-bottom:12px">
        <label class="mil-label" for="launch-prompt">想推进或了解的事</label>
        <textarea id="launch-prompt" class="mil-textarea" rows="2" style="min-height:72px" placeholder="写下想关注或探索的事情…"></textarea>
      </div>
      <div class="mil-row" style="justify-content:space-between">
        <div class="mil-row" id="launch-chat-chips"></div>
        <button type="button" class="mil-key mil-key--hot" id="launch-run">立即唤醒</button>
      </div>
      <div class="mil-feedback" id="launch-feedback" style="margin-top:10px" aria-live="polite"></div>
    </div>
  </details>
<!-- ==NOW_BODY_END== -->
  </div>

  <nav id="ms-mob-dock" class="ms-mob-dock" aria-label="移动端导航"{{MGMT_HIDDEN}}>
    <button type="button" class="ms-mob-dock-btn"{{NAV_NOW_CURRENT}} data-mob-nav="now">
      <span class="ms-mob-dock-ic" data-dock-icon="cpu"></span>
      <span class="ms-mob-dock-lbl">现场</span>
    </button>
    <button type="button" class="ms-mob-dock-btn"{{NAV_OUTPUTS_CURRENT}} data-mob-nav="outputs">
      <span class="ms-mob-dock-ic" data-dock-icon="grid"></span>
      <span class="ms-mob-dock-lbl">产物</span>
    </button>
    <button type="button" class="ms-mob-dock-btn"{{NAV_ABILITIES_CURRENT}} data-mob-nav="abilities">
      <span class="ms-mob-dock-ic" data-dock-icon="plug"></span>
      <span class="ms-mob-dock-lbl">能力</span>
    </button>
    <button type="button" class="ms-mob-dock-btn"{{NAV_MEMORY_CURRENT}} data-mob-nav="memory">
      <span class="ms-mob-dock-ic" data-dock-icon="book"></span>
      <span class="ms-mob-dock-lbl">手账</span>
    </button>
    <button type="button" class="ms-mob-dock-btn"{{NAV_SETTINGS_CURRENT}} data-mob-nav="settings">
      <span class="ms-mob-dock-ic" data-dock-icon="sliders"></span>
      <span class="ms-mob-dock-lbl">设置</span>
    </button>
  </nav>

</div>

<!-- 悬浮提示、说明气泡 & 上下文条目原文阅读器 -->
<div class="cm-tip" id="cm-tip" hidden></div>
<div class="mil-help-pop" id="mil-help-pop" role="tooltip" hidden></div>

<div class="mil-scrim" id="ctx-scrim" hidden>
  <div class="mil-modal" role="dialog" aria-modal="true" aria-labelledby="ctx-modal-title">
    <div class="mil-head" style="margin-bottom:0">
      <div class="mil-head-l">
        <span class="mil-tag" id="ctx-modal-cat">—</span>
        <strong id="ctx-modal-title">上下文条目</strong>
      </div>
      <div class="mil-head-r">
        <span class="num mil-hint" id="ctx-modal-chars">0 字符</span>
        <button type="button" class="mil-key mil-key--sm" id="ctx-modal-close">关闭</button>
      </div>
    </div>
    <pre class="mil-pre" id="ctx-modal-body" style="max-height:56vh"></pre>
  </div>
</div>

<script>
{{ICONS_JS}}
</script>
<script>
(() => {
  if (typeof window.__maisyaDispose === "function") {
    try { window.__maisyaDispose(); } catch (_) {}
  }
  const shellAbort = new AbortController();
  const shellSig = shellAbort.signal;
  let disposed = false;
  const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" }[c]));
  const $ = (sel) => document.querySelector(sel);
  const $$ = (sel) => [...document.querySelectorAll(sel)];
  window.MaisyaIcons?.ensureDefs?.();
  {{FISH_JS}}

  const PAGES = { now: "现场", outputs: "产物", abilities: "能力", memory: "手账", settings: "设置" };
  const MGMT_FRAGMENTS = {{MGMT_FRAGMENTS_JSON}};
  const defaultPage = document.body.dataset.defaultPage || "now";
  let activePage = defaultPage;
  let mgmtAbort = null;
  let userNavigated = false;
  let bootStarted = false;

  function snapFishSeed(snap, roleId) {
    const cards = Array.isArray(snap?.profile_cards) ? snap.profile_cards : [];
    const hit = cards.find((c) => c && c.id === roleId);
    return String(hit?.fish_seed || "");
  }

  const CATS = {
    system: { name: "角色与技能", color: "var(--ctx-system)" },
    memory: { name: "手账备忘", color: "var(--ctx-memory)" },
    user: { name: "输入", color: "var(--ctx-user)" },
    assistant: { name: "推理结论", color: "var(--ctx-assistant)" },
    tool: { name: "工具调用", color: "var(--ctx-tool)" },
    free: { name: "剩余空间", color: "var(--ctx-free)" },
  };
  const STATE_LABEL = {
    active: ["运行中", "mil-tag--hot", "mil-led--run"],
    waiting: ["等待回复", "mil-tag--warn", "mil-led--run"],
    idle: ["待命", "mil-tag--ok", ""],
    closed: ["已结束", "", "mil-led--off"],
  };

  let state = {
    threadId: "",
    chatFilter: "",
    thFilter: "all",
    ctxView: "map",
    ctxCat: "all",
    cursor: 0,
    events: [],
    lastSnap: null,
  };
  const localDrafts = {};
  const rollNums = new WeakMap();
  let queryQueue = Promise.resolve();
  let actionQueue = Promise.resolve();
  let timer = null;
  window.__maisyaDispose = () => {
    disposed = true;
    if (timer) {
      clearInterval(timer);
      timer = null;
    }
    if (mgmtAbort) {
      mgmtAbort.abort();
      mgmtAbort = null;
    }
    shellAbort.abort();
  };
  let lastTriggerTarget = null;
  let lastSnapshotAt = 0;
  let pendingOutputTarget = null;

  // 读请求按单通道串行，读写合计严格 <= 2 个并发排队
  let activeQueue = 0;
  const waiters = [];
  async function acquire() {
    while (activeQueue >= 2) await new Promise((res) => waiters.push(res));
    activeQueue++;
  }
  function release() {
    activeQueue--;
    if (waiters.length) waiters.shift()();
  }
  async function withSlot(fn) {
    await acquire();
    try { return await fn(); }
    finally { release(); }
  }
  const RETRYABLE_RPC_RE = /429|进行中的\s*WebUI\s*请求|Two requests|Concurrency limit/i;
  async function callMaibotRaw(kind, name, arg) {
    for (let attempt = 0; attempt < 3; attempt++) {
      try {
        const res = kind === "query"
          ? await window.maibot.query(name, arg)
          : await window.maibot.action(name, arg);
        if (res && res.success === false && attempt < 2 && RETRYABLE_RPC_RE.test(String(res.error || ""))) {
          await new Promise((r) => setTimeout(r, attempt === 0 ? 350 : 700));
          continue;
        }
        return res || { success: false, error: "空响应" };
      } catch (err) {
        const msg = String(err?.message || err || "请求失败");
        if (attempt < 2 && RETRYABLE_RPC_RE.test(msg)) {
          await new Promise((r) => setTimeout(r, attempt === 0 ? 350 : 700));
          continue;
        }
        return { success: false, error: msg };
      }
    }
    return { success: false, error: "请求繁忙，请稍后重试" };
  }
  let queryInFlight = 0;
  const enqueueQuery = (fn) => {
    queryInFlight += 1;
    const p = queryQueue.then(() => withSlot(fn), () => withSlot(fn));
    queryQueue = p.catch(() => {});
    return p.finally(() => {
      queryInFlight = Math.max(0, queryInFlight - 1);
    });
  };
  const enqueueAction = (fn) => {
    const p = actionQueue.then(() => withSlot(fn), () => withSlot(fn));
    actionQueue = p.catch(() => {});
    return p;
  };
  async function hostRpc(op, key, body) {
    const run = async () => {
      if (disposed) return { success: false, aborted: true };
      const arg = op === "read"
        ? { section: key, payload: JSON.stringify(body || {}) }
        : { action: key, payload: JSON.stringify(body || {}) };
      const res = op === "read" ? await callMaibotRaw("query", "read", arg) : await callMaibotRaw("action", "write", arg);
      if (!disposed && res?.ui_style) {
        savedUiStyle = res.ui_style;
        applyTheme();
      }
      return res;
    };
    return op === "read" ? enqueueQuery(run) : enqueueAction(run);
  }
  function hostSay(text, isErr = false) {
    const fb = $('[data-feedback-slot="mgmt"]');
    if (!fb) return;
    fb.textContent = text || "";
    fb.className = `mil-feedback${!text ? "" : isErr ? " mil-feedback--err" : " mil-feedback--ok"}`;
    const led = $("#mgmt-led");
    if (led) led.className = `mil-led${isErr ? " mil-led--bad" : ""}`;
  }
  function setNowFeedback(text, cls = "mil-feedback") {
    const fb = $('[data-feedback-slot="now"]');
    if (!fb) return;
    fb.textContent = text || "";
    fb.className = cls;
  }
  function setDirty(flag) {
    const tag = $("#dirty-tag");
    if (tag) tag.hidden = !flag;
  }
  function versionHistory(history, current) {
    const sel = $("#history");
    if (!sel) return;
    const list = (history || []).slice().reverse();
    sel.innerHTML = list.map((h) => `<option value="${esc(h.version)}">v${esc(h.version)} · ${esc(h.source || "manual")}</option>`).join("");
    if (current !== undefined) sel.value = String(current);
  }
  function helpBtn(text, label = "查看说明") {
    return text ? `<button type="button" class="mil-help" data-help="${esc(text)}" aria-label="${esc(label)}" aria-expanded="false">?</button>` : "";
  }

  let savedUiStyle = "millennium";
  let manualUiStyle = "";
  let lastCtx = null;
  function effectiveUiStyle(hostStyle) {
    const pref = manualUiStyle || savedUiStyle || "millennium";
    if (pref === "auto") return hostStyle === "millennium" ? "millennium" : "maiwork";
    return pref === "maiwork" ? "maiwork" : "millennium";
  }
  function renderMobDockIcons() {
    const ic = window.MaisyaIcons;
    if (!ic) return;
    $$("#ms-mob-dock [data-dock-icon]").forEach((el) => {
      const key = el.dataset.dockIcon || "grid";
      el.innerHTML = ic.ctrl(key, 18, 1.9);
    });
  }
  function applyTheme(ctx) {
    if (disposed) return;
    if (ctx) lastCtx = ctx;
    const c = ctx || lastCtx || window.maibot?.context || {};
    const theme = c.theme === "dark" ? "dark" : "light";
    document.documentElement.className = theme === "dark" ? "dark" : "";
    const styleName = c.dashboardStyle || "millennium";
    document.documentElement.setAttribute("data-dashboard-style", styleName);
    const eff = effectiveUiStyle(styleName);
    document.documentElement.setAttribute("data-ui-style", eff);
    const btn = $("#ui-style-toggle");
    if (btn) {
      btn.textContent = eff === "millennium" ? "千禧机械" : "默认主题";
      btn.setAttribute("aria-pressed", String(eff === "millennium"));
    }
    renderMobDockIcons();
    window.dispatchEvent(new CustomEvent("maisya:themechange", { detail: { uiStyle: eff, dark: theme === "dark" } }));
  }
  applyTheme();
  window.addEventListener("maibot:context", (ev) => applyTheme(ev.detail), { signal: shellSig });
  $("#ui-style-toggle")?.addEventListener("click", () => {
    const cur = document.documentElement.getAttribute("data-ui-style") || "millennium";
    manualUiStyle = cur === "millennium" ? "maiwork" : "millennium";
    applyTheme();
    if (activePage === "now") drawFlowLines();
  });

  const calm = () => window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;

  function fmtTime(ts) {
    if (!ts) return "—";
    const d = new Date(Number(ts) * 1000);
    if (Number.isNaN(d.getTime())) return "—";
    return d.toLocaleTimeString("zh-CN", { hour12: false, hour: "2-digit", minute: "2-digit", second: "2-digit" });
  }
  function fmtK(n) {
    const v = Number(n || 0);
    return v >= 1000 ? `${(v / 1000).toFixed(1)}K` : String(v);
  }

  // Aisya roll() 数字平滑跳变（respects reduced-motion）
  function roll(el, target, format = (v) => String(Math.round(v))) {
    if (!el) return;
    const to = Number(target || 0);
    const from = rollNums.get(el) ?? to;
    rollNums.set(el, to);
    if (calm() || from === to) {
      el.textContent = format(to);
      return;
    }
    const t0 = performance.now();
    const dur = 240;
    const step = (now) => {
      const k = Math.min(1, (now - t0) / dur);
      const eased = 1 - Math.pow(1 - k, 3);
      el.textContent = format(from + (to - from) * eased);
      if (k < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  /* ───────────── 流向图 SVG 连线与信号脉冲（移植 Aisya flight.js） ───────────── */

  let activeTrips = [];
  let flightRaf = 0;

  function drawFlowLines() {
    if (activePage !== "now") return;
    const box = $("#flow");
    const svg = box?.querySelector(":scope > .fl-svg");
    if (!box || !svg) return;
    if (window.innerWidth <= 960) {
      svg.innerHTML = "";
      return;
    }
    const br = box.getBoundingClientRect();
    svg.setAttribute("viewBox", `0 0 ${br.width} ${br.height}`);
    const cols = [...box.querySelectorAll(".fl-col")];
    if (cols.length < 4) return;
    const paths = [];
    const anchor = (el, side) => {
      const r = el.getBoundingClientRect();
      return {
        x: (side === "R" ? r.right + 4 : r.left - 6) - br.left,
        y: r.top + r.height / 2 - br.top,
      };
    };
    const curve = (a, b, key, cls) => {
      const dx = Math.max(26, (b.x - a.x) * 0.5);
      const marker = cls.includes("live") ? "url(#fl-arr-run)" : cls.includes("on") ? "url(#fl-arr-on)" : "url(#fl-arr-idle)";
      paths.push(`<path data-k="${esc(key)}" class="${cls}" marker-end="${marker}" d="M${a.x.toFixed(1)},${a.y.toFixed(1)} C${(a.x + dx).toFixed(1)},${a.y.toFixed(1)} ${(b.x - dx).toFixed(1)},${b.y.toFixed(1)} ${b.x.toFixed(1)},${b.y.toFixed(1)}"/>`);
    };
    const chats = [...box.querySelectorAll("#fl-chats .fl-node")];
    const gate = box.querySelector("#fl-gate .fl-node");
    const profs = [...box.querySelectorAll("#fl-profiles .fl-node")];
    const ths = [...box.querySelectorAll("#fl-threads .fl-node")];
    if (gate) {
      const gl = anchor(gate, "L");
      const gr = anchor(gate, "R");
      chats.forEach((c, i) => {
        const cls = [c.classList.contains("on") ? "on" : "", c.classList.contains("run") ? "live" : ""].filter(Boolean).join(" ");
        curve(anchor(c, "R"), gl, `cg-${i}`, cls);
      });
      profs.forEach((p, i) => {
        const cls = [p.classList.contains("on") ? "on" : "", p.classList.contains("run") ? "live" : ""].filter(Boolean).join(" ");
        curve(gr, anchor(p, "L"), `gp-${i}`, cls);
      });
    }
    if (profs.length && ths.length) {
      ths.forEach((t, ti) => {
        const pid = t.dataset.prof;
        const match = profs.find((p) => p.dataset.flowProfile === pid) || profs[0];
        if (match) {
          const cls = [t.classList.contains("on") ? "on" : "", t.classList.contains("run") ? "live" : ""].filter(Boolean).join(" ");
          curve(anchor(match, "R"), anchor(t, "L"), `pt-${ti}`, cls);
        }
      });
    }
    const defs = `<defs>
      <marker id="fl-arr-idle" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,1 L7,4 L0,7 Z" fill="var(--mil-lo)" stroke="none"/></marker>
      <marker id="fl-arr-on" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6.5" markerHeight="6.5" orient="auto"><path d="M0,1 L7,4 L0,7 Z" fill="var(--mil-accent)" stroke="none"/></marker>
      <marker id="fl-arr-run" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6.5" markerHeight="6.5" orient="auto"><path d="M0,1 L7,4 L0,7 Z" fill="var(--mil-live)" stroke="none"/></marker>
    </defs>`;
    svg.innerHTML = defs + paths.join("");
  }

  function emitFlightPackets() {
    if (activePage !== "now" || calm() || document.hidden || window.innerWidth <= 960) return;
    const box = $("#flow");
    if (!box) return;
    const wires = [...box.querySelectorAll(".fl-svg path.on")];
    if (!wires.length) return;
    let sky = box.querySelector(":scope > .fl-sky");
    if (!sky) {
      sky = document.createElementNS("http://www.w3.org/2000/svg", "svg");
      sky.setAttribute("class", "fl-sky");
      sky.setAttribute("aria-hidden", "true");
      box.append(sky);
    }
    const r = box.getBoundingClientRect();
    sky.setAttribute("viewBox", `0 0 ${r.width} ${r.height}`);
    wires.slice(0, 3).forEach((w) => {
      const rect = document.createElementNS("http://www.w3.org/2000/svg", "rect");
      rect.setAttribute("width", "7");
      rect.setAttribute("height", "7");
      rect.setAttribute("rx", "3.5");
      rect.setAttribute("class", "pkt");
      sky.append(rect);
      activeTrips.push({ el: rect, key: w.dataset.k, t0: performance.now(), ms: 720 });
    });
    if (!flightRaf) flightRaf = requestAnimationFrame(tickFlight);
  }

  function tickFlight(now) {
    flightRaf = 0;
    const box = $("#flow");
    activeTrips = activeTrips.filter((tr) => {
      const p = box?.querySelector(`.fl-svg path[data-k="${CSS.escape(tr.key)}"]`);
      const k = Math.min(1, (now - tr.t0) / tr.ms);
      if (!p || !tr.el.isConnected || k >= 1) {
        tr.el.remove();
        return false;
      }
      const pt = p.getPointAtLength(p.getTotalLength() * k);
      tr.el.setAttribute("x", (pt.x - 3.5).toFixed(1));
      tr.el.setAttribute("y", (pt.y - 3.5).toFixed(1));
      return true;
    });
    if (activeTrips.length) flightRaf = requestAnimationFrame(tickFlight);
  }

  function canonChatKey(snap, cid) {
    if (!cid) return "";
    if (cid === "self") return "self";
    const src = snap?.chat_sources?.[cid];
    if (src?.stream_spec) return src.stream_spec;
    return cid;
  }

  function sameChat(snap, a, b) {
    if (!a || !b) return false;
    if (a === b) return true;
    return canonChatKey(snap, a) === canonChatKey(snap, b);
  }

  function chatMeta(snap, cid) {
    const allSrcs = snap?.chat_sources || {};
    let src = allSrcs[cid] || {};
    if (!src.name && cid && cid !== "self") {
      const hit = Object.values(allSrcs).find((s) => s && (s.stream_spec === cid || s.chat_id === cid));
      if (hit) src = hit;
    }
    const spec = src.stream_spec || (cid !== "self" && /^[a-z0-9_-]+:(group|private):/i.test(cid) ? cid : "");
    const name = src.name || (cid === "self" ? "自身活动" : cid);
    const plat = src.platform || (cid === "self" ? "self" : "");
    const typeLabel = src.chat_type === "group" ? "群" : src.chat_type === "private" ? "私" : "";
    const rawAv = String(src.avatar || "");
    const safeAv = /^data:image\//i.test(rawAv) && !/["'()\s]/.test(rawAv) ? rawAv : "";
    const mono = (name || cid || "?").trim().slice(0, 1).toUpperCase();
    return { name, spec, plat, typeLabel, safeAv, mono };
  }
  function avatarHtml(meta, small = false) {
    return `<span class="mil-avatar${small ? " mil-avatar--sm" : ""}" aria-hidden="true">${esc(meta.mono)}${meta.safeAv ? `<span class="mil-avatar-img" style="background-image:url('${esc(meta.safeAv)}')"></span>` : ""}</span>`;
  }

  function renderFlow(snap) {
    const threads = snap.threads || [];
    const pulse = snap.pulse || {};
    const cards = snap.profile_cards?.length
      ? snap.profile_cards
      : (snap.profiles || []).map((id) => ({ id, title: id, environment: "readonly", autonomous: true }));
    const dedupMap = new Map();
    const pushChat = (rawCid) => {
      if (!rawCid) return;
      const k = canonChatKey(snap, rawCid);
      const pref = rawCid === "self" ? "self" : (canonChatKey(snap, rawCid) || rawCid);
      if (!dedupMap.has(k) || (rawCid.includes(":") && !dedupMap.get(k).includes(":"))) {
        dedupMap.set(k, pref);
      }
    };
    (snap.enabled_chats || []).forEach(pushChat);
    threads.forEach((t) => { if (t.chat_id) pushChat(t.chat_id); });
    const chats = [...dedupMap.values()].slice(0, 8);
    $("#fl-cnt-chat").textContent = String(chats.length);
    $("#flow-all-chats").setAttribute("aria-pressed", String(!state.chatFilter));
    const filterHint = $("#flow-filter-hint");
    const filterMeta = state.chatFilter ? chatMeta(snap, state.chatFilter) : null;
    const filterLabel = filterMeta?.name || "";
    if (state.chatFilter) {
      filterHint.hidden = false;
      const specSuffix = filterMeta?.spec || state.chatFilter;
      filterHint.textContent = filterLabel === specSuffix
        ? `筛选：${specSuffix}`
        : `筛选：${filterLabel} · ${specSuffix}`;
    } else {
      filterHint.hidden = true;
      filterHint.textContent = "";
    }

    const selThread = threads.find((t) => t.thread_id === state.threadId) || snap.selected || null;
    const selChat = state.chatFilter || selThread?.chat_id || "";
    const selProf = selThread?.profile || "";

    $("#fl-chats").innerHTML = chats.length
      ? chats.map((cid) => {
          const activeHere = threads.some((t) => sameChat(snap, t.chat_id, cid) && (t.state === "active" || t.state === "waiting"));
          const on = sameChat(snap, selChat, cid);
          const m = chatMeta(snap, cid);
          const cnt = threads.filter((t) => sameChat(snap, t.chat_id, cid)).length;
          const sub = [m.plat ? m.plat.toUpperCase() : "", m.typeLabel, `${cnt} 条活动`].filter(Boolean).join(" · ");
          const dispCode = m.spec || cid;
          return `<button type="button" class="fl-node${on ? " on" : ""}${activeHere ? " run" : ""}" data-port-out="1" data-flow-chat="${esc(cid)}" title="${esc(m.name)} (${esc(dispCode)})">
            <span class="fl-node-top">
              <span class="mil-row" style="gap:7px;min-width:0;flex:1;flex-wrap:nowrap">${avatarHtml(m)}<span class="fl-node-name">${esc(m.name)}</span></span>
              <span class="mil-led ${activeHere ? "mil-led--run" : ""}"></span>
            </span>
            <span class="fl-node-sub">${esc(sub)}${m.name !== dispCode ? ` · <span class="mono">${esc(dispCode)}</span>` : ""}</span>
          </button>`;
        }).join("")
      : `<div class="fl-node fl-node--static" data-port-out="1"><span class="fl-node-name">暂无已启用会话</span><span class="fl-node-sub">前往设置添加群或私聊</span></div>`;

    const levelLabelMap = { quiet: "安静", care: "平衡", lively: "活跃" };
    const levelText = levelLabelMap[pulse.proactive_level] || "平衡";
    const dailyPct = pulse.daily_limit ? Math.min(100, Math.round(((pulse.daily_used || 0) / pulse.daily_limit) * 100)) : 0;
    const pendingIntents = snap.stats?.pending_intents ?? (snap.scheduled_intents || []).length;
    const routeTag = pulse.web_provider && pulse.web_provider !== "auto" ? pulse.web_provider : "自动路由";
    $("#fl-gate").innerHTML = `<div class="fl-node fl-node--static fl-node--gate" data-port-in="1" data-port-out="1">
      <span class="fl-node-top"><span class="fl-node-name">MaiBot Planner</span><span class="mil-tag ${pulse.enabled !== false && !pulse.in_sleep ? "mil-tag--ok" : ""}">${pulse.in_sleep ? "休眠" : pulse.enabled !== false ? "调度中" : "停用"}</span></span>
      <span class="fl-node-sub">主脑调度 · 原生开口与工具编排</span>
      <span class="fl-node-sub mono">maisya_agent · 联网 ${esc(routeTag)}</span>
      <div class="fl-subband">
        <span class="fl-node-sub">Pulse (${esc(levelText)}) 主动 ${pulse.daily_used || 0} / ${pulse.daily_limit ?? 1} · 待唤醒 ${pendingIntents}</span>
        <div class="mil-meter" style="margin-top:2px"><i style="width:${dailyPct}%"></i></div>
      </div>
    </div>`;

    const orderedCards = [...cards].sort((a, b) => Number(b.enabled !== false) - Number(a.enabled !== false));
    $("#fl-cnt-prof").textContent = String(cards.filter((p) => p.enabled !== false).length);
    $("#fl-profiles").innerHTML = orderedCards.slice(0, 6).map((p) => {
      const running = threads.some((t) => t.profile === p.id && (t.state === "active" || t.state === "waiting"));
      const selectedMatch = selProf === p.id;
      const isOff = p.enabled === false;
      const cls = isOff ? "mil-fish--off" : "";
      const fish = roleFishHtml(p.id, p.fish_seed || "", 26, running ? {} : { still: true }, cls);
      const chain = Array.isArray(p.model_list) && p.model_list.length ? p.model_list : (p.model_name ? [p.model_name] : []);
      const modelLabel = chain.length ? (chain.length > 1 ? `${chain[0]} +${chain.length - 1}` : chain[0]) : (p.task || "utils");
      return `<button type="button" class="fl-node${selectedMatch ? " on" : ""}${running ? " run" : ""}" style="${isOff ? "opacity:0.65" : ""}" data-port-in="1" data-port-out="1" data-flow-profile="${esc(p.id)}">
        <span class="fl-node-top"><span class="mil-row" style="gap:6px;min-width:0;flex:1;flex-wrap:nowrap">${fish}<span class="fl-node-name">${esc(p.title || p.id)}</span></span><span class="mil-tag ${isOff ? "mil-tag--off" : ""}">${esc(isOff ? "已停用" : (p.environment === "sandbox" ? "沙箱" : "只读"))}</span></span>
        <span class="fl-node-sub mono">${esc(p.id)} · ${esc(modelLabel)}${isOff ? " · 停用" : p.autonomous ? "" : " · 需授权"}</span>
      </button>`;
    }).join("");

    const shownThreads = threads.slice(0, 5);
    $("#fl-cnt-th").textContent = String(threads.length);
    $("#fl-threads").innerHTML = shownThreads.length
      ? shownThreads.map((t) => {
          const st = STATE_LABEL[t.state] || ["未知", "", ""];
          const on = t.thread_id === state.threadId;
          return `<button type="button" class="fl-node${on ? " on" : ""}${t.state === "active" || t.state === "waiting" ? " run" : ""}" data-port-in="1" data-flow-thread="${esc(t.thread_id)}" data-prof="${esc(t.profile)}">
            <span class="fl-node-top"><span class="fl-node-name">${esc(t.title)}</span><span class="mil-led ${st[2]}"></span></span>
            <span class="fl-node-sub">${esc(t.profile)} · ${t.delivered ? "已交付" : st[0]}</span>
          </button>`;
        }).join("")
      : `<div class="fl-node fl-node--static" data-port-in="1"><span class="fl-node-name">暂无线程</span><span class="fl-node-sub">下方可随时发起</span></div>`;

    requestAnimationFrame(() => {
      drawFlowLines();
      if (threads.some((t) => t.state === "active" || t.state === "waiting")) emitFlightPackets();
    });
  }

  /* ───────────── 2. 当前动态条与计数器 ───────────── */

  const EVENT_KIND_LABELS = {
    opened: "发起活动",
    started: "开始处理",
    step: "推理推进",
    tools: "调用工具",
    tool_call: "调用工具",
    tool_result: "工具返回",
    input: "任务输入",
    question: "等待确认",
    redirect: "转向调整",
    note: "补充引导",
    steered: "立即转向",
    completed: "执行完成",
    delivered: "结果交付",
    waiting: "等待回复",
    stopped: "已停止",
    failed: "执行异常",
    error: "执行异常",
    model_fallback: "模型回退",
  };
  const ORIGIN_LABELS = {
    user: "对话触发",
    console: "现场唤醒",
    schedule: "定时触发",
    routine: "周期例行",
    heartbeat: "自主探索",
    webhook: "外部推送",
    intent: "主动意图",
  };

  function formatChatInline(snap, cid) {
    if (!cid || cid === "self") return "自身活动";
    const m = chatMeta(snap, cid);
    const code = m.spec || cid;
    return m.name && m.name !== code ? `${m.name} · ${code}` : code;
  }

  function friendlyEventBrief(snap, e) {
    const raw = String(e?.text || "").trim();
    if (raw.startsWith("{") && raw.endsWith("}")) {
      try {
        const j = JSON.parse(raw);
        if (j && typeof j === "object") {
          const parts = [];
          if (j.origin) parts.push(ORIGIN_LABELS[j.origin] || String(j.origin));
          if (j.owner) {
            parts.push(j.owner === "self" ? "自身记录" : j.owner === "chat" ? "会话线程" : formatChatInline(snap, j.owner));
          }
          const summary = j.summary || j.message || j.reason || j.text;
          if (summary) parts.push(String(summary).replace(/\s+/g, " ").slice(0, 72));
          if (parts.length) return parts.join(" · ");
        }
      } catch {}
    }
    return raw.replace(/\s+/g, " ").slice(0, 90);
  }

  function renderStrip(snap) {
    const sel = snap.selected;
    const threads = snap.threads || [];
    const activeThreads = threads.filter((t) => t.state === "active" || t.state === "waiting");
    const hasErr = Boolean(sel?.result?.error) || (snap.stats?.error_count || 0) > 0;
    const pulse = snap.pulse || {};

    const topLed = $("#top-led");
    const topTxt = $("#top-state-text");
    if (activeThreads.length) {
      topLed.className = "mil-led mil-led--run";
      topTxt.textContent = `${activeThreads.length} 个线程处理中`;
    } else if (pulse.enabled === false) {
      topLed.className = "mil-led mil-led--off";
      topTxt.textContent = "插件未启用";
    } else {
      topLed.className = "mil-led";
      topTxt.textContent = "系统在线";
    }

    if (activeThreads.length) {
      $("#now-headline").textContent = `${activeThreads.length} 个线程正在推进`;
      $("#now-subline").textContent = `${activeThreads[0].title}（${activeThreads[0].profile} · ${formatChatInline(snap, activeThreads[0].chat_id)}）`;
    } else if (sel) {
      const st = STATE_LABEL[sel.state] || ["就绪", "", ""];
      $("#now-headline").textContent = sel.result?.error ? "线程出错" : `最近：${st[0]}`;
      $("#now-subline").textContent = `${threads.find((t) => t.thread_id === sel.thread_id)?.title || sel.thread_id} · ${sel.profile} · ${formatChatInline(snap, sel.chat_id)}`;
    } else {
      $("#now-headline").textContent = "待命";
      $("#now-subline").textContent = "等待群聊触发或由管理员直接发起工作流";
    }

    const badges = [];
    if (sel?.model) badges.push(`<span class="mil-tag">模型 ${esc(sel.model)}</span>`);
    if (sel?.workspace) badges.push(`<span class="mil-tag mil-tag--warn">工作区 ${esc(sel.workspace)}</span>`);
    if (sel?.revision) badges.push(`<span class="mil-tag">第 ${sel.revision} 轮</span>`);
    $("#now-badges").innerHTML = badges.join("");

    const evs = state.events.slice(-3);
    $("#now-steps").innerHTML = evs.length
      ? evs.map((e) => `<li><span class="mil-tag">${esc(EVENT_KIND_LABELS[e.kind] || e.kind)}</span> ${esc(friendlyEventBrief(snap, e))}</li>`).join("")
      : `<li>暂无最新步骤日志</li>`;

    $("#now-leds").innerHTML = `
      <span class="strip-led-item"><span class="mil-led ${pulse.enabled === false ? "mil-led--off" : ""}"></span>插件${pulse.enabled === false ? "未启用" : "已就绪"}</span>
      <span class="strip-led-item"><span class="mil-led ${pulse.in_sleep ? "mil-led--off" : "mil-led"}"></span>${pulse.in_sleep ? "睡眠静默中" : `心跳 ${pulse.heartbeat_interval_minutes || 60}m`}</span>
      <span class="strip-led-item"><span class="mil-led ${hasErr ? "mil-led--bad" : ""}"></span>${hasErr ? "含异常线程" : "链路正常"}</span>
    `;

    const stats = snap.stats || {};
    roll($("#kpi-active"), stats.active_count ?? activeThreads.length);
    roll($("#kpi-today"), stats.today_threads ?? threads.length);
    roll($("#kpi-deliv"), stats.today_deliveries ?? 0);
    roll($("#kpi-intent"), stats.pending_intents ?? (snap.scheduled_intents || []).length);
  }

  /* ───────────── 3. 上下文窗口：正方化树图 & 400格晶圆（移植 Aisya ctxmap.js） ───────────── */

  function squarify(items, x, y, w, h) {
    if (!items.length || w <= 0 || h <= 0) return [];
    const total = items.reduce((s, d) => s + d.value, 0);
    if (total <= 0) return [];
    const scaled = items.map((d) => ({ ...d, area: (d.value / total) * w * h }));
    const out = [];
    const worst = (row, side) => {
      if (!row.length || side <= 0) return Infinity;
      const sum = row.reduce((s, d) => s + d.area, 0);
      const s2 = sum * sum;
      const side2 = side * side;
      let maxA = 0, minA = Infinity;
      for (const d of row) { if (d.area > maxA) maxA = d.area; if (d.area < minA) minA = d.area; }
      return Math.max((side2 * maxA) / s2, s2 / (side2 * minA));
    };
    const lay = (row, rx, ry, rw, rh) => {
      const sum = row.reduce((s, d) => s + d.area, 0);
      if (rw >= rh) {
        const cw = rh > 0 ? sum / rh : 0;
        let cy = ry;
        for (const d of row) {
          const ch = cw > 0 ? d.area / cw : 0;
          out.push({ item: d, x: rx, y: cy, w: cw, h: ch });
          cy += ch;
        }
        return { x: rx + cw, y: ry, w: Math.max(0, rw - cw), h: rh };
      }
      const ch = rw > 0 ? sum / rw : 0;
      let cx = rx;
      for (const d of row) {
        const cw = ch > 0 ? d.area / ch : 0;
        out.push({ item: d, x: cx, y: ry, w: cw, h: ch });
        cx += cw;
      }
      return { x: rx, y: ry + ch, w: rw, h: Math.max(0, rh - ch) };
    };
    let rem = [...scaled];
    let row = [];
    let box = { x, y, w, h };
    while (rem.length) {
      const next = rem[0];
      const side = Math.min(box.w, box.h);
      if (!row.length || worst([...row, next], side) <= worst(row, side)) {
        row.push(next);
        rem.shift();
      } else {
        box = lay(row, box.x, box.y, box.w, box.h);
        row = [];
      }
    }
    if (row.length) lay(row, box.x, box.y, box.w, box.h);
    return out;
  }

  let currentCtxItems = [];
  function showCtxTip(ev, text) {
    const tip = $("#cm-tip");
    tip.textContent = text;
    tip.hidden = false;
    tip.style.left = Math.min(window.innerWidth - 290, ev.clientX + 12) + "px";
    tip.style.top = Math.min(window.innerHeight - 70, ev.clientY + 12) + "px";
  }
  function hideCtxTip() {
    $("#cm-tip").hidden = true;
  }

  function openCtxModal(item) {
    if (!item || item.cat === "free") return;
    lastTriggerTarget = document.activeElement;
    const cat = CATS[item.cat] || { name: item.cat };
    $("#ctx-modal-cat").textContent = cat.name;
    $("#ctx-modal-title").textContent = item.label || "上下文片段";
    $("#ctx-modal-chars").textContent = item.tokens != null ? `${item.tokens} tokens · ${item.chars || 0} 字符` : `${item.chars || 0} 字符`;
    $("#ctx-modal-body").textContent = item.preview || "（暂无可展示预览）";
    $("#ctx-scrim").hidden = false;
    $("#ctx-modal-close").focus();
  }
  function closeCtxModal() {
    $("#ctx-scrim").hidden = true;
    if (lastTriggerTarget && typeof lastTriggerTarget.focus === "function") {
      lastTriggerTarget.focus();
    }
  }

  function renderSparkline(points, limit) {
    const svg = $("#ctx-spark");
    const lbl = $("#ctx-spark-label");
    if (!svg) return;
    if (!points || !points.length) {
      svg.innerHTML = `<text x="12" y="52" fill="var(--mil-scope-ink)" font-size="12">暂无历史轮次轨迹</text>`;
      lbl.textContent = "—";
      return;
    }
    const valOf = (p) => Number(p.tokens ?? p.chars ?? 0);
    const maxV = Math.max(limit || 262144, ...points.map(valOf), 1);
    const W = 320, H = 96, pad = 10;
    const coords = points.map((p, idx) => {
      const x = points.length === 1 ? W / 2 : pad + (idx / (points.length - 1)) * (W - pad * 2);
      const y = H - pad - (valOf(p) / maxV) * (H - pad * 2);
      return [x, y, p];
    });
    const lineD = coords.map(([x, y], i) => `${i === 0 ? "M" : "L"}${x.toFixed(1)},${y.toFixed(1)}`).join(" ");
    const areaD = `${lineD} L${coords[coords.length - 1][0].toFixed(1)},${H - pad} L${coords[0][0].toFixed(1)},${H - pad} Z`;
    const dots = coords.map(([x, y]) => `<rect x="${(x - 2.5).toFixed(1)}" y="${(y - 2.5).toFixed(1)}" width="5" height="5" fill="#ffd84a" stroke="#181c18" stroke-width="1"/>`).join("");
    svg.innerHTML = `
      <line x1="0" y1="${H - pad}" x2="${W}" y2="${H - pad}" stroke="rgba(143,214,160,0.35)" stroke-width="1"/>
      <path d="${areaD}" fill="rgba(143,214,160,0.16)"/>
      <path d="${lineD}" fill="none" stroke="#8fd6a0" stroke-width="2.2" stroke-linecap="square" stroke-linejoin="miter"/>
      ${dots}
    `;
    const latest = points[points.length - 1];
    lbl.textContent = `${points.length} 轮 · 当前 ${fmtK(valOf(latest))}`;
  }

  function renderContext(snap) {
    const threads = snap.threads || [];
    $("#ctx-threads").innerHTML = threads.slice(0, 8).map((t) =>
      `<button type="button" class="mil-key mil-key--sm" data-ctx-thread="${esc(t.thread_id)}" aria-pressed="${String(t.thread_id === state.threadId)}">${esc(t.profile)} · ${esc(String(t.title || t.thread_id).slice(0, 14))}</button>`
    ).join("") || `<span class="mil-hint">暂无可选线程</span>`;

    const sel = snap.selected;
    const ctx = sel?.context;
    if (!sel || !ctx) {
      $("#ctx-readout").textContent = "0 / 262.1K tokens (0%)";
      $("#ctx-health").textContent = "未选线程";
      $("#ctx-health").className = "mil-tag";
      $("#ctx-meter").className = "mil-meter";
      $("#ctx-meter-bar").style.width = "0%";
      $("#ctx-cats").innerHTML = "";
      $("#ctx-map").innerHTML = `<p class="mil-hint" style="padding:16px">选择一条线程后展示上下文构成。</p>`;
      $("#ctx-grid").innerHTML = "";
      $("#ctx-items").innerHTML = `<p class="mil-hint" style="padding:10px">暂无上下文条目。</p>`;
      renderSparkline([], 262144);
      return;
    }

    const useTokens = Number(ctx.token_limit || 0) > 0;
    const unitLabel = useTokens ? "tokens" : "字符";
    const used = Number((useTokens ? ctx.tokens : ctx.chars) ?? ctx.chars ?? 0);
    const rawLimit = Number((useTokens ? ctx.token_limit : ctx.limit) ?? (useTokens ? 262144 : 48000));
    const limit = Math.max(rawLimit, used, 1);
    const pct = Math.min(100, Math.round((used / limit) * 100));
    const triggerHint = useTokens && Number(ctx.trigger_tokens || 0) > 0 ? ` · 压缩线 ${fmtK(ctx.trigger_tokens)}` : "";
    $("#ctx-readout").textContent = `已用 ${fmtK(used)} / ${fmtK(limit)} ${unitLabel} (${pct}%)${triggerHint} · ${ctx.messages || 0} 条消息`;
    $("#ctx-meter-bar").style.width = `${pct}%`;
    const nearTrigger = (useTokens && Number(ctx.trigger_tokens || 0) > 0 && used >= Number(ctx.trigger_tokens) * 0.9) || pct >= 70;
    const hotTrigger = (useTokens && Number(ctx.trigger_tokens || 0) > 0 && used >= Number(ctx.trigger_tokens)) || pct >= 88;
    $("#ctx-meter").className = `mil-meter${hotTrigger ? " mil-meter--hot" : nearTrigger ? " mil-meter--warn" : ""}`;
    const health = $("#ctx-health");
    if (ctx.archived) {
      health.textContent = "已交班归档";
      health.className = "mil-tag mil-tag--warn";
    } else if (ctx.pruned) {
      health.textContent = "已折叠旧工具输出";
      health.className = "mil-tag mil-tag--ok";
    } else if (hotTrigger || nearTrigger) {
      health.textContent = "接近压缩水位";
      health.className = "mil-tag mil-tag--hot";
    } else {
      health.textContent = "健康";
      health.className = "mil-tag mil-tag--ok";
    }

    const roles = (useTokens ? ctx.token_roles : ctx.roles) || ctx.roles || {};
    const catKeys = ["system", "memory", "user", "assistant", "tool"];
    const catTotals = Object.fromEntries(catKeys.map((k) => [k, Number(roles[k] || 0)]));
    $("#ctx-cats").innerHTML = [
      `<button type="button" class="mil-key mil-key--sm" data-ctx-cat="all" aria-pressed="${String(state.ctxCat === "all")}">全部 (${fmtK(used)})</button>`,
      ...catKeys.map((k) => {
        const meta = CATS[k];
        return `<button type="button" class="mil-key mil-key--sm" data-ctx-cat="${k}" aria-pressed="${String(state.ctxCat === k)}"><i class="ctx-swatch" style="background:${meta.color}"></i>${meta.name} ${fmtK(catTotals[k])}</button>`;
      }),
    ].join("");

    // 构造明细列表（如后端未提供 items 时用角色汇总补足）
    const metricOf = (x) => Number((useTokens ? x.tokens : x.chars) ?? x.chars ?? 0);
    let items = Array.isArray(ctx.items) && ctx.items.length
      ? ctx.items.map((x) => { const m = metricOf(x); return { ...x, metric: m, value: Math.max(1, m) }; })
      : [];
    if (!items.length) {
      items = catKeys
        .filter((k) => catTotals[k] > 0)
        .map((k) => ({ id: `role-${k}`, cat: k, label: CATS[k].name, chars: catTotals[k], tokens: catTotals[k], metric: catTotals[k], value: catTotals[k], preview: `${CATS[k].name}共占 ${catTotals[k]} ${unitLabel}。` }));
    }
    currentCtxItems = items;

    const free = Math.max(0, limit - used);
    const mapInputs = [...items];
    if (free > 0 && state.ctxCat === "all") {
      mapInputs.push({ id: "free-space", cat: "free", label: "剩余可用空间", chars: free, tokens: free, metric: free, value: free, preview: "" });
    }
    const stage = $("#ctx-map");
    const grid = $("#ctx-grid");
    stage.hidden = state.ctxView !== "map";
    grid.hidden = state.ctxView !== "grid";

    if (state.ctxView === "map") {
      const w = stage.clientWidth || 540;
      const h = stage.clientHeight || 220;
      const rects = squarify(mapInputs, 0, 0, w, h);
      stage.innerHTML = rects.map((r, idx) => {
        const dim = state.ctxCat !== "all" && r.item.cat !== state.ctxCat;
        const showTitle = r.w >= 54 && r.h >= 24;
        const mVal = Number(r.item.metric ?? r.item.chars ?? 0);
        return `<button type="button" class="cm-tile${dim ? " dim" : ""}" data-cat="${esc(r.item.cat)}" data-item-idx="${idx}" style="left:${r.x.toFixed(1)}px;top:${r.y.toFixed(1)}px;width:${r.w.toFixed(1)}px;height:${r.h.toFixed(1)}px" title="${esc(r.item.label)}: ${mVal} ${unitLabel}">${showTitle ? `<b>${esc(r.item.label)}</b><span>${fmtK(mVal)}</span>` : ""}</button>`;
      }).join("");
      stage._rectItems = rects.map((r) => r.item);
    } else {
      // 400 格晶圆分配
      const cells = [];
      const alloc = [];
      let totalCells = 0;
      mapInputs.forEach((it, idx) => {
        const count = it.cat === "free" ? 0 : Math.max(1, Math.round((it.value / limit) * 400));
        alloc.push({ it, idx, count });
        totalCells += count;
      });
      while (totalCells > 400) {
        const largest = alloc.reduce((a, b) => (b.count > a.count ? b : a));
        if (largest.count <= 1) break;
        largest.count--;
        totalCells--;
      }
      alloc.forEach(({ it, idx, count }) => {
        const mVal = Number(it.metric ?? it.chars ?? 0);
        for (let i = 0; i < count; i++) cells.push({ cat: it.cat, label: it.label, chars: mVal, idx });
      });
      while (cells.length < 400) cells.push({ cat: "free", label: "剩余空间", chars: free, idx: -1 });
      grid.innerHTML = cells.map((c) => {
        const dim = state.ctxCat !== "all" && c.cat !== state.ctxCat;
        return `<button type="button" class="cm-cell${dim ? " dim" : ""}" data-cat="${esc(c.cat)}" data-cell-idx="${c.idx}" aria-label="${esc(c.label)}"></button>`;
      }).join("");
      grid._mapInputs = mapInputs;
    }

    const filteredRows = items
      .filter((it) => state.ctxCat === "all" || it.cat === state.ctxCat)
      .sort((a, b) => Number(b.metric ?? b.chars ?? 0) - Number(a.metric ?? a.chars ?? 0));
    const maxItemVal = Math.max(1, ...filteredRows.map((x) => Number(x.metric ?? x.chars ?? 0)));
    $("#ctx-items").innerHTML = filteredRows.length
      ? filteredRows.map((it) => {
          const origIdx = currentCtxItems.indexOf(it);
          const rowVal = Number(it.metric ?? it.chars ?? 0);
          const pctW = Math.max(3, Math.round((rowVal / maxItemVal) * 100));
          return `<button type="button" class="ci-row" data-ci-idx="${origIdx}">
            <span class="ctx-swatch" style="background:${(CATS[it.cat] || CATS.free).color}"></span>
            <span class="ci-row-name">${esc(it.label)}</span>
            <span class="num" style="font-size:11.5px">${rowVal}</span>
            <span class="ci-row-bar"><i style="width:${pctW}%"></i></span>
          </button>`;
        }).join("")
      : `<p class="mil-hint" style="padding:10px">该分类下暂无上下文段落。</p>`;

    renderSparkline(ctx.history_points || [], limit);
  }

  /* ───────────── 4. 处理记录列表与线程详情工作台 ───────────── */

  function renderThreads(snap) {
    const all = snap.threads || [];
    const list = all.filter((t) => {
      if (state.thFilter === "active") return t.state === "active" || t.state === "waiting";
      if (state.thFilter === "delivered") return Boolean(t.delivered);
      if (state.thFilter === "error") return Boolean(t.has_error);
      return true;
    });
    const host = $("#threads");
    if (!list.length) {
      const hasFilter = Boolean(state.chatFilter || state.thFilter !== "all");
      host._lastHtml = "";
      host.innerHTML = `<div style="padding:10px">
        <p class="mil-hint">${all.length || hasFilter ? "当前筛选下暂无线程。" : "还没有任何线程记录，可在下方发起第一个工作流。"}</p>
        ${hasFilter ? `<button type="button" class="mil-key mil-key--sm" id="clear-th-filters" style="margin-top:8px">清除筛选</button>` : ""}
      </div>`;
      return;
    }
    const threadsHtml = list.map((t) => {
      const st = STATE_LABEL[t.state] || ["未知", "", ""];
      const on = t.thread_id === state.threadId;
      const cm = chatMeta(snap, t.chat_id);
      const chatDisp = cm.name && cm.name !== (cm.spec || t.chat_id) ? `${cm.name} (${cm.spec || t.chat_id})` : (cm.spec || t.chat_id);
      return `<button type="button" class="thread-row${on ? " on" : ""}" data-thread="${esc(t.thread_id)}">
        <div class="mil-row" style="justify-content:space-between;gap:6px">
          <div class="mil-row" style="gap:6px;min-width:0">
            <span class="mil-led ${t.has_error ? "mil-led--bad" : st[2]}"></span>
            <span class="thread-title">${esc(t.title || t.thread_id)}</span>
          </div>
          <span class="mil-tag ${st[1]}">${st[0]}</span>
        </div>
        ${t.excerpt ? `<div class="thread-excerpt">${esc(t.excerpt)}</div>` : ""}
        <div class="mil-row" style="justify-content:space-between;font-size:11px">
          <span class="mil-row mono" style="gap:5px">${roleFishHtml(t.profile, snapFishSeed(snap, t.profile), 18, (t.state === "active" || t.state === "waiting") ? {} : { still: true })}<span>${esc(t.profile)} · ${esc(chatDisp)}${t.workspace ? ` · 空间:${esc(t.workspace)}` : ""}</span></span>
          <span class="num">${t.delivered ? "已交付 · " : ""}${fmtTime(t.updated)}</span>
        </div>
      </button>`;
    }).join("");
    if (host._lastHtml !== threadsHtml) {
      host._lastHtml = threadsHtml;
      host.innerHTML = threadsHtml;
    }
  }

  function renderInspector(snap) {
    const sel = snap.selected;
    const stopBtn = $("#stop");
    const insFish = $("#ins-role-fish");
    if (!sel) {
      if (insFish) { insFish.hidden = true; insFish.innerHTML = ""; insFish.className = "mil-fish mil-fish--well"; }
      $("#title").textContent = "等待选择线程";
      $("#meta").textContent = "点击上方流向图或左侧处理记录中的任意线程查看详情。";
      $("#ins-state-tag").textContent = "—";
      $("#ins-state-tag").className = "mil-tag";
      $("#ins-meta-tags").innerHTML = "";
      $("#result-box").hidden = true;
      $("#deliveries-row").innerHTML = "";
      $("#events").innerHTML = `<p class="mil-hint">选择一条线程后展示执行事件。</p>`;
      stopBtn.disabled = true;
      return;
    }

    const rowSummary = (snap.threads || []).find((t) => t.thread_id === sel.thread_id);
    const st = STATE_LABEL[sel.state] || [sel.state || "未知", "", ""];
    if (insFish) {
      const card = (snap.profile_cards || []).find((c) => c && c.id === sel.profile);
      const isOff = card?.enabled === false;
      const swimming = sel.state === "active" || sel.state === "waiting";
      insFish.hidden = false;
      insFish.className = `mil-fish mil-fish--well${isOff ? " mil-fish--off" : ""}`;
      insFish.innerHTML = fishSvg(roleFishSeed(sel.profile, snapFishSeed(snap, sel.profile)), {
        size: 38,
        still: !swimming || isOff,
        label: "",
      });
    }
    $("#title").textContent = rowSummary?.title || sel.thread_id;
    const selCm = chatMeta(snap, sel.chat_id);
    const selChatDisp = selCm.name && selCm.name !== (selCm.spec || sel.chat_id)
      ? `${selCm.name} · ${selCm.spec || sel.chat_id}`
      : (selCm.spec || sel.chat_id);
    $("#meta").textContent = `${sel.thread_id} · 会话 ${selChatDisp} · 角色 ${sel.profile} · 第 ${sel.processed_revision}/${sel.revision} 轮`;
    $("#ins-state-tag").textContent = st[0];
    $("#ins-state-tag").className = `mil-tag ${st[1]}`;
    $("#ins-meta-tags").innerHTML = [
      sel.model ? `<span class="mil-tag">${esc(sel.model)}</span>` : "",
      sel.workspace ? `<span class="mil-tag mil-tag--warn">${esc(sel.workspace)}</span>` : "",
      `<span class="mil-tag">工具 ${(sel.tools || []).length} 个</span>`,
    ].filter(Boolean).join("");
    stopBtn.disabled = sel.state === "closed";

    const resBox = $("#result-box");
    const resText = sel.result?.error ? `错误：${sel.result.error}` : (sel.result?.text || "");
    if (resText) {
      resBox.hidden = false;
      resBox.textContent = resText;
    } else {
      resBox.hidden = true;
    }

    const tags = [];
    const atts = Array.isArray(sel.attachments) ? sel.attachments : [];
    atts.forEach((att) => {
      if (att && att.handle) {
        tags.push(`<button type="button" class="mil-key mil-key--sm mil-key--hot" data-jump-att="${esc(att.handle)}">预览 ${esc(att.name || att.handle)}</button>`);
      }
    });
    if (resText || atts.length) {
      tags.push(`<button type="button" class="mil-key mil-key--sm" data-jump-out-thread="${esc(sel.thread_id)}">在产物页查看</button>`);
    }
    (snap.deliveries || []).forEach((d) => {
      tags.push(`<span class="mil-tag mil-tag--ok">交付 [${esc(d.route)}] ${esc(d.status)}</span>`);
    });
    (snap.intents || []).forEach((i) => {
      tags.push(`<span class="mil-tag">回接 R${i.revision}: ${i.consumed ? "已回接" : "待回接"} (${esc(i.wake_status || "queued")})</span>`);
    });
    (snap.scheduled_intents || []).slice(0, 3).forEach((si) => {
      tags.push(`<span class="mil-tag mil-tag--warn">计划 [${esc(si.kind)}] ${esc(si.reason)}</span>`);
    });
    $("#deliveries-row").innerHTML = tags.join("");
  }

  function renderEventsAppend(newEvents) {
    const box = $("#events");
    if (!newEvents?.length) {
      if (!state.events.length) box.innerHTML = `<p class="mil-hint">暂无步骤事件。</p>`;
      return;
    }
    if (box.querySelector(".mil-hint")) box.innerHTML = "";
    newEvents.forEach((ev) => {
      const det = document.createElement("details");
      det.className = "ev-det";
      det.setAttribute("data-event", String(ev.seq));
      const sum = document.createElement("summary");
      const kindTxt = EVENT_KIND_LABELS[ev.kind] || ev.kind;
      sum.innerHTML = `<span class="mil-tag">#${ev.seq} ${esc(kindTxt)}</span><span class="num">R${ev.revision} · ${fmtTime(ev.at)}</span>`;
      const pre = document.createElement("pre");
      pre.textContent = ev.text || "";
      det.append(sum, pre);
      if (ev.truncated) {
        const readBtn = document.createElement("button");
        readBtn.type = "button";
        readBtn.className = "mil-key mil-key--sm";
        readBtn.textContent = "读取完整步骤";
        let fullText = "";
        let nextOffset = 0;
        const loadMore = () => enqueueQuery(async () => {
          const r = await callMaibotRaw("query", "event", {
            thread_id: state.threadId,
            event_seq: ev.seq,
            offset: nextOffset,
          });
          if (!r?.success) {
            setNowFeedback(r?.error || "读取完整步骤失败", "mil-feedback mil-feedback--err");
            return;
          }
          fullText += r.text || "";
          pre.textContent = fullText;
          nextOffset = r.next_offset;
          if (nextOffset === null || nextOffset === undefined) {
            readBtn.remove();
          } else {
            readBtn.textContent = "继续读取";
          }
        });
        readBtn.onclick = loadMore;
        det.append(readBtn);
      }
      box.append(det);
    });
  }

  function renderLaunchAssist(snap) {
    const profiles = snap.profiles || [];
    const chats = snap.enabled_chats || [];
    $("#launch-profile-list").innerHTML = profiles.map((p) => `<option value="${esc(p)}">`).join("");
    $("#launch-chat-list").innerHTML = ["self", ...chats].map((c) => `<option value="${esc(c)}">`).join("");
    $("#launch-profile-chips").innerHTML = profiles.slice(0, 6).map((p) =>
      `<button type="button" class="mil-key mil-key--sm" data-pick-profile="${esc(p)}"><span class="mil-row" style="gap:5px">${roleFishHtml(p, snapFishSeed(snap, p), 18, { still: true })}<span>${esc(p)}</span></span></button>`
    ).join("");
    $("#launch-chat-chips").innerHTML = [...chats.slice(0, 4), "self"].map((c) => {
      const m = chatMeta(snap, c);
      const disp = c === "self" ? "自身活动 self" : (m.name && m.name !== c ? `${m.name} (${c})` : c);
      return `<button type="button" class="mil-key mil-key--sm" data-pick-chat="${esc(c)}" title="${esc(c)}">${esc(disp)}</button>`;
    }).join("");
    const lc = $("#launch-chat");
    if (!lc.value && chats.length) lc.value = chats[0];
  }

  function switchThread(nextId) {
    const prevId = state.threadId;
    const msgEl = $("#message");
    if (prevId && msgEl) localDrafts[prevId] = msgEl.value;
    state.threadId = nextId || "";
    state.cursor = 0;
    state.events = [];
    const evEl = $("#events");
    if (evEl) evEl.innerHTML = `<p class="mil-hint">正在读取步骤…</p>`;
    if (msgEl) msgEl.value = localDrafts[state.threadId] || "";
    setNowFeedback("", "mil-feedback");
  }

  async function refresh(reset = false) {
    if (disposed || activePage !== "now") return;
    const reqThread = state.threadId;
    const reqChat = state.chatFilter;
    const reqCursor = reset ? 0 : state.cursor;
    const snap = await enqueueQuery(() => callMaibotRaw("query", "snapshot", {
      thread_id: reqThread,
      chat_id: reqChat,
      cursor: reqCursor,
    }));
    if (disposed || activePage !== "now") return;
    if (!snap?.success) {
      setNowFeedback(snap?.error || "现场快照读取失败", "mil-feedback mil-feedback--err");
      return;
    }
    if (!disposed && snap.ui_style) {
      savedUiStyle = snap.ui_style;
      applyTheme();
    }
    lastSnapshotAt = Date.now();
    state.lastSnap = snap;
    const firstId = snap.threads?.[0]?.thread_id || "";
    if (!state.threadId && firstId) {
      switchThread(firstId);
      if (snap.selected?.thread_id === firstId) {
        reset = true;
      } else {
        if (!disposed && activePage === "now") return refresh(true);
        return;
      }
    }
    if (state.threadId && !snap.selected && firstId && state.threadId !== firstId) {
      switchThread(firstId);
      if (!disposed && activePage === "now") return refresh(true);
      return;
    }
    if (typeof snap.cursor === "number") state.cursor = snap.cursor;
    if (snap.events?.length) {
      state.events.push(...snap.events);
      renderEventsAppend(snap.events);
    } else if (reset) {
      renderEventsAppend([]);
    }
    renderFlow(snap);
    renderStrip(snap);
    renderContext(snap);
    renderThreads(snap);
    renderInspector(snap);
    renderLaunchAssist(snap);
  }

  /* ───────────── 事件交互绑定 ───────────── */

  document.addEventListener("click", (ev) => {
    const navBtn = ev.target.closest("[data-nav], [data-mob-nav]");
    if (navBtn) {
      const p = navBtn.dataset.nav || navBtn.dataset.mobNav;
      if (Object.prototype.hasOwnProperty.call(PAGES, p)) switchWorkspaceTab(p);
    }
  }, { signal: shellSig });

  $("#ms-now-view").addEventListener("click", (ev) => {
    const flowChat = ev.target.closest("[data-flow-chat]");
    if (flowChat) {
      const cid = flowChat.dataset.flowChat;
      state.chatFilter = state.chatFilter === cid ? "" : cid;
      switchThread("");
      refresh(true);
      return;
    }
    if (ev.target.closest("#flow-all-chats") || ev.target.closest("#clear-th-filters")) {
      state.chatFilter = "";
      state.thFilter = "all";
      document.querySelectorAll("[data-th-filter]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.thFilter === "all")));
      switchThread("");
      refresh(true);
      return;
    }
    const flowProf = ev.target.closest("[data-flow-profile]");
    if (flowProf) {
      const pid = flowProf.dataset.flowProfile;
      $("#launch-profile").value = pid;
      const match = (state.lastSnap?.threads || []).find((t) => t.profile === pid);
      if (match) {
        switchThread(match.thread_id);
        refresh(true);
      }
      return;
    }
    const flowTh = ev.target.closest("[data-flow-thread],[data-thread],[data-ctx-thread]");
    if (flowTh) {
      const tid = flowTh.dataset.flowThread || flowTh.dataset.thread || flowTh.dataset.ctxThread;
      if (tid && tid !== state.threadId) {
        switchThread(tid);
        refresh(true);
      }
      return;
    }
    const ctxViewBtn = ev.target.closest("[data-ctx-view]");
    if (ctxViewBtn) {
      state.ctxView = ctxViewBtn.dataset.ctxView;
      document.querySelectorAll("[data-ctx-view]").forEach((b) => b.setAttribute("aria-pressed", String(b === ctxViewBtn)));
      if (state.lastSnap) renderContext(state.lastSnap);
      return;
    }
    const ctxCatBtn = ev.target.closest("[data-ctx-cat]");
    if (ctxCatBtn) {
      state.ctxCat = ctxCatBtn.dataset.ctxCat;
      if (state.lastSnap) renderContext(state.lastSnap);
      return;
    }
    const thFilterBtn = ev.target.closest("[data-th-filter]");
    if (thFilterBtn) {
      state.thFilter = thFilterBtn.dataset.thFilter;
      document.querySelectorAll("[data-th-filter]").forEach((b) => b.setAttribute("aria-pressed", String(b === thFilterBtn)));
      if (state.lastSnap) renderThreads(state.lastSnap);
      return;
    }
    const tile = ev.target.closest(".cm-tile");
    if (tile) {
      const item = $("#ctx-map")._rectItems?.[Number(tile.dataset.itemIdx)];
      openCtxModal(item);
      return;
    }
    const cell = ev.target.closest(".cm-cell");
    if (cell) {
      const idx = Number(cell.dataset.cellIdx);
      const item = idx >= 0 ? $("#ctx-grid")._mapInputs?.[idx] : null;
      openCtxModal(item);
      return;
    }
    const ci = ev.target.closest("[data-ci-idx]");
    if (ci) {
      openCtxModal(currentCtxItems[Number(ci.dataset.ciIdx)]);
      return;
    }
    const pickProf = ev.target.closest("[data-pick-profile]");
    if (pickProf) {
      $("#launch-profile").value = pickProf.dataset.pickProfile;
      return;
    }
    const pickChat = ev.target.closest("[data-pick-chat]");
    if (pickChat) {
      $("#launch-chat").value = pickChat.dataset.pickChat;
      return;
    }
    const jumpAtt = ev.target.closest("[data-jump-att]");
    if (jumpAtt) {
      pendingOutputTarget = { handle: jumpAtt.dataset.jumpAtt, threadId: state.threadId || "" };
      switchWorkspaceTab("outputs");
      return;
    }
    const jumpOut = ev.target.closest("[data-jump-out-thread]");
    if (jumpOut) {
      pendingOutputTarget = { threadId: jumpOut.dataset.jumpOutThread || state.threadId || "" };
      switchWorkspaceTab("outputs");
      return;
    }
  });

  function bootNowTab() {
    const ctxBoard = $("#ctx-board");
    if (!ctxBoard) return;
    document.querySelectorAll("[data-th-filter]").forEach((b) => {
      b.setAttribute("aria-pressed", String(b.dataset.thFilter === state.thFilter));
    });
    document.querySelectorAll("[data-ctx-view]").forEach((b) => {
      b.setAttribute("aria-pressed", String(b.dataset.ctxView === state.ctxView));
    });

    ctxBoard.addEventListener("mousemove", (ev) => {
      const tile = ev.target.closest(".cm-tile");
      const cell = ev.target.closest(".cm-cell");
      if (tile) {
        const it = $("#ctx-map")._rectItems?.[Number(tile.dataset.itemIdx)];
        if (it) showCtxTip(ev, `${it.label} · ${it.chars} 字符`);
      } else if (cell) {
        const idx = Number(cell.dataset.cellIdx);
        const it = idx >= 0 ? $("#ctx-grid")._mapInputs?.[idx] : null;
        if (it) showCtxTip(ev, `${it.label} · ${it.chars} 字符`);
      } else {
        hideCtxTip();
      }
    });
    ctxBoard.addEventListener("mouseleave", hideCtxTip);

    const msgEl = $("#message");
    if (msgEl) {
      msgEl.value = state.threadId ? (localDrafts[state.threadId] || "") : "";
      msgEl.addEventListener("input", () => {
        if (state.threadId) localDrafts[state.threadId] = msgEl.value;
      });
      msgEl.addEventListener("keydown", (ev) => {
        if ((ev.ctrlKey || ev.metaKey) && ev.key === "Enter") {
          ev.preventDefault();
          $("#send-note")?.click();
        }
      });
    }
    const launchPrompt = $("#launch-prompt");
    if (launchPrompt) {
      launchPrompt.addEventListener("keydown", (ev) => {
        if ((ev.ctrlKey || ev.metaKey) && ev.key === "Enter") {
          ev.preventDefault();
          $("#launch-run")?.click();
        }
      });
    }

    const sendBtn = $("#send-note");
    if (sendBtn) sendBtn.onclick = () => enqueueAction(async () => {
      const fb = $('[data-feedback-slot="now"]');
      if (!fb) return;
      if (!state.threadId) {
        fb.textContent = "请先选择一条线程。";
        fb.className = "mil-feedback mil-feedback--err";
        return;
      }
      const curMsg = $("#message");
      const text = (curMsg?.value || "").trim();
      if (!text) {
        fb.textContent = "请填写要递给线程的内容。";
        fb.className = "mil-feedback mil-feedback--err";
        return;
      }
      const r = await callMaibotRaw("action", "note", {
        thread_id: state.threadId,
        message: text,
        steer: Boolean($("#steer")?.checked),
      });
      if (activePage !== "now") return;
      const nowFb = $('[data-feedback-slot="now"]');
      if (!r?.success) {
        if (nowFb) {
          nowFb.textContent = r?.error || "引导失败";
          nowFb.className = "mil-feedback mil-feedback--err";
        }
        return;
      }
      localDrafts[state.threadId] = "";
      if ($("#message")) $("#message").value = "";
      if (nowFb) {
        nowFb.textContent = "引导已送达原活动。";
        nowFb.className = "mil-feedback mil-feedback--ok";
      }
      refresh(false);
    });

    const stopBtn = $("#stop");
    if (stopBtn) stopBtn.onclick = () => enqueueAction(async () => {
      if (!state.threadId) return;
      const r = await callMaibotRaw("action", "stop", { thread_id: state.threadId });
      if (activePage !== "now") return;
      const fb = $('[data-feedback-slot="now"]');
      if (!r?.success) {
        if (fb) {
          fb.textContent = r?.error || "停止失败";
          fb.className = "mil-feedback mil-feedback--err";
        }
        return;
      }
      if (fb) {
        fb.textContent = "线程已停止。";
        fb.className = "mil-feedback mil-feedback--ok";
      }
      refresh(false);
    });

    const launchBtn = $("#launch-run");
    if (launchBtn) launchBtn.onclick = () => enqueueAction(async () => {
      const fb = $("#launch-feedback");
      if (!fb) return;
      const profile = ($("#launch-profile")?.value || "").trim() || "scout";
      const chatId = ($("#launch-chat")?.value || "").trim();
      const workspace = ($("#launch-workspace")?.value || "").trim();
      const message = ($("#launch-prompt")?.value || "").trim();
      if (!chatId || !message) {
        fb.textContent = "请填写目标会话与任务提示词。";
        fb.className = "mil-feedback mil-feedback--err";
        return;
      }
      const r = await callMaibotRaw("action", "note", {
        thread_id: "",
        message,
        profile,
        chat_id: chatId,
        workspace,
        steer: false,
      });
      if (activePage !== "now") return;
      const nowLaunchFb = $("#launch-feedback");
      if (!r?.success) {
        if (nowLaunchFb) {
          nowLaunchFb.textContent = r?.error || "工作流发起失败";
          nowLaunchFb.className = "mil-feedback mil-feedback--err";
        }
        return;
      }
      if ($("#launch-prompt")) $("#launch-prompt").value = "";
      if (nowLaunchFb) {
        nowLaunchFb.textContent = "工作流线程已发起。";
        nowLaunchFb.className = "mil-feedback mil-feedback--ok";
      }
      if (r.thread_id) switchThread(r.thread_id);
      refresh(true);
    });
  }

  $("#ctx-modal-close").onclick = closeCtxModal;
  $("#ctx-scrim").addEventListener("click", (ev) => {
    if (ev.target === $("#ctx-scrim")) closeCtxModal();
  });
  document.addEventListener("keydown", (ev) => {
    if (ev.key === "Escape" && activePage === "now" && !$("#ctx-scrim").hidden) closeCtxModal();
    if ((ev.ctrlKey || ev.metaKey) && ev.key.toLowerCase() === "s") {
      if (activePage === "settings") {
        ev.preventDefault();
        $("#save-settings")?.click();
      } else if (activePage === "abilities" || activePage === "memory") {
        ev.preventDefault();
        $("#save")?.click();
      }
    }
  }, { signal: shellSig });

  $("#open-launch").onclick = () => {
    if (activePage !== "now") return;
    const panel = $("#launch-panel");
    if (!panel) return;
    panel.open = true;
    panel.scrollIntoView({ behavior: calm() ? "auto" : "smooth", block: "center" });
    $("#launch-prompt")?.focus();
  };

  window.addEventListener("resize", () => {
    if (activePage !== "now") return;
    drawFlowLines();
    if (state.lastSnap && state.ctxView === "map") renderContext(state.lastSnap);
  }, { signal: shellSig });

  function initHelpPopovers() {
    const pop = $("#mil-help-pop");
    if (!pop) return () => {};
    let activeBtn = null;
    let pinnedBtn = null;
    const closePop = () => {
      if (activeBtn) activeBtn.setAttribute("aria-expanded", "false");
      activeBtn = null;
      pinnedBtn = null;
      pop.hidden = true;
    };
    const openPop = (btn) => {
      const text = btn?.dataset?.help || "";
      if (!text) return;
      if (activeBtn && activeBtn !== btn) activeBtn.setAttribute("aria-expanded", "false");
      activeBtn = btn;
      activeBtn.setAttribute("aria-expanded", "true");
      pop.textContent = text;
      pop.hidden = false;
      const r = btn.getBoundingClientRect();
      const pw = pop.offsetWidth || 260;
      const ph = pop.offsetHeight || 60;
      const left = Math.max(12, Math.min(window.innerWidth - pw - 12, r.left + r.width / 2 - pw / 2));
      const top = r.bottom + ph + 16 < window.innerHeight ? r.bottom + 8 : Math.max(12, r.top - ph - 8);
      pop.style.left = `${Math.round(left)}px`;
      pop.style.top = `${Math.round(top)}px`;
    };
    document.addEventListener("click", (ev) => {
      const btn = ev.target.closest(".mil-help");
      if (btn) {
        if (btn.closest("summary")) ev.preventDefault();
        ev.stopPropagation();
        if (pinnedBtn === btn && !pop.hidden) closePop();
        else { pinnedBtn = btn; openPop(btn); }
        return;
      }
      if (!pop.hidden && !ev.target.closest("#mil-help-pop")) closePop();
    }, { signal: shellSig });
    document.addEventListener("mouseenter", (ev) => {
      const btn = ev.target.closest?.(".mil-help");
      if (btn && !pinnedBtn && window.matchMedia?.("(hover: hover)").matches) openPop(btn);
    }, { capture: true, signal: shellSig });
    document.addEventListener("mouseleave", (ev) => {
      const btn = ev.target.closest?.(".mil-help");
      if (btn && activeBtn === btn && pinnedBtn !== btn && window.matchMedia?.("(hover: hover)").matches) closePop();
    }, { capture: true, signal: shellSig });
    document.addEventListener("focusin", (ev) => {
      const btn = ev.target.closest?.(".mil-help");
      if (btn && !pinnedBtn) openPop(btn);
    }, { signal: shellSig });
    document.addEventListener("focusout", (ev) => {
      const btn = ev.target.closest?.(".mil-help");
      if (btn && activeBtn === btn && pinnedBtn !== btn) closePop();
    }, { signal: shellSig });
    document.addEventListener("keydown", (ev) => {
      if (ev.key === "Escape" && !pop.hidden) closePop();
    }, { signal: shellSig });
    window.addEventListener("scroll", () => {
      if (pop.hidden) return;
      if (pinnedBtn?.isConnected) openPop(pinnedBtn);
      else closePop();
    }, { passive: true, signal: shellSig });
    window.addEventListener("resize", closePop, { signal: shellSig });
    return closePop;
  }

{{MGMT_BOOT_JS}}

  const closeHelpPop = initHelpPopovers();

  function syncShellToPage(targetPage, { remountMgmt = true, remountNow = true } = {}) {
    const prevPage = activePage;
    const isNow = targetPage === "now";
    const nowView = $("#ms-now-view");
    const mgmtWrap = $("#ms-mgmt-view-wrap");
    const mgmtView = $("#ms-mgmt-view");

    if (prevPage === "now" && !isNow && state.threadId) {
      const msgEl = $("#message");
      if (msgEl) localDrafts[state.threadId] = msgEl.value;
    }

    activePage = targetPage;
    document.body.dataset.page = targetPage;
    document.title = `Maisya · ${PAGES[targetPage] || "现场"}`;
    const titleEl = $("#ms-page-title");
    if (titleEl) titleEl.textContent = PAGES[targetPage] || "现场";
    $$("[data-nav], [data-mob-nav]").forEach((btn) => {
      const target = btn.dataset.nav || btn.dataset.mobNav;
      if (target === targetPage) btn.setAttribute("aria-current", "page");
      else btn.removeAttribute("aria-current");
    });
    if (nowView) nowView.hidden = !isNow;
    if (mgmtWrap) mgmtWrap.hidden = isNow;
    const topLedPill = $("#top-led-pill");
    const openLaunch = $("#open-launch");
    const mgmtLedPill = $("#mgmt-led-pill");
    const mobDock = $("#ms-mob-dock");
    if (topLedPill) topLedPill.hidden = !isNow;
    if (openLaunch) openLaunch.hidden = !isNow;
    if (mgmtLedPill) mgmtLedPill.hidden = isNow;
    if (mobDock) {
      mobDock.hidden = isNow;
      if (!isNow) renderMobDockIcons();
    }
    const mled = $("#mgmt-led");
    if (mled) mled.className = "mil-led";

    closeHelpPop?.();
    hideCtxTip();
    if (!isNow && !$("#ctx-scrim")?.hidden) closeCtxModal();

    if (isNow) {
      if (mgmtView) mgmtView.innerHTML = "";
      if (remountNow && nowView) nowView.innerHTML = MGMT_FRAGMENTS.now || "";
    } else {
      if (nowView) nowView.innerHTML = "";
      if (remountMgmt && mgmtView) mgmtView.innerHTML = MGMT_FRAGMENTS[targetPage] || "";
    }

    const nowFb = $('[data-feedback-slot="now"]');
    const mgmtFb = $('[data-feedback-slot="mgmt"]');
    if (isNow) {
      if (mgmtFb) mgmtFb.id = "mgmt-feedback";
      if (nowFb) nowFb.id = "feedback";
    } else {
      if (nowFb) nowFb.id = "now-feedback";
      if (mgmtFb) {
        mgmtFb.id = "feedback";
        mgmtFb.textContent = "";
        mgmtFb.className = "mil-feedback";
      }
    }
  }

  function switchWorkspaceTab(targetPage, opts = {}) {
    if (!Object.prototype.hasOwnProperty.call(PAGES, targetPage)) return;
    const forceBoot = Boolean(opts.forceBoot);
    if (targetPage === activePage && !forceBoot) return;
    if (!opts.system) userNavigated = true;
    if (mgmtAbort) {
      mgmtAbort.abort();
      mgmtAbort = null;
    }
    syncShellToPage(targetPage, { remountMgmt: opts.remountMgmt !== false, remountNow: opts.remountNow !== false });
    if (targetPage === "now") {
      bootNowTab();
      applyTheme();
      state.cursor = 0;
      state.events = [];
      if (state.lastSnap) {
        renderEventsAppend([]);
        renderFlow(state.lastSnap);
        renderStrip(state.lastSnap);
        renderContext(state.lastSnap);
        renderThreads(state.lastSnap);
        renderInspector(state.lastSnap);
        renderLaunchAssist(state.lastSnap);
      }
      if (bootStarted) {
        refresh(true);
      }
      requestAnimationFrame(() => { if (activePage === "now") drawFlowLines(); });
    } else {
      mgmtAbort = new AbortController();
      bootManagementTab(targetPage, mgmtAbort.signal);
      applyTheme();
    }
  }

  const initHostTab = String(window.maibot?.page?.state?.tab || window.maibot?.page?.state?.page || "").trim();
  if (initHostTab && Object.prototype.hasOwnProperty.call(PAGES, initHostTab) && initHostTab !== activePage) {
    switchWorkspaceTab(initHostTab, { system: true, forceBoot: true });
  } else if (activePage !== "now") {
    switchWorkspaceTab(activePage, { system: true, forceBoot: true, remountMgmt: false });
  } else {
    switchWorkspaceTab("now", { system: true, forceBoot: true, remountNow: false });
  }

  Promise.resolve(window.maibot?.ready).then(() => {
    if (disposed) return;
    bootStarted = true;
    const readyHostTab = String(window.maibot?.page?.state?.tab || window.maibot?.page?.state?.page || "").trim();
    if (!userNavigated && readyHostTab && Object.prototype.hasOwnProperty.call(PAGES, readyHostTab) && readyHostTab !== activePage) {
      switchWorkspaceTab(readyHostTab, { system: true, forceBoot: true });
    } else if (activePage === "now") {
      applyTheme();
      refresh(true);
    }
    timer = setInterval(() => {
      if (disposed || activePage !== "now") return;
      if (!document.hidden && queryInFlight === 0 && Date.now() - lastSnapshotAt >= 1800) refresh(false);
    }, 2400);
  });
})();
</script>
</body>
</html>
