  function cleanUiName(raw, fallback = "") {
    const cleaned = String(raw ?? "")
      .replace(/[\u0000-\u001f\u007f-\u009f\u034f\u061c\u115f\u1160\u17b4\u17b5\u180b-\u180e\u200b-\u200f\u202a-\u202e\u2060-\u206f\u2800\u3164\ufeff\uffa0]/g, "")
      .replace(/\s+/g, " ")
      .trim();
    return cleaned || String(fallback || "");
  }
  function parseStreamParts(cid) {
    const raw = String(cid || "").trim();
    if (!raw || raw === "self") return { platform: "self", chatType: "self", rawId: "self", streamSpec: raw };
    const p = raw.split(":");
    if (p.length >= 3 && (p[1] === "group" || p[1] === "private")) {
      return { platform: p[0].toLowerCase(), chatType: p[1], rawId: p.slice(2).join(":"), streamSpec: raw };
    }
    if (p.length === 2) {
      return { platform: p[0].toLowerCase(), chatType: "private", rawId: p[1], streamSpec: `${p[0].toLowerCase()}:private:${p[1]}` };
    }
    return { platform: "qq", chatType: "private", rawId: raw, streamSpec: raw };
  }
  function hashColorIdx(seed) {
    const s = String(seed || "");
    let h = 0;
    for (let i = 0; i < s.length; i += 1) h = (h * 31 + s.charCodeAt(i)) >>> 0;
    return h % 6;
  }
  const PLAT_LABELS = { qq: "QQ", weixin: "微信", discord: "Discord", feishu: "飞书", telegram: "Telegram", onebot: "OneBot", self: "内部" };
  function resolveChatMeta(snapOrSources, cidOrObj) {
    const isObj = cidOrObj && typeof cidOrObj === "object";
    const cid = isObj ? String(cidOrObj.chat_id || cidOrObj.stream_spec || cidOrObj.user_id || "") : String(cidOrObj || "");
    if (cid === "self") {
      return {
        chatId: "self", streamSpec: "self", platform: "self", chatType: "self",
        rawId: "self", name: "自身线程", avatarData: "", initial: "主", colorIdx: 2,
      };
    }
    const sourcesMap = snapOrSources && typeof snapOrSources === "object"
      ? (snapOrSources.chat_sources || snapOrSources.chat_meta || snapOrSources)
      : {};
    const fromMap = (sourcesMap && typeof sourcesMap === "object" && cid && sourcesMap[cid] && typeof sourcesMap[cid] === "object")
      ? sourcesMap[cid]
      : {};
    const merged = isObj ? { ...fromMap, ...cidOrObj } : fromMap;
    const parts = parseStreamParts(merged.stream_spec || fromMap.stream_spec || cid);
    const plat = String(merged.platform || fromMap.platform || parts.platform || "qq").toLowerCase();
    const chatType = String(merged.chat_type || merged.type || fromMap.chat_type || parts.chatType || "private").toLowerCase();
    const rawId = String(merged.raw_id || merged.raw_user_id || fromMap.raw_id || parts.rawId || merged.user_id || cid || "");
    const name = cleanUiName(merged.name || merged.title || merged.label || fromMap.name || fromMap.title || "", rawId || cid || "未命名会话");
    const avatarData = isSafeImageDataUri(merged.avatar_data)
      ? String(merged.avatar_data).trim()
      : (isSafeImageDataUri(fromMap.avatar_data) ? String(fromMap.avatar_data).trim() : "");
    const firstCh = cleanUiName(merged.avatar_initial || "", "");
    const initial = (firstCh ? Array.from(firstCh)[0] : (Array.from(name)[0] || "?")).toUpperCase();
    const colorIdx = Number.isInteger(merged.color_idx) ? (merged.color_idx % 6) : hashColorIdx(cid || name);
    return { chatId: cid, streamSpec: parts.streamSpec || cid, platform: plat, chatType, rawId, name, avatarData, initial, colorIdx };
  }
  function renderChatAvatarHtml(meta, size = 22) {
    const ic = window.MaisyaIcons;
    if (meta.platform === "self") {
      const svg = ic?.platform ? ic.platform("self", size, false) : esc(meta.initial);
      return `<span class="ms-chat-av ms-chat-av--c2" style="width:${size}px;height:${size}px" aria-hidden="true">${svg}</span>`;
    }
    const fontSize = Math.max(10, Math.round(size * 0.48));
    const pic = meta.avatarData ? `<span class="ms-chat-av-pic" style="background-image:url('${esc(meta.avatarData)}')"></span>` : "";
    return `<span class="ms-chat-av ms-chat-av--c${meta.colorIdx}" style="width:${size}px;height:${size}px;font-size:${fontSize}px" aria-hidden="true">${esc(meta.initial)}${pic}</span>`;
  }
  function renderChatBadgeHtml(snapOrSources, cidOrObj, opts = {}) {
    if (!cidOrObj) return `<span class="mil-hint">未指定会话</span>`;
    const meta = resolveChatMeta(snapOrSources, cidOrObj);
    const size = opts.size || 20;
    const ic = window.MaisyaIcons;
    const platHtml = meta.platform !== "self" && opts.showPlatform !== false && ic?.platform
      ? `<span class="ms-chat-plat" title="${esc(PLAT_LABELS[meta.platform] || meta.platform)}">${ic.platform(meta.platform, opts.platSize || 13, Boolean(opts.darkGround))}</span>`
      : "";
    const typeTag = opts.showType && meta.platform !== "self"
      ? `<span class="mil-tag">${meta.chatType === "group" ? "群聊" : "私聊"}</span>`
      : "";
    const rawHtml = opts.showRawId && meta.rawId && meta.rawId !== meta.name
      ? `<span class="ms-chat-rawid">${esc(meta.rawId)}</span>`
      : "";
    return `<span class="ms-chat-badge" title="${esc(meta.streamSpec || meta.chatId)}">${renderChatAvatarHtml(meta, size)}${platHtml}<span class="ms-chat-name">${esc(meta.name)}</span>${typeTag}${rawHtml}</span>`;
  }
  function collectPlatformOptions(sourcesMap, defaults = ["qq", "weixin", "discord", "feishu", "telegram", "onebot"]) {
    const set = new Set(defaults);
    if (sourcesMap && typeof sourcesMap === "object") {
      Object.values(sourcesMap).forEach((v) => {
        const p = String(v?.platform || "").trim().toLowerCase();
        if (p && p !== "self") set.add(p);
      });
    }
    return [...set];
  }
  function buildStreamSpec(plat, chatType, rawInput) {
    const raw = String(rawInput || "").trim();
    if (!raw) return "";
    const cleanPlat = String(plat || "qq").trim().toLowerCase() || "qq";
    const cleanType = chatType === "group" ? "group" : "private";
    const parsed = parseStreamParts(raw);
    if (raw.includes(":") && raw.split(":").length >= 3 && (parsed.chatType === "group" || parsed.chatType === "private")) {
      return `${cleanPlat}:${cleanType}:${parsed.rawId}`;
    }
    return `${cleanPlat}:${cleanType}:${raw}`;
  }
  function renderStructStreamBuilder(prefix, opts = {}) {
    const plats = collectPlatformOptions(opts.chatSources);
    const curPlat = opts.platform || "qq";
    const allowGroup = opts.allowGroup !== false;
    const allowPrivate = opts.allowPrivate !== false;
    const curType = opts.chatType || (allowGroup ? "group" : "private");
    const typeOpts = [
      allowGroup ? `<option value="group"${curType === "group" ? " selected" : ""}>群聊</option>` : "",
      allowPrivate ? `<option value="private"${curType === "private" ? " selected" : ""}>${allowGroup ? "私聊" : "私聊账号"}</option>` : "",
    ].join("");
    return `<div class="ms-struct-builder" data-struct-prefix="${esc(prefix)}">
      <select class="mil-select" id="${esc(prefix)}-plat" aria-label="选择平台">${plats.map((p) => `<option value="${esc(p)}"${p === curPlat ? " selected" : ""}>${esc(PLAT_LABELS[p] || p)}</option>`).join("")}</select>
      <select class="mil-select" id="${esc(prefix)}-type" aria-label="选择类型">${typeOpts}</select>
      <input type="text" class="mil-input mono" id="${esc(prefix)}-id" placeholder="${esc(opts.placeholder || "输入账号或群号")}" aria-label="${esc(opts.ariaLabel || "输入编号")}" />
      <button type="button" class="mil-key mil-key--sm" id="${esc(opts.btnId || `${prefix}-add-btn`)}">${esc(opts.btnLabel || "添加")}</button>
    </div>`;
  }
  function readStructStreamBuilder(prefix) {
    const root = document.getElementById(`${prefix}-id`);
    const plat = document.getElementById(`${prefix}-plat`)?.value || "qq";
    const chatType = document.getElementById(`${prefix}-type`)?.value || "private";
    const rawId = (root?.value || "").trim();
    return { spec: buildStreamSpec(plat, chatType, rawId), rawId, plat, chatType, inputEl: root };
  }
  function normalizeModelCatalog(rawModels, extraNames = []) {
    const map = new Map();
    (Array.isArray(rawModels) ? rawModels : []).forEach((m) => {
      if (typeof m === "string" && m.trim()) {
        map.set(m.trim(), { name: m.trim(), provider: "默认", visual: false });
      } else if (m && typeof m === "object" && String(m.name || "").trim()) {
        const name = String(m.name).trim();
        map.set(name, {
          name,
          provider: String(m.provider || "其他").trim() || "其他",
          visual: Boolean(m.visual),
        });
      }
    });
    (Array.isArray(extraNames) ? extraNames : []).forEach((n) => {
      const name = String(n || "").trim();
      if (name && !map.has(name)) map.set(name, { name, provider: "当前配置", visual: false });
    });
    return [...map.values()];
  }
  function renderModelGroupsHtml(models, opts = {}) {
    const query = String(opts.query || "").trim().toLowerCase();
    const selectedSet = new Set(opts.selectedNames || []);
    const ic = window.MaisyaIcons;
    const filtered = models.filter((m) => {
      if (opts.excludeSelected && selectedSet.has(m.name)) return false;
      if (!query) return true;
      return `${m.name} ${m.provider}`.toLowerCase().includes(query);
    });
    if (!filtered.length) return `<div class="mil-hint" style="padding:8px">没有找到匹配的模型</div>`;
    const byProv = new Map();
    filtered.forEach((m) => {
      const k = m.provider || "其他";
      if (!byProv.has(k)) byProv.set(k, []);
      byProv.get(k).push(m);
    });
    const checkSvg = ic?.ctrl ? ic.ctrl("check", 13, 2) : "";
    return [...byProv.entries()].map(([prov, items]) => `
      <div class="ms-model-group-hd">${esc(prov)}</div>
      ${items.map((m) => {
        const isSel = selectedSet.has(m.name);
        return `<button type="button" class="ms-model-opt" role="option" aria-selected="${isSel ? "true" : "false"}" data-pick-model="${esc(m.name)}">
          <span class="mil-row" style="gap:6px;min-width:0">
            <span class="mono" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(m.name)}</span>
            ${m.visual ? `<span class="ms-vis-badge">视觉</span>` : ""}
          </span>
          ${isSel ? `<span class="mil-inline-ic">${checkSvg}</span>` : ""}
        </button>`;
      }).join("")}`).join("");
  }
  function renderSingleModelBoxHtml(opts) {
    const ic = window.MaisyaIcons;
    const models = normalizeModelCatalog(opts.models, opts.value ? [opts.value] : []);
    const cur = String(opts.value || models[0]?.name || "");
    const curObj = models.find((m) => m.name === cur) || { name: cur, provider: "", visual: false };
    const chevSvg = ic?.ctrl ? ic.ctrl("chevron_d", 14, 1.9) : "";
    const searchSvg = ic?.ctrl ? ic.ctrl("search", 14, 1.9) : "";
    return `<div class="ms-model-box" id="${esc(opts.boxId)}">
      <input type="hidden" id="${esc(opts.inputId)}" value="${esc(cur)}" />
      <button type="button" class="mil-key ms-model-trigger" id="${esc(opts.triggerId)}" aria-expanded="false" aria-controls="${esc(opts.dropId)}">
        <span class="mil-row" style="gap:6px;min-width:0">
          <span class="mono" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(cur || "选择模型")}</span>
          ${curObj.provider ? `<span class="mil-hint">${esc(curObj.provider)}</span>` : ""}
          ${curObj.visual ? `<span class="ms-vis-badge">视觉</span>` : ""}
        </span>
        <span class="mil-inline-ic">${chevSvg}</span>
      </button>
      <div class="ms-model-dropdown" id="${esc(opts.dropId)}" hidden>
        <div class="ms-model-search-wrap">
          <span class="mil-inline-ic">${searchSvg}</span>
          <input type="search" id="${esc(opts.searchId)}" placeholder="搜索模型名称或厂商..." value="${esc(opts.query || "")}" aria-label="搜索模型名称或厂商" />
        </div>
        <div class="ms-model-groups" role="listbox" id="${esc(opts.listId)}">${renderModelGroupsHtml(models, { selectedNames: cur ? [cur] : [], query: opts.query })}</div>
      </div>
    </div>`;
  }
  let _confirmResolver = null;
  let _confirmClosedAt = 0;
  function closeConfirmDialog(result = "cancel") {
    const dlg = $("#ms-confirm-dialog");
    if (dlg && dlg.open) {
      try { dlg.close(result); } catch (_) {}
    } else if (_confirmResolver) {
      const res = _confirmResolver;
      _confirmResolver = null;
      _confirmClosedAt = performance.now();
      res(false);
    }
  }
  function isConfirmOpen() {
    const dlg = $("#ms-confirm-dialog");
    return Boolean(dlg?.open) || (performance.now() - _confirmClosedAt < 120);
  }
  function initConfirmDialog() {
    const dlg = $("#ms-confirm-dialog");
    const cancelBtn = $("#ms-confirm-cancel");
    const okBtn = $("#ms-confirm-ok");
    if (!dlg || dlg.dataset.bound === "1") return;
    dlg.dataset.bound = "1";
    cancelBtn?.addEventListener("click", () => closeConfirmDialog("cancel"), { signal: shellSig });
    okBtn?.addEventListener("click", () => closeConfirmDialog("confirm"), { signal: shellSig });
    dlg.addEventListener("close", () => {
      const accepted = dlg.returnValue === "confirm";
      dlg.returnValue = "";
      _confirmClosedAt = performance.now();
      const res = _confirmResolver;
      _confirmResolver = null;
      if (res) res(accepted);
    }, { signal: shellSig });
    if (!("closedBy" in HTMLDialogElement.prototype)) {
      const outside = (ev) => {
        const r = dlg.getBoundingClientRect();
        return ev.clientX < r.left || ev.clientX > r.right || ev.clientY < r.top || ev.clientY > r.bottom;
      };
      let pressedOutside = false;
      dlg.addEventListener("pointerdown", (ev) => { pressedOutside = dlg.open && outside(ev); }, { signal: shellSig });
      dlg.addEventListener("pointerup", (ev) => {
        if (pressedOutside && dlg.open && outside(ev)) closeConfirmDialog("cancel");
        pressedOutside = false;
      }, { signal: shellSig });
    }
  }
  function confirmDanger({ tag = "危险操作", title = "确认继续操作？", body = "", confirmText = "确认删除", cancelText = "取消" } = {}) {
    initConfirmDialog();
    const dlg = $("#ms-confirm-dialog");
    if (!dlg || typeof dlg.showModal !== "function" || disposed) return Promise.resolve(false);
    if (_confirmResolver) closeConfirmDialog("cancel");
    const tagEl = $("#ms-confirm-tag");
    const titleEl = $("#ms-confirm-title");
    const descEl = $("#ms-confirm-desc");
    const cancelBtn = $("#ms-confirm-cancel");
    const okBtn = $("#ms-confirm-ok");
    if (tagEl) tagEl.textContent = String(tag || "危险操作");
    if (titleEl) titleEl.textContent = String(title || "确认继续操作？");
    if (descEl) {
      const txt = String(body || "").trim();
      descEl.textContent = txt;
      descEl.hidden = !txt;
    }
    if (cancelBtn) cancelBtn.textContent = String(cancelText || "取消");
    if (okBtn) okBtn.textContent = String(confirmText || "确认删除");
    dlg.returnValue = "";
    return new Promise((resolve) => {
      _confirmResolver = resolve;
      try {
        dlg.showModal();
        cancelBtn?.focus();
      } catch (_) {
        _confirmResolver = null;
        resolve(false);
      }
    });
  }
  window.MaisyaUI = {
    cleanUiName, parseStreamParts, resolveChatMeta, renderChatAvatarHtml, renderChatBadgeHtml,
    collectPlatformOptions, buildStreamSpec, renderStructStreamBuilder, readStructStreamBuilder,
    normalizeModelCatalog, renderModelGroupsHtml, renderSingleModelBoxHtml, PLAT_LABELS,
    confirmDanger, isConfirmOpen,
  };

  function chatDisplayName(snap, cid) {
    if (!cid) return "未知会话";
    if (cid === "self") return "自身线程";
    return resolveChatMeta(snap, cid).name;
  }
  function profileFishSeedFromSnap(snap, pid) {
    const card = (snap?.profile_cards || []).find((c) => c.id === pid);
    return card?.fish_seed || "";
  }
  function selectedForView(snap) {
    if (state.selectedDetail && (!state.threadId || state.selectedDetail.thread_id === state.threadId)) {
      return state.selectedDetail;
    }
    return snap?.selected || null;
  }

  /* ───────────── Treemap 与详情弹窗 ───────────── */
  function squarify(items, x, y, w, h) {
    if (!items.length || w <= 0 || h <= 0) return [];
    const total = items.reduce((s, d) => s + d.value, 0);
    if (total <= 0) return [];
    const scaled = items.map((d) => ({ ...d, area: (d.value / total) * w * h }));
    const out = [];
    const worst = (row, side) => {
      if (!row.length || side <= 0) return Infinity;
      const sum = row.reduce((s, d) => s + d.area, 0);
      const s2 = sum * sum, side2 = side * side;
      let maxA = 0, minA = Infinity;
      for (const d of row) { if (d.area > maxA) maxA = d.area; if (d.area < minA) minA = d.area; }
      return Math.max((side2 * maxA) / s2, s2 / (side2 * minA));
    };
    const lay = (row, rx, ry, rw, rh) => {
      const sum = row.reduce((s, d) => s + d.area, 0);
      if (rw >= rh) {
        const cw = rh > 0 ? sum / rh : 0;
        let cy = ry;
        for (const d of row) {
          const ch = cw > 0 ? d.area / cw : 0;
          out.push({ item: d, x: rx, y: cy, w: cw, h: ch });
          cy += ch;
        }
        return { x: rx + cw, y: ry, w: Math.max(0, rw - cw), h: rh };
      }
      const ch = rw > 0 ? sum / rw : 0;
      let cx = rx;
      for (const d of row) {
        const cw = ch > 0 ? d.area / ch : 0;
        out.push({ item: d, x: cx, y: ry, w: cw, h: ch });
        cx += cw;
      }
      return { x: rx, y: ry + ch, w: rw, h: Math.max(0, rh - ch) };
    };
    let rem = [...scaled], row = [], box = { x, y, w, h };
    while (rem.length) {
      const next = rem[0], side = Math.min(box.w, box.h);
      if (!row.length || worst([...row, next], side) <= worst(row, side)) { row.push(next); rem.shift(); }
      else { box = lay(row, box.x, box.y, box.w, box.h); row = []; }
    }
    if (row.length) lay(row, box.x, box.y, box.w, box.h);
    return out;
  }

  let currentCtxItems = [];
  function showCtxTip(ev, text) {
    const tip = $("#cm-tip");
    if (!tip) return;
    tip.textContent = text;
    tip.hidden = false;
    tip.style.left = Math.min(window.innerWidth - 290, ev.clientX + 12) + "px";
    tip.style.top = Math.min(window.innerHeight - 70, ev.clientY + 12) + "px";
  }
  function hideCtxTip() { const tip = $("#cm-tip"); if (tip) tip.hidden = true; }
  function openCtxModal(item) {
    if (!item || item.cat === "free") return;
    lastTriggerTarget = document.activeElement;
    const cat = CATS[item.cat] || { name: item.cat };
    $("#ctx-modal-cat").textContent = cat.name;
    $("#ctx-modal-title").textContent = item.label || "上下文片段";
    $("#ctx-modal-chars").textContent = item.tokens != null ? `${item.tokens} tokens · ${item.chars || 0} 字符` : `${item.chars || 0} 字符`;
    $("#ctx-modal-body").textContent = item.preview || "（暂无可展示预览）";
    $("#ctx-scrim").hidden = false;
    $("#ctx-modal-close").focus();
  }
  function closeCtxModal() {
    $("#ctx-scrim").hidden = true;
    if (lastTriggerTarget && typeof lastTriggerTarget.focus === "function") lastTriggerTarget.focus();
  }

  function renderContext(snap) {
    const readout = $("#ctx-readout"), health = $("#ctx-health"), meter = $("#ctx-meter"), bar = $("#ctx-meter-bar");
    const cats = $("#ctx-cats"), stage = $("#ctx-map"), grid = $("#ctx-grid"), rowsEl = $("#ctx-items");
    if (!readout || !stage || !grid) return;
    const sel = selectedForView(snap);
    const ctx = sel?.context;
    if (!sel || !ctx) {
      readout.textContent = "0 / 262.1K tokens (0%)";
      health.textContent = "未选线程";
      health.className = "mil-tag";
      meter.className = "mil-meter";
      bar.style.width = "0%";
      cats.innerHTML = "";
      stage.innerHTML = `<p class="mil-hint" style="padding:16px">选中线程后展示上下文构成与 Token 占用方块图。</p>`;
      grid.innerHTML = "";
      rowsEl.innerHTML = "";
      return;
    }

    const useTokens = Number(ctx.token_limit || 0) > 0;
    const unitLabel = useTokens ? "tokens" : "字符";
    const used = Number((useTokens ? ctx.tokens : ctx.chars) ?? ctx.chars ?? 0);
    const rawLimit = Number((useTokens ? ctx.token_limit : ctx.limit) ?? (useTokens ? 262144 : 48000));
    const limit = Math.max(rawLimit, used, 1);
    const pct = Math.min(100, Math.round((used / limit) * 100));
    const triggerHint = useTokens && Number(ctx.trigger_tokens || 0) > 0 ? ` · 压缩线 ${fmtK(ctx.trigger_tokens)}` : "";
    readout.textContent = `已用 ${fmtK(used)} / ${fmtK(limit)} ${unitLabel} (${pct}%)${triggerHint}`;
    bar.style.width = `${pct}%`;
    const near = (useTokens && Number(ctx.trigger_tokens || 0) > 0 && used >= Number(ctx.trigger_tokens) * 0.9) || pct >= 70;
    const hot = (useTokens && Number(ctx.trigger_tokens || 0) > 0 && used >= Number(ctx.trigger_tokens)) || pct >= 88;
    meter.className = `mil-meter${hot ? " mil-meter--hot" : near ? " mil-meter--warn" : ""}`;
    if (ctx.archived) { health.textContent = "已归档"; health.className = "mil-tag mil-tag--warn"; }
    else if (ctx.pruned) { health.textContent = "已折叠"; health.className = "mil-tag mil-tag--ok"; }
    else if (hot || near) { health.textContent = "接近压缩"; health.className = "mil-tag mil-tag--hot"; }
    else { health.textContent = "健康"; health.className = "mil-tag mil-tag--ok"; }

    const roles = (useTokens ? ctx.token_roles : ctx.roles) || ctx.roles || {};
    const catKeys = ["system", "memory", "user", "assistant", "tool"];
    const catTotals = Object.fromEntries(catKeys.map((k) => [k, Number(roles[k] || 0)]));
    cats.innerHTML = [
      `<button type="button" class="mil-key mil-key--sm" data-ctx-cat="all" aria-pressed="${String(state.ctxCat === "all")}">全部 (${fmtK(used)})</button>`,
      ...catKeys.map((k) => `<button type="button" class="mil-key mil-key--sm" data-ctx-cat="${k}" aria-pressed="${String(state.ctxCat === k)}"><i class="ctx-swatch" style="background:${CATS[k].color}"></i>${CATS[k].name} ${fmtK(catTotals[k])}</button>`),
    ].join("");

    const metricOf = (x) => Number((useTokens ? x.tokens : x.chars) ?? x.chars ?? 0);
    let items = Array.isArray(ctx.items) && ctx.items.length
      ? ctx.items.map((x) => { const m = metricOf(x); return { ...x, cat: x.cat || x.role || "system", label: x.label || x.title || x.id, metric: m, value: Math.max(1, m) }; })
      : [];
    if (!items.length) {
      items = catKeys.filter((k) => catTotals[k] > 0).map((k) => ({ id: `role-${k}`, cat: k, label: CATS[k].name, chars: catTotals[k], tokens: catTotals[k], metric: catTotals[k], value: catTotals[k], preview: `${CATS[k].name}共占 ${catTotals[k]} ${unitLabel}。` }));
    }
    currentCtxItems = items;
    const free = Math.max(0, limit - used);
    const mapInputs = [...items];
    if (free > 0 && state.ctxCat === "all") mapInputs.push({ id: "free-space", cat: "free", label: "剩余可用空间", chars: free, tokens: free, metric: free, value: free, preview: "" });

    stage.hidden = state.ctxView !== "map";
    grid.hidden = state.ctxView !== "grid";
    if (state.ctxView === "map") {
      const w = stage.clientWidth || 460;
      const h = stage.clientHeight || 220;
      const rects = squarify(mapInputs, 0, 0, w, h);
      stage.innerHTML = rects.map((r, idx) => {
        const dim = state.ctxCat !== "all" && r.item.cat !== state.ctxCat;
        const showTitle = r.w >= 54 && r.h >= 24;
        const mVal = Number(r.item.metric ?? r.item.chars ?? 0);
        return `<button type="button" class="cm-tile${dim ? " dim" : ""}" data-cat="${esc(r.item.cat)}" data-item-idx="${idx}" style="left:${r.x.toFixed(1)}px;top:${r.y.toFixed(1)}px;width:${r.w.toFixed(1)}px;height:${r.h.toFixed(1)}px" title="${esc(r.item.label)}: ${mVal} ${unitLabel}">${showTitle ? `<b>${esc(r.item.label)}</b><span>${fmtK(mVal)}</span>` : ""}</button>`;
      }).join("");
      stage._rectItems = rects.map((r) => r.item);
    } else {
      const cells = [], alloc = [];
      let totalCells = 0;
      mapInputs.forEach((it, idx) => {
        const count = it.cat === "free" ? 0 : Math.max(1, Math.round((it.value / limit) * 400));
        alloc.push({ it, idx, count });
        totalCells += count;
      });
      while (totalCells > 400) {
        const largest = alloc.reduce((a, b) => (b.count > a.count ? b : a));
        if (largest.count <= 1) break;
        largest.count--;
        totalCells--;
      }
      alloc.forEach(({ it, idx, count }) => {
        const mVal = Number(it.metric ?? it.chars ?? 0);
        for (let i = 0; i < count; i++) cells.push({ cat: it.cat, label: it.label, chars: mVal, idx });
      });
      while (cells.length < 400) cells.push({ cat: "free", label: "剩余空间", chars: free, idx: -1 });
      grid.innerHTML = cells.map((c) => `<button type="button" class="cm-cell${state.ctxCat !== "all" && c.cat !== state.ctxCat ? " dim" : ""}" data-cat="${esc(c.cat)}" data-cell-idx="${c.idx}" aria-label="${esc(c.label)}"></button>`).join("");
      grid._mapInputs = mapInputs;
    }

    const filteredRows = items.filter((it) => state.ctxCat === "all" || it.cat === state.ctxCat).sort((a, b) => Number(b.metric ?? b.chars ?? 0) - Number(a.metric ?? a.chars ?? 0));
    const maxItemVal = Math.max(1, ...filteredRows.map((x) => Number(x.metric ?? x.chars ?? 0)));
    rowsEl.innerHTML = filteredRows.length
      ? filteredRows.map((it) => {
          const origIdx = currentCtxItems.indexOf(it);
          const rowVal = Number(it.metric ?? it.chars ?? 0);
          const pctW = Math.max(3, Math.round((rowVal / maxItemVal) * 100));
          return `<button type="button" class="ci-row" data-ci-idx="${origIdx}"><span class="ctx-swatch" style="background:${(CATS[it.cat] || CATS.free).color}"></span><span class="ci-row-name">${esc(it.label)}</span><span class="num" style="font-size:11.5px">${fmtK(rowVal)}</span><span class="ci-row-bar"><i style="width:${pctW}%"></i></span></button>`;
        }).join("")
      : `<p class="mil-hint" style="padding:10px">该分类下暂无上下文段落。</p>`;
  }

  /* ───────────── 现场页渲染（预定与盯梢 + 时间线 + Muse 步骤复盘） ───────────── */
  function collectIntents(snap) {
    const map = new Map();
    [...(snap?.scheduled_intents || []), ...(snap?.watches || [])].forEach((it) => {
      if (it && it.intent_id) map.set(it.intent_id, it);
    });
    return [...map.values()];
  }

  const HB_OUTCOME_LABEL = {
    miss: "想念",
    explore: "逛逛",
    "ok:no_reason": "无由头",
    "ok:model": "静默",
    "ok:fallback": "跳过",
    "skip:schedule": "略过",
  };
  function renderHeartbeatTicks(snap) {
    const box = $("#now-hb-ticks");
    if (!box) return;
    const ticks = Array.isArray(snap?.heartbeat_ticks) ? snap.heartbeat_ticks : [];
    const mode = snap?.pulse?.heartbeat_mode || (snap?.pulse?.heartbeat_enabled ? "gentle" : "off");
    const modeName = mode === "lively" ? "活泼" : mode === "gentle" ? "克制" : "关";
    if (!ticks.length && mode === "off") {
      box.hidden = true;
      box.innerHTML = "";
      return;
    }
    box.hidden = false;
    const eff = snap?.pulse?.heartbeat_effective || (mode === "off" ? "关闭" : "想念");
    const tags = [`<span class="mil-tag ${mode === "off" ? "mil-tag--off" : "mil-tag--ok"}">心跳：${esc(modeName)} · ${esc(eff)}</span>`];
    ticks.slice(0, 3).forEach((t) => {
      const lbl = HB_OUTCOME_LABEL[t.outcome] || t.outcome || "跳动";
      const det = String(t.detail || "").trim();
      const cls = t.outcome === "miss" || t.outcome === "explore" ? "mil-tag--hot" : "";
      tags.push(`<span class="mil-tag ${cls}" title="${esc(det)}">${esc(fmtTime(t.at))} ${esc(lbl)}${det ? ` · ${esc(det.slice(0, 22))}` : ""}</span>`);
    });
    box.innerHTML = tags.join("");
  }

  function renderIntents(snap) {
    const box = $("#now-intents");
    const cnt = $("#now-intent-count");
    if (!box) return;
    const list = collectIntents(snap);
    if (cnt) cnt.textContent = `${list.length} 项`;
    if (!list.length) {
      box.innerHTML = `<div class="mil-hint">暂无预定或盯梢项</div>`;
      return;
    }
    const HISTORY_STATES = new Set(["idle", "done", "completed", "finished", "closed", "stopped", "cancelled", "failed", "error", "archived"]);
    box.innerHTML = list.map((it) => {
      const isWatch = it.mode === "watch" || it.kind === "watch" || Boolean(it.condition);
      const isPaused = it.status === "paused";
      const dueStr = it.due_at ? fmtTime(it.due_at) : (it.daily_at ? `每日 ${it.daily_at}` : it.every_seconds ? `每 ${it.every_seconds}s` : "周期");
      const kindCls = isWatch ? "mil-tag--hot" : "mil-tag--ok";
      return `<div class="now-intent-card" data-intent-id="${esc(it.intent_id)}">
        <div class="now-card-head">
          <div class="now-card-title">
            <span class="mil-tag ${kindCls}">${isWatch ? "盯梢" : "预定"}</span>
            <span class="now-card-title-txt">${esc(it.reason || it.kind_label || it.intent_id)}</span>
          </div>
          <span class="mil-tag ${isPaused ? "mil-tag--off" : "mil-tag--ok"}">${isPaused ? "已暂停" : "等待中"}</span>
        </div>
        <div class="now-card-meta">
          <span>下次 ${esc(dueStr)}</span>
          ${it.chat_id ? `<span>·</span>${renderChatBadgeHtml(snap, it.chat_id, { size: 16, platSize: 11 })}` : ""}
          ${it.profile ? `<span class="mono">· ${esc(it.profile)}</span>` : ""}
        </div>
        ${it.condition ? `<div class="now-intent-cond">触发条件：${esc(it.condition)}</div>` : ""}
        <div class="mil-row" style="gap:6px">
          <button type="button" class="mil-key mil-key--sm" data-intent-act="${isPaused ? "intent_resume" : "intent_pause"}" data-intent-id="${esc(it.intent_id)}">${isPaused ? "恢复" : "暂停"}</button>
          <button type="button" class="mil-key mil-key--sm" data-intent-act="intent_run_now" data-intent-id="${esc(it.intent_id)}">立即跑一次</button>
          <button type="button" class="mil-key mil-key--sm mil-key--danger" data-intent-act="intent_delete" data-intent-id="${esc(it.intent_id)}">取消</button>
        </div>
      </div>`;
    }).join("");
  }

  let latestUpdateInfo = {};
  function closeUpdatePopover(returnFocus = false) {
    const pop = $("#ms-upd-pop");
    const chip = $("#ms-upd-chip");
    if (pop && !pop.hidden) pop.hidden = true;
    if (chip) {
      chip.setAttribute("aria-expanded", "false");
      if (returnFocus) chip.focus();
    }
  }
  function renderUpdateBar(upd, feedbackMsg = "") {
    const info = upd && typeof upd === "object" ? upd : latestUpdateInfo;
    latestUpdateInfo = { ...latestUpdateInfo, ...info };
    const curVer = String(latestUpdateInfo.current_version || "").trim();
    const latestVer = String(latestUpdateInfo.latest_version || "").trim();
    const hasUpd = Boolean(latestUpdateInfo.has_update && latestVer);
    const dismissed = Boolean(latestUpdateInfo.dismissed);
    const showHot = Boolean(latestUpdateInfo.show_banner && hasUpd && !dismissed);
    const checkedAt = Number(latestUpdateInfo.checked_at || 0);
    const lastErr = String(latestUpdateInfo.last_error || "").trim();
    const relUrl = String(latestUpdateInfo.release_url || latestUpdateInfo.repository_url || "").trim();

    const chip = $("#ms-upd-chip");
    const dot = $("#ms-upd-dot");
    const chipTxt = $("#ms-upd-chip-txt");
    if (chip) {
      chip.classList.toggle("mil-key--hot", showHot);
      chip.title = showHot ? `发现新版本 v${latestVer}，点击查看` : `当前版本 ${curVer ? "v" + curVer : "—"}，点击检查更新`;
    }
    if (dot) dot.hidden = !showHot;
    if (chipTxt) {
      chipTxt.textContent = showHot ? `新版 v${latestVer}` : (curVer ? `v${curVer}` : "版本");
    }

    const verEl = $("#ms-upd-pop-ver");
    const tagEl = $("#ms-upd-pop-tag");
    const metaEl = $("#ms-upd-pop-meta");
    const relBox = $("#ms-upd-rel-box");
    const titleEl = $("#ms-upd-rel-title");
    const dateEl = $("#ms-upd-rel-date");
    const notesEl = $("#ms-upd-notes");
    const openLink = $("#ms-upd-open-url");
    const copyBtn = $("#ms-upd-copy-url");
    const disBtn = $("#ms-upd-toggle-dismiss");

    if (verEl) verEl.textContent = curVer ? `v${curVer}` : "—";
    if (tagEl) {
      if (lastErr && !hasUpd) {
        tagEl.className = "mil-tag mil-tag--warn";
        tagEl.textContent = "检查失败";
      } else if (hasUpd && dismissed) {
        tagEl.className = "mil-tag mil-tag--off";
        tagEl.textContent = `已忽略 v${latestVer}`;
      } else if (hasUpd) {
        tagEl.className = "mil-tag mil-tag--hot";
        tagEl.textContent = `可更新 v${latestVer}`;
      } else if (checkedAt > 0) {
        tagEl.className = "mil-tag mil-tag--ok";
        tagEl.textContent = "已是最新";
      } else {
        tagEl.className = "mil-tag";
        tagEl.textContent = "未检查";
      }
    }
    if (metaEl) {
      if (feedbackMsg) {
        metaEl.textContent = feedbackMsg;
      } else if (lastErr) {
        metaEl.textContent = lastErr;
      } else if (hasUpd) {
        metaEl.textContent = `${checkedAt > 0 ? "检查于 " + fmtTime(checkedAt) + " · " : ""}${dismissed ? "已忽略气泡红点，点下方可恢复" : "检测到新正式版本"}`;
      } else if (checkedAt > 0) {
        metaEl.textContent = `检查于 ${fmtTime(checkedAt)} · 当前已是最新版本`;
      } else {
        metaEl.textContent = "每 12 小时静默检查，也可随时点右上角手动检测";
      }
    }
    if (relBox) {
      relBox.hidden = !hasUpd;
      if (hasUpd) {
        if (titleEl) titleEl.textContent = latestUpdateInfo.release_name || `Maisya v${latestVer}`;
        if (dateEl) dateEl.textContent = latestUpdateInfo.published_at ? String(latestUpdateInfo.published_at).slice(0, 10) : "";
        const notes = String(latestUpdateInfo.notes || latestUpdateInfo.summary || "").trim();
        if (notesEl) {
          notesEl.hidden = !notes;
          notesEl.textContent = notes;
        }
        if (openLink) {
          openLink.hidden = !relUrl;
          if (relUrl) openLink.href = relUrl;
        }
        if (copyBtn) copyBtn.hidden = !relUrl;
        if (disBtn) {
          disBtn.textContent = dismissed ? "恢复提醒" : "忽略此版";
          disBtn.dataset.updAction = dismissed ? "undismiss" : "dismiss";
          disBtn.dataset.updVersion = latestVer;
        }
        relBox.dataset.releaseUrl = relUrl;
      }
    }
    const autoEl = $("#ms-upd-auto");
    if (autoEl && typeof latestUpdateInfo.check_enabled === "boolean") autoEl.checked = latestUpdateInfo.check_enabled;
    const notifyEl = $("#ms-upd-notify");
    if (notifyEl && typeof latestUpdateInfo.notify_admin === "boolean") notifyEl.checked = latestUpdateInfo.notify_admin;
  }
  window.MaisyaUpdateBar = { render: renderUpdateBar, close: closeUpdatePopover };

  function renderPendingProposalBar(snap) {
    const props = Array.isArray(snap?.pending_skill_proposals) ? snap.pending_skill_proposals : [];
    const cnt = Number(snap?.pending_skill_proposals_count ?? props.length);
    const navBadge = $("#nav-ab-prop-badge");
    if (navBadge) {
      navBadge.hidden = cnt <= 0;
    }
    const bar = $("#now-skill-draft-bar");
    const txt = $("#now-skill-draft-txt");
    if (bar && txt) {
      bar.hidden = cnt <= 0;
      if (cnt > 0) {
        const allPlanner = props.length > 0 && props.every((p) => p.profile_id === "planner" || p.skill_id === "planner-manual");
        const names = props.slice(0, 2).map((p) => p.title || p.skill_id).filter(Boolean).join("、");
        if (allPlanner) {
          txt.textContent = cnt > 1 ? `最近沉淀出 ${cnt} 条调度经验草稿（${names}），前往确认写入调度手册。` : `最近沉淀出调度经验「${names || "调度规则"}」，点击前往确认写入。`;
        } else {
          txt.textContent = cnt > 1 ? `最近复盘整理出 ${cnt} 个新技能草稿（${names}），预览保存后即可自动沿用。` : `最近复盘整理出新技能「${names || props[0]?.skill_id || "新技能"}」，点击预览保存后即可复用。`;
        }
      }
    }
  }

  function renderThreads(snap) {
    const box = $("#now-threads");
    const cnt = $("#now-thread-count");
    if (!box) return;
    const raw = snap?.threads || [];
    const chatSel = $("#now-thread-chat");
    if (chatSel) {
      const chatIds = [...new Set(raw.map((t) => t.chat_id).filter(Boolean))];
      if (state.thChat && !chatIds.includes(state.thChat)) state.thChat = "";
      chatSel.innerHTML = `<option value="">全部会话</option>` + chatIds.map((cid) => {
        const nm = cid === "self" ? "自身探索" : chatDisplayName(snap, cid);
        return `<option value="${esc(cid)}">${esc(nm)}</option>`;
      }).join("");
      chatSel.value = state.thChat || "";
    }
    const q = state.thQuery.trim().toLowerCase();
    const HISTORY_STATES = new Set(["idle", "done", "completed", "finished", "closed", "stopped", "cancelled", "failed", "error", "archived"]);
    const list = raw.filter((t) => {
      if (state.thChat && t.chat_id !== state.thChat) return false;
      if (state.thFilter === "running" && !["active", "running", "waiting"].includes(t.state)) return false;
      if (state.thFilter === "approval" && !t.pending_approval) return false;
      if (state.thFilter === "history" && !HISTORY_STATES.has(t.state)) return false;
      if (q) {
        const hay = `${t.title || ""} ${t.excerpt || ""} ${t.profile || ""} ${t.chat_id || ""} ${chatDisplayName(snap, t.chat_id)}`.toLowerCase();
        if (!hay.includes(q)) return false;
      }
      return true;
    });
    if (cnt) cnt.textContent = `${list.length} 条`;
    if (!list.length) {
      box.innerHTML = `<div class="mil-hint">没有匹配当前筛选的活动线程</div>`;
      return;
    }
    box.innerHTML = list.map((t) => {
      const st = STATE_LABEL[t.pending_approval ? "pending_approval" : t.state] || [t.state ? String(t.state) : "已结束", "mil-tag--off", ""];
      const on = t.thread_id === state.threadId;
      const seed = t.fish_seed || profileFishSeedFromSnap(snap, t.profile);
      const fish = roleFishHtml(t.profile || "default", seed, 24, { still: !["active", "running"].includes(t.state) });
      const tok = t.total_tokens ? `${fmtK(t.total_tokens)} tok` : "";
      return `<div class="now-thread-card${on ? " is-selected" : ""}" role="button" tabindex="0" data-thread-id="${esc(t.thread_id)}">
        <div class="now-card-head">
          <div class="now-card-title">${fish}<span class="now-card-title-txt">${esc(t.title || t.thread_id)}</span></div>
          <span class="mil-tag ${st[1]}">${t.pending_approval ? "等待审批" : st[0]}</span>
        </div>
        <div class="now-card-meta">
          ${renderChatBadgeHtml(snap, t.chat_id, { size: 18, platSize: 12 })}
          <span class="mono">· ${esc(t.profile || "default")}</span>
          ${tok ? `<span class="num">· ${esc(tok)}</span>` : ""}
          <span>· ${fmtTime(t.updated || t.created)}</span>
        </div>
      </div>`;
    }).join("");
  }

  function renderSelectedStage(snap) {
    const sel = selectedForView(snap);
    const topLed = $("#top-led");
    const topTxt = $("#top-state-text");
    const threads = snap?.threads || [];
    const anyRun = threads.some((t) => ["active", "running", "waiting"].includes(t.state) || t.pending_approval);
    if (topLed) topLed.className = `mil-led${anyRun ? " mil-led--run" : ""}`;
    if (topTxt) topTxt.textContent = anyRun ? "活动中" : "待命";

    const fishEl = $("#now-sel-fish");
    const titleEl = $("#now-sel-title");
    const metaEl = $("#now-sel-meta");
    const stateTag = $("#now-sel-state");
    const reopenBtn = $("#now-reopen-btn");
    const apprBar = $("#now-approval-bar");
    const ctrlBar = $("#now-controls-bar");
    const steerBtn = $("#now-steer-btn");
    const stopBtn = $("#now-stop-btn");
    const stepsWrap = $("#now-step-timeline");

    const delThreadBtn = $("#now-del-thread-btn");
    if (!sel) {
      if (delThreadBtn) delThreadBtn.hidden = true;
      if (fishEl) fishEl.innerHTML = "";
      if (titleEl) titleEl.textContent = "尚未选中线程";
      if (metaEl) metaEl.textContent = "在左侧点选活动，查看步骤链与上下文方块图";
      if (stateTag) { stateTag.textContent = "待命"; stateTag.className = "mil-tag"; }
      if (reopenBtn) reopenBtn.hidden = true;
      if (apprBar) apprBar.hidden = true;
      if (ctrlBar) ctrlBar.hidden = true;
      if (steerBtn) steerBtn.hidden = true;
      if (stopBtn) stopBtn.hidden = true;
      if (stepsWrap) stepsWrap.innerHTML = `<div class="mil-hint">暂无步骤事件</div>`;
      $("#now-conclusion").textContent = "选中线程后在这里汇总结论与生成产物。";
      $("#now-attachments").innerHTML = "";
      const snBox = $("#now-state-note-box");
      if (snBox) snBox.hidden = true;
      const snEl = $("#now-state-note");
      if (snEl) snEl.textContent = "";
      return;
    }

    const stInfo = STATE_LABEL[sel.pending_approval ? "pending_approval" : sel.state] || [sel.state ? String(sel.state) : "已结束", "mil-tag--off", ""];
    if (fishEl) fishEl.innerHTML = roleFishHtml(sel.profile || "default", sel.fish_seed || profileFishSeedFromSnap(snap, sel.profile), 28, { still: !["active", "running"].includes(sel.state) });
    if (titleEl) titleEl.textContent = sel.title || sel.thread_id;
    if (metaEl) metaEl.innerHTML = `${renderChatBadgeHtml(snap, sel.chat_id, { size: 18, platSize: 12, showRawId: true })}<span>·</span><span class="mono">${esc(sel.profile || "default")}</span>${sel.workspace ? `<span>· 工作区 ${esc(sel.workspace)}</span>` : ""}`;
    if (stateTag) { stateTag.textContent = sel.pending_approval ? "待审批" : stInfo[0]; stateTag.className = `mil-tag ${stInfo[1]}`; }
    if (reopenBtn) reopenBtn.hidden = true;
    const noteIn = $("#now-note-input");
    const isRunningNow = ["active", "running", "waiting"].includes(sel.state) || Boolean(sel.pending_approval);
    if (noteIn) {
      noteIn.placeholder = isRunningNow
        ? "给当前活动补充提示或转向说明…"
        : "输入后续要求，直接唤醒并顺着当前上下文继续…";
    }

    const appr = sel.pending_approval || null;
    if (apprBar) {
      apprBar.hidden = !appr;
      if (appr) {
        $("#now-appr-title").textContent = `等待授权：${appr.summary || appr.tool || appr.action_key || "高危操作"}`;
        $("#now-appr-risk").textContent = appr.risk_level || appr.category || "需要确认";
        $("#now-appr-detail").textContent = appr.reason || "请决定仅本次允许、本轮会话允许、长期记住，或拒绝该动作。";
        const cmdEl = $("#now-appr-cmd");
        if (appr.command) { cmdEl.hidden = false; cmdEl.textContent = String(appr.command); }
        else cmdEl.hidden = true;
      }
    }

    const isRunning = ["active", "running", "waiting"].includes(sel.state) || Boolean(appr);
    if (delThreadBtn) delThreadBtn.hidden = !sel.can_delete || isRunning;
    if (ctrlBar) ctrlBar.hidden = false;
    if (steerBtn) steerBtn.hidden = !isRunning;
    if (stopBtn) stopBtn.hidden = !isRunning;

    // 垂直步骤时间线
    const steps = Array.isArray(sel.steps) && sel.steps.length
      ? sel.steps
      : (snap?.events || []).map((ev, idx) => ({
          id: ev.seq ?? idx,
          seq: ev.seq ?? idx + 1,
          kind: ev.kind || "tool",
          title: ev.title || ev.kind || `步骤 #${ev.seq ?? idx + 1}`,
          status: "done",
          duration_ms: ev.duration_ms,
          command: ev.command,
          args: ev.args,
          redacted_output: ev.text,
          output_preview: ev.text,
          at: ev.at,
        }));
    const STEP_KIND_CN = { trigger: "触发", thought: "思考", tool: "工具调用", command: "执行命令", wait: "等待", deliver: "交付", error: "异常", opened: "启动", input: "输入", output: "输出", finished: "完成", reopened: "唤醒", stopped: "停止", steer: "转向", context_prune: "压缩" };
    const STEP_STATUS_CN = { ok: "完成", done: "完成", running: "执行中", waiting: "待确认", stopped: "已停止", error: "异常", denied: "已拒绝" };
    stepsWrap.innerHTML = steps.length
      ? steps.map((s, idx) => {
          const sid = String(s.id ?? s.seq ?? idx);
          const active = state.viewMode === "step" && state.selectedStepId === sid;
          const stCls = s.status === "error" || s.status === "denied" ? "is-error" : s.status === "running" ? "is-running" : s.status === "waiting" ? "is-waiting" : "is-done";
          const kLabel = STEP_KIND_CN[s.kind] || s.kind || "步骤";
          const stLabel = STEP_STATUS_CN[s.status] || s.status || "完成";
          const dur = fmtMs(s.duration_ms);
          return `<button type="button" class="now-step-btn ${stCls}${active ? " is-active" : ""}" data-step-id="${esc(sid)}">
            <div class="now-card-head">
              <strong style="font-size:12.5px">${esc(s.title || s.tool || kLabel)}</strong>
              ${dur ? `<span class="num mil-hint">${esc(dur)}</span>` : ""}
            </div>
            <div class="now-card-meta"><span>${esc(kLabel)}</span>${s.tool ? `<span class="mono">· ${esc(s.tool)}</span>` : ""}<span>· ${esc(stLabel)}</span></div>
          </button>`;
        }).join("")
      : `<div class="mil-hint">当前线程暂无步骤明细</div>`;

    // 结论与附件芯片
    const resText = sel.result?.error ? `错误：${sel.result.error}` : (sel.result?.text || sel.summary || sel.excerpt || "线程准备就绪或执行中，尚未产出最终文字结论。");
    $("#now-conclusion").textContent = resText;
    const snBox = $("#now-state-note-box");
    const snEl = $("#now-state-note");
    const sNote = String(sel.state_note || "").trim();
    if (snBox && snEl) {
      snBox.hidden = !sNote;
      snEl.textContent = sNote;
    }
    const atts = Array.isArray(sel.artifacts) && sel.artifacts.length ? sel.artifacts : (sel.attachments || []);
    $("#now-attachments").innerHTML = atts.map((att) =>
      `<button type="button" class="mil-key mil-key--sm" data-jump-lib="${esc(att.handle || att.id || att.path || "")}">${esc(att.title || att.name || "查看产物")}</button>`
    ).join("");

    // 切换 总览 vs 单步命令详情
    const ovPane = $("#now-view-overview");
    const stPane = $("#now-view-step");
    const activeStep = steps.find((s, idx) => String(s.id ?? s.seq ?? idx) === state.selectedStepId);
    if (state.viewMode === "step" && activeStep) {
      ovPane.hidden = true;
      stPane.hidden = false;
      $("#now-step-title").textContent = activeStep.title || activeStep.tool || "步骤详情";
      $("#now-step-meta").textContent = `${STEP_KIND_CN[activeStep.kind] || activeStep.kind || "步骤"} · 状态 ${activeStep.status || "done"}${activeStep.duration_ms != null ? ` · 耗时 ${fmtMs(activeStep.duration_ms)}` : ""}`;
      const argsVal = activeStep.command || (typeof activeStep.args === "string" ? activeStep.args : activeStep.args ? JSON.stringify(activeStep.args, null, 2) : "（无命令行或参数记录）");
      $("#now-step-args").textContent = argsVal;
      $("#now-step-output").textContent = activeStep.redacted_output || activeStep.output_preview || "（暂无脱敏输出）";
    } else {
      state.viewMode = "overview";
      ovPane.hidden = false;
      stPane.hidden = true;
    }
  }

  let launchChatQuery = "";
  function renderLaunchAssist(snap) {
    const ic = window.MaisyaIcons;
    const chevSvg = ic?.ctrl ? ic.ctrl("chevron_d", 14, 1.9) : "";
    const searchSvg = ic?.ctrl ? ic.ctrl("search", 14, 1.9) : "";
    const checkSvg = ic?.ctrl ? ic.ctrl("check", 13, 2) : "";

    const rawCards = Array.isArray(snap?.profile_cards) && snap.profile_cards.length
      ? snap.profile_cards.filter((c) => c && c.enabled !== false)
      : (snap?.profiles || ["default"]).map((id) => ({ id, title: id, fish_seed: "" }));
    const pIn = $("#launch-profile");
    const pLbl = $("#launch-profile-label");
    const pChev = $("#launch-profile-chev");
    const pOpts = $("#launch-profile-options");
    const curPid = (pIn?.value || "").trim() || rawCards[0]?.id || "default";
    if (pIn) pIn.value = curPid;
    if (pChev) pChev.innerHTML = chevSvg;
    const curCard = rawCards.find((c) => c.id === curPid) || { id: curPid, title: curPid, fish_seed: "" };
    if (pLbl) {
      const fish = roleFishHtml(curCard.id, curCard.fish_seed || "", 20, { still: true });
      pLbl.innerHTML = `${fish}<span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(curCard.title || curCard.name || curCard.id)}</span><span class="mil-hint mono">${esc(curCard.id)}</span>`;
    }
    if (pOpts) {
      pOpts.innerHTML = rawCards.map((c) => {
        const isSel = c.id === curPid;
        const fish = roleFishHtml(c.id, c.fish_seed || "", 20, { still: true });
        return `<button type="button" class="ms-model-opt" role="option" aria-selected="${isSel ? "true" : "false"}" data-launch-pick-profile="${esc(c.id)}">
          <span class="mil-row" style="gap:8px;min-width:0">
            ${fish}
            <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:600">${esc(c.title || c.name || c.id)}</span>
            <span class="mil-hint mono">${esc(c.id)}</span>
          </span>
          ${isSel ? `<span class="mil-inline-ic">${checkSvg}</span>` : ""}
        </button>`;
      }).join("");
    }

    const enabledChats = Array.isArray(snap?.enabled_chats) ? snap.enabled_chats : [];
    const recentDms = Array.isArray(snap?.recent_dms) ? snap.recent_dms.map((d) => d?.chat_id).filter(Boolean) : [];
    const allChatIds = [...new Set([...enabledChats, ...recentDms, "self"])];
    const cIn = $("#launch-chat");
    const cLbl = $("#launch-chat-label");
    const cChev = $("#launch-chat-chev");
    const cSearchIc = $("#launch-chat-search-ic");
    const cOpts = $("#launch-chat-options");
    let curCid = (cIn?.value || "").trim();
    if (!curCid) {
      curCid = enabledChats[0] || "self";
      if (cIn) cIn.value = curCid;
    }
    if (cChev) cChev.innerHTML = chevSvg;
    if (cSearchIc) cSearchIc.innerHTML = searchSvg;
    if (cLbl) {
      cLbl.innerHTML = renderChatBadgeHtml(snap, curCid, { size: 18, platSize: 12, showRawId: curCid !== "self" });
    }
    if (cOpts) {
      const q = launchChatQuery.trim().toLowerCase();
      const filteredCids = allChatIds.filter((cid) => {
        if (!q) return true;
        const m = resolveChatMeta(snap, cid);
        return `${m.name} ${m.rawId} ${cid}`.toLowerCase().includes(q);
      });
      cOpts.innerHTML = filteredCids.length
        ? filteredCids.map((cid) => {
            const isSel = cid === curCid;
            return `<button type="button" class="ms-model-opt" role="option" aria-selected="${isSel ? "true" : "false"}" data-launch-pick-chat="${esc(cid)}">
              <span class="mil-row" style="gap:6px;min-width:0">${renderChatBadgeHtml(snap, cid, { size: 18, platSize: 12, showType: cid !== "self", showRawId: cid !== "self" })}</span>
              ${isSel ? `<span class="mil-inline-ic">${checkSvg}</span>` : ""}
            </button>`;
          }).join("")
        : `<div class="mil-hint" style="padding:8px">无匹配会话，请先在「设置」开启目标聊天流</div>`;
    }

    const wsSel = $("#launch-ws-select");
    const wsIn = $("#launch-workspace");
    if (wsSel) {
      const prevVal = wsSel.value;
      const namedWs = Array.isArray(snap?.named_workspaces) ? snap.named_workspaces : [];
      wsSel.innerHTML = `<option value="">不绑定（单次临时任务）</option>`
        + namedWs.map((w) => `<option value="${esc(w.name)}">${esc(w.name)}${w.profile ? ` · ${esc(w.profile)}` : ""}</option>`).join("")
        + `<option value="__new__">+ 新建持久工作区…</option>`;
      if ([...wsSel.options].some((o) => o.value === prevVal)) wsSel.value = prevVal;
      if (wsIn && wsSel.value !== "__new__") {
        wsIn.hidden = true;
        wsIn.value = wsSel.value || "";
      }
    }
    const intChatSel = $("#now-new-int-chat");
    if (intChatSel) {
      const prevC = intChatSel.value;
      intChatSel.innerHTML = allChatIds.map((cid) => `<option value="${esc(cid)}">${esc(cid === "self" ? "自身公开探索 (self)" : chatDisplayName(snap, cid))}</option>`).join("");
      if (prevC && allChatIds.includes(prevC)) intChatSel.value = prevC;
      else if (enabledChats[0]) intChatSel.value = enabledChats[0];
    }
    const intProfSel = $("#now-new-int-profile");
    if (intProfSel) {
      const prevP = intProfSel.value;
      intProfSel.innerHTML = rawCards.map((c) => `<option value="${esc(c.id)}">${esc(c.title || c.name || c.id)} (${esc(c.id)})</option>`).join("");
      if (prevP && rawCards.some((c) => c.id === prevP)) intProfSel.value = prevP;
    }
  }

  async function loadThreadDetail(tid) {
    if (!tid) return;
    const res = await hostRpc("read", "now_detail", { thread_id: tid });
    if (disposed || activePage !== "now" || tid !== state.threadId) return;
    if (res?.success && (res.selected || res.thread)) {
      state.selectedDetail = { ...(res.thread || {}), ...(res.selected || {}), steps: res.steps || res.selected?.steps, artifacts: res.artifacts || res.selected?.artifacts, context: res.context || res.selected?.context, pending_approval: res.pending_approval ?? res.selected?.pending_approval };
      renderSelectedStage(state.lastSnap);
      renderContext(state.lastSnap);
    }
  }

  async function refresh(reset = false) {
    if (disposed || activePage !== "now") return;
    const reqThread = state.threadId || "";
    const reqCursor = reset ? 0 : state.cursor;
    const startStyleSeq = uiStyleSeq;
    const snap = await enqueueQuery(() => callMaibotRaw("query", "snapshot", { thread_id: reqThread, cursor: reqCursor }));
    if (disposed || activePage !== "now") return;
    if (!snap?.success) {
      setNowFeedback(snap?.error || "现场快照读取失败", true);
      return;
    }
    if (snap.ui_style && startStyleSeq === uiStyleSeq) {
      savedUiStyle = normalizeThemePref(snap.ui_style);
      applyTheme();
    }
    lastSnapshotAt = Date.now();
    state.lastSnap = snap;
    if (typeof snap.cursor === "number") state.cursor = snap.cursor;

    const threads = snap.threads || [];
    if (!state.threadId) {
      const firstId = snap.selected?.thread_id || threads.find((t) => t.pending_approval || ["active", "running", "waiting"].includes(t.state))?.thread_id || threads[0]?.thread_id || "";
      if (firstId) state.threadId = firstId;
    }
    if (snap.selected && (!state.threadId || snap.selected.thread_id === state.threadId)) {
      state.selectedDetail = snap.selected;
    }

    renderUpdateBar(snap.update);
    renderPendingProposalBar(snap);
    renderHeartbeatTicks(snap);
    renderIntents(snap);
    renderThreads(snap);
    renderSelectedStage(snap);
    renderContext(snap);
    renderLaunchAssist(snap);
    maybeAutoOpenOnboarding(snap.onboarding);
  }

  /* ───────────── 五步启动引导弹窗（严格 run_id + sequence 防竞态 + WAAPI 动效 + Tab 焦点围栏） ───────────── */
  const ONB_STEPS = ["hello", "admins", "chats", "runtime", "done"];
  const ONB_ICON_MAP = {
    admin: "shield",
    admins: "shield",
    chats: "chat",
    model: "cpu",
    default_model: "cpu",
    profile: "roles",
    default_profile: "roles",
    toolsets: "sliders",
    toolsets_mcp: "sliders",
    runtime: "exec",
    sandbox: "exec",
    safety: "shield",
    permission: "shield",
  };
  const onb = {
    open: false,
    sessionDismissed: false,
    stepIdx: 0,
    runId: "",
    seq: 0,
    probeSeq: 0,
    probePending: false,
    probeResult: null,
    info: null,
    advancing: false,
    stepNavSeq: 0,
    draftAdmins: null,
    draftChats: null,
    draftPluginEnabled: null,
    draftModel: "",
    draftPerm: "",
    draftSandbox: null,
    candQuery: "",
    pickerOpen: false,
    modelQuery: "",
    modelOpen: false,
    anims: [],
    prevFocus: null,
  };

  function settleOnbAnims() {
    onb.anims.forEach((a) => { try { a.finish(); } catch (_) {} });
    onb.anims = [];
    $$("#onb-stage .onb-pane.leaving").forEach((n) => n.remove());
  }

  function stepIndexFromName(name) {
    const idx = ONB_STEPS.indexOf(String(name || "hello"));
    return idx >= 0 ? idx : 0;
  }

  function applyOnbView(view, opts = {}) {
    if (!view || typeof view !== "object") return;
    onb.info = view;
    const mv = view.model_verify && typeof view.model_verify === "object" ? view.model_verify : null;
    const rId = view.run_id || mv?.run_id || "";
    if (rId) onb.runId = String(rId);
    const vSeq = typeof view.sequence === "number" ? view.sequence : (typeof mv?.sequence === "number" ? mv.sequence : null);
    if (vSeq !== null) onb.seq = Math.max(onb.seq, vSeq);
    if (!opts.keepStep && view.current_step) onb.stepIdx = stepIndexFromName(view.current_step);
    if (mv && (!onb.probePending || (typeof mv.sequence === "number" ? mv.sequence >= onb.probeSeq : true))) {
      onb.probeResult = mv;
    }
    if (onb.open && !opts.skipRender) renderOnbStep(opts.dir || 0);
  }

  function maybeAutoOpenOnboarding(obView) {
    if (!obView) return;
    if (!onb.open && !onb.info) applyOnbView(obView);
    if (obView.show === true && !onb.open && !onb.sessionDismissed) {
      openOnboardingModal(obView);
    }
  }

  async function openOnboardingModal(initialView) {
    onb.prevFocus = document.activeElement;
    onb.open = true;
    onb.sessionDismissed = false;
    onb.advancing = false;
    onb.pickerOpen = false;
    onb.modelOpen = false;
    $("#onb-feedback").textContent = "";
    $("#onb-scrim").hidden = false;
    if (initialView) applyOnbView(initialView);
    else renderOnbStep(0);
    $("#onb-close")?.focus();
    const openedNavSeq = onb.stepNavSeq || 0;
    const res = await hostRpc("read", "onboarding", {});
    if (!disposed && onb.open && res?.success) {
      applyOnbView(res.onboarding || res, { keepStep: (onb.stepNavSeq || 0) !== openedNavSeq || onb.advancing });
    }
  }

  function closeOnboardingModal(markDismissed = true) {
    settleOnbAnims();
    onb.open = false;
    onb.pickerOpen = false;
    onb.modelOpen = false;
    if (markDismissed) onb.sessionDismissed = true;
    $("#onb-scrim").hidden = true;
    if (onb.prevFocus && typeof onb.prevFocus.focus === "function") onb.prevFocus.focus();
  }

  function renderOnbItemWithIcon(it, rightHtml) {
    const ic = window.MaisyaIcons;
    const key = ONB_ICON_MAP[it.key] || ONB_ICON_MAP[it.step] || "sliders";
    const icHtml = ic?.mod ? ic.mod(key, 18) : "";
    return `<div class="onb-item">
      <div class="onb-item-l">
        ${icHtml ? `<span class="onb-item-ic" aria-hidden="true">${icHtml}</span>` : ""}
        <div class="onb-item-text">
          <strong style="font-size:12.5px">${esc(it.title || it.key)}</strong>
          <div class="mil-hint">${esc(it.detail || "")}</div>
        </div>
      </div>
      ${rightHtml}
    </div>`;
  }

  function renderOnbCandRows(candChats, sources, query) {
    const q = String(query || "").trim().toLowerCase();
    const filtered = candChats.filter((cid) => {
      if (!q) return true;
      const m = resolveChatMeta(sources, cid);
      return `${m.name} ${m.rawId} ${cid}`.toLowerCase().includes(q);
    });
    if (!filtered.length) return `<div class="mil-hint">没有匹配的未开启会话，可用下方手动添加</div>`;
    return filtered.slice(0, 80).map((cid) => `<div class="ms-stream-row">
      <div class="ms-stream-info">${renderChatBadgeHtml(sources, cid, { size: 20, platSize: 12, showType: true, showRawId: true })}</div>
      <button type="button" class="mil-key mil-key--sm" data-onb-add-chat="${esc(cid)}">添加</button>
    </div>`).join("");
  }

  function renderOnbStep(dir = 0) {
    const stage = $("#onb-stage");
    const dots = $("#onb-dots");
    const prevBtn = $("#onb-prev");
    const nextBtn = $("#onb-next");
    const skipBtn = $("#onb-skip");
    if (!stage) return;

    const idx = Math.max(0, Math.min(ONB_STEPS.length - 1, onb.stepIdx));
    const step = ONB_STEPS[idx];
    const info = onb.info || state.lastSnap?.onboarding || {};
    const items = Array.isArray(info.items) ? info.items : [];
    const adminsInfo = state.lastSnap?.admins_info || {};
    const hostAdmins = info.host_admins || adminsInfo.host_admins || [];
    const pluginAdmins = onb.draftAdmins ?? (info.plugin_admins || info.settings_admins || adminsInfo.plugin_admins || adminsInfo.settings_admins || []);
    const recentDms = info.recent_dms || state.lastSnap?.recent_dms || [];
    const sources = { ...(state.lastSnap?.chat_sources || {}), ...(info.chat_sources || {}) };
    const rawKnownChats = (Array.isArray(info.known_chat_specs) && info.known_chat_specs.length ? info.known_chat_specs : null)
      || info.known_chats
      || state.lastSnap?.known_chat_specs
      || state.lastSnap?.known_chats
      || state.lastSnap?.enabled_chats
      || [];
    const knownChats = [...new Set(rawKnownChats
      .map((c) => {
        if (typeof c === "string") return c;
        const spec = c?.stream_spec || c?.chat_id || "";
        if (spec && c && typeof c === "object" && !sources[spec]) sources[spec] = c;
        return spec;
      })
      .filter(Boolean))];
    const enabledChats = onb.draftChats ?? (info.enabled_chats || state.lastSnap?.enabled_chats || []);
    const models = normalizeModelCatalog(
      (Array.isArray(info.model_catalog) && info.model_catalog.length ? info.model_catalog : null)
        || info.models
        || (Array.isArray(state.lastSnap?.model_catalog) && state.lastSnap.model_catalog.length ? state.lastSnap.model_catalog : null)
        || state.lastSnap?.available_models
        || []
    );
    const curModel = onb.draftModel || info.default_model || state.lastSnap?.default_model || models[0]?.name || "";
    const curPerm = onb.draftPerm || info.permission_mode || state.lastSnap?.permission_mode || "ask_risky";
    const curSandbox = onb.draftSandbox !== null ? onb.draftSandbox : Boolean(info.sandbox_enabled ?? info.sandbox?.enabled ?? state.lastSnap?.sandbox_enabled ?? state.lastSnap?.docker?.enabled);

    if (dots) {
      dots.innerHTML = ONB_STEPS.map((s, i) => `<span class="onb-dot${i === idx ? " is-active" : i < idx ? " is-done" : ""}" title="${esc(s)}"></span>`).join("");
    }
    if (prevBtn) prevBtn.disabled = idx === 0;
    if (nextBtn) nextBtn.textContent = idx === ONB_STEPS.length - 1 ? "完成启用" : "下一步";
    if (skipBtn) skipBtn.hidden = idx === ONB_STEPS.length - 1;

    settleOnbAnims();
    const prevPane = stage.querySelector(".onb-pane");
    const pane = document.createElement("div");
    pane.className = "onb-pane";

    if (step === "hello") {
      pane.innerHTML = `
        <div class="mil-silk">欢迎使用 Maisya · 五步快速就绪</div>
        <div class="mil-hint">按顺序检查权限、聊天范围与默认模型，几步即可完成首次启用。</div>
        <div class="onb-summary-grid">
          ${items.map((it) => renderOnbItemWithIcon(it, `<span class="mil-tag ${it.state === "ok" ? "mil-tag--ok" : it.state === "warn" ? "mil-tag--warn" : "mil-tag--off"}">${it.state === "ok" ? "就绪" : it.state === "warn" ? "建议补齐" : "待设置"}</span>`)).join("")}
        </div>`;
    } else if (step === "admins") {
      onb.draftAdmins = [...pluginAdmins];
      const ic = window.MaisyaIcons;
      const closeIc = ic?.ctrl ? ic.ctrl("close", 12, 2) : "×";
      pane.innerHTML = `
        <div class="mil-silk">第 2 步 · 确认管理员身份</div>
        <div class="mil-hint">宿主管理员与插件管理员可更改插件配置与高权能力，也可以从最近私聊直接加入。</div>
        <div class="mil-field">
          <span class="mil-label">宿主授权管理员（只读）</span>
          <div class="onb-chip-row">${hostAdmins.length ? hostAdmins.map((a) => `<span class="mil-tag mil-tag--ok mono">${esc(a)}</span>`).join("") : `<span class="mil-hint">暂无宿主预设</span>`}</div>
        </div>
        <div class="mil-field">
          <span class="mil-label">插件管理员</span>
          <div class="onb-chip-row" id="onb-admin-chips">${onb.draftAdmins.map((a) => `<button type="button" class="mil-key mil-key--sm mono" data-onb-del-admin="${esc(a)}"><span>${esc(a)}</span><span class="mil-inline-ic">${closeIc}</span></button>`).join("") || `<span class="mil-hint">暂未添加插件管理员</span>`}</div>
        </div>
        ${recentDms.length ? `<div class="mil-field"><span class="mil-label">最近私聊快捷添加</span><div class="onb-chip-row">${recentDms.map((d) => {
          const dmSpec = d.chat_id || (d.platform && d.user_id ? `${d.platform}:private:${d.user_id}` : String(d.user_id || d));
          const dmMeta = resolveChatMeta(sources, typeof d === "object" ? { ...d, chat_id: dmSpec } : dmSpec);
          const platSvg = ic?.platform ? ic.platform(dmMeta.platform, 12) : "";
          return `<button type="button" class="ms-dm-chip" data-onb-add-admin="${esc(dmSpec)}" title="${esc(dmSpec)}">
            ${renderChatAvatarHtml(dmMeta, 18)}
            ${platSvg ? `<span class="ms-chat-plat">${platSvg}</span>` : ""}
            <span class="ms-chat-name">${esc(dmMeta.name)}</span>
            ${dmMeta.rawId && dmMeta.rawId !== dmMeta.name ? `<span class="ms-chat-rawid">${esc(dmMeta.rawId)}</span>` : ""}
          </button>`;
        }).join("")}</div></div>` : ""}
        <div class="mil-field">
          <span class="mil-label">按平台与账号添加管理员</span>
          ${renderStructStreamBuilder("onb-adm", { chatSources: sources, allowGroup: false, allowPrivate: true, chatType: "private", placeholder: "输入用户 ID，例如 10001", ariaLabel: "管理员用户 ID", btnLabel: "添加", btnId: "onb-admin-add-btn" })}
        </div>`;
    } else if (step === "chats") {
      onb.draftChats = [...enabledChats];
      const rawPlg = info.plugin_enabled ?? info.plugin?.enabled ?? state.lastSnap?.plugin_enabled ?? state.lastSnap?.pulse?.enabled;
      if (onb.draftPluginEnabled === null) {
        const isFirstColdStart = (info.show === true && !info.completed_at && info.status !== "completed");
        onb.draftPluginEnabled = rawPlg === undefined ? true : (isFirstColdStart && rawPlg === false ? true : Boolean(rawPlg));
      }
      const enabledSet = new Set(onb.draftChats);
      const candChats = knownChats.filter((cid) => !enabledSet.has(cid));
      pane.innerHTML = `
        <div class="mil-silk">第 3 步 · 启用开关与会话范围</div>
        <div class="mil-hint">开启总开关并添加需要启用插件的群聊或私聊。</div>
        <div class="ms-entry-row">
          <div class="ms-entry-meta">
            <strong class="ms-entry-title">启用 Maisya 插件总开关</strong>
          </div>
          <label class="mil-switch">
            <input type="checkbox" id="onb-plugin-enabled" ${onb.draftPluginEnabled ? "checked" : ""} />
            <span class="mil-switch-track"></span>
          </label>
        </div>
        <div class="mil-row" style="justify-content:space-between;align-items:center">
          <span class="mil-label">已开启会话（${onb.draftChats.length} 个）</span>
          <button type="button" class="mil-key mil-key--sm" id="onb-open-chat-picker">${onb.pickerOpen ? "收起候选列表" : `+ 添加聊天流${candChats.length ? ` (${candChats.length})` : ""}`}</button>
        </div>
        <div class="ms-stream-picker" id="onb-chat-picker" ${onb.pickerOpen ? "" : "hidden"}>
          <input type="search" class="mil-input" id="onb-chat-cand-search" placeholder="搜索群名、私聊名称或 ID..." value="${esc(onb.candQuery)}" aria-label="搜索候选聊天流" />
          <div class="ms-stream-cand-list" id="onb-chat-cand-list">${renderOnbCandRows(candChats, sources, onb.candQuery)}</div>
        </div>
        <div class="ms-entry-list" id="onb-chat-list">
          ${onb.draftChats.length ? onb.draftChats.map((cid) => `<div class="ms-stream-row" data-chat-row="${esc(cid)}">
            <div class="ms-stream-info">${renderChatBadgeHtml(sources, cid, { size: 22, platSize: 13, showType: true, showRawId: true })}</div>
            <button type="button" class="mil-key mil-key--sm mil-key--danger" data-onb-del-chat="${esc(cid)}">移除</button>
          </div>`).join("") : `<div class="mil-hint">暂未开启任何会话，请从上方「+ 添加聊天流」选择或下方手动添加。</div>`}
        </div>
        <div class="mil-field">
          <span class="mil-label">手动指定聊天流</span>
          ${renderStructStreamBuilder("onb-chat", { chatSources: sources, allowGroup: true, allowPrivate: true, chatType: "group", placeholder: "输入群号或用户 ID，例如 100246809", ariaLabel: "聊天流群号或用户 ID", btnLabel: "添加会话", btnId: "onb-chat-add-btn" })}
        </div>`;
    } else if (step === "runtime") {
      const pr = onb.probeResult;
      const isFail = pr?.state === "error" || pr?.state === "failed";
      const prTxt = onb.probePending ? "正在探测模型连通性…" : pr?.message ? `${pr.state === "ok" ? "连通正常" : "连通失败"}：${pr.message}${pr.duration_ms ? ` (${pr.duration_ms}ms)` : ""}` : "完成前建议测试一次默认模型连通性";
      const prCls = onb.probePending ? "mil-tag mil-tag--warn" : pr?.state === "ok" ? "mil-tag mil-tag--ok" : isFail ? "mil-tag mil-tag--bad" : "mil-tag";
      pane.innerHTML = `
        <div class="mil-silk">第 4 步 · 默认模型、授权与安全沙箱</div>
        <div class="mil-grid-2">
          <div class="mil-field">
            <label class="mil-label" for="onb-model-trigger">默认任务模型</label>
            ${renderSingleModelBoxHtml({
              boxId: "onb-model-box",
              inputId: "onb-model",
              triggerId: "onb-model-trigger",
              dropId: "onb-model-drop",
              searchId: "onb-model-search",
              listId: "onb-model-list",
              models,
              value: curModel,
              query: onb.modelQuery,
            })}
          </div>
          <div class="mil-field">
            <label class="mil-label" for="onb-perm">默认授权策略</label>
            <select class="mil-select" id="onb-perm">
              <option value="ask_risky" ${curPerm === "ask_risky" ? "selected" : ""}>仅高危操作确认</option>
              <option value="autonomous" ${curPerm === "autonomous" ? "selected" : ""}>受托自主执行</option>
              <option value="always_ask" ${curPerm === "always_ask" ? "selected" : ""}>每次操作都确认</option>
            </select>
          </div>
        </div>
        <label class="mil-switch">
          <input type="checkbox" id="onb-sandbox" ${curSandbox ? "checked" : ""} />
          <span class="mil-switch-track"></span>
          <span class="mil-switch-txt">默认优先启用轻量 Docker 沙箱</span>
        </label>
        <div class="now-summary-box">
          <div class="now-card-head">
            <span class="mil-tag mil-tag--wrap ${prCls}" id="onb-probe-tag">${esc(prTxt)}</span>
            <button type="button" class="mil-key mil-key--sm mil-key--hot" id="onb-probe-btn">测试模型连通</button>
          </div>
        </div>`;
    } else {
      const promptText = "在群里帮我用默认档案总结最近讨论的要点";
      pane.innerHTML = `
        <div class="mil-silk">第 5 步 · 7 项就绪清单</div>
        <div class="onb-summary-grid">
          ${items.map((it) => renderOnbItemWithIcon(it, `<button type="button" class="mil-key mil-key--sm" data-onb-jump-step="${esc(it.step || "hello")}">${it.state === "ok" ? "查看" : "去完善"}</button>`)).join("")}
        </div>
        <div class="now-summary-box">
          <div class="now-card-head">
            <span class="mil-label">推荐测试消息</span>
            <button type="button" class="mil-key mil-key--sm" data-onb-copy="${esc(promptText)}">复制</button>
          </div>
          <code class="mono" style="font-size:12px">${esc(promptText)}</code>
        </div>`;
    }

    stage.appendChild(pane);
    if (prevPane) {
      if (dir === 0 || calm() || typeof pane.animate !== "function") {
        prevPane.remove();
      } else {
        prevPane.classList.add("leaving");
        const offset = dir > 0 ? 22 : -22;
        const aOut = prevPane.animate([{ opacity: 1, transform: "translateX(0)" }, { opacity: 0, transform: `translateX(${-offset}px)` }], { duration: 170, easing: "cubic-bezier(0.22,1,0.36,1)", fill: "forwards" });
        const aIn = pane.animate([{ opacity: 0, transform: `translateX(${offset}px)` }, { opacity: 1, transform: "translateX(0)" }], { duration: 170, easing: "cubic-bezier(0.22,1,0.36,1)", fill: "forwards" });
        onb.anims.push(aOut, aIn);
        aOut.finished.then(() => prevPane.remove()).catch(() => prevPane.remove());
      }
    }
  }

  async function onbStepMutation(actionName, payloadBuilder, opts = {}) {
    const reqRunId = onb.runId || onb.info?.run_id || onb.info?.model_verify?.run_id || "";
    const reqSeq = ++onb.seq;
    const body = { ...(payloadBuilder ? payloadBuilder() : {}), run_id: reqRunId, sequence: reqSeq };
    const res = await hostRpc("write", actionName, body);
    if (disposed || !onb.open) return res;
    const view = res?.onboarding && typeof res.onboarding === "object" ? res.onboarding : res;
    const resRunId = res?.run_id || view?.run_id || view?.model_verify?.run_id || "";
    if (res?.stale || (resRunId && reqRunId && resRunId !== reqRunId && actionName !== "onboarding_reopen")) {
      return res;
    }
    if (reqSeq !== onb.seq && actionName === "onboarding_verify_model") return res;
    if (!res?.success) {
      $("#onb-feedback").textContent = String(res?.error || "引导操作失败");
      $("#onb-feedback").className = "mil-feedback mil-feedback--err";
      return res;
    }
    $("#onb-feedback").textContent = "";
    $("#onb-feedback").className = "mil-feedback";
    applyOnbView(view, {
      keepStep: Boolean(opts.keepStep || actionName === "onboarding_verify_model"),
      skipRender: Boolean(opts.skipRender),
      dir: opts.dir || 0,
    });
    return res;
  }

  async function triggerOnbModelProbe() {
    const reqRunId = onb.runId || onb.info?.run_id || onb.info?.model_verify?.run_id || "";
    const curProbeSeq = ++onb.probeSeq;
    const seq = ++onb.seq;
    const modelName = $("#onb-model")?.value || onb.draftModel || "";
    onb.draftModel = modelName;
    onb.probePending = true;
    const tag = $("#onb-probe-tag");
    if (tag) { tag.textContent = "正在探测模型连通性…"; tag.className = "mil-tag mil-tag--warn"; }
    const res = await hostRpc("write", "onboarding_verify_model", { run_id: reqRunId, sequence: seq, probe_sequence: curProbeSeq, model_name: modelName });
    if (disposed || !onb.open) return;
    const resMv = res?.model_verify || res?.onboarding?.model_verify;
    const resRunId = res?.run_id || res?.onboarding?.run_id || resMv?.run_id || "";
    const resProbeSeq = res?.probe_sequence ?? resMv?.sequence ?? res?.sequence;
    if (res?.stale || (reqRunId && resRunId && resRunId !== reqRunId) || (curProbeSeq !== onb.probeSeq) || (typeof resProbeSeq === "number" && resProbeSeq < curProbeSeq && resProbeSeq !== seq)) {
      return; // 严格丢弃过期探测响应
    }
    onb.probePending = false;
    onb.probeResult = resMv || { state: res?.success ? "ok" : "error", message: res?.message || res?.error || "探测完成" };
    renderOnbStep(0);
  }

  function collectCurrentOnbStepData() {
    const step = ONB_STEPS[onb.stepIdx];
    if (step === "admins") return { admins: onb.draftAdmins || [] };
    if (step === "chats") {
      const plgEl = $("#onb-plugin-enabled");
      if (plgEl) onb.draftPluginEnabled = Boolean(plgEl.checked);
      const plgOn = onb.draftPluginEnabled !== null ? Boolean(onb.draftPluginEnabled) : true;
      return { enabled_chats: onb.draftChats || [], plugin_enabled: plgOn, plugin: { enabled: plgOn } };
    }
    if (step === "runtime") {
      onb.draftModel = $("#onb-model")?.value || onb.draftModel;
      onb.draftPerm = $("#onb-perm")?.value || onb.draftPerm;
      onb.draftSandbox = $("#onb-sandbox") ? Boolean($("#onb-sandbox").checked) : onb.draftSandbox;
      const sb = Boolean(onb.draftSandbox);
      return { default_model: onb.draftModel, permission_mode: onb.draftPerm, sandbox_enabled: sb, sandbox: { enabled: sb } };
    }
    return {};
  }

  // 全局事件绑定（现场 + 引导 + 导航 + Tab 焦点围栏）
  document.addEventListener("click", async (ev) => {
    const navBtn = ev.target.closest("[data-nav], [data-mob-nav]");
    if (navBtn) {
      const p = navBtn.dataset.nav || navBtn.dataset.mobNav;
      if (Object.prototype.hasOwnProperty.call(PAGES, p)) switchWorkspaceTab(p);
      return;
    }

    if (ev.target.closest("#open-onboarding-btn")) {
      onb.stepIdx = 0;
      const curView = state.lastSnap?.onboarding;
      if (curView && curView.show === false) {
        const res = await hostRpc("write", "onboarding_reopen", {});
        const viewObj = res?.onboarding || res;
        if (res?.success && viewObj && typeof viewObj === "object") {
          if (state.lastSnap) state.lastSnap.onboarding = viewObj;
          openOnboardingModal(viewObj);
          return;
        }
      }
      openOnboardingModal(curView);
      return;
    }

    if (ev.target.closest("#onb-close")) {
      closeOnboardingModal(true);
      return;
    }
    if (ev.target.closest("#onb-skip")) {
      await onbStepMutation("onboarding_skip", () => ({ step: ONB_STEPS[onb.stepIdx] }), { keepStep: true, skipRender: true });
      closeOnboardingModal(true);
      return;
    }
    if (ev.target.closest("#onb-prev")) {
      if (onb.stepIdx > 0 && !onb.advancing) {
        onb.stepNavSeq += 1;
        onb.stepIdx -= 1;
        renderOnbStep(-1);
      }
      return;
    }
    if (ev.target.closest("#onb-next")) {
      if (onb.advancing) return;
      onb.advancing = true;
      const nextBtnEl = $("#onb-next");
      if (nextBtnEl) nextBtnEl.disabled = true;
      try {
        if (onb.stepIdx >= ONB_STEPS.length - 1) {
          const res = await onbStepMutation("onboarding_complete", () => ({}), { keepStep: true, skipRender: true });
          const viewObj = res?.onboarding || res;
          if (res?.success && res?.completed !== false && viewObj?.completed !== false) {
            closeOnboardingModal(true);
            refresh(true);
          } else if (res?.success && (res?.completed === false || viewObj?.completed === false)) {
            $("#onb-feedback").textContent = String(res?.message || res?.error || "尚有就绪条件未完成，请先检查并完善");
            $("#onb-feedback").className = "mil-feedback mil-feedback--err";
            applyOnbView(viewObj, { keepStep: false, dir: 0 });
          }
        } else {
          const curStepIdx = onb.stepIdx;
          const data = collectCurrentOnbStepData();
          const nextStep = ONB_STEPS[curStepIdx + 1];
          onb.stepNavSeq += 1;
          const res = await onbStepMutation(
            "onboarding_advance",
            () => ({ step: ONB_STEPS[curStepIdx], target_step: nextStep, data }),
            { keepStep: true, skipRender: true }
          );
          if (res?.success) {
            const viewObj = res?.onboarding || res;
            const srvStep = viewObj?.current_step;
            const srvIdx = srvStep ? stepIndexFromName(srvStep) : curStepIdx + 1;
            onb.stepIdx = Math.min(ONB_STEPS.length - 1, srvStep ? srvIdx : curStepIdx + 1);
            renderOnbStep(1);
          }
        }
      } finally {
        onb.advancing = false;
        if (nextBtnEl) nextBtnEl.disabled = false;
      }
      return;
    }
    const addAdmQuick = ev.target.closest("[data-onb-add-admin]");
    if (addAdmQuick) {
      const id = addAdmQuick.dataset.onbAddAdmin;
      if (id && !(onb.draftAdmins || []).includes(id)) {
        onb.draftAdmins = [...(onb.draftAdmins || []), id];
        renderOnbStep(0);
      }
      return;
    }
    const delAdmQuick = ev.target.closest("[data-onb-del-admin]");
    if (delAdmQuick) {
      const id = delAdmQuick.dataset.onbDelAdmin;
      onb.draftAdmins = (onb.draftAdmins || []).filter((x) => x !== id);
      renderOnbStep(0);
      return;
    }
    if (ev.target.closest("#onb-admin-add-btn")) {
      const built = readStructStreamBuilder("onb-adm");
      if (built.rawId && built.spec && !(onb.draftAdmins || []).includes(built.spec)) {
        onb.draftAdmins = [...(onb.draftAdmins || []), built.spec];
        renderOnbStep(0);
      }
      return;
    }
    if (ev.target.closest("#onb-open-chat-picker")) {
      onb.pickerOpen = !onb.pickerOpen;
      renderOnbStep(0);
      if (onb.pickerOpen) {
        $("#onb-chat-cand-search")?.focus();
        const info = onb.info || state.lastSnap?.onboarding || {};
        const sources = { ...(state.lastSnap?.chat_sources || {}), ...(info.chat_sources || {}) };
        const rawKnown = (Array.isArray(info.known_chat_specs) && info.known_chat_specs.length ? info.known_chat_specs : null)
          || info.known_chats || state.lastSnap?.known_chat_specs || state.lastSnap?.known_chats || [];
        const enabledSet = new Set(onb.draftChats || []);
        const missing = rawKnown
          .map((c) => (typeof c === "string" ? c : (c?.stream_spec || c?.chat_id || "")))
          .filter((cid) => cid && !enabledSet.has(cid) && !sources[cid])
          .slice(0, 40);
        if (missing.length) {
          const r = await hostRpc("read", "chat_sources", { chat_ids: missing });
          if (!disposed && onb.open && r?.success && r.sources) {
            if (!onb.info) onb.info = {};
            onb.info.chat_sources = { ...(onb.info.chat_sources || {}), ...r.sources };
            const candEl = $("#onb-chat-cand-list");
            const curEnabled = new Set(onb.draftChats || []);
            const candChats = [...new Set(rawKnown.map((c) => (typeof c === "string" ? c : (c?.stream_spec || c?.chat_id || ""))).filter((x) => x && !curEnabled.has(x)))];
            if (candEl && onb.pickerOpen) {
              candEl.innerHTML = renderOnbCandRows(candChats, { ...(state.lastSnap?.chat_sources || {}), ...onb.info.chat_sources }, onb.candQuery);
            }
          }
        }
      }
      return;
    }
    const addOnbChat = ev.target.closest("[data-onb-add-chat]");
    if (addOnbChat) {
      const cid = addOnbChat.dataset.onbAddChat;
      if (cid) {
        onb.draftChats = [...new Set([...(onb.draftChats || []), cid])];
        renderOnbStep(0);
      }
      return;
    }
    const delOnbChat = ev.target.closest("[data-onb-del-chat]");
    if (delOnbChat) {
      const cid = delOnbChat.dataset.onbDelChat;
      onb.draftChats = (onb.draftChats || []).filter((x) => x !== cid);
      renderOnbStep(0);
      return;
    }
    if (ev.target.closest("#onb-chat-add-btn")) {
      const built = readStructStreamBuilder("onb-chat");
      if (built.rawId && built.spec) {
        onb.draftChats = [...new Set([...(onb.draftChats || []), built.spec])];
        renderOnbStep(0);
      }
      return;
    }
    if (ev.target.closest("#onb-model-trigger")) {
      const drop = $("#onb-model-drop");
      const trig = $("#onb-model-trigger");
      if (drop && trig) {
        const nextOpen = Boolean(drop.hidden);
        drop.hidden = !nextOpen;
        trig.setAttribute("aria-expanded", String(nextOpen));
        onb.modelOpen = nextOpen;
        if (nextOpen) $("#onb-model-search")?.focus();
      }
      return;
    }
    const onbModelPick = ev.target.closest("#onb-model-list [data-pick-model]");
    if (onbModelPick) {
      const chosen = onbModelPick.dataset.pickModel || "";
      if (chosen) {
        onb.draftModel = chosen;
        onb.modelOpen = false;
        const hiddenIn = $("#onb-model");
        if (hiddenIn) hiddenIn.value = chosen;
        renderOnbStep(0);
      }
      return;
    }
    if (!$("#onb-model-drop")?.hidden && !ev.target.closest("#onb-model-box")) {
      const drop = $("#onb-model-drop");
      const trig = $("#onb-model-trigger");
      if (drop) drop.hidden = true;
      if (trig) trig.setAttribute("aria-expanded", "false");
      onb.modelOpen = false;
    }
    if (ev.target.closest("#onb-probe-btn")) {
      triggerOnbModelProbe();
      return;
    }
    const onbJump = ev.target.closest("[data-onb-jump-step]");
    if (onbJump) {
      onb.stepNavSeq += 1;
      onb.stepIdx = stepIndexFromName(onbJump.dataset.onbJumpStep);
      renderOnbStep(-1);
      return;
    }
    const onbCopy = ev.target.closest("[data-onb-copy]");
    if (onbCopy) {
      try { await navigator.clipboard?.writeText?.(onbCopy.dataset.onbCopy || ""); $("#onb-feedback").textContent = "已复制测试语句"; } catch (_) {}
      return;
    }

    if (ev.target.closest("#ms-upd-chip")) {
      const pop = $("#ms-upd-pop");
      const chip = $("#ms-upd-chip");
      if (pop && chip) {
        const nextOpen = pop.hidden;
        pop.hidden = !nextOpen;
        chip.setAttribute("aria-expanded", String(nextOpen));
        if (nextOpen) renderUpdateBar(latestUpdateInfo);
      }
      return;
    }
    if (ev.target.closest("#ms-upd-check-btn")) {
      const btn = $("#ms-upd-check-btn");
      const metaEl = $("#ms-upd-pop-meta");
      if (btn) btn.disabled = true;
      if (metaEl) metaEl.textContent = "正在连接 GitHub 检查…";
      try {
        const r = await hostRpc("write", "update_check", {});
        if (r?.update) {
          if (state.lastSnap) state.lastSnap.update = r.update;
          renderUpdateBar(r.update);
        } else if (r?.error) {
          renderUpdateBar(latestUpdateInfo, r.error);
        }
      } catch (err) {
        renderUpdateBar(latestUpdateInfo, err?.message || "检查更新失败");
      }
      if (btn) btn.disabled = false;
      return;
    }
    if (ev.target.closest("#ms-upd-copy-url")) {
      const url = $("#ms-upd-rel-box")?.dataset.releaseUrl || latestUpdateInfo.release_url || "";
      if (url) {
        try { await navigator.clipboard?.writeText?.(url); renderUpdateBar(latestUpdateInfo, "已复制发布页链接"); }
        catch (_) { renderUpdateBar(latestUpdateInfo, url); }
      }
      return;
    }
    const updToggleBtn = ev.target.closest("#ms-upd-toggle-dismiss");
    if (updToggleBtn) {
      const isUndo = updToggleBtn.dataset.updAction === "undismiss";
      const ver = updToggleBtn.dataset.updVersion || latestUpdateInfo.latest_version || "";
      updToggleBtn.disabled = true;
      try {
        const res = await hostRpc("write", isUndo ? "update_undismiss" : "update_dismiss", isUndo ? {} : { version: ver });
        if (res?.update) {
          if (state.lastSnap) state.lastSnap.update = res.update;
          renderUpdateBar(res.update, isUndo ? "已恢复此版本提醒" : `已忽略 v${ver}，下一版本再提醒`);
        }
      } catch (_) {}
      updToggleBtn.disabled = false;
      return;
    }
    if (!$("#ms-upd-pop")?.hidden && !ev.target.closest("#ms-upd-anchor")) {
      closeUpdatePopover(false);
    }

    if (activePage !== "now") return;

    if (ev.target.closest("#now-goto-proposals")) {
      const props = Array.isArray(state.lastSnap?.pending_skill_proposals) ? state.lastSnap.pending_skill_proposals : [];
      const allPlanner = props.length > 0 && props.every((p) => p.profile_id === "planner" || p.skill_id === "planner-manual");
      if (allPlanner) {
        pendingProfileTarget = "__planner__";
        switchWorkspaceTab("abilities", { abSub: "profiles" });
      } else {
        switchWorkspaceTab("abilities", { abSub: "skills" });
      }
      return;
    }
    if (ev.target.closest("#now-add-intent-btn")) {
      const f = $("#now-intent-form");
      if (f) { f.hidden = !f.hidden; if (!f.hidden) $("#now-new-int-reason")?.focus(); }
      return;
    }
    if (ev.target.closest("#now-new-int-cancel")) {
      const f = $("#now-intent-form");
      if (f) f.hidden = true;
      return;
    }
    if (ev.target.closest("#now-prune-btn")) {
      const ok = await window.MaisyaUI.confirmDanger({
        tag: "批量清理",
        title: "清理已结束的废记录？",
        body: "将永久删除已结束、无持久工作区且无保留产物的旧活动记录，保留的产物文件不受影响。",
        confirmText: "确认清理",
      });
      if (!ok || disposed) return;
      const r = await hostRpc("write", "prune_threads", {});
      if (!r?.success) setNowFeedback(r?.error || "清理失败", true);
      else {
        const deletedIds = new Set(Array.isArray(r.deleted) ? r.deleted : []);
        const cnt = deletedIds.size || Number(r.count || 0);
        if (state.threadId && deletedIds.has(state.threadId)) {
          state.threadId = "";
          state.selectedDetail = null;
        }
        setNowFeedback(cnt > 0 ? `已清理 ${cnt} 条已结束废记录` : "暂无可清理的废记录");
        refresh(true);
      }
      return;
    }
    if (ev.target.closest("#now-del-thread-btn") && state.threadId) {
      const tid = state.threadId;
      const sel = selectedForView(state.lastSnap);
      const thTitle = (sel?.title || $("#now-sel-title")?.textContent || tid).trim();
      const ok = await window.MaisyaUI.confirmDanger({
        tag: "删除记录",
        title: "删除该条活动记录？",
        body: `将永久删除活动「${thTitle}」（${tid}）及其步骤日志；已单独生成的产物文件仍保留在产物库。`,
        confirmText: "确认删除",
      });
      if (!ok || disposed) return;
      const r = await hostRpc("write", "delete_thread", { thread_id: tid });
      if (!r?.success) setNowFeedback(r?.error || "删除失败", true);
      else {
        if (state.threadId === tid) {
          state.threadId = "";
          state.selectedDetail = null;
        }
        setNowFeedback("已删除该条活动记录");
        refresh(true);
      }
      return;
    }

    const intentActBtn = ev.target.closest("[data-intent-act]");
    if (intentActBtn) {
      const action = intentActBtn.dataset.intentAct;
      const intent_id = intentActBtn.dataset.intentId;
      if (action === "intent_delete") {
        const titleTxt = intentActBtn.closest(".now-intent-card")?.querySelector(".now-card-title-txt")?.textContent?.trim() || intent_id;
        const ok = await window.MaisyaUI.confirmDanger({
          tag: "取消计划",
          title: "取消该条预定计划？",
          body: `取消「${titleTxt}」后将不再按计划自动唤醒执行（仅暂停可点击“暂停”保留日程）。`,
          confirmText: "确认取消",
        });
        if (!ok || disposed) return;
      }
      const r = await hostRpc("write", action, { intent_id });
      if (!r?.success) setNowFeedback(r?.error || "操作失败", true);
      else { setNowFeedback("状态已更新"); refresh(true); }
      return;
    }

    const reopenBtn = ev.target.closest("[data-thread-reopen]") || (ev.target.closest("#now-reopen-btn") ? { dataset: { threadReopen: state.threadId } } : null);
    if (reopenBtn && reopenBtn.dataset.threadReopen) {
      ev.stopPropagation();
      const tid = reopenBtn.dataset.threadReopen;
      const r = await hostRpc("write", "thread_reopen", { thread_id: tid });
      if (!r?.success) setNowFeedback(r?.error || "恢复失败", true);
      else { setNowFeedback("线程已恢复可继续状态"); state.threadId = tid; refresh(true); }
      return;
    }

    const thCard = ev.target.closest("[data-thread-id]");
    if (thCard) {
      state.threadId = thCard.dataset.threadId;
      state.selectedStepId = "";
      state.viewMode = "overview";
      state.selectedDetail = null;
      refresh(true);
      loadThreadDetail(state.threadId);
      return;
    }

    const thFilterBtn = ev.target.closest("[data-th-filter]");
    if (thFilterBtn) {
      state.thFilter = thFilterBtn.dataset.thFilter;
      $$("[data-th-filter]").forEach((b) => b.setAttribute("aria-pressed", String(b === thFilterBtn)));
      if (state.lastSnap) renderThreads(state.lastSnap);
      return;
    }

    const apprBtn = ev.target.closest("[data-appr-decision]");
    if (apprBtn) {
      const sel = selectedForView(state.lastSnap);
      const appr = sel?.pending_approval || {};
      const r = await hostRpc("write", "thread_approve", {
        thread_id: sel?.thread_id || state.threadId,
        request_id: appr.request_id || "",
        action_key: appr.action_key || "",
        decision: apprBtn.dataset.apprDecision,
      });
      if (!r?.success) setNowFeedback(r?.error || "审批提交失败", true);
      else { setNowFeedback("已提交审批决定"); refresh(true); loadThreadDetail(state.threadId); }
      return;
    }

    if (ev.target.closest("#now-note-send")) {
      const inp = $("#now-note-input");
      const msg = (inp?.value || "").trim();
      if (!msg) return;
      const r = await enqueueAction(() => callMaibotRaw("action", "note", { thread_id: state.threadId, message: msg, steer: false }));
      if (!r?.success) setNowFeedback(r?.error || "补充发送失败", true);
      else { inp.value = ""; setNowFeedback("补充说明已送入线程"); refresh(true); }
      return;
    }

    if (ev.target.closest("#now-steer-btn")) {
      const inp = $("#now-note-input");
      const msg = (inp?.value || "").trim();
      if (!msg) { setNowFeedback("请先在输入框填写要转向的新要求", true); inp?.focus(); return; }
      const r = await enqueueAction(() => callMaibotRaw("action", "note", { thread_id: state.threadId, message: msg, steer: true }));
      if (!r?.success) setNowFeedback(r?.error || "转向发送失败", true);
      else { inp.value = ""; setNowFeedback("已发送立即转向指令，正按新要求调整方向"); refresh(true); }
      return;
    }

    if (ev.target.closest("#now-stop-btn")) {
      const r = await hostRpc("write", "thread_stop", { thread_id: state.threadId });
      if (!r?.success) setNowFeedback(r?.error || "停止失败", true);
      else { setNowFeedback("已请求停止并保留上下文（发消息即可继续）"); refresh(true); }
      return;
    }

    const stepBtn = ev.target.closest("[data-step-id]");
    if (stepBtn) {
      state.selectedStepId = stepBtn.dataset.stepId;
      state.viewMode = "step";
      if (state.lastSnap) renderSelectedStage(state.lastSnap);
      return;
    }

    if (ev.target.closest("#now-back-overview")) {
      state.viewMode = "overview";
      if (state.lastSnap) { renderSelectedStage(state.lastSnap); renderContext(state.lastSnap); }
      return;
    }

    const jumpLib = ev.target.closest("[data-jump-lib]");
    if (jumpLib) {
      pendingLibraryTarget = { id: jumpLib.dataset.jumpLib };
      switchWorkspaceTab("library");
      return;
    }

    const ctxViewBtn = ev.target.closest("[data-ctx-view]");
    if (ctxViewBtn) {
      state.ctxView = ctxViewBtn.dataset.ctxView;
      $$("[data-ctx-view]").forEach((b) => b.setAttribute("aria-pressed", String(b === ctxViewBtn)));
      if (state.lastSnap) renderContext(state.lastSnap);
      return;
    }
    const ctxCatBtn = ev.target.closest("[data-ctx-cat]");
    if (ctxCatBtn) {
      state.ctxCat = ctxCatBtn.dataset.ctxCat;
      if (state.lastSnap) renderContext(state.lastSnap);
      return;
    }
    const tile = ev.target.closest(".cm-tile");
    if (tile) { openCtxModal($("#ctx-map")?._rectItems?.[Number(tile.dataset.itemIdx)]); return; }
    const cell = ev.target.closest(".cm-cell");
    if (cell) { const idx = Number(cell.dataset.cellIdx); openCtxModal(idx >= 0 ? $("#ctx-grid")?._mapInputs?.[idx] : null); return; }
    const ci = ev.target.closest("[data-ci-idx]");
    if (ci) { openCtxModal(currentCtxItems[Number(ci.dataset.ciIdx)]); return; }

    if (ev.target.closest("#ctx-modal-close") || ev.target === $("#ctx-scrim")) {
      closeCtxModal();
      return;
    }

    if (ev.target.closest("#launch-profile-trigger")) {
      const drop = $("#launch-profile-drop");
      if (drop) {
        const nextOpen = drop.hidden;
        drop.hidden = !nextOpen;
        $("#launch-profile-trigger")?.setAttribute("aria-expanded", String(nextOpen));
        const chatDrop = $("#launch-chat-drop");
        if (nextOpen && chatDrop && !chatDrop.hidden) {
          chatDrop.hidden = true;
          $("#launch-chat-trigger")?.setAttribute("aria-expanded", "false");
        }
      }
      return;
    }
    const pickLP = ev.target.closest("[data-launch-pick-profile]");
    if (pickLP) {
      const pIn = $("#launch-profile");
      if (pIn) pIn.value = pickLP.dataset.launchPickProfile;
      const drop = $("#launch-profile-drop");
      if (drop) drop.hidden = true;
      $("#launch-profile-trigger")?.setAttribute("aria-expanded", "false");
      if (state.lastSnap) renderLaunchAssist(state.lastSnap);
      return;
    }
    if (ev.target.closest("#launch-chat-trigger")) {
      const drop = $("#launch-chat-drop");
      if (drop) {
        const nextOpen = drop.hidden;
        drop.hidden = !nextOpen;
        $("#launch-chat-trigger")?.setAttribute("aria-expanded", String(nextOpen));
        const profDrop = $("#launch-profile-drop");
        if (nextOpen && profDrop && !profDrop.hidden) {
          profDrop.hidden = true;
          $("#launch-profile-trigger")?.setAttribute("aria-expanded", "false");
        }
        if (nextOpen) setTimeout(() => $("#launch-chat-search")?.focus(), 20);
      }
      return;
    }
    const pickLC = ev.target.closest("[data-launch-pick-chat]");
    if (pickLC) {
      const cIn = $("#launch-chat");
      if (cIn) cIn.value = pickLC.dataset.launchPickChat;
      const drop = $("#launch-chat-drop");
      if (drop) drop.hidden = true;
      $("#launch-chat-trigger")?.setAttribute("aria-expanded", "false");
      if (state.lastSnap) renderLaunchAssist(state.lastSnap);
      return;
    }
    if (!ev.target.closest("#launch-profile-box")) {
      const drop = $("#launch-profile-drop");
      if (drop && !drop.hidden) {
        drop.hidden = true;
        $("#launch-profile-trigger")?.setAttribute("aria-expanded", "false");
      }
    }
    if (!ev.target.closest("#launch-chat-box")) {
      const drop = $("#launch-chat-drop");
      if (drop && !drop.hidden) {
        drop.hidden = true;
        $("#launch-chat-trigger")?.setAttribute("aria-expanded", "false");
      }
    }

    if (ev.target.closest("#launch-run")) {
      const fb = $("#launch-feedback");
      const msg = ($("#launch-prompt")?.value || "").trim();
      if (!msg) { if (fb) { fb.textContent = "请输入事情描述"; fb.className = "mil-feedback mil-feedback--err"; } return; }
      const wsSel = $("#launch-ws-select");
      const rawWs = wsSel?.value === "__new__" ? ($("#launch-workspace")?.value || "").trim() : (wsSel?.value || $("#launch-workspace")?.value || "").trim();
      const res = await enqueueAction(() => callMaibotRaw("action", "note", {
        profile: ($("#launch-profile")?.value || "default").trim() || "default",
        chat_id: ($("#launch-chat")?.value || "").trim() || undefined,
        workspace: rawWs || undefined,
        message: msg,
        steer: false,
      }));
      if (!res?.success) { if (fb) { fb.textContent = res?.error || "发起失败"; fb.className = "mil-feedback mil-feedback--err"; } }
      else { if (fb) { fb.textContent = "已提交发起"; fb.className = "mil-feedback mil-feedback--ok"; } $("#launch-prompt").value = ""; if (res.thread_id) state.threadId = res.thread_id; refresh(true); }
    }
  }, { signal: shellSig });

  document.addEventListener("submit", async (ev) => {
    if (ev.target.id !== "now-intent-form") return;
    ev.preventDefault();
    const modeVal = ($("#now-new-int-mode")?.value || "once").trim();
    const mins = Math.max(1, Number($("#now-new-int-mins")?.value || 60));
    const chatVal = ($("#now-new-int-chat")?.value || "").trim() || "self";
    const profVal = ($("#now-new-int-profile")?.value || "default").trim();
    const reasonVal = ($("#now-new-int-reason")?.value || "").trim();
    const condVal = ($("#now-new-int-cond")?.value || "").trim();
    if (!reasonVal) { setNowFeedback("请先填写安排或盯梢说明", true); $("#now-new-int-reason")?.focus(); return; }
    if (modeVal === "watch" && !condVal) { setNowFeedback("条件盯梢需要填写触发条件", true); $("#now-new-int-cond")?.focus(); return; }
    const payload = {
      chat_id: chatVal,
      profile: profVal,
      reason: reasonVal,
      prompt: reasonVal,
      in_seconds: modeVal === "once" ? mins * 60 : Math.max(60, mins * 60),
      ...(modeVal === "recurring" ? { every_seconds: Math.max(300, mins * 60) } : {}),
      ...(modeVal === "watch" ? { mode: "watch", every_seconds: Math.max(300, mins * 60), condition: condVal } : {}),
    };
    const r = await hostRpc("write", "schedule_intent", payload);
    if (!r?.success) { setNowFeedback(r?.error || "保存安排失败", true); return; }
    $("#now-intent-form").hidden = true;
    $("#now-new-int-reason").value = "";
    $("#now-new-int-cond").value = "";
    setNowFeedback("已加入预定与盯梢队列");
    refresh(true);
  }, { signal: shellSig });

  document.addEventListener("change", async (ev) => {
    if (ev.target.id === "ms-upd-auto" || ev.target.id === "ms-upd-notify") {
      const key = ev.target.id === "ms-upd-auto" ? "update_check_enabled" : "update_notify_admin";
      const val = Boolean(ev.target.checked);
      try {
        const res = await hostRpc("write", "settings_update", { settings: { [key]: val } });
        if (res?.success) {
          const nextUpd = res.update || { ...latestUpdateInfo, [key === "update_check_enabled" ? "check_enabled" : "notify_admin"]: val };
          if (state.lastSnap) state.lastSnap.update = nextUpd;
          renderUpdateBar(nextUpd, "已保存更新偏好");
        } else {
          ev.target.checked = !val;
          renderUpdateBar(latestUpdateInfo, res?.error || "保存失败");
        }
      } catch (_) {
        ev.target.checked = !val;
      }
      return;
    }
    if (ev.target.id === "now-thread-chat") {
      state.thChat = ev.target.value || "";
      if (state.lastSnap) renderThreads(state.lastSnap);
      return;
    }
    if (ev.target.id === "now-new-int-mode") {
      const cw = $("#now-new-int-cond-wrap");
      if (cw) cw.hidden = ev.target.value !== "watch";
      return;
    }
    if (ev.target.id === "launch-ws-select") {
      const wsIn = $("#launch-workspace");
      if (wsIn) {
        if (ev.target.value === "__new__") {
          wsIn.hidden = false;
          wsIn.value = "";
          setTimeout(() => wsIn.focus(), 20);
        } else {
          wsIn.hidden = true;
          wsIn.value = ev.target.value || "";
        }
      }
      return;
    }
    const chk = ev.target.closest("[data-onb-chat]");
    if (chk) {
      const cid = chk.dataset.onbChat;
      const cur = new Set(onb.draftChats || []);
      if (chk.checked) cur.add(cid); else cur.delete(cid);
      onb.draftChats = [...cur];
      return;
    }
    if (ev.target.id === "onb-plugin-enabled") onb.draftPluginEnabled = Boolean(ev.target.checked);
    if (ev.target.id === "onb-model") onb.draftModel = ev.target.value;
    if (ev.target.id === "onb-perm") onb.draftPerm = ev.target.value;
    if (ev.target.id === "onb-sandbox") onb.draftSandbox = Boolean(ev.target.checked);
  }, { signal: shellSig });

  document.addEventListener("input", (ev) => {
    if (ev.target.id === "now-thread-search") {
      state.thQuery = ev.target.value || "";
      if (state.lastSnap) renderThreads(state.lastSnap);
    } else if (ev.target.id === "launch-chat-search") {
      launchChatQuery = ev.target.value || "";
      if (state.lastSnap) renderLaunchAssist(state.lastSnap);
    } else if (ev.target.id === "onb-chat-cand-search") {
      onb.candQuery = ev.target.value || "";
      const listEl = $("#onb-chat-cand-list");
      const info = onb.info || state.lastSnap?.onboarding || {};
      const sources = { ...(state.lastSnap?.chat_sources || {}), ...(info.chat_sources || {}) };
      const rawKnown = (Array.isArray(info.known_chat_specs) && info.known_chat_specs.length ? info.known_chat_specs : null)
        || info.known_chats || state.lastSnap?.known_chat_specs || state.lastSnap?.known_chats || [];
      const enabledSet = new Set(onb.draftChats || []);
      const candChats = [...new Set(rawKnown.map((c) => (typeof c === "string" ? c : (c?.stream_spec || c?.chat_id || ""))).filter((x) => x && !enabledSet.has(x)))];
      if (listEl) listEl.innerHTML = renderOnbCandRows(candChats, sources, onb.candQuery);
    } else if (ev.target.id === "onb-model-search") {
      onb.modelQuery = ev.target.value || "";
      const listEl = $("#onb-model-list");
      const info = onb.info || state.lastSnap?.onboarding || {};
      const curVal = $("#onb-model")?.value || onb.draftModel || "";
      const rawModels = (Array.isArray(info.model_catalog) && info.model_catalog.length ? info.model_catalog : null)
        || info.models
        || (Array.isArray(state.lastSnap?.model_catalog) && state.lastSnap.model_catalog.length ? state.lastSnap.model_catalog : null)
        || state.lastSnap?.available_models || [];
      const models = normalizeModelCatalog(rawModels, curVal ? [curVal] : []);
      if (listEl) listEl.innerHTML = renderModelGroupsHtml(models, { selectedNames: curVal ? [curVal] : [], query: onb.modelQuery });
    }
  }, { signal: shellSig });

  document.addEventListener("keydown", (ev) => {
    if (ev.key === "Escape") {
      if (isConfirmOpen() || ev.target?.closest?.("#ms-confirm-dialog")) return;
      if (!$("#ms-upd-pop")?.hidden) { closeUpdatePopover(true); return; }
      if (!$("#ctx-scrim")?.hidden) { closeCtxModal(); return; }
      const mDrop = $("#onb-model-drop");
      if (mDrop && !mDrop.hidden) {
        mDrop.hidden = true;
        $("#onb-model-trigger")?.setAttribute("aria-expanded", "false");
        onb.modelOpen = false;
        $("#onb-model-trigger")?.focus();
        return;
      }
      if (onb.open) { closeOnboardingModal(true); return; }
    }
    // 引导弹窗 Tab 焦点围栏
    if (ev.key === "Tab" && onb.open && !$("#onb-scrim")?.hidden) {
      const card = $("#onb-card");
      if (!card) return;
      const focusables = [...card.querySelectorAll('button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])')]
        .filter((el) => !el.hidden && !el.closest("[hidden]") && !el.closest(".leaving") && el.offsetParent !== null);
      if (!focusables.length) return;
      const first = focusables[0], last = focusables[focusables.length - 1];
      if (ev.shiftKey && (document.activeElement === first || !card.contains(document.activeElement))) {
        ev.preventDefault(); last.focus();
      } else if (!ev.shiftKey && document.activeElement === last) {
        ev.preventDefault(); first.focus();
      }
    }
  }, { signal: shellSig });

  document.addEventListener("mouseover", (ev) => {
    const t = ev.target.closest(".cm-tile, .cm-cell");
    if (!t || activePage !== "now") return;
    const item = t.classList.contains("cm-tile")
      ? $("#ctx-map")?._rectItems?.[Number(t.dataset.itemIdx)]
      : $("#ctx-grid")?._mapInputs?.[Number(t.dataset.cellIdx)];
    if (item) showCtxTip(ev, `${item.label} · ${fmtK(item.tokens ?? item.chars ?? 0)}`);
  }, { signal: shellSig });
  document.addEventListener("mouseout", (ev) => {
    if (ev.target.closest(".cm-tile, .cm-cell")) hideCtxTip();
  }, { signal: shellSig });

  function initHelpPopovers() {
    const pop = $("#mil-help-pop");
    if (!pop) return () => {};
    let activeBtn = null, pinnedBtn = null;
    const closePop = () => {
      if (activeBtn) activeBtn.setAttribute("aria-expanded", "false");
      activeBtn = null; pinnedBtn = null; pop.hidden = true;
    };
    const openPop = (btn) => {
      const text = btn?.dataset?.help || "";
      if (!text) return;
      if (activeBtn && activeBtn !== btn) activeBtn.setAttribute("aria-expanded", "false");
      activeBtn = btn; activeBtn.setAttribute("aria-expanded", "true");
      pop.textContent = text; pop.hidden = false;
      const r = btn.getBoundingClientRect();
      const pw = pop.offsetWidth || 260, ph = pop.offsetHeight || 60;
      pop.style.left = `${Math.round(Math.max(12, Math.min(window.innerWidth - pw - 12, r.left + r.width / 2 - pw / 2)))}px`;
      pop.style.top = `${Math.round(r.bottom + ph + 16 < window.innerHeight ? r.bottom + 8 : Math.max(12, r.top - ph - 8))}px`;
    };
    document.addEventListener("click", (ev) => {
      const btn = ev.target.closest(".mil-help");
      if (btn) {
        if (btn.closest("summary")) ev.preventDefault();
        ev.stopPropagation();
        if (pinnedBtn === btn && !pop.hidden) closePop(); else { pinnedBtn = btn; openPop(btn); }
        return;
      }
      if (!pop.hidden && !ev.target.closest("#mil-help-pop")) closePop();
    }, { signal: shellSig });
    document.addEventListener("keydown", (ev) => { if (ev.key === "Escape" && !isConfirmOpen() && !pop.hidden) closePop(); }, { signal: shellSig });
    return closePop;
  }

{{MGMT_BOOT_JS}}

  const closeHelpPop = initHelpPopovers();

  function syncShellToPage(targetPage, { remountMgmt = true, remountNow = true } = {}) {
    const isNow = targetPage === "now";
    const nowView = $("#ms-now-view");
    const mgmtWrap = $("#ms-mgmt-view-wrap");
    const mgmtView = $("#ms-mgmt-view");

    activePage = targetPage;
    document.body.dataset.page = targetPage;
    document.title = `Maisya · ${PAGES[targetPage] || "现场"}`;
    const titleEl = $("#ms-page-title");
    if (titleEl) titleEl.textContent = PAGES[targetPage] || "现场";
    $$("[data-nav], [data-mob-nav]").forEach((btn) => {
      const target = btn.dataset.nav || btn.dataset.mobNav;
      if (target === targetPage) btn.setAttribute("aria-current", "page");
      else btn.removeAttribute("aria-current");
    });
    if (nowView) nowView.hidden = !isNow;
    if (mgmtWrap) mgmtWrap.hidden = isNow;
    const topLedPill = $("#top-led-pill");
    if (topLedPill) topLedPill.hidden = !isNow;

    closeHelpPop?.();
    closeUpdatePopover(false);
    hideCtxTip();
    if ($("#ms-confirm-dialog")?.open) closeConfirmDialog("cancel");
    if (!isNow && !$("#ctx-scrim")?.hidden) closeCtxModal();

    if (isNow) {
      if (mgmtView) mgmtView.innerHTML = "";
      if (remountNow && nowView && !nowView.innerHTML.trim()) nowView.innerHTML = MGMT_FRAGMENTS.now || "";
    } else {
      if (remountMgmt && mgmtView) mgmtView.innerHTML = MGMT_FRAGMENTS[targetPage] || "";
    }
    renderIconSlots();
  }

  function switchWorkspaceTab(rawTarget, opts = {}) {
    const resolved = resolvePageAlias(rawTarget);
    const targetPage = resolved.page;
    if (!Object.prototype.hasOwnProperty.call(PAGES, targetPage)) return;
    if (resolved.abSub) pendingAbilitiesSubTab = resolved.abSub;
    else if (rawTarget === "abilities" && opts.abSub) pendingAbilitiesSubTab = opts.abSub;
    if (resolved.memKind) pendingMemoryKind = resolved.memKind;
    else if (opts.memKind) pendingMemoryKind = opts.memKind;

    if (targetPage === activePage && !opts.forceBoot) {
      if (targetPage === "abilities" && (resolved.abSub || opts.abSub)) {
        window.dispatchEvent(new CustomEvent("maisya:abilities-subtab", { detail: { sub: pendingAbilitiesSubTab } }));
      } else if (targetPage === "memory" && (resolved.memKind || opts.memKind)) {
        window.dispatchEvent(new CustomEvent("maisya:memory-kind", { detail: { kind: pendingMemoryKind } }));
      }
      return;
    }
    if (!opts.system) userNavigated = true;
    if (mgmtAbort) { mgmtAbort.abort(); mgmtAbort = null; }
    syncShellToPage(targetPage, { remountMgmt: opts.remountMgmt !== false, remountNow: opts.remountNow !== false });
    if (targetPage === "now") {
      applyTheme();
      if (state.lastSnap) {
        renderHeartbeatTicks(state.lastSnap);
        renderIntents(state.lastSnap);
        renderThreads(state.lastSnap);
        renderSelectedStage(state.lastSnap);
        renderContext(state.lastSnap);
      }
      if (bootStarted) refresh(true);
    } else {
      mgmtAbort = new AbortController();
      bootManagementTab(targetPage, mgmtAbort.signal);
      applyTheme();
    }
  }

  window.addEventListener("maisya:themechange", () => {
    if (disposed) return;
    if (activePage === "now" && state.lastSnap) {
      renderIntents(state.lastSnap);
      renderThreads(state.lastSnap);
      renderSelectedStage(state.lastSnap);
    }
    if (onb.open) renderOnbStep(0);
  }, { signal: shellSig });

  window.__maisyaDispose = () => {
    disposed = true;
    closeConfirmDialog("cancel");
    if (timer) clearInterval(timer);
    if (mgmtAbort) mgmtAbort.abort();
    shellAbort.abort();
  };

  const initHostRaw = String(window.maibot?.page?.state?.tab || window.maibot?.page?.state?.page || "").trim();
  const initHostResolved = resolvePageAlias(initHostRaw);
  if (initHostRaw && Object.prototype.hasOwnProperty.call(PAGES, initHostResolved.page) && (initHostResolved.page !== activePage || initHostResolved.abSub || initHostResolved.memKind)) {
    switchWorkspaceTab(initHostRaw, { system: true, forceBoot: true });
  } else {
    switchWorkspaceTab(activePage, { system: true, forceBoot: true, remountMgmt: false, remountNow: false });
  }

  Promise.resolve(window.maibot?.ready).then(() => {
    if (disposed) return;
    bootStarted = true;
    const readyRaw = String(window.maibot?.page?.state?.tab || window.maibot?.page?.state?.page || "").trim();
    const readyResolved = resolvePageAlias(readyRaw);
    if (!userNavigated && readyRaw && Object.prototype.hasOwnProperty.call(PAGES, readyResolved.page) && (readyResolved.page !== activePage || readyResolved.abSub || readyResolved.memKind)) {
      switchWorkspaceTab(readyRaw, { system: true, forceBoot: true });
    } else if (activePage === "now") {
      applyTheme();
      refresh(true);
    }
    timer = setInterval(() => {
      if (disposed || activePage !== "now") return;
      if (!document.hidden && queryInFlight === 0 && Date.now() - lastSnapshotAt >= 2000) refresh(false);
    }, 2600);
  });
})();
</script>
</body>
</html>
