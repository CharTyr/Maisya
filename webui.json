{
  "schema_version": 2,
  "workspace_title": "Maisya",
  "required_capabilities": [
    "custom_pages"
  ],
  "pages": [
    {
      "id": "now",
      "title": "现场",
      "mode": "custom",
      "placement": "workspace",
      "entry": "webui/now.html",
      "layout": "viewport",
      "queries": {
        "event": {
          "api": "maisya_event",
          "version": "1",
          "parameters": {
            "thread_id": {
              "type": "string",
              "required": true,
              "max_length": 64
            },
            "event_seq": {
              "type": "integer",
              "required": true,
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            }
          }
        },
        "snapshot": {
          "api": "maisya_now",
          "version": "1",
          "parameters": {
            "thread_id": {
              "type": "string",
              "max_length": 64
            },
            "chat_id": {
              "type": "string",
              "max_length": 256
            },
            "cursor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      },
      "actions": {
        "note": {
          "api": "maisya_note",
          "version": "1",
          "parameters": {
            "thread_id": {
              "type": "string",
              "required": true,
              "max_length": 64
            },
            "message": {
              "type": "string",
              "required": true,
              "max_length": 16000
            }
          }
        },
        "stop": {
          "api": "maisya_stop",
          "version": "1",
          "parameters": {
            "thread_id": {
              "type": "string",
              "required": true,
              "max_length": 64
            }
          }
        }
      }
    },
    {
      "id": "abilities",
      "title": "能力",
      "mode": "custom",
      "placement": "workspace",
      "entry": "webui/abilities.html",
      "layout": "viewport",
      "queries": {
        "read": {
          "api": "maisya_manage_read",
          "version": "1",
          "parameters": {
            "section": {
              "type": "string",
              "required": true,
              "max_length": 64
            },
            "payload": {
              "type": "string",
              "max_length": 60000
            }
          }
        }
      },
      "actions": {
        "write": {
          "api": "maisya_manage_write",
          "version": "1",
          "parameters": {
            "action": {
              "type": "string",
              "required": true,
              "max_length": 64
            },
            "payload": {
              "type": "string",
              "max_length": 60000
            }
          }
        }
      }
    },
    {
      "id": "memory",
      "title": "记忆",
      "mode": "custom",
      "placement": "workspace",
      "entry": "webui/memory.html",
      "layout": "viewport",
      "queries": {
        "read": {
          "api": "maisya_manage_read",
          "version": "1",
          "parameters": {
            "section": {
              "type": "string",
              "required": true,
              "max_length": 64
            },
            "payload": {
              "type": "string",
              "max_length": 60000
            }
          }
        }
      },
      "actions": {
        "write": {
          "api": "maisya_manage_write",
          "version": "1",
          "parameters": {
            "action": {
              "type": "string",
              "required": true,
              "max_length": 64
            },
            "payload": {
              "type": "string",
              "max_length": 60000
            }
          }
        }
      }
    },
    {
      "id": "settings",
      "title": "设置",
      "mode": "custom",
      "placement": "workspace",
      "entry": "webui/settings.html",
      "layout": "viewport",
      "queries": {
        "read": {
          "api": "maisya_manage_read",
          "version": "1",
          "parameters": {
            "section": {
              "type": "string",
              "required": true,
              "max_length": 64
            },
            "payload": {
              "type": "string",
              "max_length": 60000
            }
          }
        }
      },
      "actions": {
        "write": {
          "api": "maisya_manage_write",
          "version": "1",
          "parameters": {
            "action": {
              "type": "string",
              "required": true,
              "max_length": 64
            },
            "payload": {
              "type": "string",
              "max_length": 60000
            }
          }
        },
        "incoming_event": {
          "api": "maisya_incoming_event",
          "version": "1",
          "parameters": {
            "channel": {
              "type": "string",
              "required": true,
              "max_length": 64
            },
            "event_id": {
              "type": "string",
              "required": true,
              "max_length": 128
            },
            "timestamp": {
              "type": "integer",
              "required": true,
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "payload": {
              "type": "string",
              "required": true,
              "max_length": 16000
            },
            "signature": {
              "type": "string",
              "required": true,
              "max_length": 64
            }
          }
        }
      }
    }
  ]
}
